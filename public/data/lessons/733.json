{
  "id": "733",
  "title": "Can You Speak a Bit Slower?",
  "level": "newbie",
  "date": "2019-06-13",
  "synopsis": "Ben is having a hard time understanding what the shop assistant is saying.",
  "audioUrl": "https://static.duchinese.net/documents/1070/557e1f54333e0c1cd1822a2ebad6bb728258adae.mp3?1560164244",
  "series": {
    "title": "Ben’s life in China 5: You’re my best friend",
    "chapter": 26,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你能说慢一点儿吗？\n\n本：不好意思！请问，苹果在哪儿？\n店员：在前面，你往前走一点儿就会看到了。\n本：不好意思，你能说慢一点儿吗？\n店员：在前面。我和你一起去吧！\n本：好的。谢谢！\n店员：不客气！",
    "traditional": "你能說慢一點兒嗎？\n\n本：不好意思！請問，蘋果在哪兒？\n店員：在前面，你往前走一點兒就會看到了。\n本：不好意思，你能說慢一點兒嗎？\n店員：在前面。我和你一起去吧！\n本：好的。謝謝！\n店員：不客氣！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Can You Speak a Bit Slower?"
    },
    {
      "index": 2,
      "simplified": "本：不好意思！请问，苹果在哪儿？",
      "traditional": "本：不好意思！請問，蘋果在哪兒？",
      "pinyin": "běn bù hǎo yì si qǐng wèn píng guǒ zài nǎ'r",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Excuse me! May I ask, where are the apples?"
    },
    {
      "index": 4,
      "simplified": "店员：在前面，你往前走一点儿就会看到了。",
      "traditional": "店員：在前面，你往前走一點兒就會看到了。",
      "pinyin": "diàn yuán zài qián miàn nǐ wǎng qián zǒu yì diǎn'r jiù huì kàn dào le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: They are up ahead, go forward a bit and you will see them."
    },
    {
      "index": 6,
      "simplified": "本：不好意思，你能说慢一点儿吗？",
      "traditional": "本：不好意思，你能說慢一點兒嗎？",
      "pinyin": "běn bù hǎo yì si nǐ néng shuō màn yì diǎn'r ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Excuse me, can you say that a bit slower?"
    },
    {
      "index": 8,
      "simplified": "店员：在前面。我和你一起去吧！",
      "traditional": "店員：在前面。我和你一起去吧！",
      "pinyin": "diàn yuán zài qián miàn wǒ hé nǐ yì qǐ qù ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: They are up ahead. I will go with you!"
    },
    {
      "index": 10,
      "simplified": "本：好的。谢谢！",
      "traditional": "本：好的。謝謝！",
      "pinyin": "běn hǎo de xiè xie",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Ok. Thank you!"
    },
    {
      "index": 12,
      "simplified": "店员：不客气！",
      "traditional": "店員：不客氣！",
      "pinyin": "diàn yuán bú kè qi",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Shop assistant: Not at all!"
    }
  ],
