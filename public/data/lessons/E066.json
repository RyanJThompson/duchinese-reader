    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer Service: Hello, Shanghai KTV."
    },
    {
      "index": 4,
      "simplified": "客人：您好。我想订一个包厢。",
      "traditional": "客人：您好。我想訂一個包廂。",
      "pinyin": "kè rén nín hǎo wǒ xiǎng dìng yí ge bāo xiāng",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer: Hello. I would like to book a room."
    },
    {
      "index": 6,
      "simplified": "客服：请问是哪家店？",
      "traditional": "客服：請問是哪家店？",
      "pinyin": "kè fú qǐng wèn shì něi jiā diàn",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer Service: May I ask for which location?"
    },
    {
      "index": 8,
      "simplified": "客人：上海五角场店。",
      "traditional": "客人：上海五角場店。",
      "pinyin": "kè rén shàng hǎi wǔ jiǎo chǎng diàn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer: The one in Wujiaochang, Shanghai."
    },
    {
      "index": 10,
      "simplified": "客服：请问什么时候？",
      "traditional": "客服：請問什麼時候？",
      "pinyin": "kè fú qǐng wèn shén me shí hou",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer Service: May I ask for when?"
    },
    {
      "index": 12,
      "simplified": "客人：8号星期天晚上10点。",
      "traditional": "客人：8號星期天晚上10點。",
      "pinyin": "kè rén 1 hào xīng qī tiān wǎn shang 1 diǎn",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer: At 10:00 pm, Sunday the 8th."
    },
    {
      "index": 14,
      "simplified": "客服：请问要大包，中包，还是小包？",
      "traditional": "客服：請問要大包，中包，還是小包？",
      "pinyin": "kè fú qǐng wèn yào dà bāo zhōng bāo hái shi xiǎo bāo",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer Service: May I ask if you want a large room, a medium one or a small one?"
    },
    {
