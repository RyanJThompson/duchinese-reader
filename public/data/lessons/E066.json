    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer Service: 6 to 9 people."
    },
    {
      "index": 20,
      "simplified": "客人：我们有11个人，那还是大包吧。",
      "traditional": "客人：我們有11個人，那還是大包吧。",
      "pinyin": "kè rén wǒ men yǒu 2 ge rén nà hái shì dà bāo ba",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Customer: We have 11 people, I would go with a large room then."
    },
    {
      "index": 22,
      "simplified": "客服：好的，8号晚上10点上海五角场店大包一间，已为您预定好。",
      "traditional": "客服：好的，8號晚上10點上海五角場店大包一間，已為您預定好。",
      "pinyin": "kè fú hǎo de 1 hào wǎn shang 1 diǎn shàng hǎi wǔ jiǎo chǎng diàn dà bāo yì jiān yǐ wèi nín yù dìng hǎo",
      "english": ""
    },
    {
      "index": 23,
      "simplified": "包厢到时保留15分钟，请准时到店。",
      "traditional": "包廂到時保留15分鐘，請準時到店。",
      "pinyin": "bāo xiāng dào shí bǎo liú 2 fēn zhōng qǐng zhǔn shí dào diàn",
      "english": "Customer Service: Ok. A big room in Wujiaochang, Shanghai, 10:00pm on the 8th. It is reserved."
    },
    {
      "index": 24,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "The room will be kept for 15 minutes after the reserved time. Please be there on time."
    },
    {
      "index": 25,
      "simplified": "客人：好的，谢谢你。再见。",
      "traditional": "客人：好的，謝謝你。再見。",
      "pinyin": "kè rén hǎo de xiè xie nǐ zài jiàn",
      "english": ""
    },
    {
      "index": 26,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Customer: OK. Thank you. Bye."
    }
