{
  "id": "540",
  "title": "Keep Your Shoes On",
  "level": "intermediate",
  "date": "2018-07-08",
  "synopsis": "The cleaning lady doesn’t want to keep her shoes on in Little He’s room.",
  "audioUrl": "https://static.duchinese.net/documents/779/ea25531e10740a217fe96cb229999da8863c48b3.mp3?1530694233",
  "series": null,
  "fullText": {
    "simplified": "不用脱鞋\n\n    小何请了一个阿姨帮他打扫房间。阿姨进门就要穿鞋套，小何赶紧说：“不用，不用脱鞋。可以直接进来。”阿姨说：“不是。我怕把我的新鞋弄脏了。”",
    "traditional": "不用脫鞋\n\n    小何請了一個阿姨幫他打掃房間。阿姨進門就要穿鞋套，小何趕緊說：“不用，不用脫鞋。可以直接進來。”阿姨說：“不是。我怕把我的新鞋弄髒了。”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "No need to take your shoes off"
    },
    {
      "index": 2,
      "simplified": "小何请了一个阿姨帮他打扫房间。",
      "traditional": "小何請了一個阿姨幫他打掃房間。",
      "pinyin": "xiǎo hé qǐng le yí ge ā yí bāng tā dǎ sǎo fáng jiān",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "阿姨进门就要穿鞋套，",
      "traditional": "阿姨進門就要穿鞋套，",
      "pinyin": "ā yí jìn mén jiù yào chuān xié tào",
      "english": "Little He asked a lady to help him clean his room."
    },
    {
      "index": 4,
      "simplified": "小何赶紧说：“不用，不用脱鞋。可以直接进来。”",
      "traditional": "小何趕緊說：“不用，不用脫鞋。可以直接進來。”",
      "pinyin": "xiǎo hé gǎn jǐn shuō bú yòng bú yòng tuō xié kě yǐ zhí jiē jìn lái",
      "english": "The lady entered the room and started to put on shoe covers."
    },
    {
      "index": 5,
      "simplified": "阿姨说：“不是。我怕把我的新鞋弄脏了。”",
      "traditional": "阿姨說：“不是。我怕把我的新鞋弄髒了。”",
      "pinyin": "ā yí shuō bú shì wǒ pà bǎ wǒ de xīn xié nòng zāng le",
      "english": "Little He hurriedly said: “No need to take your shoes off. You can enter directly.”"
    }
  ],
