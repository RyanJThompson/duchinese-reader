{
  "id": "E095",
  "title": "Cutting Your Hair",
  "level": "intermediate",
  "date": "2017-03-04",
  "synopsis": "How do you express yourself when talking to a barber?",
  "audioUrl": "https://static.duchinese.net/documents/356/44157d33d373a8479185e498aebe9b5f41d08bee.mp3?1488226468",
  "series": null,
  "fullText": {
    "simplified": "剪头发\n\n    你好，我要剪头发。头顶不要剪太短。两边和后面剪短一点，露出耳朵。请用剪刀剪，不要用推子。还有，可以先帮我洗头，再剪头发吗？谢谢！",
    "traditional": "剪頭髮\n\n    你好，我要剪頭髮。頭頂不要剪太短。兩邊和後面剪短一點，露出耳朵。請用剪刀剪，不要用推子。還有，可以先幫我洗頭，再剪頭髮嗎？謝謝！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Cutting your hair"
    },
    {
      "index": 2,
      "simplified": "你好，我要剪头发。",
      "traditional": "你好，我要剪頭髮。",
      "pinyin": "nǐ hǎo wǒ yào jiǎn tóu fa",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "头顶不要剪太短。",
      "traditional": "頭頂不要剪太短。",
      "pinyin": "tóu dǐng bú yào jiǎn tài duǎn",
      "english": "Hello, I would like to cut my hair."
    },
    {
      "index": 4,
      "simplified": "两边和后面剪短一点，露出耳朵。",
      "traditional": "兩邊和後面剪短一點，露出耳朵。",
      "pinyin": "liǎng biān hé hòu miàn jiǎn duǎn yì diǎn lù chū ěr duo",
      "english": "Don’t cut too short on the top of my head."
    },
    {
      "index": 5,
      "simplified": "请用剪刀剪，不要用推子。",
      "traditional": "請用剪刀剪，不要用推子。",
      "pinyin": "qǐng yòng jiǎn dāo jiǎn bú yào yòng tuī zi",
      "english": "On the sides and in the back a bit shorter, show my ears."
    },
    {
      "index": 6,
      "simplified": "还有，可以先帮我洗头，再剪头发吗？",
      "traditional": "還有，可以先幫我洗頭，再剪頭髮嗎？",
      "pinyin": "hái yǒu kě yǐ xiān bāng wǒ xǐ tóu zài jiǎn tóu fa ma",
      "english": "Please use scissors, no electric clipper."
    },
    {
      "index": 7,
      "simplified": "谢谢！",
      "traditional": "謝謝！",
      "pinyin": "xiè xie",
      "english": "Also, could you wash my hair first before cutting it?"
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Thank you!"
    }
  ],
