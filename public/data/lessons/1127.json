{
  "id": "1127",
  "title": "Can Money Buy Everything?",
  "level": "newbie",
  "date": "2020-10-21",
  "synopsis": "To a wealthy father, money can buy everything. But the son thinks otherwise …",
  "audioUrl": "https://static.duchinese.net/documents/1127/0e695140bbb63afdbf5fc6c097ad4ae74304a0fa.mp3?1600007082",
