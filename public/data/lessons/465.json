{
  "id": "465",
  "title": "Stand Still!",
  "level": "intermediate",
  "date": "2018-03-18",
  "synopsis": "Little Ming has a sudden encounter in the park. Is he being robbed?",
  "audioUrl": "https://static.duchinese.net/documents/675/bd1c2f6a6f83b33aef5486d7b086db0abcdbe3c8.mp3?1519569690",
  "series": null,
  "fullText": {
    "simplified": "站住！\n\n    晚饭过后，小明去公园散步。\n    他走到一处人很少的地方，突然听见背后有人大喊：“站住！不许动！”\n    小明心想：天啊，抢劫的！\n    接着，身后的人又喊：“坐下！”\n    小明马上坐到了地上。\n    这时，他听到了狗的叫声，回头一看，心里大骂：讨厌！训练狗，叫那么大声干嘛？害得我以为是有人要抢劫！",
    "traditional": "站住！\n\n    晚飯過後，小明去公園散步。\n    他走到一處人很少的地方，突然聽見背後有人大喊：“站住！不許動！”\n    小明心想：天啊，搶劫的！\n    接著，身後的人又喊：“坐下！”\n    小明馬上坐到了地上。\n    這時，他聽到了狗的叫聲，回頭一看，心裡大罵：討厭！訓練狗，叫那麼大聲幹嘛？害得我以為是有人要搶劫！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Stand Still!"
    },
    {
      "index": 2,
      "simplified": "晚饭过后，小明去公园散步。",
      "traditional": "晚飯過後，小明去公園散步。",
      "pinyin": "wǎn fàn guò hòu xiǎo míng qù gōng yuán sàn bù",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "After dinner, Little Ming went to the park for a walk."
    },
    {
      "index": 4,
      "simplified": "他走到一处人很少的地方，突然听见背后有人大喊：",
      "traditional": "他走到一處人很少的地方，突然聽見背後有人大喊：",
      "pinyin": "tā zǒu dào yí chù rén hěn shǎo de dì fang tū rán tīng jiàn bèi hòu yǒu rén dà hǎn",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "“站住！不许动！”",
      "traditional": "“站住！不許動！”",
      "pinyin": "zhàn zhù bù xǔ dòng",
      "english": "He went to a place with very few people around, and suddenly heard someone yell behind him:"
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "“Stand still! Don't move!”"
    },
    {
      "index": 7,
      "simplified": "小明心想：天啊，抢劫的！",
      "traditional": "小明心想：天啊，搶劫的！",
      "pinyin": "xiǎo míng xīn xiǎng tiān a qiǎng jié de",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Ming thought to himself: Oh my, I'm being robbed!"
    },
    {
      "index": 9,
      "simplified": "接着，身后的人又喊：“坐下！”",
      "traditional": "接著，身後的人又喊：“坐下！”",
      "pinyin": "jiē zhe shēn hòu de rén yòu hǎn zuò xià",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "The person behind him then yelled: “Sit down!”"
    },
    {
      "index": 11,
      "simplified": "小明马上坐到了地上。",
      "traditional": "小明馬上坐到了地上。",
      "pinyin": "xiǎo míng mǎ shàng zuò dào le dì shang",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Ming immediately sat down on the ground."
    },
    {
      "index": 13,
      "simplified": "这时，他听到了狗的叫声，回头一看，",
      "traditional": "這時，他聽到了狗的叫聲，回頭一看，",
      "pinyin": "zhè shí tā tīng dào le gǒu de jiào shēng huí tóu yí kàn",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "心里大骂：讨厌！训练狗，叫那么大声干嘛？",
      "traditional": "心裡大罵：討厭！訓練狗，叫那麼大聲幹嘛？",
      "pinyin": "xīn li dà mà tǎo yàn xùn liàn gǒu jiào nà me dà shēng gàn má",
      "english": "At this moment he heard a dog bark, and turned around to take a look."
    },
    {
      "index": 15,
      "simplified": "害得我以为是有人要抢劫！",
      "traditional": "害得我以為是有人要搶劫！",
      "pinyin": "hài de wǒ yǐ wéi shì yǒu rén yào qiǎng jié",
      "english": "He cursed by himself: How annoying! Do you have to shout so loudly when training your dog?"
    },
    {
      "index": 16,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "You made me think I was getting robbed!"
    }
  ],
