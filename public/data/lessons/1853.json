    {
      "index": 2,
      "simplified": "冷小西又见到高明了，她很高兴。",
      "traditional": "冷小西又見到高明了，她很高興。",
      "pinyin": "lěng xiǎo xī yòu jiàn dào gāo míng le tā hěn gāo xìng",
      "english": "Leng Xiaoxi sees Gao Ming again. She is very happy."
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 4,
      "simplified": "高明说：“学姐，我在小饭店那儿看见猫了。我们一起去看它们，好吗？”",
      "traditional": "高明說：“學姐，我在小飯店那兒看見貓了。我們一起去看牠們，好嗎？”",
      "pinyin": "gāo míng shuō xué jiě wǒ zài xiǎo fàn diàn nà'r kàn jiàn māo le wǒ men yì qǐ qù kàn tā men hǎo ma",
      "english": "Gao Ming says, “Senior, I saw the cats at the small restaurant. How about we go together to see them?”"
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "“好。我们走。”冷小西说。",
      "traditional": "“好。我們走。”冷小西說。",
      "pinyin": "hǎo wǒ men zǒu lěng xiǎo xī shuō",
      "english": "“Sure. Let’s go,” Leng Xiaoxi says."
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "学姐？他叫我学姐？他怎么知道我是学姐？",
      "traditional": "學姐？他叫我學姐？他怎麼知道我是學姐？",
      "pinyin": "xué jiě tā jiào wǒ xué jiě tā zěn me zhī dào wǒ shì xué jiě",
      "english": "Senior? He called me senior? How did he know I’m his senior?"
    },
    {
      "index": 9,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "“你怎么知道……”冷小西想说。",
      "traditional": "“你怎麼知道……”冷小西想說。",
      "pinyin": "nǐ zěn me zhī dào lěng xiǎo xī xiǎng shuō",
      "english": "“How did you know …” Leng Xiaoxi wants to ask."
    },
    {
      "index": 11,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "这时候，有人打电话给冷小西。冷小西看看手机，是医院的谢医生。",
      "traditional": "這時候，有人打電話給冷小西。冷小西看看手機，是醫院的謝醫生。",
      "pinyin": "zhè shí hou yǒu rén dǎ diàn huà gěi lěng xiǎo xī lěng xiǎo xī kàn kan shǒu jī shì yī yuàn de xiè yī shēng",
      "english": "At this time, someone rings Leng Xiaoxi. Leng Xiaoxi looks at her phone. It is Doctor Xie from the hospital."
    },
    {
      "index": 13,
      "simplified": "谢医生说有人打120，医院要三个医生，他希望冷小西回去工作。",
      "traditional": "謝醫生說有人打120，醫院要三個醫生，他希望冷小西回去工作。",
      "pinyin": "xiè yī shēng shuō yǒu rén dǎ 3 yī yuàn yào sān ge yī shēng tā xī wàng lěng xiǎo xī huí qù gōng zuò",
      "english": "Doctor Xie says someone dialed 120. The hospital needs three doctors. He hopes Leng Xiaoxi will come back to work."
    },
    {
      "index": 14,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "冷小西要回医院了，她看看高明，说：“对不起，我要走了。”",
      "traditional": "冷小西要回醫院了，她看看高明，說：“對不起，我要走了。”",
      "pinyin": "lěng xiǎo xī yào huí yī yuàn le tā kàn kan gāo míng shuō duì bu qǐ wǒ yào zǒu le",
      "english": "Leng Xiaoxi must return to the hospital. She looks at Gao Ming and says, “Sorry, I must go.”"
    },
    {
      "index": 16,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "“现在？现在吗？我们……我们会再见吗？”高明说。",
      "traditional": "“現在？現在嗎？我們……我們會再見嗎？”高明說。",
      "pinyin": "xiàn zài xiàn zài ma wǒ men wǒ men huì zài jiàn ma gāo míng shuō",
      "english": "“Now? Right now? Will we … will we see each other again?” Gao Ming asks."
    }
