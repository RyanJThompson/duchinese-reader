{
  "id": "1045",
  "title": "Our Romance",
  "level": "newbie",
  "date": "2020-08-26",
  "synopsis": "Read about a romance between former high school classmates.",
  "audioUrl": "https://static.duchinese.net/documents/1045/1ecb320e9f823962433431e4ecc64d3d306f5abb.mp3?1595237389",
  "series": null,
  "fullText": {
    "simplified": "我们的爱情\n\n    以前我们是高中同学，后来我们是朋友。我们认识了六年后在一起了。现在我们是夫妻。他很爱我，对我很好。我也很爱他。\n    现在我在医院，他也在医院。因为他做爸爸了，我做妈妈了。我们有了自己的孩子。",
    "traditional": "我們的愛情\n\n    以前我們是高中同學，後來我們是朋友。我們認識了六年後在一起了。現在我們是夫妻。他很愛我，對我很好。我也很愛他。\n    現在我在醫院，他也在醫院。因為他做爸爸了，我做媽媽了。我們有了自己的孩子。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Our Romance"
    },
    {
      "index": 2,
      "simplified": "以前我们是高中同学，后来我们是朋友。",
      "traditional": "以前我們是高中同學，後來我們是朋友。",
      "pinyin": "yǐ qián wǒ men shì gāo zhōng tóng xué hòu lái wǒ men shì péng you",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "我们认识了六年后在一起了。",
      "traditional": "我們認識了六年後在一起了。",
      "pinyin": "wǒ men rèn shi le liù nián hòu zài yì qǐ le",
      "english": "Previously, we were senior high school classmates, and later we were friends."
    },
    {
      "index": 4,
      "simplified": "现在我们是夫妻。他很爱我，对我很好。我也很爱他。",
      "traditional": "現在我們是夫妻。他很愛我，對我很好。我也很愛他。",
      "pinyin": "xiàn zài wǒ men shì fū qī tā hěn ài wǒ duì wǒ hěn hǎo wǒ yě hěn ài tā",
      "english": "After we had known each other for six years we started dating."
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Now we are husband and wife. He really loves me, and treats me very well. I also really love him."
    },
    {
      "index": 6,
      "simplified": "现在我在医院，他也在医院。",
      "traditional": "現在我在醫院，他也在醫院。",
      "pinyin": "xiàn zài wǒ zài yī yuàn tā yě zài yī yuàn",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "因为他做爸爸了，我做妈妈了。我们有了自己的孩子。",
      "traditional": "因為他做爸爸了，我做媽媽了。我們有了自己的孩子。",
      "pinyin": "yīn wèi tā zuò bà ba le wǒ zuò mā ma le wǒ men yǒu le zì jǐ de hái zi",
      "english": "Now I am at the hospital. He is also at the hospital."
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Because he has become a father, and I have become a mother. We have our own child."
    }
  ],
