{
  "id": "1170",
  "title": "Don’t Say the Color Black",
  "level": "elementary",
  "date": "2021-02-13",
  "synopsis": "Little Hong and Little Ming are in a battle of wits!",
  "audioUrl": "https://static.duchinese.net/documents/1170/c72d5ed9534d1b1afa8ea332cc3b03c36f8145f2.mp3?1610187747",
  "series": null,
  "fullText": {
    "simplified": "不能说黑色\n\n小红：小明，和我玩儿吧。\n小明：好的，怎么玩儿？\n小红：我们不能说黑色，不然就打一下。\n小明：哦，不能说什么？\n小红：黑色。\n小明：你说了！快给我打一下！\n小红：这就开始了？\n小明：那我再问你，彩虹有几个颜色？\n小红：红橙黄绿青蓝紫。\n小明：你又说红色了。\n小红：不是不能说黑色吗？\n小明：你又说了！",
    "traditional": "不能說黑色\n\n小紅：小明，和我玩兒吧。\n小明：好的，怎麼玩兒？\n小紅：我們不能說黑色，不然就打一下。\n小明：哦，不能說什麼？\n小紅：黑色。\n小明：你說了！快給我打一下！\n小紅：這就開始了？\n小明：那我再問你，彩虹有幾個顏色？\n小紅：紅橙黃綠青藍紫。\n小明：你又說紅色了。\n小紅：不是不能說黑色嗎？\n小明：你又說了！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Don’t Say the Color Black"
    },
    {
      "index": 2,
      "simplified": "小红：小明，和我玩儿吧。",
      "traditional": "小紅：小明，和我玩兒吧。",
      "pinyin": "xiǎo hóng xiǎo míng hé wǒ wán'r ba",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: Little Ming, play a game with me."
    },
    {
      "index": 4,
      "simplified": "小明：好的，怎么玩儿？",
      "traditional": "小明：好的，怎麼玩兒？",
      "pinyin": "xiǎo míng hǎo de zěn me wán'r",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Ok, how do we play?"
    },
    {
      "index": 6,
      "simplified": "小红：我们不能说黑色，不然就打一下。",
      "traditional": "小紅：我們不能說黑色，不然就打一下。",
      "pinyin": "xiǎo hóng wǒ men bù néng shuō hēi sè bù rán jiù dǎ yí xià",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: We can’t say the color black, or else you get hit once."
    },
    {
      "index": 8,
      "simplified": "小明：哦，不能说什么？",
      "traditional": "小明：哦，不能說什麼？",
      "pinyin": "xiǎo míng ò bù néng shuō shén me",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Oh, what can’t we say?"
    },
    {
      "index": 10,
      "simplified": "小红：黑色。",
      "traditional": "小紅：黑色。",
      "pinyin": "xiǎo hóng hēi sè",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: Black."
    },
    {
      "index": 12,
      "simplified": "小明：你说了！快给我打一下！",
      "traditional": "小明：你說了！快給我打一下！",
      "pinyin": "xiǎo míng nǐ shuō le kuài gěi wǒ dǎ yí xià",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: You said it! Quick, let me hit you!"
    },
    {
      "index": 14,
      "simplified": "小红：这就开始了？",
      "traditional": "小紅：這就開始了？",
      "pinyin": "xiǎo hóng zhè jiù kāi shǐ le",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: So we’re starting now?"
    },
    {
      "index": 16,
      "simplified": "小明：那我再问你，彩虹有几个颜色？",
      "traditional": "小明：那我再問你，彩虹有幾個顏色？",
      "pinyin": "xiǎo míng nà wǒ zài wèn nǐ cǎi hóng yǒu jǐ ge yán sè",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Then I’ll ask you another question. How many colors does a rainbow have?"
    },
    {
      "index": 18,
      "simplified": "小红：红橙黄绿青蓝紫。",
      "traditional": "小紅：紅橙黃綠青藍紫。",
      "pinyin": "xiǎo hóng hóng chéng huáng lǜ qīng lán zǐ",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: Red, orange, yellow, green, cyan, blue, and purple."
    },
    {
      "index": 20,
      "simplified": "小明：你又说红色了。",
      "traditional": "小明：你又說紅色了。",
      "pinyin": "xiǎo míng nǐ yòu shuō hóng sè le",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: You said red again."
    },
    {
      "index": 22,
      "simplified": "小红：不是不能说黑色吗？",
      "traditional": "小紅：不是不能說黑色嗎？",
      "pinyin": "xiǎo hóng bú shì bù néng shuō hēi sè ma",
      "english": ""
    },
    {
      "index": 23,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: Wasn’t the color we couldn’t say black?"
    },
    {
      "index": 24,
      "simplified": "小明：你又说了！",
      "traditional": "小明：你又說了！",
      "pinyin": "xiǎo míng nǐ yòu shuō le",
      "english": ""
    },
    {
      "index": 25,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Ming: You said it again!"
    }
  ],
