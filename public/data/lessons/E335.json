{
  "id": "E335",
  "title": "What Do You Want to Drink?",
  "level": "intermediate",
  "date": "2019-06-30",
  "synopsis": "What’s your favorite summer drink? Learn to order drinks with Little Li.",
  "audioUrl": "https://static.duchinese.net/documents/1084/786efd77e2617bf5514fecfc5a8ed352b121d6e2.mp3?1561035685",
  "series": null,
  "fullText": {
    "simplified": "你要喝什么？\n\n服务员：你们好，想喝点儿什么？\n小丽：我想要一杯苹果汁。 \n服务员：对不起，苹果汁卖完了\n小丽：好吧，那我要一杯橙汁吧。\n妈妈：天气太热了，给我来一杯冰的气泡水吧。多放点冰，再加一点柠檬。妈，你喝什么？\n外婆：你们喝的饮料太不健康了，我就喝一杯白水。",
    "traditional": "你要喝什麼？\n\n服務員：你們好，想喝點兒什麼？\n小麗：我想要一杯蘋果汁。 \n服務員：對不起，蘋果汁賣完了\n小麗：好吧，那我要一杯橙汁吧。\n媽媽：天氣太熱了，給我來一杯冰的氣泡水吧。多放點冰，再加一點檸檬。媽，你喝什麼？\n外婆：你們喝的飲料太不健康了，我就喝一杯白水。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "What Do You Want to Drink?"
    },
    {
      "index": 2,
      "simplified": "服务员：你们好，想喝点儿什么？",
      "traditional": "服務員：你們好，想喝點兒什麼？",
      "pinyin": "fú wù yuán nǐ men hǎo xiǎng hē diǎn'r shén me",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Waiter: Hello, what do you want to drink?"
    },
    {
      "index": 4,
      "simplified": "小丽：我想要一杯苹果汁。",
      "traditional": "小麗：我想要一杯蘋果汁。",
      "pinyin": "xiǎo lì wǒ xiǎng yào yì bēi píng guǒ zhī",
      "english": ""
    },
    {
      "index": 5,
      "simplified": " \n",
      "traditional": " \n",
      "pinyin": "",
      "english": "Little Li: I want a glass of apple juice."
    },
    {
      "index": 6,
      "simplified": "服务员：对不起，苹果汁卖完了",
      "traditional": "服務員：對不起，蘋果汁賣完了",
      "pinyin": "fú wù yuán duì bu qǐ píng guǒ zhī mài wán le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Waiter: Sorry, apple juice is sold out."
    },
    {
      "index": 8,
      "simplified": "小丽：好吧，那我要一杯橙汁吧。",
      "traditional": "小麗：好吧，那我要一杯橙汁吧。",
      "pinyin": "xiǎo lì hǎo ba nà wǒ yào yì bēi chéng zhī ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Li: Ok, then I will have a glass of orange juice."
    },
    {
      "index": 10,
      "simplified": "妈妈：天气太热了，给我来一杯冰的气泡水吧。",
      "traditional": "媽媽：天氣太熱了，給我來一杯冰的氣泡水吧。",
      "pinyin": "mā ma tiān qì tài rè le gěi wǒ lái yì bēi bīng de qì pào shuǐ ba",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "多放点冰，再加一点柠檬。妈，你喝什么？",
      "traditional": "多放點冰，再加一點檸檬。媽，你喝什麼？",
      "pinyin": "duō fàng diǎn bīng zài jiā yì diǎn níng méng mā nǐ hē shén me",
      "english": "Mom: The weather is too hot, give me a glass of iced sparkling water."
    },
    {
      "index": 12,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Add extra ice, and on top of that some lemon. Mom, what will you drink?"
    },
    {
      "index": 13,
      "simplified": "外婆：你们喝的饮料太不健康了，我就喝一杯白水。",
      "traditional": "外婆：你們喝的飲料太不健康了，我就喝一杯白水。",
      "pinyin": "wài pó nǐ men hē de yǐn liào tài bú jiàn kāng le wǒ jiù hē yì bēi bái shuǐ",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Grandma: Your drinks are too unhealthy, I will just have a glass of plain water."
    }
