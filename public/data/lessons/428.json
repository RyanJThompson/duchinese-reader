      "index": 4,
      "simplified": "本：我刚才摔了一跤。",
      "traditional": "本：我剛才摔了一跤。",
      "pinyin": "běn wǒ gāng cái shuāi le yì jiāo",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I took a tumble just now."
    },
    {
      "index": 6,
      "simplified": "丽丽：怎么那么不小心！",
      "traditional": "麗麗：怎麼那麼不小心！",
      "pinyin": "lì lì zěn me nà me bù xiǎo xīn",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: How can you be so careless!"
    },
    {
      "index": 8,
      "simplified": "本：我一边走路一边看手机，没注意路上有个香蕉皮，",
      "traditional": "本：我一邊走路一邊看手機，沒注意路上有個香蕉皮，",
      "pinyin": "běn wǒ yì biān zǒu lù yì biān kàn shǒu jī méi zhù yì lù shang yǒu ge xiāng jiāo pí",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "一不小心就滑了一下。",
      "traditional": "一不小心就滑了一下。",
      "pinyin": "yí bù xiǎo xīn jiù huá le yí xià",
      "english": "Ben: I was looking at my phone while walking, and didn't notice the banana peel on the road."
    },
    {
      "index": 10,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Just when I wasn't paying attention, I slipped."
    },
    {
      "index": 11,
      "simplified": "丽丽：给我看看伤口。",
      "traditional": "麗麗：給我看看傷口。",
      "pinyin": "lì lì gěi wǒ kàn kan shāng kǒu",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Let me take a look at the wound."
    },
    {
      "index": 13,
      "simplified": "本：不用，没事的，一会儿就好。",
      "traditional": "本：不用，沒事的，一會兒就好。",
      "pinyin": "běn bú yòng méi shì de yí huì'r jiù hǎo",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: No need, it's nothing. I'll be fine soon."
    },
    {
      "index": 15,
      "simplified": "丽丽：别废话，快给我看看！……",
      "traditional": "麗麗：別廢話，快給我看看！……",
      "pinyin": "lì lì bié fèi huà kuài gěi wǒ kàn kan",
      "english": ""
    },
    {
      "index": 16,
      "simplified": "都流血了，还说没事。我去给你买药。",
      "traditional": "都流血了，還說沒事。我去給你買藥。",
      "pinyin": "dōu liú xiě le hái shuō méi shì wǒ qù gěi nǐ mǎi yào",
      "english": "Lili: Don't talk nonsense, let me have a look! …"
    },
    {
      "index": 17,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "It's bleeding, and you still say it's nothing. I'll go buy some medicine for you."
    }
