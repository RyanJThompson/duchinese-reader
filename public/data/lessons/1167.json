    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Yu said, “It’s older sister!”"
    },
    {
      "index": 7,
      "simplified": "小朋友看了看小狗，又看了看小雨，说：",
      "traditional": "小朋友看了看小狗，又看了看小雨，說：",
