{
  "id": "695",
  "title": "Too Slippery",
  "level": "intermediate",
  "date": "2019-04-07",
  "synopsis": "Paul slips on the ice on his way to school.",
  "audioUrl": "https://static.duchinese.net/documents/1009/760ef8bda79bd57fada57a590f508cba8d39ba62.mp3?1553506284",
  "series": null,
  "fullText": {
    "simplified": "太滑了\n\n保罗：啊，疼！疼！\n小乐：怎么了？\n保罗：路太滑了，我来学校的路上，摔了两跤。\n小乐：现在是冬天，每天都是零下，路上都是冰，你要小心。",
    "traditional": "太滑了\n\n保羅：啊，疼！疼！\n小樂：怎麼了？\n保羅：路太滑了，我來學校的路上，摔了兩跤。\n小樂：現在是冬天，每天都是零下，路上都是冰，你要小心。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Too Slippery"
    },
    {
      "index": 2,
      "simplified": "保罗：啊，疼！疼！",
      "traditional": "保羅：啊，疼！疼！",
      "pinyin": "bǎo luó a téng téng",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Ah, it hurts! It hurts!"
    },
    {
      "index": 4,
      "simplified": "小乐：怎么了？",
      "traditional": "小樂：怎麼了？",
      "pinyin": "xiǎo lè zěn me le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: What’s wrong?"
    },
    {
      "index": 6,
      "simplified": "保罗：路太滑了，我来学校的路上，摔了两跤。",
      "traditional": "保羅：路太滑了，我來學校的路上，摔了兩跤。",
      "pinyin": "bǎo luó lù tài huá le wǒ lái xué xiào de lù shang shuāi le liǎng jiāo",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: The road is too slippery. I fell twice on the way to school."
    },
    {
      "index": 8,
      "simplified": "小乐：现在是冬天，每天都是零下，路上都是冰，你要小心。",
      "traditional": "小樂：現在是冬天，每天都是零下，路上都是冰，你要小心。",
      "pinyin": "xiǎo lè xiàn zài shì dōng tiān měi tiān dōu shì líng xià lù shang dōu shì bīng nǐ yào xiǎo xīn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: It’s winter now and below zero every day. The road is covered in ice, so you must be careful."
    }
  ],
