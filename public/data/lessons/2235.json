{
  "id": "2235",
  "title": "I Want to Check Out",
  "level": "elementary",
  "date": "2023-11-09",
  "synopsis": "Amy has finished her trip to China and is about to check out of the hotel and return to the United States.\nThis lesson focuses on learning how to check out at a hotel and how to ask the front desk for help.",
  "audioUrl": "https://static.duchinese.net/documents/2235/6e38be7e3d99d12770df7fc1f25d74c03ca204f1.mp3?1696848996",
  "series": {
    "title": "Amy’s Trip to Beijing",
    "chapter": 13,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "我想退房\n\n爱米：你好，我想退房。\n前台：好的。请问，您住的是哪一个房间？\n爱米：607号房，这是房卡。\n前台：好的，请等一下……好了，谢谢您！\n爱米：我想去机场，您能帮我叫一下出租车吗？\n前台：好的，没问题。出租车会在10分钟后到酒店门口，请您等一下。\n爱米：好的，谢谢！\n前台：不客气！谢谢您入住北京大饭店，欢迎下次再来！",
    "traditional": "我想退房\n\n愛米：你好，我想退房。\n前臺：好的。請問，您住的是哪一個房間？\n愛米：607號房，這是房卡。\n前臺：好的，請等一下……好了，謝謝您！\n愛米：我想去機場，您能幫我叫一下出租車嗎？\n前臺：好的，沒問題。出租車會在10分鐘後到酒店門口，請您等一下。\n愛米：好的，謝謝！\n前臺：不客氣！謝謝您入住北京大飯店，歡迎下次再來！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Want to Check Out"
    },
    {
      "index": 2,
      "simplified": "爱米：你好，我想退房。",
      "traditional": "愛米：你好，我想退房。",
      "pinyin": "ài mǐ nǐ hǎo wǒ xiǎng tuì fáng",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Amy: Hello, I want to check out."
    },
    {
      "index": 4,
      "simplified": "前台：好的。请问，您住的是哪一个房间？",
      "traditional": "前臺：好的。請問，您住的是哪一個房間？",
      "pinyin": "qián tái hǎo de qǐng wèn nín zhù de shì nǎ yí ge fáng jiān",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Front desk: Okay. Which room you are staying in?"
    },
    {
      "index": 6,
      "simplified": "爱米：607号房，这是房卡。",
      "traditional": "愛米：607號房，這是房卡。",
      "pinyin": "ài mǐ 3 hào fáng zhè shì fáng kǎ",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Amy: Room 607, here is the room card."
    },
    {
      "index": 8,
      "simplified": "前台：好的，请等一下……好了，谢谢您！",
      "traditional": "前臺：好的，請等一下……好了，謝謝您！",
      "pinyin": "qián tái hǎo de qǐng děng yí xià hǎo le xiè xie nín",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Front desk: Okay. Please wait a moment … Okay then, thank you!"
    },
    {
      "index": 10,
      "simplified": "爱米：我想去机场，您能帮我叫一下出租车吗？",
      "traditional": "愛米：我想去機場，您能幫我叫一下出租車嗎？",
      "pinyin": "ài mǐ wǒ xiǎng qù jī chǎng nín néng bāng wǒ jiào yí xià chū zū chē ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Amy: I want to go to the airport. Can you call a taxi for me?"
    },
    {
      "index": 12,
      "simplified": "前台：好的，没问题。出租车会在10分钟后到酒店门口，请您等一下。",
      "traditional": "前臺：好的，沒問題。出租車會在10分鐘後到酒店門口，請您等一下。",
      "pinyin": "qián tái hǎo de méi wèn tí chū zū chē huì zài 1 fēn zhōng hòu dào jiǔ diàn mén kǒu qǐng nín děng yí xià",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Front desk: Yes, no problem. The taxi will arrive at the hotel entrance in 10 minutes. Please wait a moment."
    },
    {
      "index": 14,
      "simplified": "爱米：好的，谢谢！",
      "traditional": "愛米：好的，謝謝！",
      "pinyin": "ài mǐ hǎo de xiè xie",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Amy: Okay, thank you!"
    },
    {
      "index": 16,
      "simplified": "前台：不客气！谢谢您入住北京大饭店，欢迎下次再来！",
      "traditional": "前臺：不客氣！謝謝您入住北京大飯店，歡迎下次再來！",
      "pinyin": "qián tái bú kè qi xiè xie nín rù zhù běi jīng dà fàn diàn huān yíng xià cì zài lái",
      "english": ""
    }
  ],
