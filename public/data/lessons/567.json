{
  "id": "567",
  "title": "Doing a Disservice",
  "level": "elementary",
  "date": "2018-12-08",
  "synopsis": "Little Ming helps his mom water the plants.",
  "audioUrl": "https://static.duchinese.net/documents/905/dc7fb6885d905b93c8d253acdf7f12c5f7feab17.mp3?1698350664",
  "series": null,
  "fullText": {
    "simplified": "帮倒忙\n\n小明：妈妈，你在干什么？\n妈妈：我在浇花。\n小明：我来帮你吧。\n妈妈：好！小明真乖！谢谢你的帮忙。\n过了一会儿。\n妈妈：哎呀！小明！你在浇花还是在浇我啊？\n小明：哈哈，真好玩！\n妈妈：还是我来浇吧！你就是在帮倒忙。",
    "traditional": "幫倒忙\n\n小明：媽媽，你在幹什麼？\n媽媽：我在澆花。\n小明：我來幫你吧。\n媽媽：好！小明真乖！謝謝你的幫忙。\n過了一會兒。\n媽媽：哎呀！小明！你在澆花還是在澆我啊？\n小明：哈哈，真好玩！\n媽媽：還是我來澆吧！你就是在幫倒忙。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Doing a Disservice"
    },
    {
      "index": 2,
      "simplified": "小明：妈妈，你在干什么？",
      "traditional": "小明：媽媽，你在幹什麼？",
      "pinyin": "xiǎo míng mā ma nǐ zài gàn shén me",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Mom, what are you doing?"
    },
    {
      "index": 4,
      "simplified": "妈妈：我在浇花。",
      "traditional": "媽媽：我在澆花。",
      "pinyin": "mā ma wǒ zài jiāo huā",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: I’m watering the flowers."
    },
    {
      "index": 6,
      "simplified": "小明：我来帮你吧。",
      "traditional": "小明：我來幫你吧。",
      "pinyin": "xiǎo míng wǒ lái bāng nǐ ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I’ll help you."
    },
    {
      "index": 8,
      "simplified": "妈妈：好！小明真乖！谢谢你的帮忙。",
      "traditional": "媽媽：好！小明真乖！謝謝你的幫忙。",
      "pinyin": "mā ma hǎo xiǎo míng zhēn guāi xiè xie nǐ de bāng máng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Ok! Little Ming, you’re such a good boy! Thank you for helping me."
    },
    {
      "index": 10,
      "simplified": "过了一会儿。",
      "traditional": "過了一會兒。",
      "pinyin": "guò le yí huì'r",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "After a while."
    },
    {
      "index": 12,
      "simplified": "妈妈：哎呀！小明！你在浇花还是在浇我啊？",
      "traditional": "媽媽：哎呀！小明！你在澆花還是在澆我啊？",
      "pinyin": "mā ma āi yā xiǎo míng nǐ zài jiāo huā hái shi zài jiāo wǒ a",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Ah! Little Ming! Are you watering the flowers or watering me?"
    },
    {
      "index": 14,
      "simplified": "小明：哈哈，真好玩！",
      "traditional": "小明：哈哈，真好玩！",
      "pinyin": "xiǎo míng hā hā zhēn hǎo wán",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Haha, funny!"
    },
    {
      "index": 16,
      "simplified": "妈妈：还是我来浇吧！你就是在帮倒忙。",
      "traditional": "媽媽：還是我來澆吧！你就是在幫倒忙。",
      "pinyin": "mā ma hái shi wǒ lái jiāo ba nǐ jiù shì zài bāng dào máng",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Mom: I better water them myself instead! You’re doing me a disservice."
    }
  ],
