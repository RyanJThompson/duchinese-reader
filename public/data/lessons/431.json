{
  "id": "431",
  "title": "Autumn Excursion",
  "level": "elementary",
  "date": "2017-11-21",
  "synopsis": "The school is announcing an autumn excursion to go see the autumn leaves.",
  "audioUrl": "https://static.duchinese.net/documents/583/e9c5cc8159f5b84ad9a4cb8043eb0cf7050a3aa7.mp3?1511205954",
