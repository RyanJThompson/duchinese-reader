    "sentence_translations": [
      "Seeing the dentist",
      "",
      "Annie: Doctor, I brush my teeth every day. Why do I still have a toothache?",
      "",
      "Dentist: Do you brush your teeth in both the morning and at night?",
      "",
      "Annie: Yeah, every morning and night.",
      "",
      "Dentist: Do you gargle after each meal?",
      "",
      "Annie: Yeah.",
      "",
      "Dentist: Do you like eating sugar?",
      "",
      "Annie: I never eat sugar.",
      "",
      "Dentist: That’s strange… Do you really not eat anything after brushing your teeth at night?",
      "",
      "Annie: No. I only drink a cup of honey-water before going to bed everyday.",
      "",
      "Dentist: Ok, honey is also a kind of sugar… Remember to brush your teeth after drinking honey water!",
      ""
    ]
  }
