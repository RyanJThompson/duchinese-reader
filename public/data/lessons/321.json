{
  "id": "321",
  "title": "Ben’s Diary — Drinking Cold Water",
  "level": "newbie",
  "date": "2017-06-16",
  "synopsis": "Ben writes about how he tried to order cold water in China in the summer.",
  "audioUrl": "https://static.duchinese.net/documents/445/8c6ba6d025fd272ce302e708395ff6fbdd5f35ab.mp3?1589791101",
  "series": {
    "title": "Ben’s life in China 2: Lili’s Boyfriend",
    "chapter": 6,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "本的日记-喝冰水\n\n    今天太热了。我去学校后面的饭店吃饭，他们给了我一杯热水。我口渴，想喝冰水，但是饭店里没有冰水。真的太奇怪了，天气那么热，为什么饭店里没有冰水呢？",
    "traditional": "本的日記-喝冰水\n\n    今天太熱了。我去學校後面的飯店吃飯，他們給了我一杯熱水。我口渴，想喝冰水，但是飯店裡沒有冰水。真的太奇怪了，天氣那麼熱，為什麼飯店裡沒有冰水呢？"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Ben’s Diary — Drinking Cold Water"
    },
    {
      "index": 2,
      "simplified": "今天太热了。",
      "traditional": "今天太熱了。",
      "pinyin": "jīn tiān tài rè le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "我去学校后面的饭店吃饭，他们给了我一杯热水。",
      "traditional": "我去學校後面的飯店吃飯，他們給了我一杯熱水。",
      "pinyin": "wǒ qù xué xiào hòu miàn de fàn diàn chī fàn tā men gěi le wǒ yì bēi rè shuǐ",
      "english": "Today it was too hot."
    },
    {
      "index": 4,
      "simplified": "我口渴，想喝冰水，但是饭店里没有冰水。",
      "traditional": "我口渴，想喝冰水，但是飯店裡沒有冰水。",
      "pinyin": "wǒ kǒu kě xiǎng hē bīng shuǐ dàn shì fàn diàn lǐ méi yǒu bīng shuǐ",
      "english": "I went to the restaurant behind the school to eat, and they gave me a glass of hot water."
    },
    {
      "index": 5,
      "simplified": "真的太奇怪了，天气那么热，为什么饭店里没有冰水呢？",
      "traditional": "真的太奇怪了，天氣那麼熱，為什麼飯店裡沒有冰水呢？",
      "pinyin": "zhēn de tài qí guài le tiān qì nà me rè wèi shén me fàn diàn lǐ méi yǒu bīng shuǐ ne",
      "english": "I was thirsty and wanted to drink cold water, but they didn’t have any cold water in the restaurant."
    },
    {
      "index": 6,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "It’s really odd. It’s so hot outside, how come they don’t have cold water in the restaurant?"
    }
  ],
