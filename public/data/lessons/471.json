      "english": "Ben: I do."
    },
    {
      "index": 6,
      "simplified": "小雨：我可以加你吗？",
      "traditional": "小雨：我可以加你嗎？",
      "pinyin": "xiǎo yǔ wǒ kě yǐ jiā nǐ ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Can I add you?"
    },
    {
      "index": 8,
      "simplified": "本：好啊。",
      "traditional": "本：好啊。",
      "pinyin": "běn hǎo a",
      "english": ""
    },
    {
