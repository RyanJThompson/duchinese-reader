{
  "id": "1047",
  "title": "I Want…",
  "level": "elementary",
  "date": "2020-07-25",
  "synopsis": "Little Ming hasn’t really understood how ordering food over the phone works.",
  "audioUrl": "https://static.duchinese.net/documents/1047/9ce625d1cb2708d7af113a045a71d8cb5d2ead75.mp3?1595070746",
  "series": null,
  "fullText": {
    "simplified": "我要……\n\n    小明看到大人们可以打电话叫外卖，他也想试一下。\n    他随便拨了一个电话号码，说：“喂，我要两杯可乐，两个汉堡。”\n    对方回答：“不好意思，我们这儿是图书馆。”\n    小明马上很小声地说：“我要两杯可乐，两个汉堡。”",
    "traditional": "我要……\n\n    小明看到大人們可以打電話叫外賣，他也想試一下。\n    他隨便撥了一個電話號碼，說：“喂，我要兩杯可樂，兩個漢堡。”\n    對方回答：“不好意思，我們這兒是圖書館。”\n    小明馬上很小聲地說：“我要兩杯可樂，兩個漢堡。”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "I want …"
    },
    {
      "index": 2,
      "simplified": "小明看到大人们可以打电话叫外卖，他也想试一下。",
      "traditional": "小明看到大人們可以打電話叫外賣，他也想試一下。",
      "pinyin": "xiǎo míng kàn dào dà ren men kě yǐ dǎ diàn huà jiào wài mài tā yě xiǎng shì yí xià",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Ming has noticed that grownups can order food delivery over the phone, and he also wants to give it a go."
    },
    {
      "index": 4,
      "simplified": "他随便拨了一个电话号码，说：“喂，我要两杯可乐，两个汉堡。”",
      "traditional": "他隨便撥了一個電話號碼，說：“喂，我要兩杯可樂，兩個漢堡。”",
      "pinyin": "tā suí biàn bō le yí ge diàn huà hào mǎ shuō wéi wǒ yào liǎng bēi kě lè liǎng ge hàn bǎo",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "He dialed a phone number at random, and said, “Hello, I want two coca-colas, and two hamburgers.”"
    },
    {
      "index": 6,
      "simplified": "对方回答：“不好意思，我们这儿是图书馆。”",
      "traditional": "對方回答：“不好意思，我們這兒是圖書館。”",
      "pinyin": "duì fāng huí dá bù hǎo yì si wǒ men zhè‘r shì tú shū guǎn",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "The person on the other end answered, “I’m sorry, this is a library.”"
    },
    {
      "index": 8,
      "simplified": "小明马上很小声地说：“我要两杯可乐，两个汉堡。”",
      "traditional": "小明馬上很小聲地說：“我要兩杯可樂，兩個漢堡。”",
      "pinyin": "xiǎo míng mǎ shàng hěn xiǎo shēng de shuō wǒ yào liǎng bēi kě lè liǎng ge hàn bǎo",
      "english": ""
    }
  ],
