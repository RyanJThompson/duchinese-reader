      "index": 16,
      "simplified": "本：天哪！我坐错车了！",
      "traditional": "本：天哪！我坐錯車了！",
      "pinyin": "běn tiān na wǒ zuò cuò chē le",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "",
      "traditional": "",
