{
  "id": "344",
  "title": "Ben Takes the Train",
  "level": "elementary",
  "date": "2017-07-28",
  "synopsis": "Ben is on the train when another passenger appears to have the same seat as him.",
  "audioUrl": "https://static.duchinese.net/documents/481/e1982341a50183203396a199360c8b8ea1551fb7.mp3?1698352627",
  "series": null,
  "fullText": {
    "simplified": "在火车上\n\n女乘客：你好！这是我的座位。\n本：不对。这是我的座位。\n女乘客：可以给我看看你的火车票吗？\n本：可以。给！\n女乘客：时间一样！座位也一样！真奇怪！啊，你的票是去上海的！\n本：是的。我要去上海。\n女乘客：这个火车是去北海的！\n本：天哪！我坐错车了！",
    "traditional": "在火車上\n\n女乘客：你好！這是我的座位。\n本：不對。這是我的座位。\n女乘客：可以給我看看你的火車票嗎？\n本：可以。給！\n女乘客：時間一樣！座位也一樣！真奇怪！啊，你的票是去上海的！\n本：是的。我要去上海。\n女乘客：這個火車是去北海的！\n本：天哪！我坐錯車了！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "On the train"
    },
    {
      "index": 2,
      "simplified": "女乘客：你好！这是我的座位。",
      "traditional": "女乘客：你好！這是我的座位。",
      "pinyin": "nǚ chéng kè nǐ hǎo zhè shì wǒ de zuò wèi",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Female passenger: Hi! This is my seat."
    },
    {
      "index": 4,
      "simplified": "本：不对。这是我的座位。",
      "traditional": "本：不對。這是我的座位。",
      "pinyin": "běn bú duì zhè shì wǒ de zuò wèi",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: No, this is my seat."
    },
    {
      "index": 6,
      "simplified": "女乘客：可以给我看看你的火车票吗？",
      "traditional": "女乘客：可以給我看看你的火車票嗎？",
      "pinyin": "nǚ chéng kè kě yǐ gěi wǒ kàn kan nǐ de huǒ chē piào ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Female passenger: May I have a look at your train ticket?"
    },
    {
      "index": 8,
      "simplified": "本：可以。给！",
      "traditional": "本：可以。給！",
      "pinyin": "běn kě yǐ gěi",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Sure, here!"
    },
    {
      "index": 10,
      "simplified": "女乘客：时间一样！座位也一样！真奇怪！啊，你的票是去上海的！",
      "traditional": "女乘客：時間一樣！座位也一樣！真奇怪！啊，你的票是去上海的！",
      "pinyin": "nǚ chéng kè shí jiān yí yàng zuò wèi yě yí yàng zhēn qí guài a nǐ de piào shì qù shàng hǎi de",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Female passenger: Same time! Same seat! How odd! Ah, your ticket is for Shanghai."
    },
    {
      "index": 12,
      "simplified": "本：是的。我要去上海。",
      "traditional": "本：是的。我要去上海。",
      "pinyin": "běn shì de wǒ yào qù shàng hǎi",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Yes, I'm going to Shanghai."
    },
    {
      "index": 14,
      "simplified": "女乘客：这个火车是去北海的！",
      "traditional": "女乘客：這個火車是去北海的！",
      "pinyin": "nǚ chéng kè zhè ge huǒ chē shì qù běi hǎi de",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Female passenger: This train goes to Beihai!"
    },
