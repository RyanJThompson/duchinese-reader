    {
      "index": 4,
      "simplified": "安妮：您好，我要一张去上海的火车票。",
      "traditional": "安妮：您好，我要一張去上海的火車票。",
      "pinyin": "ān nī nín hǎo wǒ yào yì zhāng qù shàng hǎi de huǒ chē piào",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Hi, I would like to buy a ticket to Shanghai."
    },
    {
      "index": 6,
      "simplified": "售票员：您几点出发？",
      "traditional": "售票員：您幾點出發？",
      "pinyin": "shòu piào yuán nín jǐ diǎn chū fā",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Staff: When do you want to leave?"
    },
    {
      "index": 8,
      "simplified": "安妮：越早越好。",
      "traditional": "安妮：越早越好。",
      "pinyin": "ān nī yuè zǎo yuè hǎo",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: As early as possible."
    },
    {
      "index": 10,
      "simplified": "售票员：好的，我帮您查查。",
      "traditional": "售票員：好的，我幫您查查。",
      "pinyin": "shòu piào yuán hǎo de wǒ bāng nín chá cha",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "12点16分有一班，可是只有站票了。",
      "traditional": "12點16分有一班，可是只有站票了。",
      "pinyin": "2 diǎn 2 fēn yǒu yì bān kě shì zhǐ yǒu zhàn piào le",
      "english": "Staff: Ok, let me check."
    },
    {
      "index": 12,
      "simplified": "1点08分有一班，有坐票。",
      "traditional": "1點08分有一班，有坐票。",
      "pinyin": "1 diǎn 2 fēn yǒu yì bān yǒu zuò piào",
      "english": "There’s a train leaving at 12:16, but only some standing tickets left."
    },
    {
      "index": 13,
      "simplified": "您要买哪个？",
      "traditional": "您要買哪個？",
      "pinyin": "nín yào mǎi něi ge",
      "english": "Another train leaving at 1:08 still has some seats."
    },
    {
      "index": 14,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Which ticket would you like to buy?"
    },
    {
      "index": 15,
      "simplified": "安妮：从这里到上海要几个小时？",
      "traditional": "安妮：從這裡到上海要幾個小時？",
      "pinyin": "ān nī cóng zhè lǐ dào shàng hǎi yào jǐ ge xiǎo shí",
      "english": ""
    },
    {
      "index": 16,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: How long does it take from here to Shanghai?"
    },
    {
      "index": 17,
      "simplified": "售票员：三个半小时左右。",
      "traditional": "售票員：三個半小時左右。",
      "pinyin": "shòu piào yuán sān ge bàn xiǎo shí zuǒ yòu",
      "english": ""
    },
    {
      "index": 18,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Staff: Around 3.5 hours."
    },
    {
      "index": 19,
      "simplified": "安妮：那我买1点08分的吧，这是我的护照。",
      "traditional": "安妮：那我買1點08分的吧，這是我的護照。",
      "pinyin": "ān nī nà wǒ mǎi 1 diǎn 2 fēn de ba zhè shì wǒ de hù zhào",
      "english": ""
    },
    {
      "index": 20,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Then I’ll take the 1:08 train. Here is my passport."
    },
    {
      "index": 21,
      "simplified": "售票员：好的，您要一等座还是二等座？",
      "traditional": "售票員：好的，您要一等座還是二等座？",
      "pinyin": "shòu piào yuán hǎo de nín yào yī děng zuò hái shi èr děng zuò",
      "english": ""
    },
    {
      "index": 22,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Staff: Ok. Would you like to buy a first-class or second-class ticket?"
    },
    {
      "index": 23,
      "simplified": "安妮：二等座。",
      "traditional": "安妮：二等座。",
      "pinyin": "ān nī èr děng zuò",
      "english": ""
    },
    {
      "index": 24,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Second-class."
    },
    {
      "index": 25,
      "simplified": "售票员：这是您的火车票，请拿好。",
      "traditional": "售票員：這是您的火車票，請拿好。",
      "pinyin": "shòu piào yuán zhè shì nín de huǒ chē piào qǐng ná hǎo",
      "english": ""
    },
    {
      "index": 26,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Staff: Here is your ticket, take it please."
    },
