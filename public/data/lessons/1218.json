{
  "id": "1218",
  "title": "Can I Get Them for 10 Yuan?",
  "level": "newbie",
  "date": "2022-03-28",
  "synopsis": "Ben tries to haggle for shoes …",
  "audioUrl": "https://static.duchinese.net/documents/1218/0521fa1f9b406944222cf419381e2705ce730b8c.mp3?1615549391",
  "series": null,
  "fullText": {
    "simplified": "十块钱可以吗？\n\n本：老板，你好！你这儿有鞋吗？\n老板：有。你看，都在这儿。\n本：这鞋多少钱？\n老板：二十块！\n本：有点儿贵呢，十块钱可以吗？\n老板：我想想……可以，那你是要左脚的还是要右脚的？",
    "traditional": "十塊錢可以嗎？\n\n本：老闆，你好！你這兒有鞋嗎？\n老闆：有。你看，都在這兒。\n本：這鞋多少錢？\n老闆：二十塊！\n本：有點兒貴呢，十塊錢可以嗎？\n老闆：我想想……可以，那你是要左腳的還是要右腳的？"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Can I Get Them for 10 Yuan?"
    },
    {
      "index": 2,
      "simplified": "本：老板，你好！你这儿有鞋吗？",
      "traditional": "本：老闆，你好！你這兒有鞋嗎？",
      "pinyin": "běn lǎo bǎn nǐ hǎo nǐ zhè‘r yǒu xié ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Boss, hello! Do you have shoes here?"
    },
    {
      "index": 4,
      "simplified": "老板：有。你看，都在这儿。",
      "traditional": "老闆：有。你看，都在這兒。",
      "pinyin": "lǎo bǎn yǒu nǐ kàn dōu zài zhè‘r",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop Owner: Yes. See, they are all here."
    },
    {
      "index": 6,
      "simplified": "本：这鞋多少钱？",
      "traditional": "本：這鞋多少錢？",
      "pinyin": "běn zhè xié duō shao qián",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: How much are these shoes?"
    },
    {
      "index": 8,
      "simplified": "老板：二十块！",
      "traditional": "老闆：二十塊！",
      "pinyin": "lǎo bǎn èr shí kuài",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop Owner: 20 yuan!"
    },
    {
      "index": 10,
      "simplified": "本：有点儿贵呢，十块钱可以吗？",
      "traditional": "本：有點兒貴呢，十塊錢可以嗎？",
      "pinyin": "běn yǒu diǎn'r guì ne shí kuài qián kě yǐ ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: That is a little bit expensive. Can I get them for 10 yuan?"
    },
    {
      "index": 12,
      "simplified": "老板：我想想……可以，那你是要左脚的还是要右脚的？",
      "traditional": "老闆：我想想……可以，那你是要左腳的還是要右腳的？",
      "pinyin": "lǎo bǎn wǒ xiǎng xiǎng kě yǐ nà nǐ shì yào zuǒ jiǎo de hái shi yào yòu jiǎo de",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Shop Owner: Let me think … sure. So do you want the left shoe or the right shoe?"
    }
  ],
