{
  "id": "364",
  "title": "Do You Have a Chinese Name?",
  "level": "elementary",
  "date": "2017-10-14",
  "synopsis": "Make sure you check with a Chinese friend when you decide on your Chinese name.",
  "audioUrl": "https://static.duchinese.net/documents/545/b78302e5ed321f34c72b51cba4ca0c5cc9839377.mp3?1589791615",
  "series": {
    "title": "Ben’s life in China 3: Who is Little Yu?",
    "chapter": 9,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你有汉语名字吗？\n\n丽丽：你有汉语名字吗？\n本：没有。你觉得什么名字好？\n丽丽：嗯……你英文叫“Ben”，汉语名字就叫“本”吧！\n本：我想叫“笨”。\n丽丽：“笨”？在汉语里是“傻瓜”的意思。\n本：那我还是叫“本”吧！",
    "traditional": "你有漢語名字嗎？\n\n麗麗：你有漢語名字嗎？\n本：沒有。你覺得什麼名字好？\n麗麗：嗯……你英文叫“Ben”，漢語名字就叫“本”吧！\n本：我想叫“笨”。\n麗麗：“笨”？在漢語裡是“傻瓜”的意思。\n本：那我還是叫“本”吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Do you have a Chinese name?"
    },
    {
      "index": 2,
      "simplified": "丽丽：你有汉语名字吗？",
      "traditional": "麗麗：你有漢語名字嗎？",
      "pinyin": "lì lì nǐ yǒu hàn yǔ míng zi ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Do you have a Chinese name?"
    },
    {
      "index": 4,
      "simplified": "本：没有。你觉得什么名字好？",
      "traditional": "本：沒有。你覺得什麼名字好？",
      "pinyin": "běn méi yǒu nǐ jué de shén me míng zi hǎo",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: No. What name do you think is good?"
    },
    {
      "index": 6,
      "simplified": "丽丽：嗯……你英文叫“Ben”，汉语名字就叫“本”吧！",
      "traditional": "麗麗：嗯……你英文叫“Ben”，漢語名字就叫“本”吧！",
      "pinyin": "lì lì èn nǐ yīng wén jiào 1 hàn yǔ míng zi jiù jiào běn ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Hmm… Your English name is “Ben”, so let’s make your Chinese name “Běn”!"
    },
    {
      "index": 8,
      "simplified": "本：我想叫“笨”。",
      "traditional": "本：我想叫“笨”。",
      "pinyin": "běn wǒ xiǎng jiào bèn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I want to be called “Bèn”."
    },
    {
      "index": 10,
      "simplified": "丽丽：“笨”？在汉语里是“傻瓜”的意思。",
      "traditional": "麗麗：“笨”？在漢語裡是“傻瓜”的意思。",
      "pinyin": "lì lì bèn zài hàn yǔ lǐ shì shǎ guā de yì si",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: “Bèn”? In Chinese, that means “idiot”."
    },
    {
      "index": 12,
      "simplified": "本：那我还是叫“本”吧！",
      "traditional": "本：那我還是叫“本”吧！",
      "pinyin": "běn nà wǒ hái shi jiào běn ba",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Then let's go with “Běn”!"
    }
  ],
