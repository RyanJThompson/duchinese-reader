{
  "id": "359",
  "title": "Are you returning home this year?",
  "level": "newbie",
  "date": "2017-08-26",
  "synopsis": "Ben hasn't returned home to see his parents for two years.",
  "audioUrl": "https://static.duchinese.net/documents/508/cca937e2517b695d7cb80efddb00efd8b8eaa4af.mp3?1698352514",
  "series": null,
  "fullText": {
    "simplified": "你今年回国吗？\n\n小丽：本，你今年回国吗？\n本：不回。回美国的机票太贵了。\n小丽：你有几年没回国了？\n本：两年了。\n小丽：你想你的爸爸妈妈吗？\n本：很想。",
    "traditional": "你今年回國嗎？\n\n小麗：本，你今年回國嗎？\n本：不回。回美國的機票太貴了。\n小麗：你有幾年沒回國了？\n本：兩年了。\n小麗：你想你的爸爸媽媽嗎？\n本：很想。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Are you going back to your country this year?"
    },
    {
      "index": 2,
      "simplified": "小丽：本，你今年回国吗？",
      "traditional": "小麗：本，你今年回國嗎？",
      "pinyin": "xiǎo lì běn nǐ jīn nián huí guó ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Li: Ben, are you going back to your country this year?"
    },
    {
      "index": 4,
      "simplified": "本：不回。回美国的机票太贵了。",
      "traditional": "本：不回。回美國的機票太貴了。",
      "pinyin": "běn bù huí huí měi guó de jī piào tài guì le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: No. The plane ticket back to America is too expensive."
    },
    {
      "index": 6,
      "simplified": "小丽：你有几年没回国了？",
      "traditional": "小麗：你有幾年沒回國了？",
      "pinyin": "xiǎo lì nǐ yǒu jǐ nián méi huí guó le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Li: How many years has it been since you returned home?"
    },
    {
      "index": 8,
      "simplified": "本：两年了。",
      "traditional": "本：兩年了。",
      "pinyin": "běn liǎng nián le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Two years."
    },
    {
      "index": 10,
      "simplified": "小丽：你想你的爸爸妈妈吗？",
      "traditional": "小麗：你想你的爸爸媽媽嗎？",
      "pinyin": "xiǎo lì nǐ xiǎng nǐ de bà ba mā ma ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Li: Do you miss your parents?"
    },
    {
      "index": 12,
      "simplified": "本：很想。",
      "traditional": "本：很想。",
      "pinyin": "běn hěn xiǎng",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Yes, a lot."
    }
  ],
