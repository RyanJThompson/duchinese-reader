      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "After New Year, Old Wang gave a red envelope with money to a business owner."
    },
    {
      "index": 4,
      "simplified": "老板：“你这是什么意思？”",
      "traditional": "老闆：“你這是什麼意思？”",
      "pinyin": "lǎo bǎn nǐ zhè shì shén me yì si",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Business owner: “What's the meaning of this?”"
    },
    {
      "index": 6,
      "simplified": "老王：“没什么意思。就意思意思。”",
      "traditional": "老王：“沒什麼意思。就意思意思。”",
      "pinyin": "lǎo wáng méi shén me yì si jiù yì si yì si",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Old Wang: “No meaning at all. It's just a little something.”"
    },
    {
      "index": 8,
      "simplified": "老板：“你这就不够意思了。”",
      "traditional": "老闆：“你這就不夠意思了。”",
      "pinyin": "lǎo bǎn nǐ zhè jiù bú gòu yì si le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Business owner: “You're acting like we don't know each other.”"
    },
    {
      "index": 10,
      "simplified": "老王：“小意思，小意思”",
      "traditional": "老王：“小意思，小意思”",
      "pinyin": "lǎo wáng xiǎo yì si xiǎo yì si",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Old Wang: “It's just a small token.”"
    },
    {
      "index": 12,
      "simplified": "老板：“你这人真有意思。”",
      "traditional": "老闆：“你這人真有意思。”",
      "pinyin": "lǎo bǎn nǐ zhè rén zhēn yǒu yì si",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Business owner: “You're really peculiar.”"
    },
    {
      "index": 14,
      "simplified": "老王：“其实也没有别的意思”",
      "traditional": "老王：“其實也沒有別的意思”",
