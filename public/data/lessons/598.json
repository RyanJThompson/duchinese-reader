{
  "id": "598",
  "title": "I Didn’t Know It Was Going to Rain",
  "level": "intermediate",
  "date": "2018-09-30",
  "synopsis": "Ben didn’t know it would rain, so he didn’t bring an umbrella.",
  "audioUrl": "https://static.duchinese.net/documents/848/638d8c44d2649f1113e8825725fda63d4882fea7.mp3?1589791815",
  "series": {
    "title": "Ben’s life in China 4: Trouble in Paradise",
    "chapter": 3,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "我不知道会下雨\n\n小雨：本？你没带伞？\n本：小雨！是啊，我不知道会下雨。\n小雨：我带伞了，我们一起走吧。\n本：太好了！\n小雨：你想去哪儿？\n本：我看了一天的书，又累又饿。我想去吃饭。\n小雨：我也饿了。那我们一起去吃饭吧！\n本：好！谢谢你！",
    "traditional": "我不知道會下雨\n\n小雨：本？你沒帶傘？\n本：小雨！是啊，我不知道會下雨。\n小雨：我帶傘了，我們一起走吧。\n本：太好了！\n小雨：你想去哪兒？\n本：我看了一天的書，又累又餓。我想去吃飯。\n小雨：我也餓了。那我們一起去吃飯吧！\n本：好！謝謝你！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Didn’t Know It Was Going to Rain"
    },
    {
      "index": 2,
      "simplified": "小雨：本？你没带伞？",
      "traditional": "小雨：本？你沒帶傘？",
      "pinyin": "xiǎo yǔ běn nǐ méi dài sǎn",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Ben? You didn’t bring an umbrella?"
    },
    {
      "index": 4,
      "simplified": "本：小雨！是啊，我不知道会下雨。",
      "traditional": "本：小雨！是啊，我不知道會下雨。",
      "pinyin": "běn xiǎo yǔ shì a wǒ bù zhī dào huì xià yǔ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Little Yu! No, I didn’t know it was going to rain."
    },
    {
      "index": 6,
      "simplified": "小雨：我带伞了，我们一起走吧。",
      "traditional": "小雨：我帶傘了，我們一起走吧。",
      "pinyin": "xiǎo yǔ wǒ dài sǎn le wǒ men yì qǐ zǒu ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: I brought an umbrella. We can walk together."
    },
    {
      "index": 8,
      "simplified": "本：太好了！",
      "traditional": "本：太好了！",
      "pinyin": "běn tài hǎo le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Great!"
    },
    {
      "index": 10,
      "simplified": "小雨：你想去哪儿？",
      "traditional": "小雨：你想去哪兒？",
      "pinyin": "xiǎo yǔ nǐ xiǎng qù nǎ'r",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Where do you want to go?"
    },
    {
      "index": 12,
      "simplified": "本：我看了一天的书，又累又饿。我想去吃饭。",
      "traditional": "本：我看了一天的書，又累又餓。我想去吃飯。",
      "pinyin": "běn wǒ kàn le yì tiān de shū yòu lèi yòu è wǒ xiǎng qù chī fàn",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I’ve been studying all day, so I’m both tired and hungry. I want to go eat."
    },
    {
      "index": 14,
      "simplified": "小雨：我也饿了。那我们一起去吃饭吧！",
      "traditional": "小雨：我也餓了。那我們一起去吃飯吧！",
      "pinyin": "xiǎo yǔ wǒ yě è le nà wǒ men yì qǐ qù chī fàn ba",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: I’m also hungry. Let’s go have a meal together!"
    },
    {
      "index": 16,
      "simplified": "本：好！谢谢你！",
      "traditional": "本：好！謝謝你！",
      "pinyin": "běn hǎo xiè xie nǐ",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Ok! Thank you!"
    }
  ],
