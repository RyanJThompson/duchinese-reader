    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: I want to buy Chinese books. Is the bookstore far?"
    },
    {
      "index": 14,
      "simplified": "高天：不远。我和你一起去，怎么样？",
      "traditional": "高天：不遠。我和你一起去，怎麼樣？",
