      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Gao Tian: This is a Chinese book. I’m learning Chinese."
    },
    {
      "index": 8,
      "simplified": "Anne：我也想学汉语。在哪儿买汉语书？",
