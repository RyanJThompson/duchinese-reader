      "simplified": "小明很喜欢笑笑。",
      "traditional": "小明很喜歡笑笑。",
      "pinyin": "xiǎo míng hěn xǐ huan xiào xiào",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "一天，他对笑笑说：“我们玩个游戏吧，谁先动谁输。”",
      "traditional": "一天，他對笑笑說：“我們玩個遊戲吧，誰先動誰輸。”",
      "pinyin": "yì tiān tā duì xiào xiào shuō wǒ men wán ge yóu xì ba shéi xiān dòng shéi shū",
      "english": "Little Ming really likes Xiao Xiao."
    },
    {
      "index": 4,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "One day he said to Xiao Xiao: “Let's play a game. Whoever moves first loses.”"
    },
    {
      "index": 5,
      "simplified": "笑笑说：“好啊！”",
      "traditional": "笑笑說：“好啊！”",
      "pinyin": "xiào xiào shuō hǎo a",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Xiao Xiao said: “Sure!”"
    },
    {
      "index": 7,
      "simplified": "才过了几秒钟，小明说：“我输了！”",
      "traditional": "才過了幾秒鐘，小明說：“我輸了！”",
      "pinyin": "cái guò le jǐ miǎo zhōng xiǎo míng shuō wǒ shū le",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "After just a few seconds, Little Ming said: “I lost!”"
    },
    {
      "index": 9,
      "simplified": "笑笑很奇怪，问：“你没有动呀！为什么输了呢？”",
      "traditional": "笑笑很奇怪，問：“你沒有動呀！為什麼輸了呢？”",
      "pinyin": "xiào xiào hěn qí guài wèn nǐ méi yǒu dòng ya wèi shén me shū le ne",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Xiao Xiao was confused, and asked: “You didn't move! Why did you lose?”"
    },
    {
      "index": 11,
      "simplified": "小明回答：“我心动了！”",
      "traditional": "小明回答：“我心動了！”",
      "pinyin": "xiǎo míng huí dá wǒ xīn dòng le",
      "english": ""
    }
  ],
