    "sentence_translations": [
      "Can I Like You for Four Days?",
      "",
      "Paul: Can I like you for four days?",
      "",
      "Little Le: What? Which four days?",
      "",
      "Paul: Spring, summer, autumn, and winter.",
      "",
      "Little Le: That’s too much.",
      "",
      "Paul: Can I like you for three days?",
      "",
      "Little Le: Which three days?",
      "",
      "Paul: Yesterday, today, and tomorrow.",
      "",
      "Little Le: That’s still a bit much.",
      "",
      "Paul: In that case, can I like you for two days?",
      "",
      "Little Le: Which two days, then?",
      "",
      "Paul: Daytime and nighttime.",
      "",
      "Little Le: No, no, I’ll give you one day at most.",
      "",
      "Paul: If it’s one day, then I’ll like you every single day.",
      ""
    ]
  }
