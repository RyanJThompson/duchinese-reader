{
  "id": "1219",
  "title": "Can I Like You for Four Days?",
  "level": "newbie",
  "date": "2022-04-04",
  "synopsis": "Paul really likes Little Le!",
  "audioUrl": "https://static.duchinese.net/documents/1219/54ae0bee061120d8f77c1283afbde82139ce7482.mp3?1615549221",
  "series": null,
  "fullText": {
    "simplified": "我能不能喜欢你四天\n\n保罗：我能不能喜欢你四天？\n小乐：什么？哪四天？\n保罗：春天、夏天、秋天和冬天。\n小乐：这太多了。\n保罗：我能不能喜欢你三天？\n小乐：哪三天？\n保罗：昨天、今天和明天。\n小乐：还是有点多。\n保罗：那我能不能喜欢你两天？\n小乐：哪两天呢？\n保罗：白天和黑天。\n小乐：不好不好，最多给你一天。\n保罗：一天的话，那就是，爱你每一天。",
    "traditional": "我能不能喜歡你四天\n\n保羅：我能不能喜歡你四天？\n小樂：什麼？哪四天？\n保羅：春天、夏天、秋天和冬天。\n小樂：這太多了。\n保羅：我能不能喜歡你三天？\n小樂：哪三天？\n保羅：昨天、今天和明天。\n小樂：還是有點多。\n保羅：那我能不能喜歡你兩天？\n小樂：哪兩天呢？\n保羅：白天和黑天。\n小樂：不好不好，最多給你一天。\n保羅：一天的話，那就是，愛你每一天。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Can I Like You for Four Days?"
    },
    {
      "index": 2,
      "simplified": "保罗：我能不能喜欢你四天？",
      "traditional": "保羅：我能不能喜歡你四天？",
      "pinyin": "bǎo luó wǒ néng bù néng xǐ huan nǐ sì tiān",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Can I like you for four days?"
    },
    {
      "index": 4,
      "simplified": "小乐：什么？哪四天？",
      "traditional": "小樂：什麼？哪四天？",
      "pinyin": "xiǎo lè shén me nǎ sì tiān",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: What? Which four days?"
    },
    {
      "index": 6,
      "simplified": "保罗：春天、夏天、秋天和冬天。",
      "traditional": "保羅：春天、夏天、秋天和冬天。",
      "pinyin": "bǎo luó chūn tiān xià tiān qiū tiān hé dōng tiān",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Spring, summer, autumn, and winter."
    },
    {
      "index": 8,
      "simplified": "小乐：这太多了。",
      "traditional": "小樂：這太多了。",
      "pinyin": "xiǎo lè zhè tài duō le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: That’s too much."
    },
    {
      "index": 10,
      "simplified": "保罗：我能不能喜欢你三天？",
      "traditional": "保羅：我能不能喜歡你三天？",
      "pinyin": "bǎo luó wǒ néng bù néng xǐ huan nǐ sān tiān",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Can I like you for three days?"
    },
    {
      "index": 12,
      "simplified": "小乐：哪三天？",
      "traditional": "小樂：哪三天？",
      "pinyin": "xiǎo lè nǎ sān tiān",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Which three days?"
    },
    {
      "index": 14,
      "simplified": "保罗：昨天、今天和明天。",
      "traditional": "保羅：昨天、今天和明天。",
      "pinyin": "bǎo luó zuó tiān jīn tiān hé míng tiān",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Yesterday, today, and tomorrow."
    },
    {
      "index": 16,
      "simplified": "小乐：还是有点多。",
      "traditional": "小樂：還是有點多。",
      "pinyin": "xiǎo lè hái shì yǒu diǎn duō",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: That’s still a bit much."
    },
    {
      "index": 18,
      "simplified": "保罗：那我能不能喜欢你两天？",
      "traditional": "保羅：那我能不能喜歡你兩天？",
      "pinyin": "bǎo luó nà wǒ néng bù néng xǐ huan nǐ liǎng tiān",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: In that case, can I like you for two days?"
    },
    {
      "index": 20,
      "simplified": "小乐：哪两天呢？",
      "traditional": "小樂：哪兩天呢？",
      "pinyin": "xiǎo lè nǎ liǎng tiān ne",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Which two days, then?"
    },
    {
      "index": 22,
      "simplified": "保罗：白天和黑天。",
      "traditional": "保羅：白天和黑天。",
      "pinyin": "bǎo luó bái tiān hé hēi tiān",
      "english": ""
    },
    {
      "index": 23,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Daytime and nighttime."
    },
    {
      "index": 24,
      "simplified": "小乐：不好不好，最多给你一天。",
      "traditional": "小樂：不好不好，最多給你一天。",
      "pinyin": "xiǎo lè bù hǎo bù hǎo zuì duō gěi nǐ yì tiān",
      "english": ""
    },
    {
      "index": 25,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: No, no, I’ll give you one day at most."
    },
    {
      "index": 26,
      "simplified": "保罗：一天的话，那就是，爱你每一天。",
      "traditional": "保羅：一天的話，那就是，愛你每一天。",
      "pinyin": "bǎo luó yì tiān de huà nà jiù shì ài nǐ měi yì tiān",
      "english": ""
    },
    {
      "index": 27,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Paul: If it’s one day, then I’ll like you every single day."
    }
