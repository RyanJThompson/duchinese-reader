{
  "id": "E220",
  "title": "Yes, that could work…",
  "level": "elementary",
  "date": "2018-05-12",
  "synopsis": "“That could work…” actually implies “I don’t like this idea”.",
  "audioUrl": "https://static.duchinese.net/documents/732/c5d2de164066aaded1d1082041f6eca764af3482.mp3?1525687515",
  "series": null,
  "fullText": {
    "simplified": "可以是可以 \n\n杰杰：老板，下个星期我们忙不忙？我想请几天假。\n老板：可以是可以。你想请几天？\n杰杰：五天，可以吗？\n老板：五天也太长了！三天怎么样？\n杰杰：可以是可以，但是……\n老板：好，就三天吧！不要“但是”了。",
    "traditional": "可以是可以 \n\n杰杰：老闆，下個星期我們忙不忙？我想請幾天假。\n老闆：可以是可以。你想請幾天？\n杰杰：五天，可以嗎？\n老闆：五天也太長了！三天怎麼樣？\n杰杰：可以是可以，但是……\n老闆：好，就三天吧！不要“但是”了。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Yes, that could work…"
    },
    {
      "index": 2,
      "simplified": "杰杰：老板，下个星期我们忙不忙？我想请几天假。",
      "traditional": "杰杰：老闆，下個星期我們忙不忙？我想請幾天假。",
      "pinyin": "jié jié lǎo bǎn xià ge xīng qī wǒ men máng bù máng wǒ xiǎng qǐng jǐ tiān jià",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Jay: Boss, are we busy next week? I would like to ask for a few days off."
    },
    {
      "index": 4,
      "simplified": "老板：可以是可以。你想请几天？",
      "traditional": "老闆：可以是可以。你想請幾天？",
      "pinyin": "lǎo bǎn kě yǐ shì kě yǐ nǐ xiǎng qǐng jǐ tiān",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Boss: That could work… How many days do you want off?"
    },
    {
      "index": 6,
      "simplified": "杰杰：五天，可以吗？",
      "traditional": "杰杰：五天，可以嗎？",
      "pinyin": "jié jié wǔ tiān kě yǐ ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Jay: Five days, is that ok?"
    },
    {
      "index": 8,
      "simplified": "老板：五天也太长了！三天怎么样？",
      "traditional": "老闆：五天也太長了！三天怎麼樣？",
      "pinyin": "lǎo bǎn wǔ tiān yě tài cháng le sān tiān zěn me yàng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Boss: Five days is too long! How about three days?"
    },
    {
      "index": 10,
      "simplified": "杰杰：可以是可以，但是……",
      "traditional": "杰杰：可以是可以，但是……",
      "pinyin": "jié jié kě yǐ shì kě yǐ dàn shì",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Jay: Yes, that could work, but..."
    },
    {
      "index": 12,
      "simplified": "老板：好，就三天吧！不要“但是”了。",
      "traditional": "老闆：好，就三天吧！不要“但是”了。",
      "pinyin": "lǎo bǎn hǎo jiù sān tiān ba bú yào dàn shì le",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Boss: Ok, three days then. I don’t want to hear any “buts”."
    }
  ],
