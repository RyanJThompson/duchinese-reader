{
  "id": "787",
  "title": "Is This the Phone to Call?",
  "level": "newbie",
  "date": "2019-08-22",
  "synopsis": "How can Lucy give the handsome guy his shirt back?",
  "audioUrl": "https://static.duchinese.net/documents/1130/e362d7e4e77e50cef9597e06172549860f36203a.mp3?1566203924",
  "series": {
