    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lucy: Hello! I’m the one with the coffee last time…"
    },
    {
      "index": 6,
      "simplified": "帅哥：啊，你好！",
      "traditional": "帥哥：啊，你好！",
