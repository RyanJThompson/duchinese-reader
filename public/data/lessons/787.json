    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Handsome guy: Ah, hello!"
    },
    {
      "index": 8,
      "simplified": "露西：你好！你的衣服我洗好了，怎么给你？",
      "traditional": "露西：你好！你的衣服我洗好了，怎麼給你？",
      "pinyin": "lù xī nǐ hǎo nǐ de yī fu wǒ xǐ hǎo le zěn me gěi nǐ",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lucy: Hello! I finished washing your shirt, how do I give it to you?"
    },
    {
      "index": 10,
      "simplified": "帅哥：我明天会去学校，到时候打电话给你？",
      "traditional": "帥哥：我明天會去學校，到時候打電話給你？",
      "pinyin": "shuài gē wǒ míng tiān huì qù xué xiào dào shí hou dǎ diàn huà gěi nǐ",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Handsome guy: I’m going to the school tomorrow, I’ll give you a call when I get there?"
    },
    {
      "index": 12,
      "simplified": "露西：好的。明天我都在学校。",
      "traditional": "露西：好的。明天我都在學校。",
      "pinyin": "lù xī hǎo de míng tiān wǒ dōu zài xué xiào",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lucy: Ok. I’m at school all day tomorrow."
    },
    {
      "index": 14,
      "simplified": "帅哥：好的。那是打这个电话吗？",
      "traditional": "帥哥：好的。那是打這個電話嗎？",
      "pinyin": "shuài gē hǎo de nà shì dǎ zhè ge diàn huà ma",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Handsome guy: Ok. Is this the phone to call then?"
    },
    {
      "index": 16,
      "simplified": "露西：是的。这是我的手机号。",
      "traditional": "露西：是的。這是我的手機號。",
      "pinyin": "lù xī shì de zhè shì wǒ de shǒu jī hào",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Lucy: Yes. This is my cell phone number."
    }
