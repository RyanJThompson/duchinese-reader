      "english": ""
    },
    {
      "index": 3,
      "simplified": "一百万只猫在老爷爷后面，他们走啊走啊。",
      "traditional": "一百萬隻貓在老爺爺後面，他們走啊走啊。",
      "pinyin": "yì bǎi wàn zhī māo zài lǎo yé ye hòu miàn tā men zǒu a zǒu a",
      "english": "The one million cats were behind the old man, they walked and walked."
    },
    {
      "index": 4,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "有一只猫说：“我想吃东西！”",
      "traditional": "有一隻貓說：“我想吃東西！”",
      "pinyin": "yǒu yì zhī māo shuō wǒ xiǎng chī dōng xi",
      "english": "There was a cat that said, “I want to eat something!”"
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "又有一只猫说：“我想吃东西！”",
      "traditional": "又有一隻貓說：“我想吃東西！”",
      "pinyin": "yòu yǒu yì zhī māo shuō wǒ xiǎng chī dōng xi",
      "english": "Another cat said, “I want to eat something!”"
    },
    {
      "index": 8,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "几百只猫一起叫：“我想吃东西！”",
      "traditional": "幾百隻貓一起叫：“我想吃東西！”",
      "pinyin": "jǐ bǎi zhī māo yì qǐ jiào wǒ xiǎng chī dōng xi",
      "english": "A few hundred cats shouted together, “I want to eat something!”"
    },
    {
      "index": 10,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "一百万只猫都在叫：“我想吃东西！”",
      "traditional": "一百萬隻貓都在叫：“我想吃東西！”",
      "pinyin": "yì bǎi wàn zhī māo dōu zài jiào wǒ xiǎng chī dōng xi",
      "english": "The one million cats were all shouting, “I want to eat something!”"
    },
    {
      "index": 12,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "老爷爷和它们走到一个苹果商店，那里有很多苹果。老爷爷说：",
      "traditional": "老爺爺和它們走到一個蘋果商店，那裡有很多蘋果。老爺爺說：",
      "pinyin": "lǎo yé ye hé tā men zǒu dào yí ge píng guǒ shāng diàn nà lǐ yǒu hěn duō píng guǒ lǎo yé ye shuō",
      "english": "They and the old man walked up to an apple store. There were a lot of apples there. The old man said:"
    },
    {
      "index": 14,
      "simplified": "“这里有很多苹果！你们吃，你们吃！”",
      "traditional": "“這裡有很多蘋果！你們吃，你們吃！”",
      "pinyin": "zhè lǐ yǒu hěn duō píng guǒ nǐ men chī nǐ men chī",
      "english": "“There are a lot of apples here! You eat some, you eat some!”"
    },
    {
      "index": 15,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 16,
      "simplified": "但是一百万只猫一起吃苹果，吃了几分钟，苹果就没有了。",
      "traditional": "但是一百萬隻貓一起吃蘋果，吃了幾分鐘，蘋果就沒有了。",
      "pinyin": "dàn shì yì bǎi wàn zhī māo yì qǐ chī píng guǒ chī le jǐ fēn zhōng píng guǒ jiù méi yǒu le",
      "english": "But the one million cats ate the apples together, and ate for several minutes until the apples were gone."
    },
    {
      "index": 17,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": ""
    }
