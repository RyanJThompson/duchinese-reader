{
  "id": "418",
  "title": "The Phone is Ringing",
  "level": "intermediate",
  "date": "2018-01-17",
  "synopsis": "Little Ming gets a phone call at the library.",
  "audioUrl": "https://static.duchinese.net/documents/632/6560ae19ac782ffdbcc13cf09c7e9729b888f99c.mp3?1515603627",
  "series": null,
  "fullText": {
    "simplified": "手机响了\n\n    一天，小明在图书馆看书。突然，他的手机响了。为了不影响别的同学看书，他马上跑了出去，但他又马上跑了进来，你知道为什么吗？\n    答案是：他忘了拿手机。",
    "traditional": "手機響了\n\n    一天，小明在圖書館看書。突然，他的手機響了。為了不影響別的同學看書，他馬上跑了出去，但他又馬上跑了進來，你知道為什麼嗎？\n    答案是：他忘了拿手機。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "The Phone is Ringing"
    },
    {
      "index": 2,
      "simplified": "一天，小明在图书馆看书。",
      "traditional": "一天，小明在圖書館看書。",
      "pinyin": "yì tiān xiǎo míng zài tú shū guǎn kàn shū",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "突然，他的手机响了。",
      "traditional": "突然，他的手機響了。",
      "pinyin": "tū rán tā de shǒu jī xiǎng le",
      "english": "One day, Little Ming was at the library reading."
    },
    {
      "index": 4,
      "simplified": "为了不影响别的同学看书，他马上跑了出去，但他又马上跑了进来，",
      "traditional": "為了不影響別的同學看書，他馬上跑了出去，但他又馬上跑了進來，",
      "pinyin": "wèi le bù yǐng xiǎng bié de tóng xué kàn shū tā mǎ shàng pǎo le chū qù dàn tā yòu mǎ shàng pǎo le jìn lái",
      "english": "Suddenly, his mobile phone rang."
    },
    {
      "index": 5,
      "simplified": "你知道为什么吗？",
      "traditional": "你知道為什麼嗎？",
      "pinyin": "nǐ zhī dào wèi shén me ma",
      "english": "In order not to disturb other people reading, he immediately ran outside, but then ran back inside right away."
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Do you know why?"
    },
    {
      "index": 7,
      "simplified": "答案是：他忘了拿手机。",
      "traditional": "答案是：他忘了拿手機。",
      "pinyin": "dá àn shì tā wàng le ná shǒu jī",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "The answer is: He forgot to bring his mobile phone."
    }
  ],
