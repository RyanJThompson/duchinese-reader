{
  "id": "871",
  "title": "How Many Students?",
  "level": "newbie",
  "date": "2020-02-27",
  "synopsis": "Lili is asking Ben about his class.",
  "audioUrl": "https://static.duchinese.net/documents/871/535359225c8f813cbd74930a6e3bbcc7a3f3650e.mp3?1582276820",
  "series": null,
  "fullText": {
    "simplified": "你们班有多少名学生？\n\n丽丽：你们班有多少名学生？\n本：我们班有30名学生。\n丽丽：他们都是外国人吗？\n本：是的。我们在一起学汉语。",
    "traditional": "你們班有多少名學生？\n\n麗麗：你們班有多少名學生？\n本：我們班有30名學生。\n麗麗：他們都是外國人嗎？\n本：是的。我們在一起學漢語。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "How many students are in your class?"
    },
    {
      "index": 2,
      "simplified": "丽丽：你们班有多少名学生？",
      "traditional": "麗麗：你們班有多少名學生？",
      "pinyin": "lì lì nǐ men bān yǒu duō shao míng xué sheng",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: How many students are in your class?"
    },
    {
      "index": 4,
      "simplified": "本：我们班有30名学生。",
      "traditional": "本：我們班有30名學生。",
      "pinyin": "běn wǒ men bān yǒu 2 míng xué sheng",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Our class has 30 students."
    },
    {
      "index": 6,
      "simplified": "丽丽：他们都是外国人吗？",
      "traditional": "麗麗：他們都是外國人嗎？",
      "pinyin": "lì lì tā men dōu shì wài guó rén ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Are they all foreigners?"
    },
    {
      "index": 8,
      "simplified": "本：是的。我们在一起学汉语。",
      "traditional": "本：是的。我們在一起學漢語。",
      "pinyin": "běn shì de wǒ men zài yì qǐ xué hàn yǔ",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Yes, they are. We study Chinese together."
    }
  ],
