{
  "id": "846",
  "title": "Buying Dumplings",
  "level": "elementary",
  "date": "2020-03-14",
  "synopsis": "Ben is buying steamed dumplings. How many should he get?",
  "audioUrl": "https://static.duchinese.net/documents/846/407b9e2ce34817b3b3a33a4bfe75c9b4b3f2661c.mp3?1583763688",
  "series": null,
  "fullText": {
    "simplified": "我要一笼\n\n本：我想要15个小笼包。\n店员：不好意思。我们的小笼包是一笼一笼卖的。不能卖15个。\n本：一笼小笼包有几个？\n店员：10个。你可以要一笼，也可以要两笼。\n本：我要一笼。再给我一个肉包和一杯豆浆。\n店员：好的。",
    "traditional": "我要一籠\n\n本：我想要15個小籠包。\n店員：不好意思。我們的小籠包是一籠一籠賣的。不能賣15個。\n本：一籠小籠包有幾個？\n店員：10個。你可以要一籠，也可以要兩籠。\n本：我要一籠。再給我一個肉包和一杯豆漿。\n店員：好的。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I want one steamer basket"
    },
    {
      "index": 2,
      "simplified": "本：我想要15个小笼包。",
      "traditional": "本：我想要15個小籠包。",
      "pinyin": "běn wǒ xiǎng yào 2 ge xiǎo lóng bāo",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I want 15 steamed dumplings."
    },
    {
      "index": 4,
      "simplified": "店员：不好意思。我们的小笼包是一笼一笼卖的。不能卖15个。",
      "traditional": "店員：不好意思。我們的小籠包是一籠一籠賣的。不能賣15個。",
      "pinyin": "diàn yuán bù hǎo yì si wǒ men de xiǎo lóng bāo shì yì lóng yì lóng mài de bù néng mài 2 ge",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: I’m sorry. Our dumplings are sold one steamer basket at a time. We can’t sell 15 steamed dumplings."
    },
    {
      "index": 6,
      "simplified": "本：一笼小笼包有几个？",
      "traditional": "本：一籠小籠包有幾個？",
      "pinyin": "běn yì lóng xiǎo lóng bāo yǒu jǐ ge",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: How many steamed dumplings are in a steamer basket?"
    },
    {
      "index": 8,
      "simplified": "店员：10个。你可以要一笼，也可以要两笼。",
      "traditional": "店員：10個。你可以要一籠，也可以要兩籠。",
      "pinyin": "diàn yuán 1 ge nǐ kě yǐ yào yì lóng yě kě yǐ yào liǎng lóng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: 10. You can ask for one basket or you can also ask for two baskets."
    },
    {
      "index": 10,
      "simplified": "本：我要一笼。再给我一个肉包和一杯豆浆。",
      "traditional": "本：我要一籠。再給我一個肉包和一杯豆漿。",
      "pinyin": "běn wǒ yào yì lóng zài gěi wǒ yí ge ròu bāo hé yì bēi dòu jiāng",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I want one basket. Also give me a steamed meat bun and a glass of soy milk."
    },
    {
      "index": 12,
      "simplified": "店员：好的。",
      "traditional": "店員：好的。",
      "pinyin": "diàn yuán hǎo de",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Shop assistant: OK."
    }
  ],
