    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Today is Sunday, May 10th."
    },
    {
      "index": 4,
      "simplified": "上个星期，老师告诉我们，五月的第二个星期日是母亲节，是妈妈的节日。",
      "traditional": "上個星期，老師告訴我們，五月的第二個星期日是母親節，是媽媽的節日。",
      "pinyin": "shàng ge xīng qī lǎo shī gào su wǒ men wǔ yuè de dì èr ge xīng qī rì shì mǔ qīn jié shì mā ma de jié rì",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "所以今天我去花店，我要给妈妈买花。",
      "traditional": "所以今天我去花店，我要給媽媽買花。",
      "pinyin": "suǒ yǐ jīn tiān wǒ qù huā diàn wǒ yào gěi mā ma mǎi huā",
      "english": "Last week, my teacher told us that the second Sunday in May is Mother’s Day, which is a festival for mothers."
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "So today I went to the flower shop. I wanted to buy flowers for Mom."
    },
    {
      "index": 7,
      "simplified": "花店里的人可真多！我问老板：“老板，康乃馨多少钱？”",
      "traditional": "花店裡的人可真多！我問老闆：“老闆，康乃馨多少錢？”",
      "pinyin": "huā diàn lǐ de rén kě zhēn duō wǒ wèn lǎo bǎn lǎo bǎn kāng nǎi xīn duō shao qián",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "老板说：“对不起，小朋友，康乃馨卖完了。”我很难过，不知道怎么办。",
      "traditional": "老闆說：“對不起，小朋友，康乃馨賣完了。”我很難過，不知道怎麼辦。",
      "pinyin": "lǎo bǎn shuō duì bu qǐ xiǎo péng you kāng nǎi xīn mài wán le wǒ hěn nán guò bù zhī dào zěn me bàn",
      "english": "There were so many people in the flower shop! I asked the shop owner, “Boss, how much are carnations?”"
    },
    {
      "index": 9,
      "simplified": "这时老板看看我，给了我两支画笔和一张纸，说：",
      "traditional": "這時老闆看看我，給了我兩支畫筆和一張紙，說：",
      "pinyin": "zhè shí lǎo bǎn kàn kan wǒ gěi le wǒ liǎng zhī huà bǐ hé yì zhāng zhǐ shuō",
      "english": "The shop owner said: “I’m sorry, child. We have sold out of carnations.” I was very sad and didn’t know what to do."
    },
    {
      "index": 10,
      "simplified": "“你可以给妈妈画康乃馨，她也会很高兴的。”",
      "traditional": "“你可以給媽媽畫康乃馨，她也會很高興的。”",
      "pinyin": "nǐ kě yǐ gěi mā ma huà kāng nǎi xīn tā yě huì hěn gāo xìng de",
      "english": "At that time, the shop owner looked at me, gave me two paintbrushes and a piece of paper, and said, .."
    },
    {
      "index": 11,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ".. “You can paint carnations for your mom. She will also be very happy.”"
    },
    {
      "index": 12,
      "simplified": "回家以后，我给妈妈看了我的画，妈妈真的很高兴！",
      "traditional": "回家以後，我給媽媽看了我的畫，媽媽真的很高興！",
      "pinyin": "huí jiā yǐ hòu wǒ gěi mā ma kàn le wǒ de huà mā ma zhēn de hěn gāo xìng",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "她抱着我，说：“谢谢你，这是最好的礼物。”我希望妈妈每天都能这么高兴。",
      "traditional": "她抱著我，說：“謝謝你，這是最好的禮物。”我希望媽媽每天都能這麼高興。",
      "pinyin": "tā bào zhe wǒ shuō xiè xie nǐ zhè shì zuì hǎo de lǐ wù wǒ xī wàng mā ma měi tiān dōu néng zhè me gāo xìng",
      "english": "After I got home, I showed Mom my painting. Mom really was very happy!"
    }
