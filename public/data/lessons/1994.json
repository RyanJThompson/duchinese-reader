    "sentence_translations": [
      "The Kitten Is Sleeping",
      "",
      "Anne: Gao Tian! What are you doing right now?",
      "",
      "Gao Tian: I am looking at the kitten. The kitten is sleeping.",
      "",
      "Anne: Where is the kitten?",
      "",
      "Gao Tian: The kitten is under the chair. Did you see it?",
      "",
      "Anne: I saw it. The kitten is sleeping under the chair.",
      "",
      "Gao Tian: I like kittens. What about you?",
      "",
      "Anne: I don’t like kittens. I like puppies.",
      "",
      "Gao Tian: Who is that person in front of the restaurant? He’s looking at you.",
      "",
      "Anne: That’s Li. He’s also looking at you. Look, he’s coming over.",
      "",
      "Anne: Li, this is my classmate Gao Tian.",
      "",
      "Li: Hello, Gao Tian. Nice to meet you.",
      "",
      "Gao Tian: Hello, Li. It’s also nice to meet you.",
      "",
      "Anne: Gao Tian, have you eaten yet?",
      "",
      "Gao Tian: No, how about you?",
      "",
      "Anne: Li and I haven’t eaten yet either. How about we go to the restaurant to eat together?",
      "",
      "Gao Tian: Sure. Li, do you like kittens?",
      "",
      "Li: I don’t like kittens. I like puppies."
    ]
  }
