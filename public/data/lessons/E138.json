  "id": "E138",
  "title": "Playing Badminton",
  "level": "upper intermediate",
  "date": "2017-08-04",
  "synopsis": "Annie learns there are consequences to being healthy and doing athletic activities.",
  "audioUrl": "https://static.duchinese.net/documents/495/8f5404dad8b539903a37f9b66bc29cec330d0577.mp3?1500800487",
