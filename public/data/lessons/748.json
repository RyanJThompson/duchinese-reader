{
  "id": "748",
  "title": "Don’t Know What to Do With You",
  "level": "newbie",
  "date": "2019-06-20",
  "synopsis": "Lili and Little He are talking about how much food to get.",
  "audioUrl": "https://static.duchinese.net/documents/1075/78cec331396a2341f1795a3fde406a918dd69cc6.mp3?1560417368",
  "series": null,
  "fullText": {
    "simplified": "真拿你没办法\n\n丽丽：我想吃这个、这个、这个和这个……\n小何：那么多个菜，我们两个人吃得完吗？\n丽丽：这些都是我爱吃的菜，我都想吃嘛，好不好嘛？\n小何：真拿你没办法。好！我们都要。",
    "traditional": "真拿你沒辦法\n\n麗麗：我想吃這個、這個、這個和這個……\n小何：那麼多個菜，我們兩個人吃得完嗎？\n麗麗：這些都是我愛吃的菜，我都想吃嘛，好不好嘛？\n小何：真拿你沒辦法。好！我們都要。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Really Don’t Know What to Do With You"
    },
    {
      "index": 2,
      "simplified": "丽丽：我想吃这个、这个、这个和这个……",
      "traditional": "麗麗：我想吃這個、這個、這個和這個……",
      "pinyin": "lì lì wǒ xiǎng chī zhèi ge zhèi ge zhèi ge hé zhèi ge",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I want to eat this one, this one, this one and this one…"
    },
    {
      "index": 4,
      "simplified": "小何：那么多个菜，我们两个人吃得完吗？",
      "traditional": "小何：那麼多個菜，我們兩個人吃得完嗎？",
      "pinyin": "xiǎo hé nà me duō ge cài wǒ men liǎng ge rén chī de wán ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: That many dishes, can the two of us eat it all?"
    },
    {
      "index": 6,
      "simplified": "丽丽：这些都是我爱吃的菜，我都想吃嘛，好不好嘛？",
      "traditional": "麗麗：這些都是我愛吃的菜，我都想吃嘛，好不好嘛？",
      "pinyin": "lì lì zhè xiē dōu shì wǒ ài chī de cài wǒ dōu xiǎng chī ma hǎo bù hǎo ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: All of these are dishes I love to eat. I want to eat all of them if that’s OK?"
    },
    {
      "index": 8,
      "simplified": "小何：真拿你没办法。好！我们都要。",
      "traditional": "小何：真拿你沒辦法。好！我們都要。",
      "pinyin": "xiǎo hé zhēn ná nǐ méi bàn fǎ hǎo wǒ men dōu yào",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: I really don’t know what to do with you. OK! We’ll get all of them."
    }
  ],
