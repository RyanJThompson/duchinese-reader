    },
    {
      "index": 3,
      "simplified": "黄色博美，耳朵黑色，喊它名字它会看你。",
      "traditional": "黃色博美，耳朵黑色，喊它名字它會看你。",
      "pinyin": "huáng sè bó měi ěr duo hēi sè hǎn tā míng zi tā huì kàn nǐ",
      "english": "Jack, female, 3 years old."
    },
    {
      "index": 4,
      "simplified": "于2018年8月31日晚9点左右在南湖公园附近走失。",
      "traditional": "於2018年8月31日晚9點左右在南湖公園附近走失。",
      "pinyin": "yú 4 nián 1 yuè 3 rì wǎn 1 diǎn zuǒ yòu zài nán hú gōng yuán fù jìn zǒu shī",
      "english": "Yellow Pomeranian, black ears. Will look at you if you call her name."
    },
    {
      "index": 5,
      "simplified": "希望好心人帮忙留意。",
      "traditional": "希望好心人幫忙留意。",
      "pinyin": "xī wàng hǎo xīn rén bāng máng liú yì",
      "english": "Lost on 2018-08-31 around 9 p.m. in the Hunan Park area."
    },
    {
      "index": 6,
      "simplified": "能帮助将狗找回者，失主将不胜感激，必有重谢！",
      "traditional": "能幫助將狗找回者，失主將不勝感激，必有重謝！",
      "pinyin": "néng bāng zhù jiāng gǒu zhǎo huí zhě shī zhǔ jiāng bú shèng gǎn jī bì yǒu zhòng xiè",
      "english": "Wish for someone kind to help keep this in mind."
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "If you can help retrieve the dog, the owner will be deeply appreciative and grateful!"
    },
