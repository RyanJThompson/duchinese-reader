{
  "id": "699",
  "title": "Miss…",
  "level": "newbie",
  "date": "2019-04-04",
  "synopsis": "Ben learns to be careful about calling girls “xiao jie” in China.",
  "audioUrl": "https://static.duchinese.net/documents/1010/0bbbd6078e7aceb274e43e422654f447e8b72d25.mp3?1698349926",
  "series": null,
  "fullText": {
    "simplified": "小姐……\n\n本：小姐，请问图书馆怎么走？\n女孩：你叫我什么？哼！\n本：她怎么了？为什么不高兴？\n丽丽：你叫她“小姐”，她不高兴了。\n本：不能叫“小姐”吗？\n丽丽：不太好。你可以叫她“同学”、“美女”……",
    "traditional": "小姐……\n\n本：小姐，請問圖書館怎麼走？\n女孩：你叫我什麼？哼！\n本：她怎麼了？為什麼不高興？\n麗麗：你叫她“小姐”，她不高興了。\n本：不能叫“小姐”嗎？\n麗麗：不太好。你可以叫她“同學”、“美女”……"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Miss…"
    },
    {
      "index": 2,
      "simplified": "本：小姐，请问图书馆怎么走？",
      "traditional": "本：小姐，請問圖書館怎麼走？",
      "pinyin": "běn xiǎo jiě qǐng wèn tú shū guǎn zěn me zǒu",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Miss, may I ask how to get to the library?"
    },
    {
      "index": 4,
      "simplified": "女孩：你叫我什么？哼！",
      "traditional": "女孩：你叫我什麼？哼！",
      "pinyin": "nǚ hái nǐ jiào wǒ shén me hēng",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Girl: What did you call me? Hmph!"
    },
    {
      "index": 6,
      "simplified": "本：她怎么了？为什么不高兴？",
      "traditional": "本：她怎麼了？為什麼不高興？",
      "pinyin": "běn tā zěn me le wèi shén me bù gāo xìng",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: What’s up with her? Why is she so unhappy?"
    },
    {
      "index": 8,
      "simplified": "丽丽：你叫她“小姐”，她不高兴了。",
      "traditional": "麗麗：你叫她“小姐”，她不高興了。",
      "pinyin": "lì lì nǐ jiào tā xiǎo jiě tā bù gāo xìng le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: You called her “miss”, that’s why she’s unhappy."
    },
    {
      "index": 10,
      "simplified": "本：不能叫“小姐”吗？",
      "traditional": "本：不能叫“小姐”嗎？",
      "pinyin": "běn bù néng jiào xiǎo jiě ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I can’t say “miss”?"
    },
    {
      "index": 12,
      "simplified": "丽丽：不太好。你可以叫她“同学”、“美女”……",
      "traditional": "麗麗：不太好。你可以叫她“同學”、“美女”……",
      "pinyin": "lì lì bú tài hǎo nǐ kě yǐ jiào tā tóng xué měi nǚ",
      "english": ""
    }
  ],
