    },
    {
      "index": 2,
      "simplified": "小明非常喜欢看姚明打篮球。",
      "traditional": "小明非常喜歡看姚明打籃球。",
      "pinyin": "xiǎo míng fēi cháng xǐ huan kàn yáo míng dǎ lán qiú",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "今天上午有姚明的球迷见面会，",
      "traditional": "今天上午有姚明的球迷見面會，",
      "pinyin": "jīn tiān shàng wǔ yǒu yáo míng de qiú mí jiàn miàn huì",
      "english": "Little Ming really likes watching Yao Ming playing basketball."
    },
    {
      "index": 4,
      "simplified": "小明非常想去，但见面会是上课的时间。",
      "traditional": "小明非常想去，但見面會是上課的時間。",
      "pinyin": "xiǎo míng fēi cháng xiǎng qù dàn jiàn miàn huì shì shàng kè de shí jiān",
      "english": "This morning, it is Yao Ming’s fan meet-and-greet."
    },
    {
      "index": 5,
      "simplified": "为了见到姚明，他想请假，不去上课了。",
      "traditional": "為了見到姚明，他想請假，不去上課了。",
      "pinyin": "wèi le jiàn dào yáo míng tā xiǎng qǐng jià bú qù shàng kè le",
      "english": "Little Ming really wants to go, but the meet-and-greet is during class time."
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "In order to be able to see Yao Ming, he wants to request leave of absence and not go to class."
    },
    {
      "index": 7,
      "simplified": "小明想了想，给老师打了个电话，说：",
      "traditional": "小明想了想，給老師打了個電話，說：",
      "pinyin": "xiǎo míng xiǎng le xiǎng gěi lǎo shī dǎ le ge diàn huà shuō",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "“老师，您好！小明今天生病了，不能去上课。”",
      "traditional": "“老師，您好！小明今天生病了，不能去上課。”",
