{
  "id": "1134",
  "title": "Can Money Buy Everything?",
  "level": "newbie",
  "date": "2020-11-17",
  "synopsis": "To a wealthy father, money can buy everything. But the son thinks otherwise …",
  "audioUrl": "https://static.duchinese.net/documents/1134/08abbf328f05782c6bb4ac8faebdf201d07dcc97.mp3?1600007139",
