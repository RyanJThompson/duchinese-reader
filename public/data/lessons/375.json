{
  "id": "375",
  "title": "Do You Like Chinese Songs?",
  "level": "newbie",
  "date": "2017-09-16",
  "synopsis": "Ben and Lili discuss Chinese songs.",
  "audioUrl": "https://static.duchinese.net/documents/524/2dea5908056ee349352383ae62c144dd9fec0e65.mp3?1589791807",
  "series": {
    "title": "Ben’s life in China 4: Trouble in Paradise",
    "chapter": 0,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你喜欢听中文歌吗？\n\n丽丽：本，你喜欢听中文歌吗？\n本：喜欢。\n丽丽：你喜欢听谁的歌？\n本：五月天的。\n丽丽：啊，我也喜欢他们。你最喜欢他们的什么歌？\n本：《突然好想你》。",
    "traditional": "你喜歡聽中文歌嗎？\n\n麗麗：本，你喜歡聽中文歌嗎？\n本：喜歡。\n麗麗：你喜歡聽誰的歌？\n本：五月天的。\n麗麗：啊，我也喜歡他們。你最喜歡他們的什麼歌？\n本：《突然好想你》。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Do you like to listen to Chinese songs?"
    },
    {
      "index": 2,
      "simplified": "丽丽：本，你喜欢听中文歌吗？",
      "traditional": "麗麗：本，你喜歡聽中文歌嗎？",
      "pinyin": "lì lì běn nǐ xǐ huan tīng zhōng wén gē ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Ben, do you like to listen to Chinese songs?"
    },
    {
      "index": 4,
      "simplified": "本：喜欢。",
      "traditional": "本：喜歡。",
      "pinyin": "běn xǐ huan",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Yes, I like to."
    },
    {
      "index": 6,
      "simplified": "丽丽：你喜欢听谁的歌？",
      "traditional": "麗麗：你喜歡聽誰的歌？",
      "pinyin": "lì lì nǐ xǐ huan tīng shéi de gē",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Whose songs do you like to listen to?"
    },
    {
      "index": 8,
      "simplified": "本：五月天的。",
      "traditional": "本：五月天的。",
      "pinyin": "běn wǔ yuè tiān de",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Mayday's."
    },
    {
      "index": 10,
      "simplified": "丽丽：啊，我也喜欢他们。你最喜欢他们的什么歌？",
      "traditional": "麗麗：啊，我也喜歡他們。你最喜歡他們的什麼歌？",
      "pinyin": "lì lì a wǒ yě xǐ huan tā men nǐ zuì xǐ huan tā men de shén me gē",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Ah, I also like them. Which of their songs do you like the most?"
    },
    {
      "index": 12,
      "simplified": "本：《突然好想你》。",
      "traditional": "本：《突然好想你》。",
      "pinyin": "běn tū rán hǎo xiǎng nǐ",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: “Suddenly missing you so bad”."
    }
  ],
