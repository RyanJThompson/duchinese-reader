{
  "id": "E401",
  "title": "Beautiful Bestie",
  "level": "intermediate",
  "date": "2020-02-05",
  "synopsis": "Lili is not happy about yesterday, and Ben is making everything even worse.",
  "audioUrl": "https://static.duchinese.net/documents/50401/bffe9efb172c497196db849d3d524e5e421ad089.mp3?1580462932",
  "series": null,
  "fullText": {
    "simplified": "我的漂亮闺蜜\n\n丽丽：气死我了！\n本：你怎么了？\n丽丽：昨天跟我闺蜜去吃饭，服务员居然以为我是她妈！\n本：有照片吗？\n丽丽：你看！\n本：哇，你的闺蜜又年轻又漂亮！可以介绍给我吗？\n丽丽：你想得美！\n",
    "traditional": "我的漂亮閨蜜\n\n麗麗：氣死我了！\n本：你怎麼了？\n麗麗：昨天跟我閨蜜去吃飯，服務員居然以為我是她媽！\n本：有照片嗎？\n麗麗：你看！\n本：哇，你的閨蜜又年輕又漂亮！可以介紹給我嗎？\n麗麗：你想得美！\n"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "My Beautiful Bestie"
    },
    {
      "index": 2,
      "simplified": "丽丽：气死我了！",
      "traditional": "麗麗：氣死我了！",
      "pinyin": "lì lì qì sǐ wǒ le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I’m so angry!"
    },
    {
      "index": 4,
      "simplified": "本：你怎么了？",
      "traditional": "本：你怎麼了？",
      "pinyin": "běn nǐ zěn me le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: What happened to you?"
    },
    {
      "index": 6,
      "simplified": "丽丽：昨天跟我闺蜜去吃饭，服务员居然以为我是她妈！",
      "traditional": "麗麗：昨天跟我閨蜜去吃飯，服務員居然以為我是她媽！",
      "pinyin": "lì lì zuó tiān gēn wǒ guī mì qù chī fàn fú wù yuán jū rán yǐ wéi wǒ shì tā mā",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I went to dinner with my bestie yesterday, and the waiter thought that I was her mother!"
    },
    {
      "index": 8,
      "simplified": "本：有照片吗？",
      "traditional": "本：有照片嗎？",
      "pinyin": "běn yǒu zhào piàn ma",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Do you have a photo?"
    },
    {
      "index": 10,
      "simplified": "丽丽：你看！",
      "traditional": "麗麗：你看！",
      "pinyin": "lì lì nǐ kàn",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Look!"
    },
    {
      "index": 12,
      "simplified": "本：哇，你的闺蜜又年轻又漂亮！可以介绍给我吗？",
      "traditional": "本：哇，你的閨蜜又年輕又漂亮！可以介紹給我嗎？",
      "pinyin": "běn wā nǐ de guī mì yòu nián qīng yòu piào liang kě yǐ jiè shào gěi wǒ ma",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Wow, your bestie is young and beautiful! Can you introduce her to me?"
    },
    {
      "index": 14,
      "simplified": "丽丽：你想得美！",
      "traditional": "麗麗：你想得美！",
      "pinyin": "lì lì nǐ xiǎng dé měi",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: You wish!"
    }
  ],
