{
  "id": "E116",
  "title": "Don't Run After Two Horses",
  "level": "intermediate",
  "date": "2017-05-21",
  "synopsis": "Many people can not do two things at the same time, unless it is something they enjoy.",
  "audioUrl": "https://static.duchinese.net/documents/424/662d4c61aaec981ca7f1544a451480de9cddc348.mp3?1494870441",
  "series": null,
  "fullText": {
    "simplified": "一心不能二用\n\n妈妈：小明，你在做什么？\n小明：我在看电视。\n妈妈：你能帮我削一下土豆皮吗？\n小明：我在看电视，没有时间啊。\n妈妈：你可以一边看电视一边削。\n小明：不行，老师说“一心不能二用”。\n妈妈：你常常一边看电视一边吃零食。\n小明：那不算，吃零食不用眼睛。\n妈妈：你还常常一边看电视一边写作业！\n小明：好吧好吧，我帮你削。",
    "traditional": "一心不能二用\n\n媽媽：小明，你在做什麼？\n小明：我在看電視。\n媽媽：你能幫我削一下土豆皮嗎？\n小明：我在看電視，沒有時間啊。\n媽媽：你可以一邊看電視一邊削。\n小明：不行，老師說“一心不能二用”。\n媽媽：你常常一邊看電視一邊吃零食。\n小明：那不算，吃零食不用眼睛。\n媽媽：你還常常一邊看電視一邊寫作業！\n小明：好吧好吧，我幫你削。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "One cannot run after two horses"
    },
    {
      "index": 2,
      "simplified": "妈妈：小明，你在做什么？",
      "traditional": "媽媽：小明，你在做什麼？",
      "pinyin": "mā ma xiǎo míng nǐ zài zuò shén me",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Little Ming, what are you doing now?"
    },
    {
      "index": 4,
      "simplified": "小明：我在看电视。",
      "traditional": "小明：我在看電視。",
      "pinyin": "xiǎo míng wǒ zài kàn diàn shì",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I’m watching TV."
    },
    {
      "index": 6,
      "simplified": "妈妈：你能帮我削一下土豆皮吗？",
      "traditional": "媽媽：你能幫我削一下土豆皮嗎？",
      "pinyin": "mā ma nǐ néng bāng wǒ xiāo yí xià tǔ dòu pí ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Could you help me peel the potatoes?"
    },
    {
      "index": 8,
      "simplified": "小明：我在看电视，没有时间啊。",
      "traditional": "小明：我在看電視，沒有時間啊。",
      "pinyin": "xiǎo míng wǒ zài kàn diàn shì méi yǒu shí jiān a",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I’m watching TV. I don’t have time."
    },
    {
      "index": 10,
      "simplified": "妈妈：你可以一边看电视一边削。",
      "traditional": "媽媽：你可以一邊看電視一邊削。",
      "pinyin": "mā ma nǐ kě yǐ yì biān kàn diàn shì yì biān xiāo",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: You can peel potatoes while watching TV."
    },
    {
      "index": 12,
      "simplified": "小明：不行，老师说“一心不能二用”。",
      "traditional": "小明：不行，老師說“一心不能二用”。",
      "pinyin": "xiǎo míng bù xíng lǎo shī shuō yì xīn bù néng èr yòng",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: No, my teacher said, “one cannot run after two horses.”"
    },
    {
      "index": 14,
      "simplified": "妈妈：你常常一边看电视一边吃零食。",
      "traditional": "媽媽：你常常一邊看電視一邊吃零食。",
      "pinyin": "mā ma nǐ cháng cháng yì biān kàn diàn shì yì biān chī líng shí",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: You often eat snacks while watching TV."
    },
    {
      "index": 16,
      "simplified": "小明：那不算，吃零食不用眼睛。",
      "traditional": "小明：那不算，吃零食不用眼睛。",
      "pinyin": "xiǎo míng nà bú suàn chī líng shí bú yòng yǎn jing",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: It doesn’t count. I don’t need my eyes to eat snacks."
    },
    {
      "index": 18,
      "simplified": "妈妈：你还常常一边看电视一边写作业！",
      "traditional": "媽媽：你還常常一邊看電視一邊寫作業！",
      "pinyin": "mā ma nǐ hái cháng cháng yì biān kàn diàn shì yì biān xiě zuò yè",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: You often do your homework while watching TV."
    },
    {
      "index": 20,
      "simplified": "小明：好吧好吧，我帮你削。",
      "traditional": "小明：好吧好吧，我幫你削。",
      "pinyin": "xiǎo míng hǎo ba hǎo ba wǒ bāng nǐ xiāo",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Ming: Fine, I’ll peel the potatoes for you."
    }
