    "sentence_translations": [
      "See You In 20 Minutes",
      "",
      "Gao Tian: Anne, what are you doing?",
      "",
      "Anne: I am studying. I am watching Chinese movies.",
      "",
      "Gao Tian: Are you watching the movies at the movie theater?",
      "",
      "Anne: No, I am watching the Chinese movies on my computer. My computer has a lot of Chinese movies.",
      "",
      "Gao Tian: What time are you coming to school today?",
      "",
      "Anne: Today is Sunday. I am not going to school.",
      "",
      "Gao Tian: I’m at school playing basketball. Will you come and watch?",
      "",
      "Anne: Is Li Xiaobei there? Is he playing basketball with you?",
      "",
      "Gao Tian: He’s here. Are you coming?",
      "",
      "Anne: I’ll go now. See you in 10 minutes!",
      "",
      "Gao Tian: We don’t have any water. Can you buy some water?",
      "",
      "Anne: Okay, I’ll buy water.",
      "",
      "Gao Tian: Thank you! Today is Sunday. There are many people in the store. See you in 20 minutes.",
      "",
      "Anne: Don’t mention it! See you in 20 minutes!"
    ]
  }
