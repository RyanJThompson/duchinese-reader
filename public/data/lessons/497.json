    },
    {
      "index": 2,
      "simplified": "今天是情人节。",
      "traditional": "今天是情人節。",
      "pinyin": "jīn tiān shì qíng rén jié",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "丽丽说，她的男朋友小何送了花和巧克力给她。",
      "traditional": "麗麗說，她的男朋友小何送了花和巧克力給她。",
      "pinyin": "lì lì shuō tā de nán péng you xiǎo hé sòng le huā hé qiǎo kè lì gěi tā",
      "english": "Today is Valentine’s day."
    },
    {
      "index": 4,
      "simplified": "因为我没有女朋友，所以我不用送礼物。",
      "traditional": "因為我沒有女朋友，所以我不用送禮物。",
      "pinyin": "yīn wèi wǒ méi yǒu nǚ péng you suǒ yǐ wǒ bú yòng sòng lǐ wù",
      "english": "Lili said her boyfriend Xiao He gave her flowers and chocolate."
    },
    {
      "index": 5,
      "simplified": "但是，我收到了一个礼物，是小雨送给我的巧克力。",
      "traditional": "但是，我收到了一個禮物，是小雨送給我的巧克力。",
      "pinyin": "dàn shì wǒ shōu dào le yí ge lǐ wù shì xiǎo yǔ sòng gěi wǒ de qiǎo kè lì",
      "english": "Since I don’t have a girlfriend, I don’t have to give any presents."
    },
    {
      "index": 6,
      "simplified": "小雨不是我的女朋友，她为什么给我巧克力？",
      "traditional": "小雨不是我的女朋友，她為什麼給我巧克力？",
      "pinyin": "xiǎo yǔ bú shì wǒ de nǚ péng you tā wèi shén me gěi wǒ qiǎo kè lì",
      "english": "However, I received a present. It was Little Yu who sent me chocolate."
    },
    {
      "index": 7,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu is not my girlfriend, how come she’s sending me chocolate?"
    }
