{
  "id": "E279",
  "title": "I Came By Plane",
  "level": "newbie",
  "date": "2018-12-06",
  "synopsis": "Here’s how you can start a conversation when meeting a business partner for the first time.",
  "audioUrl": "https://static.duchinese.net/documents/918/0a2e8c4f2587e9d62e5a9e07a8acfa5dd77bb3e1.mp3?1543807882",
  "series": null,
  "fullText": {
    "simplified": "我是坐飞机来的\n\n王总：你好，李总。欢迎来上海！\n李总：你好，王总。很高兴认识你！\n王总：我也很高兴认识你！你是坐飞机来的吗？路上怎么样？\n李总：对，我是坐飞机来的，很顺利。",
    "traditional": "我是坐飛機來的\n\n王總：你好，李總。歡迎來上海！\n李總：你好，王總。很高興認識你！\n王總：我也很高興認識你！你是坐飛機來的嗎？路上怎麼樣？\n李總：對，我是坐飛機來的，很順利。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Came Here By Plane"
    },
    {
      "index": 2,
      "simplified": "王总：你好，李总。欢迎来上海！",
      "traditional": "王總：你好，李總。歡迎來上海！",
      "pinyin": "wáng zǒng nǐ hǎo lǐ zǒng huān yíng lái shàng hǎi",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: Hello, manager Li. Welcome to Shanghai!"
    },
    {
      "index": 4,
      "simplified": "李总：你好，王总。很高兴认识你！",
      "traditional": "李總：你好，王總。很高興認識你！",
      "pinyin": "lǐ zǒng nǐ hǎo wáng zǒng hěn gāo xìng rèn shi nǐ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Li: Hello, manager Wang. Nice to meet you!"
    },
    {
      "index": 6,
      "simplified": "王总：我也很高兴认识你！你是坐飞机来的吗？路上怎么样？",
      "traditional": "王總：我也很高興認識你！你是坐飛機來的嗎？路上怎麼樣？",
      "pinyin": "wáng zǒng wǒ yě hěn gāo xìng rèn shi nǐ nǐ shì zuò fēi jī lái de ma lù shang zěn me yàng",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: Nice to meet you too! Did you come here by plane? How was the trip?"
    },
    {
      "index": 8,
      "simplified": "李总：对，我是坐飞机来的，很顺利。",
      "traditional": "李總：對，我是坐飛機來的，很順利。",
      "pinyin": "lǐ zǒng duì wǒ shì zuò fēi jī lái de hěn shùn lì",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Manager Li: Yes, I came here by plane. Everything went well."
    }
  ],
