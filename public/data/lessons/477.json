  "title": "Trying on Clothes",
  "level": "intermediate",
  "date": "2018-04-15",
  "synopsis": "Lili and Little He are out window-shopping for clothes.",
  "audioUrl": "https://static.duchinese.net/documents/659/0034b391b7f6bb68f1bb0a298a9c29c0237b25a0.mp3?1517821359",
