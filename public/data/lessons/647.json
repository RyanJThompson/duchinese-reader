{
  "id": "647",
  "title": "Who is Taller",
  "level": "elementary",
  "date": "2019-01-13",
  "synopsis": "Ben asks a bunch of questions comparing Little Yu and Lili.",
  "audioUrl": "https://static.duchinese.net/documents/937/f324ea0b90bef2db8debc5394ad76ae5dd8a4af3.mp3?1634201916",
  "series": {
    "title": "Ben’s life in China 5: You’re my best friend",
    "chapter": 22,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "丽丽比我高\n\n本：你和丽丽谁高？\n小雨：丽丽比我高。\n本：你和丽丽谁跑得快？\n小雨：丽丽比我跑得快。\n本：你和丽丽谁吃得多？\n小雨：我。你问这些干什么？\n本：没什么。我在练习说中文。",
    "traditional": "麗麗比我高\n\n本：你和麗麗誰高？\n小雨：麗麗比我高。\n本：你和麗麗誰跑得快？\n小雨：麗麗比我跑得快。\n本：你和麗麗誰吃得多？\n小雨：我。你問這些幹什麼？\n本：沒什麼。我在練習說中文。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Lili is taller than me"
    },
    {
      "index": 2,
      "simplified": "本：你和丽丽谁高？",
      "traditional": "本：你和麗麗誰高？",
      "pinyin": "běn nǐ hé lì lì shéi gāo",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Who is taller, you or Lili?"
    },
    {
      "index": 4,
      "simplified": "小雨：丽丽比我高。",
      "traditional": "小雨：麗麗比我高。",
      "pinyin": "xiǎo yǔ lì lì bǐ wǒ gāo",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Lili is taller than me."
    },
    {
      "index": 6,
      "simplified": "本：你和丽丽谁跑得快？",
      "traditional": "本：你和麗麗誰跑得快？",
      "pinyin": "běn nǐ hé lì lì shéi pǎo de kuài",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Who runs faster, you or Lili?"
    },
    {
      "index": 8,
      "simplified": "小雨：丽丽比我跑得快。",
      "traditional": "小雨：麗麗比我跑得快。",
      "pinyin": "xiǎo yǔ lì lì bǐ wǒ pǎo de kuài",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Lili runs faster than me."
    },
    {
      "index": 10,
      "simplified": "本：你和丽丽谁吃得多？",
      "traditional": "本：你和麗麗誰吃得多？",
      "pinyin": "běn nǐ hé lì lì shéi chī de duō",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Who eats more, you or Lili?"
    },
    {
      "index": 12,
      "simplified": "小雨：我。你问这些干什么？",
      "traditional": "小雨：我。你問這些幹什麼？",
      "pinyin": "xiǎo yǔ wǒ nǐ wèn zhè xiē gàn shén me",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: I do. Why are you asking these questions?"
    },
    {
      "index": 14,
      "simplified": "本：没什么。我在练习说中文。",
      "traditional": "本：沒什麼。我在練習說中文。",
      "pinyin": "běn méi shén me wǒ zài liàn xí shuō zhōng wén",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: No reason. I’m practicing speaking Chinese."
    }
  ],
