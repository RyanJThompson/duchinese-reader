{
  "id": "587",
  "title": "Depend on Friends",
  "level": "intermediate",
  "date": "2018-10-07",
  "synopsis": "Little Yu offers to help Ben when he’s in need.",
  "audioUrl": "https://static.duchinese.net/documents/853/4e65dcdb08a56f3afa9013f374c9ee18b048d2d7.mp3?1698350725",
  "series": null,
  "fullText": {
    "simplified": "出门靠朋友\n\n小雨：本，你怎么了？\n本：我的钱包不见了！\n小雨：在哪儿不见的？\n本：刚才我去打球，回来钱包就不见了。\n小雨：里面有很多钱吗？\n本：嗯，这个月我没有钱吃饭了。\n小雨：别急。我借你一点钱吧。\n本：真的吗？太谢谢你了！\n小雨：别客气。在家靠父母，出门靠朋友嘛。",
    "traditional": "出門靠朋友\n\n小雨：本，你怎麼了？\n本：我的錢包不見了！\n小雨：在哪兒不見的？\n本：剛才我去打球，回來錢包就不見了。\n小雨：裡面有很多錢嗎？\n本：嗯，這個月我沒有錢吃飯了。\n小雨：別急。我借你一點錢吧。\n本：真的嗎？太謝謝你了！\n小雨：別客氣。在家靠父母，出門靠朋友嘛。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Outside We Depend On Our Friends"
    },
    {
      "index": 2,
      "simplified": "小雨：本，你怎么了？",
      "traditional": "小雨：本，你怎麼了？",
      "pinyin": "xiǎo yǔ běn nǐ zěn me le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Ben, what’s wrong?"
    },
    {
      "index": 4,
      "simplified": "本：我的钱包不见了！",
      "traditional": "本：我的錢包不見了！",
      "pinyin": "běn wǒ de qián bāo bú jiàn le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I lost my wallet!"
    },
    {
      "index": 6,
      "simplified": "小雨：在哪儿不见的？",
      "traditional": "小雨：在哪兒不見的？",
      "pinyin": "xiǎo yǔ zài nǎ'r bú jiàn de",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Where did you lose it?"
    },
    {
      "index": 8,
      "simplified": "本：刚才我去打球，回来钱包就不见了。",
      "traditional": "本：剛才我去打球，回來錢包就不見了。",
      "pinyin": "běn gāng cái wǒ qù dǎ qiú huí lái qián bāo jiù bú jiàn le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I went to play some ball just now, and when I came back my wallet was gone."
    },
    {
      "index": 10,
      "simplified": "小雨：里面有很多钱吗？",
      "traditional": "小雨：裡面有很多錢嗎？",
      "pinyin": "xiǎo yǔ lǐ miàn yǒu hěn duō qián ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Was there a lot of money inside?"
    },
    {
      "index": 12,
      "simplified": "本：嗯，这个月我没有钱吃饭了。",
      "traditional": "本：嗯，這個月我沒有錢吃飯了。",
      "pinyin": "běn èn zhè ge yuè wǒ méi yǒu qián chī fàn le",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Mm, I no longer have money to eat this month."
    },
    {
      "index": 14,
      "simplified": "小雨：别急。我借你一点钱吧。",
      "traditional": "小雨：別急。我借你一點錢吧。",
      "pinyin": "xiǎo yǔ bié jí wǒ jiè nǐ yì diǎn qián ba",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Don’t worry. I’ll lend you some money."
    },
    {
      "index": 16,
      "simplified": "本：真的吗？太谢谢你了！",
      "traditional": "本：真的嗎？太謝謝你了！",
      "pinyin": "běn zhēn de ma tài xiè xie nǐ le",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Really? Thank you so much!"
    },
    {
      "index": 18,
      "simplified": "小雨：别客气。在家靠父母，出门靠朋友嘛。",
      "traditional": "小雨：別客氣。在家靠父母，出門靠朋友嘛。",
      "pinyin": "xiǎo yǔ bié kè qi zài jiā kào fù mǔ chū mén kào péng you ma",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu: Don’t mention it. At home we depend on our parents, outside we depend on our friends."
    }
  ],
