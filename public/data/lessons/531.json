{
  "id": "531",
  "title": "Guaranteed Sweet Apples",
  "level": "newbie",
  "date": "2018-06-28",
  "synopsis": "Little Ming is out with his mom to buy some apples.",
  "audioUrl": "https://static.duchinese.net/documents/756/f4fa208a442f03adccb2fe39f9f890c9ffa6c0dd.mp3?1527744199",
  "series": null,
  "fullText": {
    "simplified": "不甜不要钱\n\n小明和妈妈去买苹果。\n妈妈问卖水果的人：“这个苹果甜不甜呀？”\n卖苹果的人说：“很甜。不甜不要钱。”\n小明问：“那我能不能买一斤不甜的苹果？”",
    "traditional": "不甜不要錢\n\n小明和媽媽去買蘋果。\n媽媽問賣水果的人：“這個蘋果甜不甜呀？”\n賣蘋果的人說：“很甜。不甜不要錢。”\n小明問：“那我能不能買一斤不甜的蘋果？”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "If they’re not sweet you don’t need to pay"
    },
    {
      "index": 2,
      "simplified": "小明和妈妈去买苹果。",
      "traditional": "小明和媽媽去買蘋果。",
      "pinyin": "xiǎo míng hé mā ma qù mǎi píng guǒ",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming and his mom went to buy apples."
    },
    {
      "index": 4,
      "simplified": "妈妈问卖水果的人：“这个苹果甜不甜呀？”",
      "traditional": "媽媽問賣水果的人：“這個蘋果甜不甜呀？”",
      "pinyin": "mā ma wèn mài shuǐ guǒ de rén zhè ge píng guǒ tián bù tián ya",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom asked the apple seller: “Are these apples sweet?”"
    },
    {
      "index": 6,
      "simplified": "卖苹果的人说：“很甜。不甜不要钱。”",
      "traditional": "賣蘋果的人說：“很甜。不甜不要錢。”",
      "pinyin": "mài píng guǒ de rén shuō hěn tián bù tián bú yào qián",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "The apple seller said: “Very sweet. If they’re not sweet you don’t need to pay.”"
    },
    {
      "index": 8,
      "simplified": "小明问：“那我能不能买一斤不甜的苹果？”",
      "traditional": "小明問：“那我能不能買一斤不甜的蘋果？”",
      "pinyin": "xiǎo míng wèn nà wǒ néng bù néng mǎi yì jīn bù tián de píng guǒ",
      "english": ""
    }
  ],
