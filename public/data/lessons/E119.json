      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Working as a kid"
    },
    {
      "index": 2,
      "simplified": "早上，妈妈要送小宝去幼儿园。",
      "traditional": "早上，媽媽要送小寶去幼兒園。",
      "pinyin": "zǎo shang mā ma yào sòng xiǎo bǎo qù yòu ér yuán",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "小宝背着小书包出门。",
      "traditional": "小寶背著小書包出門。",
      "pinyin": "xiǎo bǎo bēi zhe xiǎo shū bāo chū mén",
      "english": "In the morning, the mother was planning to take Xiao Bao to kindergarten."
    },
    {
      "index": 4,
      "simplified": "奶奶看见了，问他：“小宝，你去干什么呀？”",
      "traditional": "奶奶看見了，問他：“小寶，你去幹什麼呀？”",
      "pinyin": "nǎi nai kàn jiàn le wèn tā xiǎo bǎo nǐ qù gàn shén me ya",
      "english": "Xiao Bao was heading out with his school bag."
    },
    {
      "index": 5,
      "simplified": "小宝说：“我去工作。”",
      "traditional": "小寶說：“我去工作。”",
      "pinyin": "xiǎo bǎo shuō wǒ qù gōng zuò",
      "english": "Grandma saw him and asked: “Xiao Bao, what are you going to do?”"
    },
    {
      "index": 6,
      "simplified": "奶奶又问：“你做什么工作呢？”",
      "traditional": "奶奶又問：“你做什麼工作呢？”",
      "pinyin": "nǎi nai yòu wèn nǐ zuò shén me gōng zuò ne",
      "english": "Xiao Bao said: “I’m going to work.”"
    },
    {
      "index": 7,
      "simplified": "小宝说：“我去做小孩！”",
      "traditional": "小寶說：“我去做小孩！”",
      "pinyin": "xiǎo bǎo shuō wǒ qù zuò xiǎo hái",
      "english": "Grandma asked again: “What kind of work are you going to do?”"
    }
  ],
