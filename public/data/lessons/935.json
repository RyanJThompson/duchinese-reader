{
  "id": "935",
  "title": "My Pretty Mom",
  "level": "newbie",
  "date": "2020-07-15",
  "synopsis": "Little Ming is really good at persuading his mom …",
  "audioUrl": "https://static.duchinese.net/documents/935/ecc254fbd3f45645825f47e3d647b95b33a342b5.mp3?1594636876",
  "series": null,
  "fullText": {
    "simplified": "我的漂亮妈妈\n\n小明：妈妈，可以给我五十块钱吗？\n妈妈：为什么？\n小明：我想和同学去看电影。\n妈妈：不可以，你还没做作业。\n小明：妈妈，你比我的老师还漂亮。\n妈妈：你先做作业，然后去看电影。\n小明：妈妈，你比昨天还漂亮！\n妈妈：好的，你先去看电影，然后做作业。\n小明：妈妈，你比上午还漂亮！\n妈妈：再给你五十块钱，买一杯可乐吧！\n小明：谢谢妈妈，再见！",
    "traditional": "我的漂亮媽媽\n\n小明：媽媽，可以給我五十塊錢嗎？\n媽媽：為什麼？\n小明：我想和同學去看電影。\n媽媽：不可以，你還沒做作業。\n小明：媽媽，你比我的老師還漂亮。\n媽媽：你先做作業，然後去看電影。\n小明：媽媽，你比昨天還漂亮！\n媽媽：好的，你先去看電影，然後做作業。\n小明：媽媽，你比上午還漂亮！\n媽媽：再給你五十塊錢，買一杯可樂吧！\n小明：謝謝媽媽，再見！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "My Pretty Mom"
    },
    {
      "index": 2,
      "simplified": "小明：妈妈，可以给我五十块钱吗？",
      "traditional": "小明：媽媽，可以給我五十塊錢嗎？",
      "pinyin": "xiǎo míng mā ma kě yǐ gěi wǒ wǔ shí kuài qián ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Mom, can you give me 50 yuan?"
    },
    {
      "index": 4,
      "simplified": "妈妈：为什么？",
      "traditional": "媽媽：為什麼？",
      "pinyin": "mā ma wèi shén me",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Why?"
    },
    {
      "index": 6,
      "simplified": "小明：我想和同学去看电影。",
      "traditional": "小明：我想和同學去看電影。",
      "pinyin": "xiǎo míng wǒ xiǎng hé tóng xué qù kàn diàn yǐng",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I want to go to see a movie with a classmate."
    },
    {
      "index": 8,
      "simplified": "妈妈：不可以，你还没做作业。",
      "traditional": "媽媽：不可以，你還沒做作業。",
      "pinyin": "mā ma bù kě yǐ nǐ hái méi zuò zuò yè",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: No, you still haven’t done your homework."
    },
    {
      "index": 10,
      "simplified": "小明：妈妈，你比我的老师还漂亮。",
      "traditional": "小明：媽媽，你比我的老師還漂亮。",
      "pinyin": "xiǎo míng mā ma nǐ bǐ wǒ de lǎo shī hái piào liang",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Mom, you’re even prettier than my teacher."
    },
    {
      "index": 12,
      "simplified": "妈妈：你先做作业，然后去看电影。",
      "traditional": "媽媽：你先做作業，然後去看電影。",
      "pinyin": "mā ma nǐ xiān zuò zuò yè rán hòu qù kàn diàn yǐng",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: You do your homework first, then go see a movie."
    },
    {
      "index": 14,
      "simplified": "小明：妈妈，你比昨天还漂亮！",
      "traditional": "小明：媽媽，你比昨天還漂亮！",
      "pinyin": "xiǎo míng mā ma nǐ bǐ zuó tiān hái piào liang",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Mom, you’re even prettier than yesterday!"
    },
    {
      "index": 16,
      "simplified": "妈妈：好的，你先去看电影，然后做作业。",
      "traditional": "媽媽：好的，你先去看電影，然後做作業。",
      "pinyin": "mā ma hǎo de nǐ xiān qù kàn diàn yǐng rán hòu zuò zuò yè",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Ok, you go see a movie first, then do your homework."
    },
    {
      "index": 18,
      "simplified": "小明：妈妈，你比上午还漂亮！",
      "traditional": "小明：媽媽，你比上午還漂亮！",
      "pinyin": "xiǎo míng mā ma nǐ bǐ shàng wǔ hái piào liang",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Mom, you’re even prettier than this morning!"
    },
    {
      "index": 20,
      "simplified": "妈妈：再给你五十块钱，买一杯可乐吧！",
      "traditional": "媽媽：再給你五十塊錢，買一杯可樂吧！",
      "pinyin": "mā ma zài gěi nǐ wǔ shí kuài qián mǎi yì bēi kě lè ba",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: I’ll give you another 50 yuan, buy a glass of coca-cola!"
    },
    {
      "index": 22,
      "simplified": "小明：谢谢妈妈，再见！",
      "traditional": "小明：謝謝媽媽，再見！",
      "pinyin": "xiǎo míng xiè xie mā ma zài jiàn",
      "english": ""
    },
    {
      "index": 23,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Ming: Thanks mom, see you later!"
    }
