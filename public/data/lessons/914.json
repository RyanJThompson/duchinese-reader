{
  "id": "914",
  "title": "Do You Have an English Menu?",
  "level": "newbie",
  "date": "2020-06-29",
  "synopsis": "Anne asks for an English menu at a Chinese restaurant.",
  "audioUrl": "https://static.duchinese.net/documents/914/69cb2c410e3776e85e0ce88983d8b1c3bb403ba5.mp3?1588497622",
  "series": null,
  "fullText": {
    "simplified": "请问有英文菜单吗？\n\n安：不好意思！请问有英文菜单吗？我看不懂中文菜单。\n店员：有！我去拿给您。\n安：好的，谢谢！\n店员：不客气！\n",
    "traditional": "請問有英文菜單嗎？\n\n安：不好意思！請問有英文菜單嗎？我看不懂中文菜單。\n店員：有！我去拿給您。\n安：好的，謝謝！\n店員：不客氣！\n"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Excuse me, do you have an English menu?"
    },
    {
      "index": 2,
      "simplified": "安：不好意思！请问有英文菜单吗？我看不懂中文菜单。",
      "traditional": "安：不好意思！請問有英文菜單嗎？我看不懂中文菜單。",
      "pinyin": "ān bù hǎo yì si qǐng wèn yǒu yīng wén cài dān ma wǒ kàn bù dǒng zhōng wén cài dān",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: I’m sorry, may I ask if you have an English menu? I can’t read the Chinese menu."
    },
    {
      "index": 4,
      "simplified": "店员：有！我去拿给您。",
      "traditional": "店員：有！我去拿給您。",
      "pinyin": "diàn yuán yǒu wǒ qù ná gěi nín",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: We do! I’ll go get it for you."
    },
    {
      "index": 6,
      "simplified": "安：好的，谢谢！",
      "traditional": "安：好的，謝謝！",
      "pinyin": "ān hǎo de xiè xie",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: Great, thanks!"
    },
    {
      "index": 8,
      "simplified": "店员：不客气！",
      "traditional": "店員：不客氣！",
      "pinyin": "diàn yuán bú kè qi",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: You’re welcome!"
    }
  ],
