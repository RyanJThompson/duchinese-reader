{
  "id": "145",
  "title": "Lying",
  "level": "elementary",
  "date": "2016-07-02",
  "synopsis": "Little Ming visits his father's office. This time he can't stop himself from telling a lie.",
  "audioUrl": "https://static.duchinese.net/documents/166/665de49a1c86d0710ea4b9d3f6973da95d5484f8.mp3",
  "series": null,
  "fullText": {
    "simplified": "说谎   \n\n    一天，小明去他爸爸的公司玩。爸爸的一个女同事逗他说：“小明，你好帅啊！”小明也对女同事说：“姐姐，你好漂亮啊！”\n    说完他马上跑到他爸爸的面前说：“爸爸，对不起，我又说谎了！”\n    全公司的人都笑了。",
    "traditional": "說謊   \n\n    一天，小明去他爸爸的公司玩。爸爸的一個女同事逗他說：“小明，你好帥啊！”小明也對女同事說：“姐姐，你好漂亮啊！”\n    說完他馬上跑到他爸爸的面前說：“爸爸，對不起，我又說謊了！”\n    全公司的人都笑了。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Lying"
    },
    {
      "index": 2,
      "simplified": "一天，小明去他爸爸的公司玩。",
      "traditional": "一天，小明去他爸爸的公司玩。",
      "pinyin": "yì tiān xiǎo míng qù tā bà ba de gōng sī wán",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "爸爸的一个女同事逗他说：“小明，你好帅啊！”",
      "traditional": "爸爸的一個女同事逗他說：“小明，你好帥啊！”",
      "pinyin": "bà ba de yí ge nǚ tóng shì dòu tā shuō xiǎo míng nǐ hǎo shuài a",
      "english": "One day, Little Ming went to his dad's office to play."
    },
    {
      "index": 4,
      "simplified": "小明也对女同事说：“姐姐，你好漂亮啊！”",
      "traditional": "小明也對女同事說：“姐姐，你好漂亮啊！”",
      "pinyin": "xiǎo míng yě duì nǚ tóng shì shuō jiě jie nǐ hǎo piào liang a",
      "english": "One of dad's female colleagues joked with Little Ming and said: “Little Ming, you're so handsome!”"
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Ming replied to the female colleague: “Miss, you're very beautiful!”"
    },
    {
      "index": 6,
      "simplified": "说完他马上跑到他爸爸的面前说：“爸爸，对不起，我又说谎了！”",
      "traditional": "說完他馬上跑到他爸爸的面前說：“爸爸，對不起，我又說謊了！”",
      "pinyin": "shuō wán tā mǎ shàng pǎo dào tā bà ba de miàn qián shuō bà ba duì bu qǐ wǒ yòu shuō huǎng le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "After he finished speaking he ran over to his dad and said: “Dad, I'm sorry! I told a lie again!”"
    },
    {
      "index": 8,
      "simplified": "全公司的人都笑了。",
      "traditional": "全公司的人都笑了。",
      "pinyin": "quán gōng sī de rén dōu xiào le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Everyone at the company laughed."
    }
  ],
