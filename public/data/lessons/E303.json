{
  "id": "E303",
  "title": "Pass By or Pass Away",
  "level": "elementary",
  "date": "2019-03-08",
  "synopsis": "Watch out! Direct translations sometimes cause misunderstandings.",
  "audioUrl": "https://static.duchinese.net/documents/987/9a6755f643d61c26a2ddd1fc3e4a0595056db83f.mp3?1550313318",
  "series": null,
  "fullText": {
    "simplified": "他刚过去了\n\n本：你看见保罗了吗？\n丽丽：哦，他刚过去了。\n本：什么？他去世了？什么时候的事？\n丽丽：不是，我的意思是他刚路过这儿……",
    "traditional": "他剛過去了\n\n本：你看見保羅了嗎？\n麗麗：哦，他剛過去了。\n本：什麼？他去世了？什麼時候的事？\n麗麗：不是，我的意思是他剛路過這兒……"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "He Just Passed By"
    },
    {
      "index": 2,
      "simplified": "本：你看见保罗了吗？",
      "traditional": "本：你看見保羅了嗎？",
      "pinyin": "běn nǐ kàn jiàn bǎo luó le ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Have you seen Paul?"
    },
    {
      "index": 4,
      "simplified": "丽丽：哦，他刚过去了。",
      "traditional": "麗麗：哦，他剛過去了。",
      "pinyin": "lì lì ò tā gāng guò qù le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Oh, he just passed by."
    },
    {
      "index": 6,
      "simplified": "本：什么？他去世了？什么时候的事？",
      "traditional": "本：什麼？他去世了？什麼時候的事？",
      "pinyin": "běn shén me tā qù shì le shén me shí hou de shì",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: What? He passed away? When did this happen?"
    },
    {
      "index": 8,
      "simplified": "丽丽：不是，我的意思是他刚路过这儿……",
      "traditional": "麗麗：不是，我的意思是他剛路過這兒……",
      "pinyin": "lì lì bú shì wǒ de yì si shì tā gāng lù guò zhè‘r",
      "english": ""
    }
