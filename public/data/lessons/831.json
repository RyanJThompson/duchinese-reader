{
  "id": "831",
  "title": "What’s Pretty About It?",
  "level": "newbie",
  "date": "2019-11-28",
  "synopsis": "Lili is trying to get Little He's opinion about a bag.",
  "audioUrl": "https://static.duchinese.net/documents/831/de0ebf06732844ae3726757168c8c59a3255b87a.mp3?1574775854",
