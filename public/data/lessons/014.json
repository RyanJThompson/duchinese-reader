{
  "id": "014",
  "title": "Exam Instructions",
  "level": "intermediate",
  "date": "2015-11-13",
  "synopsis": "If you’re taking an exam in China it helps if you can fully understand the instructions. This is the instructions sheet for a test in a Chinese school.",
  "audioUrl": "https://static.duchinese.net/documents/13/d5a4f55d75b89d8f004d836ef09552363fe8a0a3.mp3",
  "series": null,
  "fullText": {
    "simplified": "考试须知\n\n考试科目：三年级语文\n考试时间：9：00～10：00，1小时\n试卷页数：3页\n\n注意：\n1. 请关闭手机。\n2. 不可以使用铅笔。\n3. 考试时不可以说话。有问题请举手问老师。",
    "traditional": "考試須知\n\n考試科目：三年級語文\n考試時間：9：00～10：00，1小時\n試卷頁數：3頁\n\n注意：\n1. 請關閉手機。\n2. 不可以使用鉛筆。\n3. 考試時不可以說話。有問題請舉手問老師。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Exam Instructions"
    },
    {
      "index": 2,
      "simplified": "考试科目：三年级语文\n",
      "traditional": "考試科目：三年級語文\n",
      "pinyin": "kǎo shì kē mù sān nián jí yǔ wén",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "考试时间：9：00～10：00，1小时\n",
      "traditional": "考試時間：9：00～10：00，1小時\n",
      "pinyin": "kǎo shì shí jiān 2 dào 2 yì xiǎo shí",
      "english": "Exam subject: Third year literature and language"
    },
    {
      "index": 4,
      "simplified": "试卷页数：3页\n\n",
      "traditional": "試卷頁數：3頁\n\n",
      "pinyin": "shì juàn yè shù sān yè",
      "english": "Exam time: 9:00-10:00, 1 hour"
    },
    {
      "index": 5,
      "simplified": "注意：\n",
      "traditional": "注意：\n",
      "pinyin": "zhù yì",
      "english": "Exam paper page count: 3 pages"
    },
    {
      "index": 6,
      "simplified": "1. 请关闭手机。\n",
      "traditional": "1. 請關閉手機。\n",
      "pinyin": "yī qǐng guān bì shǒu jī",
      "english": "Note:"
    },
    {
      "index": 7,
      "simplified": "2. 不可以使用铅笔。\n",
      "traditional": "2. 不可以使用鉛筆。\n",
      "pinyin": "èr bù kě yǐ shǐ yòng qiān bǐ",
      "english": "1. Please switch off your cell phone."
    },
    {
      "index": 8,
      "simplified": "3. 考试时不可以说话。",
      "traditional": "3. 考試時不可以說話。",
      "pinyin": "sān kǎo shì shí bù kě yǐ shuō huà",
      "english": "2. You may not use a pencil."
    },
    {
      "index": 9,
      "simplified": "有问题请举手问老师。",
      "traditional": "有問題請舉手問老師。",
      "pinyin": "yǒu wèn tí qǐng jǔ shǒu wèn lǎo shī",
      "english": "3. No speaking during the exam."
    }
  ],
