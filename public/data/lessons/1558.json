      "english": ""
    },
    {
      "index": 2,
      "simplified": "我是一个手机，我的名字叫小米，你可以叫我小米手机。",
      "traditional": "我是一個手機，我的名字叫小米，你可以叫我小米手機。",
      "pinyin": "wǒ shì yí ge shǒu jī wǒ de míng zi jiào xiǎo mǐ nǐ kě yǐ jiào wǒ xiǎo mǐ shǒu jī",
      "english": "I am a cell phone. My name is Xiaomi, and you can call me the Xiaomi phone. "
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 4,
      "simplified": "我的主人叫大星，他今年十八岁了。",
      "traditional": "我的主人叫大星，他今年十八歲了。",
      "pinyin": "wǒ de zhǔ rén jiào dà xīng tā jīn nián shí bā suì le",
      "english": "My owner is called Daxing. He is 18 years old this year."
    },
    {
      "index": 5,
      "simplified": "他是一个高中生，今年读高三。",
      "traditional": "他是一個高中生，今年讀高三。",
      "pinyin": "tā shì yí ge gāo zhōng shēng jīn nián dú gāo sān",
      "english": "He is a  senior high school student. This year he is in the third year of senior high school."
    },
    {
      "index": 6,
      "simplified": "大星喜欢我，我也喜欢大星。",
      "traditional": "大星喜歡我，我也喜歡大星。",
      "pinyin": "dà xīng xǐ huan wǒ wǒ yě xǐ huan dà xīng",
      "english": "Daxing likes me, and I also like Daxing."
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "上午，大星说：“我的手机在哪儿？”。",
      "traditional": "上午，大星說：“我的手機在哪兒？”。",
      "pinyin": "shàng wǔ dà xīng shuō wǒ de shǒu jī zài nǎ'r",
      "english": "In the mornings, Daxing says, “Where is my phone?”. "
    },
    {
      "index": 9,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "下午，大星说：“我的手机在哪儿？我要看电影。”。",
      "traditional": "下午，大星說：“我的手機在哪兒？我要看電影。”。",
      "pinyin": "xià wǔ dà xīng shuō wǒ de shǒu jī zài nǎ'r wǒ yào kàn diàn yǐng",
      "english": "In the afternoons, Daxing says, “Where is my phone? I want to watch a movie.” "
    },
    {
      "index": 11,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "晚上，大星说：“我的手机在哪儿？我要看Facebook。”",
      "traditional": "晚上，大星說：“我的手機在哪兒？我要看Facebook。”",
      "pinyin": "wǎn shang dà xīng shuō wǒ de shǒu jī zài nǎ'r wǒ yào kàn 3",
      "english": "In the evenings, Daxing says, “Where is my phone? I want to go on Facebook.”"
    },
    {
      "index": 13,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "我听见他叫我，我太高兴了。我说：“我在这儿！我在这儿！”",
      "traditional": "我聽見他叫我，我太高興了。我說：“我在這兒！我在這兒！”",
      "pinyin": "wǒ tīng jiàn tā jiào wǒ wǒ tài gāo xìng le wǒ shuō wǒ zài zhè‘r wǒ zài zhè‘r",
      "english": "When I hear him calling for me, I am so happy! I say, “I am here! I am here!”"
    }
  ],
