{
  "id": "930",
  "title": "I Can’t See You",
  "level": "elementary",
  "date": "2020-05-29",
  "synopsis": "Anne’s taxi driver struggles to identify her on the roadside.",
  "audioUrl": "https://static.duchinese.net/documents/930/a28d06a4b5d5988d6294e13d89c7cb93950596f7.mp3?1589700472",
  "series": null,
  "fullText": {
    "simplified": "我没看见你\n\n安：喂，师傅，我在路边等你。我看见你的车了。你往前开一点。\n司机：好的。你在哪里？我没看见你！\n安：哎呀，师傅，你开过了。你往后开一下。我穿着一件黑色的上衣。\n司机：我没看见你人！你在哪里？我只看到了一个老外。\n安：师傅，我就是那个老外！\n司机：好吧，不好意思！我都没听出来你是个外国人。你中文说得真好！",
    "traditional": "我沒看見你\n\n安：喂，師傅，我在路邊等你。我看見你的車了。你往前開一點。\n司機：好的。你在哪裏？我沒看見你！\n安：哎呀，師傅，你開過了。你往後開一下。我穿著一件黑色的上衣。\n司機：我沒看見你人！你在哪裏？我只看到了一個老外。\n安：師傅，我就是那個老外！\n司機：好吧，不好意思！我都沒聽出來你是個外國人。你中文說得真好！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Can’t See You"
    },
    {
      "index": 2,
      "simplified": "安：喂，师傅，我在路边等你。我看见你的车了。你往前开一点。",
      "traditional": "安：喂，師傅，我在路邊等你。我看見你的車了。你往前開一點。",
      "pinyin": "ān wéi shī fu wǒ zài lù biān děng nǐ wǒ kàn jiàn nǐ de chē le nǐ wǎng qián kāi yì diǎn",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: Hello, sir, I am on the roadside waiting for you. I saw your car. Drive forward a bit."
    },
    {
      "index": 4,
      "simplified": "司机：好的。你在哪里？我没看见你！",
      "traditional": "司機：好的。你在哪裏？我沒看見你！",
      "pinyin": "sī jī hǎo de nǐ zài nǎ lǐ wǒ méi kàn jiàn nǐ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Driver: Sure. Where are you? I can’t see you!"
    },
    {
      "index": 6,
      "simplified": "安：哎呀，师傅，你开过了。你往后开一下。我穿着一件黑色的上衣。",
      "traditional": "安：哎呀，師傅，你開過了。你往後開一下。我穿著一件黑色的上衣。",
      "pinyin": "ān āi yā shī fu nǐ kāi guò le nǐ wǎng hòu kāi yí xià wǒ chuān zhe yí jiàn hēi sè de shàng yī",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: Ah! Sir, you have driven past me. Drive backwards a bit. I am wearing a black jacket."
    },
    {
      "index": 8,
      "simplified": "司机：我没看见你人！你在哪里？我只看到了一个老外。",
      "traditional": "司機：我沒看見你人！你在哪裏？我只看到了一個老外。",
      "pinyin": "sī jī wǒ méi kàn jiàn nǐ rén nǐ zài nǎ lǐ wǒ zhǐ kàn dào le yí ge lǎo wài",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Driver: I can’t see you! Where are you? I can only see a foreigner."
    },
    {
      "index": 10,
      "simplified": "安：师傅，我就是那个老外！",
      "traditional": "安：師傅，我就是那個老外！",
      "pinyin": "ān shī fu wǒ jiù shì nèi ge lǎo wài",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: Sir, I am that foreigner!"
    },
    {
      "index": 12,
      "simplified": "司机：好吧，不好意思！我都没听出来你是个外国人。你中文说得真好！",
      "traditional": "司機：好吧，不好意思！我都沒聽出來你是個外國人。你中文說得真好！",
      "pinyin": "sī jī hǎo ba bù hǎo yì si wǒ dōu méi tīng chū lái nǐ shì ge wài guó rén nǐ zhōng wén shuō de zhēn hǎo",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Driver: Okay, sorry about that! I couldn’t tell that you were a foreigner. You speak Chinese so well!"
    }
  ],
