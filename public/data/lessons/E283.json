{
  "id": "E283",
  "title": "Scared to Death",
  "level": "intermediate",
  "date": "2018-12-19",
  "synopsis": "What do Chinese people say when they get scared?",
  "audioUrl": "https://static.duchinese.net/documents/931/c1f8164736fb47aac88b79e017fcc7f7460ea273.mp3?1545070116",
  "series": null,
  "fullText": {
    "simplified": "吓死我了\n\n（办公室里很安静，突然…)\n小何：啊！\n小张：吓死我了！怎么了？\n小何：我们要去开会了，快走吧！\n小张：你忘了吗？今天不开会了，改到明天了。\n小何：吓死我了，我以为我们要迟到了。",
    "traditional": "嚇死我了\n\n（辦公室裡很安靜，突然…)\n小何：啊！\n小張：嚇死我了！怎麼了？\n小何：我們要去開會了，快走吧！\n小張：你忘了嗎？今天不開會了，改到明天了。\n小何：嚇死我了，我以為我們要遲到了。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "That scared me to death!"
    },
    {
      "index": 2,
      "simplified": "（办公室里很安静，突然…)",
      "traditional": "（辦公室裡很安靜，突然…)",
      "pinyin": "bàn gōng shì lǐ hěn ān jìng tū rán",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "(It was quiet in the office, when suddenly…)"
    },
    {
      "index": 4,
      "simplified": "小何：啊！",
      "traditional": "小何：啊！",
      "pinyin": "xiǎo hé a",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Ah!"
    },
    {
      "index": 6,
      "simplified": "小张：吓死我了！怎么了？",
      "traditional": "小張：嚇死我了！怎麼了？",
      "pinyin": "xiǎo zhāng xià sǐ wǒ le zěn me le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: You scared me to death! What happened?"
    },
    {
      "index": 8,
      "simplified": "小何：我们要去开会了，快走吧！",
      "traditional": "小何：我們要去開會了，快走吧！",
      "pinyin": "xiǎo hé wǒ men yào qù kāi huì le kuài zǒu ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: We have to be off to the meeting. Let’s go!"
    },
    {
      "index": 10,
      "simplified": "小张：你忘了吗？今天不开会了，改到明天了。",
      "traditional": "小張：你忘了嗎？今天不開會了，改到明天了。",
      "pinyin": "xiǎo zhāng nǐ wàng le ma jīn tiān bù kāi huì le gǎi dào míng tiān le",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: Did you forget? We don’t have a meeting today. It was rescheduled for tomorrow."
    },
    {
      "index": 12,
      "simplified": "小何：吓死我了，我以为我们要迟到了。",
      "traditional": "小何：嚇死我了，我以為我們要遲到了。",
      "pinyin": "xiǎo hé xià sǐ wǒ le wǒ yǐ wéi wǒ men yào chí dào le",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: It scared me to death! I thought we were running late."
    }
  ],
