    },
    {
      "index": 2,
      "simplified": "妈妈：小明，写作业的时候别玩笔。",
      "traditional": "媽媽：小明，寫作業的時候別玩筆。",
      "pinyin": "mā ma xiǎo míng xiě zuò yè de shí hou bié wán bǐ",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Little Ming, don’t play with your pencil when doing homework."
    },
    {
      "index": 4,
      "simplified": "小明：哦。我去上厕所。",
      "traditional": "小明：哦。我去上廁所。",
      "pinyin": "xiǎo míng ò wǒ qù shàng cè suǒ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Oh. I’m going to the bathroom."
    },
    {
      "index": 6,
      "simplified": "妈妈：小明，都过了半个小时了，你还没好吗？",
      "traditional": "媽媽：小明，都過了半個小時了，你還沒好嗎？",
      "pinyin": "mā ma xiǎo míng dōu guò le bàn ge xiǎo shí le nǐ hái méi hǎo ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Little Ming, it’s been half an hour already. Are you not ready yet?"
    },
    {
      "index": 8,
      "simplified": "小明：好了好了。",
      "traditional": "小明：好了好了。",
      "pinyin": "xiǎo míng hǎo le hǎo le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I’m ready, I’m ready."
    },
    {
