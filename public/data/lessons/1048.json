{
  "id": "1048",
  "title": "No Posting",
  "level": "elementary",
  "date": "2020-10-17",
  "synopsis": "Does the “No Posting” sign really apply to everyone?",
  "audioUrl": "https://static.duchinese.net/documents/1048/db2481118ed5e304c48190bf3eacb145ac5a5ce5.mp3?1595238060",
  "series": null,
  "fullText": {
    "simplified": "禁止张贴\n\n笑笑：小明，你看！这儿写了“禁止张贴”，我们还是把广告贴到那儿去吧！\n小明：“禁止张贴”的意思是：禁止姓张的人在这儿贴东西。我们不姓张，没关系的！\n笑笑：真的吗？\n小明：我开玩笑的。我们还是把广告贴到那儿去吧！",
    "traditional": "禁止張貼\n\n笑笑：小明，你看！這兒寫了“禁止張貼”，我們還是把廣告貼到那兒去吧！\n小明：“禁止張貼”的意思是：禁止姓張的人在這兒貼東西。我們不姓張，沒關係的！\n笑笑：真的嗎？\n小明：我開玩笑的。我們還是把廣告貼到那兒去吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "No Posting"
    },
    {
      "index": 2,
      "simplified": "笑笑：小明，你看！这儿写了“禁止张贴”，我们还是把广告贴到那儿去吧！",
      "traditional": "笑笑：小明，你看！這兒寫了“禁止張貼”，我們還是把廣告貼到那兒去吧！",
      "pinyin": "xiào xiào xiǎo míng nǐ kàn zhè‘r xiě le jìn zhǐ zhāng tiē wǒ men hái shi bǎ guǎng gào tiē dào nà'r qù ba",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Xiao Xiao: Little Ming, look! It says “No Posting” here. We had better stick the advertisement over there!"
    },
    {
      "index": 4,
      "simplified": "小明：“禁止张贴”的意思是：禁止姓张的人在这儿贴东西。",
      "traditional": "小明：“禁止張貼”的意思是：禁止姓張的人在這兒貼東西。",
      "pinyin": "xiǎo míng jìn zhǐ zhāng tiē de yì si shì jìn zhǐ xìng zhāng de rén zài zhè‘r tiē dōng xi",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "我们不姓张，没关系的！",
      "traditional": "我們不姓張，沒關係的！",
      "pinyin": "wǒ men bú xìng zhāng méi guān xi de",
      "english": "Little Ming: The meaning of “No Posting” is: It is forbidden for people surnamed Zhang to stick things here."
    },
    {
      "index": 6,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "We are not surnamed Zhang, so it doesn’t matter!"
    },
    {
      "index": 7,
      "simplified": "笑笑：真的吗？",
      "traditional": "笑笑：真的嗎？",
      "pinyin": "xiào xiào zhēn de ma",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Xiao Xiao: Really?"
    },
    {
      "index": 9,
      "simplified": "小明：我开玩笑的。我们还是把广告贴到那儿去吧！",
      "traditional": "小明：我開玩笑的。我們還是把廣告貼到那兒去吧！",
      "pinyin": "xiǎo míng wǒ kāi wán xiào de wǒ men hái shi bǎ guǎng gào tiē dào nà'r qù ba",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Ming: I am joking. We had better stick the advertisement over there!"
    }
  ],
