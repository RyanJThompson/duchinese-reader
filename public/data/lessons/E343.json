{
  "id": "E343",
  "title": "You Are So Stupid!",
  "level": "newbie",
  "date": "2019-07-18",
  "synopsis": "Guess which is the most \"stupid\" number in China.",
  "audioUrl": "https://static.duchinese.net/documents/1102/c76e93ea6e60889ba57aa03807db83b7ce874cea.mp3?1563182493",
  "series": null,
  "fullText": {
    "simplified": "你太二了\n\n保罗：喂，你在哪儿呢？今天不是9点上课吗？教室里怎么一个人都没有？\n小乐：今天是星期六，不上课。你不会又看错时间了吧？\n保罗：噢！真的，我又二了！\n小乐：你真是太二了！",
    "traditional": "你太二了\n\n保羅：喂，你在哪兒呢？今天不是9點上課嗎？教室裡怎麼一個人都沒有？\n小樂：今天是星期六，不上課。你不會又看錯時間了吧？\n保羅：噢！真的，我又二了！\n小樂：你真是太二了！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "You Are So Stupid!"
    },
    {
      "index": 2,
      "simplified": "保罗：喂，你在哪儿呢？今天不是9点上课吗？",
      "traditional": "保羅：喂，你在哪兒呢？今天不是9點上課嗎？",
      "pinyin": "bǎo luó wéi nǐ zài nǎ'r ne jīn tiān bú shì 1 diǎn shàng kè ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "教室里怎么一个人都没有？",
      "traditional": "教室裡怎麼一個人都沒有？",
      "pinyin": "jiào shì lǐ zěn me yí ge rén dōu méi yǒu",
      "english": "Paul: Hello, where are you? Don’t we have class at 9 today?"
    },
    {
      "index": 4,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "How come there is not a single person in the classroom?"
    },
    {
      "index": 5,
      "simplified": "小乐：今天是星期六，不上课。你不会又看错时间了吧？",
      "traditional": "小樂：今天是星期六，不上課。你不會又看錯時間了吧？",
      "pinyin": "xiǎo lè jīn tiān shì xīng qī liù bú shàng kè nǐ bú huì yòu kàn cuò shí jiān le ba",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: It is Saturday today, we don’t have class. You can’t have gotten the time wrong again?"
    },
    {
      "index": 7,
      "simplified": "保罗：噢！真的，我又二了！",
      "traditional": "保羅：噢！真的，我又二了！",
      "pinyin": "bǎo luó ō zhēn de wǒ yòu èr le",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Oh! That’s true! I’m being stupid again!"
    },
    {
      "index": 9,
      "simplified": "小乐：你真是太二了！",
      "traditional": "小樂：你真是太二了！",
      "pinyin": "xiǎo lè nǐ zhēn shì tài èr le",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: You are really stupid!"
    }
  ],
