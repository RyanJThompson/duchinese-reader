  "title": "Today Is Colder Than Yesterday",
  "level": "elementary",
  "date": "2018-04-21",
  "synopsis": "Lili compares the weather with her dad.",
  "audioUrl": "https://static.duchinese.net/documents/706/b70a636c463354a43d7ed44d6aba067d43719636.mp3?1589791848",
