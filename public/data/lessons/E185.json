{
  "id": "E185",
  "title": "She Doesn’t Like Me",
  "level": "elementary",
  "date": "2018-01-13",
  "synopsis": "Xiao Bao is very cute but Xiao Xi doesn’t like him.",
  "audioUrl": "https://static.duchinese.net/documents/628/63583dfc972fab92153ac30c29f2b7fefdb7ac3b.mp3?1515329018",
  "series": null,
  "fullText": {
    "simplified": "她不喜欢我\n\n    小宝今天不高兴。奶奶问他为什么，小宝说：“小西不喜欢我。她说阳阳个子比我高，力气比我大，还比我可爱。奶奶，你不是说我是最可爱的孩子吗？”",
    "traditional": "她不喜歡我\n\n    小寶今天不高興。奶奶問他為什麼，小寶說：“小西不喜歡我。她說陽陽個子比我高，力氣比我大，還比我可愛。奶奶，你不是說我是最可愛的孩子嗎？”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "She doesn’t like me"
    },
    {
      "index": 2,
      "simplified": "小宝今天不高兴。",
      "traditional": "小寶今天不高興。",
      "pinyin": "xiǎo bǎo jīn tiān bù gāo xìng",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "奶奶问他为什么，小宝说：",
      "traditional": "奶奶問他為什麼，小寶說：",
      "pinyin": "nǎi nai wèn tā wèi shén me xiǎo bǎo shuō",
      "english": "Xiao Bao is unhappy today."
    },
    {
      "index": 4,
      "simplified": "“小西不喜欢我。她说阳阳个子比我高，力气比我大，还比我可爱。",
      "traditional": "“小西不喜歡我。她說陽陽個子比我高，力氣比我大，還比我可愛。",
      "pinyin": "xiǎo xī bù xǐ huan wǒ tā shuō yáng yáng gè zi bǐ wǒ gāo lì qi bǐ wǒ dà hái bǐ wǒ kě ài",
      "english": "Grandma asks him why, and Xiao Bao says:"
    },
    {
      "index": 5,
      "simplified": "奶奶，你不是说我是最可爱的孩子吗？”",
      "traditional": "奶奶，你不是說我是最可愛的孩子嗎？”",
      "pinyin": "nǎi nai nǐ bú shì shuō wǒ shì zuì kě ài de hái zi ma",
      "english": "“Xiao Xi doesn’t like me. She said Yangyang is taller than me, stronger than me, and also cuter than me.”"
    }
  ],
