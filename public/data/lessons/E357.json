{
  "id": "E357",
  "title": "Apartment Rental Advertisement",
  "level": "upper intermediate",
  "date": "2019-09-06",
  "synopsis": "Words that you might need for renting an apartment in China.",
  "audioUrl": "https://static.duchinese.net/documents/1145/1a671faba4bde1bd881e0f7cf6f8e8f21f435ff7.mp3?1567416371",
  "series": null,
  "fullText": {
    "simplified": "租房广告\n\n    现有一套80平方的房子转租。房子两室一厅，一个厨房一个卫生间，有阳台，窗外风景好。交通方便，离地铁站步行8分钟，公交车站步行3分钟。小区环境好，既干净又安静，而且附近还有超市、饭店、健身房等。租金6500元每月，付三押一。",
    "traditional": "租房廣告\n\n    現有一套80平方的房子轉租。房子兩室一廳，一個廚房一個衛生間，有陽臺，窗外風景好。交通方便，離地鐵站步行8分鐘，公交車站步行3分鐘。小區環境好，既乾淨又安靜，而且附近還有超市、飯店、健身房等。租金6500元每月，付三押一。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Apartment Rental Advertisement"
    },
    {
      "index": 2,
      "simplified": "现有一套80平方的房子转租。",
      "traditional": "現有一套80平方的房子轉租。",
      "pinyin": "xiàn yǒu yí tào 2 píng fāng de fáng zi zhuǎn zū",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "房子两室一厅，一个厨房一个卫生间，有阳台，窗外风景好。",
      "traditional": "房子兩室一廳，一個廚房一個衛生間，有陽臺，窗外風景好。",
      "pinyin": "fáng zi liǎng shì yì tīng yí ge chú fáng yí ge wèi shēng jiān yǒu yáng tái chuāng wài fēng jǐng hǎo",
      "english": "An 80 square meter apartment now available to sublet."
    },
    {
      "index": 4,
      "simplified": "交通方便，离地铁站步行8分钟，公交车站步行3分钟。",
      "traditional": "交通方便，離地鐵站步行8分鐘，公交車站步行3分鐘。",
      "pinyin": "jiāo tōng fāng biàn lí dì tiě zhàn bù xíng 1 fēn zhōng gōng jiāo chē zhàn bù xíng 1 fēn zhōng",
      "english": "The apartment has two bedrooms, one living room, one kitchen and one bathroom, a balcony and good view from the window."
    },
    {
      "index": 5,
      "simplified": "小区环境好，既干净又安静，",
      "traditional": "小區環境好，既乾淨又安靜，",
      "pinyin": "xiǎo qū huán jìng hǎo jì gān jìng yòu ān jìng",
      "english": "Convenient transportation: an 8-minute walk to the subway station and 3-minute walk to the bus stop."
    },
    {
      "index": 6,
      "simplified": "而且附近还有超市、饭店、健身房等。",
      "traditional": "而且附近還有超市、飯店、健身房等。",
      "pinyin": "ér qiě fù jìn hái yǒu chāo shì fàn diàn jiàn shēn fáng děng",
      "english": "The surrounding community is good, both clean and quiet."
    },
    {
      "index": 7,
      "simplified": "租金6500元每月，付三押一。",
      "traditional": "租金6500元每月，付三押一。",
      "pinyin": "zū jīn 4 yuán měi yuè fù sān yā yī",
      "english": "Additionally, supermarkets, restaurants and gyms, etc. are also nearby."
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Rent is 6500 yuan per month. Payment upfront every third month and one month’s deposit."
    }
  ],
