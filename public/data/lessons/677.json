  "title": "I Don’t Understand",
  "level": "elementary",
  "date": "2019-06-01",
  "synopsis": "A shop assistant wants to sell fruit to Ben.",
  "audioUrl": "https://static.duchinese.net/documents/1056/2bcb3fa8539e34db52e51cc03f1e82bc85f9f07d.mp3?1558605926",
