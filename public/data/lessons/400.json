{
  "id": "400",
  "title": "Have You Seen Our Family Dog?",
  "level": "newbie",
  "date": "2017-11-04",
  "synopsis": "Aunt Li asks Ben if he has seen her dog.",
  "audioUrl": "https://static.duchinese.net/documents/566/6414b926ed814cc7f445944ad2b3031a15eb14eb.mp3?1554973212",
  "series": {
