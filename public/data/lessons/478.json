{
  "id": "478",
  "title": "Buying a Cup",
  "level": "elementary",
  "date": "2018-03-31",
  "synopsis": "Little Yu wants to buy a cup for Ben.",
  "audioUrl": "https://static.duchinese.net/documents/686/c91c811557fe54abd524bf359e610bef8285a610.mp3?1589791676",
  "series": {
