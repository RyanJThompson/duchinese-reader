{
  "id": "E253",
  "title": "Both Happy and Unhappy",
  "level": "newbie",
  "date": "2018-09-06",
  "synopsis": "School will start soon, which makes Little Ming feel torn.",
  "audioUrl": "https://static.duchinese.net/documents/832/2425ec97ddddec885ff2f03e1dad676cbc64d942.mp3?1535360236",
  "series": null,
  "fullText": {
    "simplified": "我又高兴，又不高兴\n\n妈妈：小明，马上就要开学了，你高兴吗？\n小明：我又高兴，又不高兴。\n妈妈：为什么？\n小明：高兴是因为可以见到我的朋友们了。不高兴是因为又得开始每天写作业了。",
    "traditional": "我又高興，又不高興\n\n媽媽：小明，馬上就要開學了，你高興嗎？\n小明：我又高興，又不高興。\n媽媽：為什麼？\n小明：高興是因為可以見到我的朋友們了。不高興是因為又得開始每天寫作業了。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I’m both happy and unhappy"
    },
    {
      "index": 2,
      "simplified": "妈妈：小明，马上就要开学了，你高兴吗？",
      "traditional": "媽媽：小明，馬上就要開學了，你高興嗎？",
      "pinyin": "mā ma xiǎo míng mǎ shàng jiù yào kāi xué le nǐ gāo xìng ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Little Ming, school will start soon. Are you happy about it?"
    },
    {
      "index": 4,
      "simplified": "小明：我又高兴，又不高兴。",
      "traditional": "小明：我又高興，又不高興。",
      "pinyin": "xiǎo míng wǒ yòu gāo xìng yòu bù gāo xìng",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I’m both happy and unhappy."
    },
    {
      "index": 6,
      "simplified": "妈妈：为什么？",
      "traditional": "媽媽：為什麼？",
      "pinyin": "mā ma wèi shén me",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Why?"
    },
    {
      "index": 8,
      "simplified": "小明：高兴是因为可以见到我的朋友们了。",
      "traditional": "小明：高興是因為可以見到我的朋友們了。",
      "pinyin": "xiǎo míng gāo xìng shì yīn wèi kě yǐ jiàn dào wǒ de péng you men le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "不高兴是因为又得开始每天写作业了。",
      "traditional": "不高興是因為又得開始每天寫作業了。",
      "pinyin": "bù gāo xìng shì yīn wèi yòu děi kāi shǐ měi tiān xiě zuò yè le",
      "english": "Little Ming: I’m happy because I can meet my friends."
    },
    {
      "index": 10,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "I’m unhappy because I’ll have to do homework every day again."
    }
  ],
