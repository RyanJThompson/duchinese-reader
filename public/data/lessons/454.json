    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Hurry up!"
    },
    {
      "index": 8,
      "simplified": "小何：我回来了。",
      "traditional": "小何：我回來了。",
      "pinyin": "xiǎo hé wǒ huí lái le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: I'm back."
    },
    {
      "index": 10,
      "simplified": "丽丽：电影马上要开始了，把手机关了吧！",
      "traditional": "麗麗：電影馬上要開始了，把手機關了吧！",
      "pinyin": "lì lì diàn yǐng mǎ shàng yào kāi shǐ le bǎ shǒu jī guān le ba",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: The movie is about to start. Why don't you turn off your phone?"
    },
    {
      "index": 12,
      "simplified": "小何：不行啊，这是工作的电话。",
      "traditional": "小何：不行啊，這是工作的電話。",
      "pinyin": "xiǎo hé bù xíng a zhè shì gōng zuò de diàn huà",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: That won't do, this is my work phone."
    },
    {
      "index": 14,
      "simplified": "丽丽：好吧。",
      "traditional": "麗麗：好吧。",
      "pinyin": "lì lì hǎo ba",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Alright."
    },
    {
      "index": 16,
      "simplified": "电影中……滴！滴！滴！",
      "traditional": "電影中……滴！滴！滴！",
      "pinyin": "diàn yǐng zhōng dī dī dī",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "In the middle of the movie… Beep! Beep! Beep!"
    },
    {
