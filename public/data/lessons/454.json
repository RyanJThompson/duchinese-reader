    {
      "index": 27,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Sorry! There's an urgent matter at work, so it can't be helped. You can continue watching."
    },
    {
      "index": 28,
      "simplified": "丽丽：好吧！你走吧！",
      "traditional": "麗麗：好吧！你走吧！",
