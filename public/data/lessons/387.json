{
  "id": "387",
  "title": "Ben is Back Home",
  "level": "newbie",
  "date": "2017-09-23",
  "synopsis": "Ben meets Lili after coming back from his trip to Guangzhou.",
  "audioUrl": "https://static.duchinese.net/documents/530/4f2869da4a8b91500285ee389dd26476fa152840.mp3?1698352353",
  "series": null,
  "fullText": {
    "simplified": "我回来了\n\n丽丽：本！你从广州回来啦？\n本：嗯。我昨天回来的。\n丽丽：广州好玩吗？\n本：太好玩了！\n丽丽：广州不热吗？\n本：太热了！\n本：这是给你的。\n丽丽：这是什么？\n本：我在广州给你买的东西。",
    "traditional": "我回來了\n\n麗麗：本！你從廣州回來啦？\n本：嗯。我昨天回來的。\n麗麗：廣州好玩嗎？\n本：太好玩了！\n麗麗：廣州不熱嗎？\n本：太熱了！\n本：這是給你的。\n麗麗：這是什麼？\n本：我在廣州給你買的東西。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I'm back"
    },
    {
      "index": 2,
      "simplified": "丽丽：本！你从广州回来啦？",
      "traditional": "麗麗：本！你從廣州回來啦？",
      "pinyin": "lì lì běn nǐ cóng guǎng zhōu huí lái la",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Ben! You're back from Guangzhou?"
    },
    {
      "index": 4,
      "simplified": "本：嗯。我昨天回来的。",
      "traditional": "本：嗯。我昨天回來的。",
      "pinyin": "běn èn wǒ zuó tiān huí lái de",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Yes. I came back yesterday."
    },
    {
      "index": 6,
      "simplified": "丽丽：广州好玩吗？",
      "traditional": "麗麗：廣州好玩嗎？",
      "pinyin": "lì lì guǎng zhōu hǎo wán ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Was Guangzhou fun?"
    },
    {
      "index": 8,
      "simplified": "本：太好玩了！",
      "traditional": "本：太好玩了！",
      "pinyin": "běn tài hǎo wán le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: A lot of fun!"
    },
    {
      "index": 10,
      "simplified": "丽丽：广州不热吗？",
      "traditional": "麗麗：廣州不熱嗎？",
      "pinyin": "lì lì guǎng zhōu bú rè ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Wasn't it hot in Guangzhou?"
    },
    {
      "index": 12,
      "simplified": "本：太热了！",
      "traditional": "本：太熱了！",
      "pinyin": "běn tài rè le",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Yes, too hot!"
    },
    {
      "index": 14,
      "simplified": "本：这是给你的。",
      "traditional": "本：這是給你的。",
      "pinyin": "běn zhè shì gěi nǐ de",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Here's something for you."
    },
    {
      "index": 16,
      "simplified": "丽丽：这是什么？",
      "traditional": "麗麗：這是什麼？",
      "pinyin": "lì lì zhè shì shén me",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: What's this?"
    },
    {
      "index": 18,
