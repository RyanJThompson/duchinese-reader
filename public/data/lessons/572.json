{
  "id": "572",
  "title": "My Friend Lili",
  "level": "newbie",
  "date": "2018-08-30",
  "synopsis": "Ben describes his good friend Lili.",
  "audioUrl": "https://static.duchinese.net/documents/827/f2484e4f4f2b72cedc4368b5a9d0916e7c79b67f.mp3?1535300180",
  "series": null,
  "fullText": {
    "simplified": "我的朋友\n\n    我叫本。我有一个好朋友，她的名字叫丽丽。她是我来中国认识的第一个朋友。她很漂亮。她有长长的头发，大大的眼睛。我们都喜欢看书，我们常常一起去图书馆看书。",
    "traditional": "我的朋友\n\n    我叫本。我有一個好朋友，她的名字叫麗麗。她是我來中國認識的第一個朋友。她很漂亮。她有長長的頭髮，大大的眼睛。我們都喜歡看書，我們常常一起去圖書館看書。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "My Friend"
    },
    {
      "index": 2,
      "simplified": "我叫本。",
      "traditional": "我叫本。",
      "pinyin": "wǒ jiào běn",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "我有一个好朋友，她的名字叫丽丽。",
      "traditional": "我有一個好朋友，她的名字叫麗麗。",
      "pinyin": "wǒ yǒu yí ge hǎo péng you tā de míng zi jiào lì lì",
      "english": "My name is Ben."
    },
    {
      "index": 4,
      "simplified": "她是我来中国认识的第一个朋友。",
      "traditional": "她是我來中國認識的第一個朋友。",
      "pinyin": "tā shì wǒ lái zhōng guó rèn shi de dì yī ge péng you",
      "english": "I have a good friend. Her name is Lili."
    },
    {
      "index": 5,
      "simplified": "她很漂亮。",
      "traditional": "她很漂亮。",
      "pinyin": "tā hěn piào liang",
      "english": "She was the first friend I made after coming to China."
    },
    {
      "index": 6,
      "simplified": "她有长长的头发，大大的眼睛。",
      "traditional": "她有長長的頭髮，大大的眼睛。",
      "pinyin": "tā yǒu cháng cháng de tóu fa dà dà de yǎn jing",
      "english": "She is very beautiful."
    },
    {
      "index": 7,
      "simplified": "我们都喜欢看书，我们常常一起去图书馆看书。",
      "traditional": "我們都喜歡看書，我們常常一起去圖書館看書。",
      "pinyin": "wǒ men dōu xǐ huan kàn shū wǒ men cháng cháng yì qǐ qù tú shū guǎn kàn shū",
      "english": "She has long hair and big eyes."
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "We both like studying. We often go to the library together to study."
    }
  ],
