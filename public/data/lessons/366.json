{
  "id": "366",
  "title": "Is Manager Wang There?",
  "level": "elementary",
  "date": "2017-08-18",
  "synopsis": "Chen Dong calls looking for Manager Wang.",
  "audioUrl": "https://static.duchinese.net/documents/499/4246cb371556d9e66e92366aa46001722cc81f80.mp3?1698352476",
  "series": null,
  "fullText": {
    "simplified": "王总在吗？\n\n张力：喂，您好！大华公司。\n陈东：喂，您好！我是陈东。请问你们王总在吗？\n张力：您好，陈总！王总现在在开会，他请您三点后到他办公室找他。\n陈东：好的。我知道了！谢谢！再见！\n张力：再见！",
    "traditional": "王總在嗎？\n\n張力：喂，您好！大華公司。\n陳東：喂，您好！我是陳東。請問你們王總在嗎？\n張力：您好，陳總！王總現在在開會，他請您三點後到他辦公室找他。\n陳東：好的。我知道了！謝謝！再見！\n張力：再見！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Is Manager Wang there?"
    },
    {
      "index": 2,
      "simplified": "张力：喂，您好！大华公司。",
      "traditional": "張力：喂，您好！大華公司。",
      "pinyin": "zhāng lì wéi nín hǎo dà huá gōng sī",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Zhang Li: Hello! Dahua Corporation."
    },
    {
      "index": 4,
      "simplified": "陈东：喂，您好！我是陈东。请问你们王总在吗？",
      "traditional": "陳東：喂，您好！我是陳東。請問你們王總在嗎？",
      "pinyin": "chén dōng wéi nín hǎo wǒ shì chén dōng qǐng wèn nǐ men wáng zǒng zài ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Chen Dong: Hello! I'm Chen Dong. May I ask if Manager Wang is there?"
    },
    {
      "index": 6,
      "simplified": "张力：您好，陈总！王总现在在开会，",
      "traditional": "張力：您好，陳總！王總現在在開會，",
      "pinyin": "zhāng lì nín hǎo chén zǒng wáng zǒng xiàn zài zài kāi huì",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "他请您三点后到他办公室找他。",
      "traditional": "他請您三點後到他辦公室找他。",
      "pinyin": "tā qǐng nín sān diǎn hòu dào tā bàn gōng shì zhǎo tā",
      "english": "Zhang Li: Hello, Manager Chen. Manager Wang is in a meeting."
    },
    {
      "index": 8,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "He asked for you to come look for him in his office after 3 o'clock."
    },
    {
      "index": 9,
      "simplified": "陈东：好的。我知道了！谢谢！再见！",
      "traditional": "陳東：好的。我知道了！謝謝！再見！",
      "pinyin": "chén dōng hǎo de wǒ zhī dào le xiè xie zài jiàn",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Chen Dong: Ok, got it! Thank you! Goodbye!"
    },
    {
      "index": 11,
      "simplified": "张力：再见！",
      "traditional": "張力：再見！",
      "pinyin": "zhāng lì zài jiàn",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Zhang Li: Goodbye!"
    }
  ],
