      "simplified": "小明妈妈：那你呢？",
      "traditional": "小明媽媽：那你呢？",
      "pinyin": "xiǎo míng mā ma nà nǐ ne",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming’s Mom: Then what about you?"
    },
    {
      "index": 8,
      "simplified": "小明爸爸：我比你差一点。",
      "traditional": "小明爸爸：我比你差一點。",
      "pinyin": "xiǎo míng bà ba wǒ bǐ nǐ chà yì diǎn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming’s Dad: I am slightly inferior to you."
    },
    {
      "index": 10,
      "simplified": "小明妈妈：什么？你说什么？",
      "traditional": "小明媽媽：什麼？你說什麼？",
      "pinyin": "xiǎo míng mā ma shén me nǐ shuō shén me",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming’s Mom: What? What are you saying?"
    },
    {
      "index": 12,
      "simplified": "小明爸爸：怎么了？我说，我比你差一点。",
      "traditional": "小明爸爸：怎麼了？我說，我比你差一點。",
      "pinyin": "xiǎo míng bà ba zěn me le wǒ shuō wǒ bǐ nǐ chà yì diǎn",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming’s Dad: What’s wrong? I said, I am slightly inferior to you."
    },
    {
      "index": 14,
      "simplified": "小明妈妈：差一点？“一家之主”的“主”少一个点，那不就是“王”吗？",
      "traditional": "小明媽媽：差一點？“一家之主”的“主”少一個點，那不就是“王”嗎？",
      "pinyin": "xiǎo míng mā ma chà yì diǎn yì jiā zhī zhǔ de zhǔ shǎo yí ge diǎn nà bú jiù shì wáng ma",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "你的意思是，你想做“一家之王”吗！？",
      "traditional": "你的意思是，你想做“一家之王”嗎！？",
      "pinyin": "nǐ de yì si shì nǐ xiǎng zuò yì jiā zhī wáng ma",
      "english": "Little Ming’s Mom: “Missing a dot”? The “head” (主) in “head of the family” without a dot … isn’t that “king” (王)?"
    },
    {
      "index": 16,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "What you are saying is that you want to be “the king of the family”!?"
    }
  ],
