{
  "id": "728",
  "title": "How Are You?",
  "level": "newbie",
  "date": "2019-05-23",
  "synopsis": "Ben and Lili haven’t seen each other for a long time.",
  "audioUrl": "https://static.duchinese.net/documents/1051/222fa60830f5f2ab0b3aa6b5c38c2db25807bb07.mp3?1558086957",
  "series": null,
  "fullText": {
    "simplified": "你好吗？\n\n本：丽丽，好久不见！你好吗？\n丽丽：我很好，谢谢！你呢？\n本：我也很好。你的妈妈怎么样？病好了吗？\n丽丽：她的病好了。谢谢！",
    "traditional": "你好嗎？\n\n本：麗麗，好久不見！你好嗎？\n麗麗：我很好，謝謝！你呢？\n本：我也很好。你的媽媽怎麼樣？病好了嗎？\n麗麗：她的病好了。謝謝！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "How Are You?"
    },
    {
      "index": 2,
      "simplified": "本：丽丽，好久不见！你好吗？",
      "traditional": "本：麗麗，好久不見！你好嗎？",
      "pinyin": "běn lì lì hǎo jiǔ bu jiàn nǐ hǎo ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Lili, long time no see! How are you?"
    },
    {
      "index": 4,
      "simplified": "丽丽：我很好，谢谢！你呢？",
      "traditional": "麗麗：我很好，謝謝！你呢？",
      "pinyin": "lì lì wǒ hěn hǎo xiè xie nǐ ne",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I’m very well, thank you! How about you?"
    },
    {
      "index": 6,
      "simplified": "本：我也很好。你的妈妈怎么样？病好了吗？",
      "traditional": "本：我也很好。你的媽媽怎麼樣？病好了嗎？",
      "pinyin": "běn wǒ yě hěn hǎo nǐ de mā ma zěn me yàng bìng hǎo le ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I’m also very well. How is your mom? Is she well again?"
    },
    {
      "index": 8,
      "simplified": "丽丽：她的病好了。谢谢！",
      "traditional": "麗麗：她的病好了。謝謝！",
      "pinyin": "lì lì tā de bìng hǎo le xiè xie",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Lili: She is well again. Thank you!"
    }
  ],
