    },
    {
      "index": 4,
      "simplified": "店员：您好，一共15块。",
      "traditional": "店員：您好，一共15塊。",
      "pinyin": "diàn yuán nín hǎo yí gòng 2 kuài",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: Hello. 15 yuan altogether."
    },
    {
      "index": 6,
      "simplified": "本：我用手机付。",
      "traditional": "本：我用手機付。",
      "pinyin": "běn wǒ yòng shǒu jī fù",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I’ll pay with my phone."
    },
    {
      "index": 8,
      "simplified": "店员：好的。微信请扫这个码。",
      "traditional": "店員：好的。微信請掃這個碼。",
      "pinyin": "diàn yuán hǎo de wēi xìn qǐng sǎo zhè ge mǎ",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: Ok. Please scan this code using WeChat."
    },
    {
      "index": 10,
      "simplified": "本：可以用支付宝吗？",
      "traditional": "本：可以用支付寶嗎？",
      "pinyin": "běn kě yǐ yòng zhī fù bǎo ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Can I use AliPay?"
    },
    {
      "index": 12,
      "simplified": "店员：可以。我扫您。",
      "traditional": "店員：可以。我掃您。",
      "pinyin": "diàn yuán kě yǐ wǒ sǎo nín",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: Yes. I’ll scan you."
    },
    {
      "index": 14,
      "simplified": "本：好的，这个。",
      "traditional": "本：好的，這個。",
      "pinyin": "běn hǎo de zhè ge",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Ok, here."
    },
    {
      "index": 16,
      "simplified": "（机器音，滴！）",
      "traditional": "（機器音，滴！）",
      "pinyin": "jī qì yīn dī",
