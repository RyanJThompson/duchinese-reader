    "sentence_translations": [
      "Hotel Check-in",
      "",
      "Front desk: Hello! Is there anything I can help you with?",
      "",
      "Amy: Hello! I booked a room on Booking. My name is Amy.",
      "",
      "Front desk: Okay. May I have your passport, please?",
      "",
      "Amy: Here you go.",
      "",
      "Front desk: Thank you, here is your passport. We’re delighted that you are staying at our hotel.",
      "You have booked a single room for nine nights for a total of 2,900 RMB.",
      "",
      "Amy: Okay. Can I pay by card?",
      "",
      "Front desk: Yes.",
      "",
      "Front desk: Done. Welcome to the Beijing Hotel. Here is your key card.",
      "Your room number is 607, on the sixth floor. Please take the elevator from here to the sixth floor.",
      "The room you booked includes breakfast. Breakfast time is from 7 am to 10 am every day.",
      "",
      "Amy: Okay. Thank you! Is there wifi here?",
      "",
      "Front desk: Yes. The wifi password is on the key card. Please hold onto it.",
      "",
      "Amy: Thank you!"
    ]
  }
