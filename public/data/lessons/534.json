{
  "id": "534",
  "title": "Looking at Your Phone",
  "level": "elementary",
  "date": "2018-09-22",
  "synopsis": "Why is Paul looking at his phone on his first date with Little Le?",
  "audioUrl": "https://static.duchinese.net/documents/840/fa234bf91bff25b9a4d85f17db81dd2400309108.mp3?1536666374",
  "series": null,
  "fullText": {
    "simplified": "看手机\n\n    小乐和保罗第一次约会。小乐很喜欢保罗，但他们聊了一会儿后，保罗开始看手机。小乐觉得保罗应该不喜欢自己，就说：“那我先走了。”保罗说：“你等等。我在搜怎么和自己喜欢的女孩聊天。”",
    "traditional": "看手機\n\n    小樂和保羅第一次約會。小樂很喜歡保羅，但他們聊了一會兒後，保羅開始看手機。小樂覺得保羅應該不喜歡自己，就說：“那我先走了。”保羅說：“你等等。我在搜怎麼和自己喜歡的女孩聊天。”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Looking at Your Phone"
    },
    {
      "index": 2,
      "simplified": "小乐和保罗第一次约会。",
      "traditional": "小樂和保羅第一次約會。",
      "pinyin": "xiǎo lè hé bǎo luó dì yī cì yuē huì",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "小乐很喜欢保罗，但他们聊了一会儿后，保罗开始看手机。",
      "traditional": "小樂很喜歡保羅，但他們聊了一會兒後，保羅開始看手機。",
      "pinyin": "xiǎo lè hěn xǐ huan bǎo luó dàn tā men liáo le yí huì'r hòu bǎo luó kāi shǐ kàn shǒu jī",
      "english": "Little He and Paul were on their first date."
    },
    {
      "index": 4,
      "simplified": "小乐觉得保罗应该不喜欢自己，就说：“那我先走了。”",
      "traditional": "小樂覺得保羅應該不喜歡自己，就說：“那我先走了。”",
      "pinyin": "xiǎo lè jué de bǎo luó yīng gāi bù xǐ huan zì jǐ jiù shuō nà wǒ xiān zǒu le",
      "english": "Little Le really liked Paul, but after talking for a while Paul started to look at his phone."
    },
    {
      "index": 5,
      "simplified": "保罗说：“你等等。我在搜怎么和自己喜欢的女孩聊天。”",
      "traditional": "保羅說：“你等等。我在搜怎麼和自己喜歡的女孩聊天。”",
      "pinyin": "bǎo luó shuō nǐ děng děng wǒ zài sōu zěn me hé zì jǐ xǐ huan de nǚ hái liáo tiān",
      "english": "Little Le felt that Paul probably didn't like her, so she said: “I’ll be going then.”"
    }
  ],
