      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Gao Tian: I am Japanese. My father is Chinese, and my mother is Japanese."
    },
    {
      "index": 8,
      "simplified": "Anne：我爸爸是美国人，我妈妈是中国人。你多大了？",
      "traditional": "Anne：我爸爸是美國人，我媽媽是中國人。你多大了？",
      "pinyin": "1 wǒ bà ba shì měi guó rén wǒ mā ma shì zhōng guó rén nǐ duō dà le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: My father is American. My mother is Chinese. How old are you?"
    },
    {
      "index": 10,
      "simplified": "高天：我十九岁，你呢？",
      "traditional": "高天：我十九歲，你呢？",
      "pinyin": "gāo tiān wǒ shí jiǔ suì nǐ ne",
