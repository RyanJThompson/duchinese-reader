{
  "id": "E219",
  "title": "Paul’s Wi-Fi Password",
  "level": "newbie",
  "date": "2018-05-17",
  "synopsis": "Paul’s Wi-Fi password is quite funny.",
  "audioUrl": "https://static.duchinese.net/documents/736/3906f1bdf3bb3155ba4e86e16bb095a8f3f03ea9.mp3?1525687527",
  "series": null,
  "fullText": {
    "simplified": "你家的Wi-Fi密码是多少？\n\n小乐：保罗，你家的Wi-Fi密码是多少？\n保罗：“不知道”。\n小乐：你怎么会不知道自己的Wi-Fi密码?\n保罗：密码就是“不知道”的拼音，哈哈！是不是很好玩儿？\n小乐：一点都不好玩……",
    "traditional": "你家的Wi-Fi密碼是多少？\n\n小樂：保羅，你家的Wi-Fi密碼是多少？\n保羅：“不知道”。\n小樂：你怎麼會不知道自己的Wi-Fi密碼?\n保羅：密碼就是“不知道”的拼音，哈哈！是不是很好玩兒？\n小樂：一點都不好玩……"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "What is the Wi-Fi password in your home?"
    },
    {
      "index": 2,
      "simplified": "小乐：保罗，你家的Wi-Fi密码是多少？",
      "traditional": "小樂：保羅，你家的Wi-Fi密碼是多少？",
      "pinyin": "xiǎo lè bǎo luó nǐ jiā de 2 mì mǎ shì duō shao",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Paul, what’s the Wi-Fi password in your home?"
    },
    {
      "index": 4,
      "simplified": "保罗：“不知道”。",
      "traditional": "保羅：“不知道”。",
      "pinyin": "bǎo luó bù zhī dào",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: “I don’t know”."
    },
    {
      "index": 6,
      "simplified": "小乐：你怎么会不知道自己的Wi-Fi密码?",
      "traditional": "小樂：你怎麼會不知道自己的Wi-Fi密碼?",
      "pinyin": "xiǎo lè nǐ zěn me huì bù zhī dào zì jǐ de 2 mì mǎ",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: How can you not know your own Wi-Fi password?"
    },
    {
      "index": 8,
      "simplified": "保罗：密码就是“不知道”的拼音，哈哈！是不是很好玩儿？",
      "traditional": "保羅：密碼就是“不知道”的拼音，哈哈！是不是很好玩兒？",
      "pinyin": "bǎo luó mì mǎ jiù shì bù zhī dào de pīn yīn hā hā shì bú shì hěn hǎo wán‘r",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: The password is the pinyin for “buzhidao”, haha! Isn’t it funny?"
    },
    {
      "index": 10,
      "simplified": "小乐：一点都不好玩……",
      "traditional": "小樂：一點都不好玩……",
      "pinyin": "xiǎo lè yì diǎn dōu bù hǎo wán",
      "english": ""
    }
  ],
