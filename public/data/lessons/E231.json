{
  "id": "E231",
  "title": "Have a Guess",
  "level": "elementary",
  "date": "2018-06-23",
  "synopsis": "Wang Ping asks her colleague to guess how old she is.",
  "audioUrl": "https://static.duchinese.net/documents/768/8d835b570c5691a5ab30524b283c1ae69d2a7fd5.mp3?1529323579",
  "series": null,
  "fullText": {
    "simplified": "你猜\n\n同事：你今年多大了？\n王萍：你猜。\n同事：26？\n王萍：不对。\n同事：猜大了还是小了？\n王萍：小了。再猜猜。\n同事：28？\n王萍：还是小了。我已经35岁了。\n同事：真的吗？你看起来很年轻啊！\n王萍：哈哈，谢谢你的夸奖。",
    "traditional": "你猜\n\n同事：你今年多大了？\n王萍：你猜。\n同事：26？\n王萍：不對。\n同事：猜大了還是小了？\n王萍：小了。再猜猜。\n同事：28？\n王萍：還是小了。我已經35歲了。\n同事：真的嗎？你看起來很年輕啊！\n王萍：哈哈，謝謝你的誇獎。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Have a Guess"
    },
    {
      "index": 2,
      "simplified": "同事：你今年多大了？",
      "traditional": "同事：你今年多大了？",
      "pinyin": "tóng shì nǐ jīn nián duō dà le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Colleague: How old are you this year?"
    },
    {
      "index": 4,
      "simplified": "王萍：你猜。",
      "traditional": "王萍：你猜。",
      "pinyin": "wáng píng nǐ cāi",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Wang Ping: Guess."
    },
    {
      "index": 6,
      "simplified": "同事：26？",
      "traditional": "同事：26？",
      "pinyin": "tóng shì 3",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Colleague: 26?"
    },
    {
      "index": 8,
      "simplified": "王萍：不对。",
      "traditional": "王萍：不對。",
      "pinyin": "wáng píng bú duì",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Wang Ping: Wrong."
    },
    {
      "index": 10,
      "simplified": "同事：猜大了还是小了？",
      "traditional": "同事：猜大了還是小了？",
      "pinyin": "tóng shì cāi dà le hái shi xiǎo le",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Colleague: Did I guess too high or too low?"
    },
    {
      "index": 12,
      "simplified": "王萍：小了。再猜猜。",
      "traditional": "王萍：小了。再猜猜。",
      "pinyin": "wáng píng xiǎo le zài cāi cāi",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Wang Ping: Too low. Guess again."
    },
    {
      "index": 14,
      "simplified": "同事：28？",
      "traditional": "同事：28？",
      "pinyin": "tóng shì 3",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Colleague: 28?"
    },
    {
      "index": 16,
      "simplified": "王萍：还是小了。我已经35岁了。",
      "traditional": "王萍：還是小了。我已經35歲了。",
      "pinyin": "wáng píng hái shi xiǎo le wǒ yǐ jīng 3 suì le",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Wang Ping: Still too low. I’m 35 years old."
    },
    {
      "index": 18,
      "simplified": "同事：真的吗？你看起来很年轻啊！",
      "traditional": "同事：真的嗎？你看起來很年輕啊！",
      "pinyin": "tóng shì zhēn de ma nǐ kàn qǐ lái hěn nián qīng a",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Colleague: Really? You look very young!"
    },
    {
      "index": 20,
      "simplified": "王萍：哈哈，谢谢你的夸奖。",
      "traditional": "王萍：哈哈，謝謝你的誇獎。",
      "pinyin": "wáng píng hā hā xiè xie nǐ de kuā jiǎng",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Wang Ping: Haha, thank you for your praise."
    }
  ],
