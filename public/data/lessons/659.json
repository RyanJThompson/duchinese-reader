{
  "id": "659",
  "title": "Hurry Up and Eat",
  "level": "intermediate",
  "date": "2019-02-10",
  "synopsis": "Little Ming has a stressful breakfast.",
  "audioUrl": "https://static.duchinese.net/documents/961/99c9b516ae90210959760242385af1191462f55f.mp3?1698350172",
  "series": null,
  "fullText": {
    "simplified": "快吃\n\n妈妈：小明，快没时间了。你快点吃！\n小明：我不想吃！\n妈妈：快吃！面包吃不下就算了，快把鸡蛋吃了！\n小明：好吧！\n妈妈：唉，你要是早点起来不就好了。\n小明：我不吃了。\n妈妈：等会儿！把牛奶喝完！\n小明：唉……\n妈妈：快点，快点！要迟到了！",
    "traditional": "快吃\n\n媽媽：小明，快沒時間了。你快點吃！\n小明：我不想吃！\n媽媽：快吃！麵包吃不下就算了，快把雞蛋吃了！\n小明：好吧！\n媽媽：唉，你要是早點起來不就好了。\n小明：我不吃了。\n媽媽：等會兒！把牛奶喝完！\n小明：唉……\n媽媽：快點，快點！要遲到了！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Hurry Up and Eat"
    },
    {
      "index": 2,
      "simplified": "妈妈：小明，快没时间了。你快点吃！",
      "traditional": "媽媽：小明，快沒時間了。你快點吃！",
      "pinyin": "mā ma xiǎo míng kuài méi shí jiān le nǐ kuài diǎn chī",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Little Ming, we’re running out of time. Hurry up and eat!"
    },
    {
      "index": 4,
      "simplified": "小明：我不想吃！",
      "traditional": "小明：我不想吃！",
      "pinyin": "xiǎo míng wǒ bù xiǎng chī",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I don’t want to eat!"
    },
    {
      "index": 6,
      "simplified": "妈妈：快吃！面包吃不下就算了，快把鸡蛋吃了！",
      "traditional": "媽媽：快吃！麵包吃不下就算了，快把雞蛋吃了！",
      "pinyin": "mā ma kuài chī miàn bāo chī bú xià jiù suàn le kuài bǎ jī dàn chī le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Hurry up and eat! It doesn’t matter if you can’t finish the bread. Hurry up and eat the eggs!"
    },
    {
      "index": 8,
      "simplified": "小明：好吧！",
      "traditional": "小明：好吧！",
      "pinyin": "xiǎo míng hǎo ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Alright!"
    },
    {
      "index": 10,
      "simplified": "妈妈：唉，你要是早点起来不就好了。",
      "traditional": "媽媽：唉，你要是早點起來不就好了。",
      "pinyin": "mā ma ài nǐ yào shi zǎo diǎn qǐ lai bú jiù hǎo le",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Sigh, couldn’t you just get up a bit earlier?"
    },
    {
      "index": 12,
      "simplified": "小明：我不吃了。",
      "traditional": "小明：我不吃了。",
      "pinyin": "xiǎo míng wǒ bù chī le",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I’m not eating any more."
    },
    {
      "index": 14,
      "simplified": "妈妈：等会儿！把牛奶喝完！",
      "traditional": "媽媽：等會兒！把牛奶喝完！",
      "pinyin": "mā ma děng huì'r bǎ niú nǎi hē wán",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Wait! Drink up your milk!"
    },
    {
      "index": 16,
      "simplified": "小明：唉……",
      "traditional": "小明：唉……",
      "pinyin": "xiǎo míng ài",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Sigh…"
    },
    {
      "index": 18,
      "simplified": "妈妈：快点，快点！要迟到了！",
      "traditional": "媽媽：快點，快點！要遲到了！",
      "pinyin": "mā ma kuài diǎn kuài diǎn yào chí dào le",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Mom: Hurry, hurry! We are going to be late!"
    }
  ],
