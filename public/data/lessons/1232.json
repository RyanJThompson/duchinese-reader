    "sentence_translations": [
      "How Many Heads Does a Cow Have?",
      "",
      "Little Ming: Little Hong, let me ask you, how many heads does a cow have?",
      "",
      "Little Hong: One.",
      "",
      "Little Ming: How many legs does a cow have?",
      "",
      "Little Hong: Four.",
      "",
      "Little Ming: How much hair does a cow have?",
      "",
      "Little Hong: A cow has so much hair, how would I know how many hairs it has?",
      "",
      "Little Ming: I’ll tell you. It has one coat of hair!",
      "",
      "Little Hong: Alright …",
      "",
      "Little Ming: Then I’ll ask you one more time, how much hair does a cow have?",
      "",
      "Little Hong: A coat of hair.",
      "",
      "Little Ming: Why? (What do you feed it?)",
      "",
      "Little Hong: How would I know why?",
      "",
      "Little Ming: You feed it grass!",
      ""
    ]
