    },
    {
      "index": 3,
      "simplified": "我现在在中国学汉语，我学汉语两年了。",
      "traditional": "我現在在中國學漢語，我學漢語兩年了。",
      "pinyin": "wǒ xiàn zài zài zhōng guó xué hàn yǔ wǒ xué hàn yǔ liǎng nián le",
      "english": "My name is Ben and I'm from the USA. I'm 20 years old and like to watch movies."
    },
    {
      "index": 4,
      "simplified": "我很喜欢中国，我有很多中国朋友，丽丽、小雨都是我的好朋友。",
      "traditional": "我很喜歡中國，我有很多中國朋友，麗麗、小雨都是我的好朋友。",
      "pinyin": "wǒ hěn xǐ huan zhōng guó wǒ yǒu hěn duō zhōng guó péng you lì lì xiǎo yǔ dōu shì wǒ de hǎo péng you",
      "english": "I'm currently in China to study Chinese. I've studied Chinese for 2 years."
    },
    {
      "index": 5,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "I really like China. I have many Chinese friends. Lili and Little Yu are both my good friends."
    }
