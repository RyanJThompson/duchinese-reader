{
  "id": "514",
  "title": "A Riddle Of Doing",
  "level": "newbie",
  "date": "2018-03-08",
  "synopsis": "Can you guess the answer to the riddle?",
  "audioUrl": "https://static.duchinese.net/documents/674/bde4ec426d1173dc1f632336a3cbb8eb2fcf9e88.mp3?1519569576",
  "series": null,
  "fullText": {
    "simplified": "这是做什么？ \n\n    你能做，我能做，大家都做；一个人能做，两个人不能一起做。这是做什么？ \n    这是一个IQ题，请想一想！\n    想出来了吗？那就是：做梦。",
    "traditional": "這是做什麼？ \n\n    你能做，我能做，大家都做；一個人能做，兩個人不能一起做。這是做什麼？ \n    這是一個IQ題，請想一想！\n    想出來了嗎？那就是：做夢。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": " \n\n    ",
      "traditional": " \n\n    ",
      "pinyin": "",
      "english": "What are we doing?"
    },
    {
      "index": 2,
      "simplified": "你能做，我能做，大家都做；",
      "traditional": "你能做，我能做，大家都做；",
      "pinyin": "nǐ néng zuò wǒ néng zuò dà jiā dōu zuò",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "一个人能做，两个人不能一起做。",
      "traditional": "一個人能做，兩個人不能一起做。",
      "pinyin": "yí ge rén néng zuò liǎng ge rén bù néng yì qǐ zuò",
      "english": "You can do it. I can do it. Everyone does it."
    },
    {
      "index": 4,
      "simplified": "这是做什么？",
      "traditional": "這是做什麼？",
      "pinyin": "zhè shì zuò shén me",
      "english": "One person can do it, but two people cannot do it together."
    },
    {
      "index": 5,
      "simplified": " \n    ",
      "traditional": " \n    ",
      "pinyin": "",
      "english": "What are we doing?"
    },
    {
      "index": 6,
      "simplified": "这是一个IQ题，请想一想！",
      "traditional": "這是一個IQ題，請想一想！",
      "pinyin": "zhè shì yí ge 2 tí qǐng xiǎng yi xiǎng",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "This is an IQ question. Please think about it for a while!"
    },
    {
      "index": 8,
      "simplified": "想出来了吗？那就是：做梦。",
      "traditional": "想出來了嗎？那就是：做夢。",
      "pinyin": "xiǎng chū lái le ma nà jiù shì zuò mèng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Did you get it? The answer is: to dream."
    }
  ],
