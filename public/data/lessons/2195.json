      "english": ""
    },
    {
      "index": 10,
      "simplified": "“可乐有主人了，主人带她回家了。对不起。”小亮说。",
      "traditional": "“可樂有主人了，主人帶她回家了。對不起。”小亮說。",
      "pinyin": "kě lè yǒu zhǔ rén le zhǔ rén dài tā huí jiā le duì bu qǐ xiǎo liàng shuō",
      "english": "“Cola has an owner now. The owner took her home. I’m sorry,” Little Liang said."
    },
    {
      "index": 11,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "钱多多哭了，说：“可乐不见了！没有人喜欢我了！你们都不喜欢我！！”",
      "traditional": "錢多多哭了，說：“可樂不見了！沒有人喜歡我了！你們都不喜歡我！！”",
      "pinyin": "qián duō duō kū le shuō kě lè bú jiàn le méi yǒu rén xǐ huan wǒ le nǐ men dōu bù xǐ huan wǒ",
      "english": "Qian Duoduo cried and said, “Cola is gone! Nobody likes me! Even you guys don’t like me!!”"
    },
    {
      "index": 13,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "钱多多哭了。小亮不说话，他和钱多多一起喝酒。",
      "traditional": "錢多多哭了。小亮不說話，他和錢多多一起喝酒。",
      "pinyin": "qián duō duō kū le xiǎo liàng bù shuō huà tā hé qián duō duō yì qǐ hē jiǔ",
      "english": "Qian Duoduo cried. Little Liang didn’t say anything. He drank alcohol together with Qian Duoduo."
    },
    {
      "index": 15,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 16,
      "simplified": "店里有很多狗，他们和钱多多一起玩。",
      "traditional": "店裡有很多狗，他們和錢多多一起玩。",
      "pinyin": "diàn lǐ yǒu hěn duō gǒu tā men hé qián duō duō yì qǐ wán",
      "english": "There were a lot of dogs in the store. They all played together with Qian Duoduo."
    },
    {
      "index": 17,
      "simplified": "钱多多好一些了，但是没有可乐，她很想可乐……",
      "traditional": "錢多多好一些了，但是沒有可樂，她很想可樂……",
      "pinyin": "qián duō duō hǎo yì xiē le dàn shì méi yǒu kě lè tā hěn xiǎng kě lè",
      "english": "Qian Duoduo felt a bit better, but there was no Cola. She really missed Cola …"
    },
    {
      "index": 18,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "晚上十点，钱多多回家了。",
      "traditional": "晚上十點，錢多多回家了。",
      "pinyin": "wǎn shang shí diǎn qián duō duō huí jiā le",
      "english": "At 10 o’clock in the evening, Qian Duoduo returned home."
    }
