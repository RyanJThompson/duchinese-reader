      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Let’s go watch a movie today."
    },
    {
      "index": 4,
      "simplified": "何京：今天要工作。明天再说吧！",
      "traditional": "何京：今天要工作。明天再說吧！",
      "pinyin": "hé jīng jīn tiān yào gōng zuò míng tiān zài shuō ba",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "He Jing: I have to work today. Let’s talk about it tomorrow!"
    },
    {
      "index": 6,
      "simplified": "丽丽：那我们这个星期天去买衣服吧。",
      "traditional": "麗麗：那我們這個星期天去買衣服吧。",
      "pinyin": "lì lì nà wǒ men zhè ge xīng qī tiān qù mǎi yī fu ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Then let’s go buy clothes this Sunday."
    },
    {
      "index": 8,
      "simplified": "何京：我星期天有事，下个星期再说吧！",
      "traditional": "何京：我星期天有事，下個星期再說吧！",
      "pinyin": "hé jīng wǒ xīng qī tiān yǒu shì xià ge xīng qī zài shuō ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "He Jing: I’m busy on Sunday. Let’s discuss it next week!"
    },
    {
      "index": 10,
      "simplified": "丽丽：我们好久没去旅游了，今年秋天我们去日本玩吧！",
      "traditional": "麗麗：我們好久沒去旅遊了，今年秋天我們去日本玩吧！",
      "pinyin": "lì lì wǒ men hǎo jiǔ méi qù lǚ yóu le jīn nián qiū tiān wǒ men qù rì běn wán ba",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: We haven’t traveled for a long time. Let’s travel to Japan this fall!"
    },
    {
      "index": 12,
      "simplified": "何京：那么久以后的事，以后的事以后再说吧！",
      "traditional": "何京：那麼久以後的事，以後的事以後再說吧！",
      "pinyin": "hé jīng nà me jiǔ yǐ hòu de shì yǐ hòu de shì yǐ hòu zài shuō ba",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "He Jing: That’s so far in the future. Let’s talk about things that far in the future later!"
    },
    {
      "index": 14,
      "simplified": "丽丽：再说，再说，我看你就是不想和我出去玩儿。",
      "traditional": "麗麗：再說，再說，我看你就是不想和我出去玩兒。",
      "pinyin": "lì lì zài shuō zài shuō wǒ kàn nǐ jiù shì bù xiǎng hé wǒ chū qù wán'r",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Lili: Later, later. It seems like you don’t want to do things together with me."
    }
