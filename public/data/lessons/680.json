      "pinyin": "xiǎo yǔ nǐ de yǎn jing zhēn hǎo kàn",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Your eyes are really pretty!"
    },
    {
      "index": 4,
      "simplified": "本：谢谢你！你的眼睛也好看！",
      "traditional": "本：謝謝你！你的眼睛也好看！",
      "pinyin": "běn xiè xie nǐ nǐ de yǎn jing yě hǎo kàn",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Thank you! Your eyes are pretty too!"
    },
    {
      "index": 6,
      "simplified": "小雨：我的眼睛是单眼皮的，不好看。",
      "traditional": "小雨：我的眼睛是單眼皮的，不好看。",
      "pinyin": "xiǎo yǔ wǒ de yǎn jing shì dān yǎn pí de bù hǎo kàn",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: My eyes have single eyelids, so they're not pretty."
    },
    {
      "index": 8,
      "simplified": "本：单眼皮？",
      "traditional": "本：單眼皮？",
      "pinyin": "běn dān yǎn pí",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Single eyelids?"
    },
    {
      "index": 10,
      "simplified": "小雨：看！单眼皮，眼睛小。你的，双眼皮，眼睛大。",
      "traditional": "小雨：看！單眼皮，眼睛小。你的，雙眼皮，眼睛大。",
      "pinyin": "xiǎo yǔ kàn dān yǎn pí yǎn jing xiǎo nǐ de shuāng yǎn pí yǎn jing dà",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu: Look! With single eyelids, the eyes look small. Yours have double eyelids, so your eyes look big."
    }
