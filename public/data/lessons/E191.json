{
  "id": "E191",
  "title": "Your Package Arrived",
  "level": "elementary",
  "date": "2018-02-03",
  "synopsis": "What do you say when the delivery man calls you?",
  "audioUrl": "https://static.duchinese.net/documents/647/7824d7621653985b69a17da28f6e5de99b166418.mp3?1517217144",
  "series": null,
  "fullText": {
    "simplified": "你的快递到了  \n\n快递员：你好，你的快递到了。家里没有人，放在哪里？\n林红：你好，请把快递放在我家门口。\n快递员：我不能进小区。\n林红：那把快递放在门卫那里吧。谢谢！\n快递员：好的！",
    "traditional": "你的快遞到了  \n\n快遞員：你好，你的快遞到了。家裡沒有人，放在哪裏？\n林紅：你好，請把快遞放在我家門口。\n快遞員：我不能進小區。\n林紅：那把快遞放在門衛那裡吧。謝謝！\n快遞員：好的！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Your Package Arrived"
    },
    {
      "index": 2,
      "simplified": "快递员：你好，你的快递到了。家里没有人，放在哪里？",
      "traditional": "快遞員：你好，你的快遞到了。家裡沒有人，放在哪裏？",
      "pinyin": "kuài dì yuán nǐ hǎo nǐ de kuài dì dào le jiā lǐ méi yǒu rén fàng zài nǎ lǐ",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Delivery man: Hello! Your package arrived. No one is at home. Where should I put it?"
    },
    {
      "index": 4,
      "simplified": "林红：你好，请把快递放在我家门口。",
      "traditional": "林紅：你好，請把快遞放在我家門口。",
      "pinyin": "lín hóng nǐ hǎo qǐng bǎ kuài dì fàng zài wǒ jiā mén kǒu",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lin Hong: Hello! Please put it at my door."
    },
    {
      "index": 6,
      "simplified": "快递员：我不能进小区。",
      "traditional": "快遞員：我不能進小區。",
      "pinyin": "kuài dì yuán wǒ bù néng jìn xiǎo qū",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Delivery man: I can't get through the gate to the community."
    },
    {
      "index": 8,
      "simplified": "林红：那把快递放在门卫那里吧。谢谢！",
      "traditional": "林紅：那把快遞放在門衛那裡吧。謝謝！",
      "pinyin": "lín hóng nà bǎ kuài dì fàng zài mén wèi nà lǐ ba xiè xie",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lin Hong: Then please leave it at the security gate. Thank you!"
    },
    {
      "index": 10,
      "simplified": "快递员：好的！",
      "traditional": "快遞員：好的！",
      "pinyin": "kuài dì yuán hǎo de",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Delivery man: Ok!"
    }
  ],
