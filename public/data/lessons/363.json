{
  "id": "363",
  "title": "Did You Bring Your Phone?",
  "level": "elementary",
  "date": "2017-09-22",
  "synopsis": "Little Li wants to borrow Ben's phone to make a call.",
  "audioUrl": "https://static.duchinese.net/documents/532/1ae5ecd35db69e117fcaee69483c283be68e7d61.mp3?1554973095",
  "series": {
    "title": "Ben’s life in China 2: Lili’s Boyfriend",
    "chapter": 7,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你带手机了吗？\n\n丽丽：本，你带手机了吗？\n本：带了。怎么了？\n丽丽：借你手机给我打个电话。\n本：好。给！\n丽丽：嗯？你手机里没有保罗的号码吗？\n本：没有。他没有给我。",
    "traditional": "你帶手機了嗎？\n\n麗麗：本，你帶手機了嗎？\n本：帶了。怎麼了？\n麗麗：借你手機給我打個電話。\n本：好。給！\n麗麗：嗯？你手機裡沒有保羅的號碼嗎？\n本：沒有。他沒有給我。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Did you bring your mobile phone?"
    },
    {
      "index": 2,
      "simplified": "丽丽：本，你带手机了吗？",
      "traditional": "麗麗：本，你帶手機了嗎？",
      "pinyin": "lì lì běn nǐ dài shǒu jī le ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Li: Ben, did you bring your mobile phone?"
    },
    {
      "index": 4,
      "simplified": "本：带了。怎么了？",
      "traditional": "本：帶了。怎麼了？",
      "pinyin": "běn dài le zěn me le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I did. Why?"
    },
    {
      "index": 6,
      "simplified": "丽丽：借你手机给我打个电话。",
      "traditional": "麗麗：借你手機給我打個電話。",
      "pinyin": "lì lì jiè nǐ shǒu jī gěi wǒ dǎ ge diàn huà",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Li: Lend me your phone so I can make a phone call."
    },
    {
      "index": 8,
      "simplified": "本：好。给！",
      "traditional": "本：好。給！",
      "pinyin": "běn hǎo gěi",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Ok, here!"
    },
    {
      "index": 10,
      "simplified": "丽丽：嗯？你手机里没有保罗的号码吗？",
      "traditional": "麗麗：嗯？你手機裡沒有保羅的號碼嗎？",
      "pinyin": "lì lì èn nǐ shǒu jī lǐ méi yǒu bǎo luó de hào mǎ ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Li: Hmm? You don't have Paul's number in your phone?"
    },
    {
      "index": 12,
      "simplified": "本：没有。他没有给我。",
      "traditional": "本：沒有。他沒有給我。",
      "pinyin": "běn méi yǒu tā méi yǒu gěi wǒ",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: I don't. He hasn't given it to me."
    }
  ],
