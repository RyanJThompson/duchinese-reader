{
  "id": "E243",
  "title": "Second Cup Half Price",
  "level": "elementary",
  "date": "2018-08-04",
  "synopsis": "Will you buy two cups because of a promotion?",
  "audioUrl": "https://static.duchinese.net/documents/809/f0aaa0b79f95e9895f102df5219369ce1d103a6e.mp3?1532935069",
  "series": null,
  "fullText": {
    "simplified": "第二杯半价\n\n小乐：我们去喝奶茶吧！\n保罗：我有点累，不想去。\n小乐：奶茶店不太远，我们一起去吧。\n保罗：你是不是想去那家新的奶茶店？\n小乐：是的，他们现在第二杯半价。",
    "traditional": "第二杯半價\n\n小樂：我們去喝奶茶吧！\n保羅：我有點累，不想去。\n小樂：奶茶店不太遠，我們一起去吧。\n保羅：你是不是想去那家新的奶茶店？\n小樂：是的，他們現在第二杯半價。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Second Cup Half Price"
    },
    {
      "index": 2,
      "simplified": "小乐：我们去喝奶茶吧！",
      "traditional": "小樂：我們去喝奶茶吧！",
      "pinyin": "xiǎo lè wǒ men qù hē nǎi chá ba",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Let’s go drink milk tea!"
    },
    {
      "index": 4,
      "simplified": "保罗：我有点累，不想去。",
      "traditional": "保羅：我有點累，不想去。",
      "pinyin": "bǎo luó wǒ yǒu diǎn lèi bù xiǎng qù",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: I’m a bit tired. I don’t want to go."
    },
    {
      "index": 6,
      "simplified": "小乐：奶茶店不太远，我们一起去吧。",
      "traditional": "小樂：奶茶店不太遠，我們一起去吧。",
      "pinyin": "xiǎo lè nǎi chá diàn bú tài yuǎn wǒ men yì qǐ qù ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: The milk tea shop is not too far away. Let’s go together."
    },
    {
      "index": 8,
      "simplified": "保罗：你是不是想去那家新的奶茶店？",
      "traditional": "保羅：你是不是想去那家新的奶茶店？",
      "pinyin": "bǎo luó nǐ shì bu shì xiǎng qù nà jiā xīn de nǎi chá diàn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: You want to go to that new milk tea shop, right?"
    },
    {
      "index": 10,
      "simplified": "小乐：是的，他们现在第二杯半价。",
      "traditional": "小樂：是的，他們現在第二杯半價。",
      "pinyin": "xiǎo lè shì de tā men xiàn zài dì èr bēi bàn jià",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: Yes, it’s half price for the second cup now."
    }
  ],
