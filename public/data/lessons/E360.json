{
  "id": "E360",
  "title": "Oh C’mon!",
  "level": "elementary",
  "date": "2019-09-14",
  "synopsis": "A good way of saying “oh come on” in Chinese.",
  "audioUrl": "https://static.duchinese.net/documents/1150/ff74725168a5a3e4fee09a94a0c5c0fd328feff9.mp3?1568022028",
  "series": null,
  "fullText": {
    "simplified": "拜托\n\n保罗：这个周末是小乐的生日。你帮我想想送什么礼物吧？\n丽丽：法拉利！\n保罗：拜托，这个太贵了啊！\n丽丽：巧克力？\n保罗：拜托，这个太普通了吧！\n丽丽：拜托，我说的都不行？那你自己想吧！",
    "traditional": "拜託\n\n保羅：這個週末是小樂的生日。你幫我想想送什麼禮物吧？\n麗麗：法拉利！\n保羅：拜託，這個太貴了啊！\n麗麗：巧克力？\n保羅：拜託，這個太普通了吧！\n麗麗：拜託，我說的都不行？那你自己想吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Oh C’mon!"
    },
    {
      "index": 2,
      "simplified": "保罗：这个周末是小乐的生日。你帮我想想送什么礼物吧？",
      "traditional": "保羅：這個週末是小樂的生日。你幫我想想送什麼禮物吧？",
      "pinyin": "bǎo luó zhè ge zhōu mò shì xiǎo lè de shēng rì nǐ bāng wǒ xiǎng xiǎng sòng shén me lǐ wù ba",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le's birthday is this weekend. Can you help me think of what to give as a gift?"
    },
    {
      "index": 4,
      "simplified": "丽丽：法拉利！",
      "traditional": "麗麗：法拉利！",
      "pinyin": "lì lì fǎ lā lì",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: A Ferrari!"
    },
    {
      "index": 6,
      "simplified": "保罗：拜托，这个太贵了啊！",
      "traditional": "保羅：拜託，這個太貴了啊！",
      "pinyin": "bǎo luó bài tuō zhè ge tài guì le a",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Come on, that’s too expensive!"
    },
    {
      "index": 8,
      "simplified": "丽丽：巧克力？",
      "traditional": "麗麗：巧克力？",
      "pinyin": "lì lì qiǎo kè lì",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Chocolate?"
    },
    {
      "index": 10,
      "simplified": "保罗：拜托，这个太普通了吧！",
      "traditional": "保羅：拜託，這個太普通了吧！",
      "pinyin": "bǎo luó bài tuō zhè ge tài pǔ tōng le ba",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Come on, that’s too common!"
    },
    {
      "index": 12,
      "simplified": "丽丽：拜托，我说的都不行？那你自己想吧！",
      "traditional": "麗麗：拜託，我說的都不行？那你自己想吧！",
      "pinyin": "lì lì bài tuō wǒ shuō de dōu bù xíng nà nǐ zì jǐ xiǎng ba",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Lili: Come on, none of what I say works? Then you think for yourself!"
    }
  ],
