    "sentence_translations": [
      "Does Your Friend Play Basketball?",
      "",
      "Gao Tian: Does your friend play basketball?",
      "",
      "Anne: Which friend?",
      "",
      "Gao Tian: Li.",
      "",
      "Anne: He plays basketball.",
      "",
      "Gao Tian: When did you two meet?",
      "",
      "Anne: We met on August 7th this year.",
      "",
      "Gao Tian: Where did you two meet?",
      "",
      "Anne: We met on the plane.",
      "",
      "Gao Tian: On the plane?",
      "",
      "Anne: I flew to China on August 7th this year. Li was also on the plane.",
      "",
      "Gao Tian: I am going to play basketball tomorrow. Can Li come? I want to play basketball with him.",
      "",
      "Anne: What time will you play basketball tomorrow?",
      "",
      "Gao Tian: Two o’clock in the afternoon.",
      "",
      "Anne: It rained both yesterday and today. What will the weather be like tomorrow? Will it rain?",
      "",
      "Gao Tian: The weather tomorrow will be very good. It won’t rain.",
      "",
      "Anne: Okay, I’ll call to ask Li.",
      "",
      "Gao Tian: Thank you.",
      "",
      "Anne: You’re welcome."
    ]
  }
