  "title": "Does Your Friend Play Basketball?",
  "level": "newbie",
  "date": "2023-11-06",
  "synopsis": "Gao Tian wants to play basketball with Anne’s friend Li.",
  "audioUrl": "https://static.duchinese.net/documents/1990/11429397497d88ab392fb3a5e976e66d4a49a9b3.mp3?1696863122",
