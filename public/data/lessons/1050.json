      "pinyin": "yí ge xiǎo shí hòu mā ma jiàn xiǎo míng hái zài kàn zhe tiān shang de xuě",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "就问他：“你在天上找什么呢？”",
      "traditional": "就問他：“你在天上找什麼呢？”",
      "pinyin": "jiù wèn tā nǐ zài tiān shang zhǎo shén me ne",
