{
  "id": "1224",
  "title": "The Person I Like",
  "level": "newbie",
  "date": "2021-12-31",
  "synopsis": "How would you describe someone you like?",
  "audioUrl": "https://static.duchinese.net/documents/1224/1e0c1594da364cc78499dc9d69fbc135f1bf9ad1.mp3?1615290888",
  "series": {
    "title": "Ben’s life in China 5: You’re my best friend",
    "chapter": 11,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "喜欢的人\n\n小雨：你可以用一个字说一下你喜欢的人是什么样的吗？\n本：美！\n小雨：那两个字呢？\n本：漂亮！\n小雨：三个字呢？\n本：很漂亮！\n小雨：四个字呢？\n本：不喜欢我！",
    "traditional": "喜歡的人\n\n小雨：你可以用一個字說一下你喜歡的人是甚麼樣的嗎？\n本：美！\n小雨：那兩個字呢？\n本：漂亮！\n小雨：三個字呢？\n本：很漂亮！\n小雨：四個字呢？\n本：不喜歡我！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "The Person I Like"
    },
    {
      "index": 2,
      "simplified": "小雨：你可以用一个字说一下你喜欢的人是什么样的吗？",
      "traditional": "小雨：你可以用一個字說一下你喜歡的人是甚麼樣的嗎？",
      "pinyin": "xiǎo yǔ nǐ kě yǐ yòng yí ge zì shuō yí xià nǐ xǐ huan de rén shì shén me yàng de ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Can you use one character to describe the person you like?"
    },
    {
      "index": 4,
      "simplified": "本：美！",
      "traditional": "本：美！",
      "pinyin": "běn měi",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Beautiful!"
    },
    {
      "index": 6,
      "simplified": "小雨：那两个字呢？",
      "traditional": "小雨：那兩個字呢？",
      "pinyin": "xiǎo yǔ nà liǎng ge zì ne",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Then what about in two characters?"
    },
    {
      "index": 8,
      "simplified": "本：漂亮！",
      "traditional": "本：漂亮！",
      "pinyin": "běn piào liang",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Pretty!"
    },
    {
      "index": 10,
      "simplified": "小雨：三个字呢？",
      "traditional": "小雨：三個字呢？",
      "pinyin": "xiǎo yǔ sān ge zì ne",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: How about three characters?"
    },
    {
      "index": 12,
      "simplified": "本：很漂亮！",
      "traditional": "本：很漂亮！",
      "pinyin": "běn hěn piào liang",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Very pretty!"
    },
    {
      "index": 14,
      "simplified": "小雨：四个字呢？",
      "traditional": "小雨：四個字呢？",
      "pinyin": "xiǎo yǔ sì ge zì ne",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: How about four characters?"
    },
    {
      "index": 16,
      "simplified": "本：不喜欢我！",
      "traditional": "本：不喜歡我！",
      "pinyin": "běn bù xǐ huan wǒ",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Does not like me!"
    }
  ],
