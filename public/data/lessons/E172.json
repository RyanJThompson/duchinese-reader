{
  "id": "E172",
  "title": "Grandma’s Morning",
  "level": "elementary",
  "date": "2017-12-01",
  "synopsis": "Grandma has a lot to do in the morning.",
  "audioUrl": "https://static.duchinese.net/documents/591/1f218f90537148ec9bcb9360fcad3eb638ed609f.mp3?1511798156",
  "series": null,
  "fullText": {
    "simplified": "奶奶的早上\n\n    小宝的奶奶每天早上六点起床，她常常一边吃早饭一边看报纸。吃完早饭，奶奶会送小宝去幼儿园，然后跟朋友去公园散步。她喜欢一边散步一边跟朋友聊天。十点半，奶奶会回家做饭，她常常一边做饭一边听京剧。",
    "traditional": "奶奶的早上\n\n    小寶的奶奶每天早上六點起床，她常常一邊吃早飯一邊看報紙。吃完早飯，奶奶會送小寶去幼兒園，然後跟朋友去公園散步。她喜歡一邊散步一邊跟朋友聊天。十點半，奶奶會回家做飯，她常常一邊做飯一邊聽京劇。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Grandma’s morning"
    },
    {
      "index": 2,
      "simplified": "小宝的奶奶每天早上六点起床，她常常一边吃早饭一边看报纸。",
      "traditional": "小寶的奶奶每天早上六點起床，她常常一邊吃早飯一邊看報紙。",
      "pinyin": "xiǎo bǎo de nǎi nai měi tiān zǎo shang liù diǎn qǐ chuáng tā cháng cháng yì biān chī zǎo fàn yì biān kàn bào zhǐ",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "吃完早饭，奶奶会送小宝去幼儿园，然后跟朋友去公园散步。",
      "traditional": "吃完早飯，奶奶會送小寶去幼兒園，然後跟朋友去公園散步。",
      "pinyin": "chī wán zǎo fàn nǎi nai huì sòng xiǎo bǎo qù yòu ér yuán rán hòu gēn péng you qù gōng yuán sàn bù",
      "english": "Xiao Bao’s grandma gets up at 6 every morning. She often reads the newspaper while having breakfast."
    },
    {
      "index": 4,
      "simplified": "她喜欢一边散步一边跟朋友聊天。",
      "traditional": "她喜歡一邊散步一邊跟朋友聊天。",
      "pinyin": "tā xǐ huan yì biān sàn bù yì biān gēn péng you liáo tiān",
      "english": "After breakfast, grandma will take Xiao Bao to the kindergarten, and later take a walk with her friends in the park."
    },
    {
      "index": 5,
      "simplified": "十点半，奶奶会回家做饭，她常常一边做饭一边听京剧。",
      "traditional": "十點半，奶奶會回家做飯，她常常一邊做飯一邊聽京劇。",
      "pinyin": "shí diǎn bàn nǎi nai huì huí jiā zuò fàn tā cháng cháng yì biān zuò fàn yì biān tīng jīng jù",
      "english": "She likes talking with her friends while walking."
    },
    {
      "index": 6,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "At 10:30 am, grandma will go back home and cook lunch. She often listens to Beijing opera while cooking."
    }
  ],
