{
  "id": "913",
  "title": "Do You Speak English?",
  "level": "newbie",
  "date": "2020-04-05",
  "synopsis": "Anne tries to find someone who can speak English.",
  "audioUrl": "https://static.duchinese.net/documents/913/fe70c7623206672d321827910b93c52ffb04cdc6.mp3?1585482368",
  "series": null,
  "fullText": {
    "simplified": "你会说英语吗？\n\n店员：您好！请问要吃点什么？\n安：不好意思！我没听懂。你会说英语吗？\n店员：不好意思，我不会。他会，我帮您叫他过来。\n安：好的，谢谢您！\n",
    "traditional": "你會說英語嗎？\n\n店員：您好！請問要吃點什麼？\n安：不好意思！我沒聽懂。你會說英語嗎？\n店員：不好意思，我不會。他會，我幫您叫他過來。\n安：好的，謝謝您！\n"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Do you speak English?"
    },
    {
      "index": 2,
      "simplified": "店员：您好！请问要吃点什么？",
      "traditional": "店員：您好！請問要吃點什麼？",
      "pinyin": "diàn yuán nín hǎo qǐng wèn yào chī diǎn shén me",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: Hello! What would you like to eat?"
    },
    {
      "index": 4,
      "simplified": "安：不好意思！我没听懂。你会说英语吗？",
      "traditional": "安：不好意思！我沒聽懂。你會說英語嗎？",
      "pinyin": "ān bù hǎo yì si wǒ méi tīng dǒng nǐ huì shuō yīng yǔ ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: I’m sorry! I didn’t understand that. Do you speak English?"
    },
    {
      "index": 6,
      "simplified": "店员：不好意思，我不会。他会，我帮您叫他过来。",
      "traditional": "店員：不好意思，我不會。他會，我幫您叫他過來。",
      "pinyin": "diàn yuán bù hǎo yì si wǒ bú huì tā huì wǒ bāng nín jiào tā guò lái",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Shop assistant: I’m sorry, I don’t. He does, I’ll call him over for you."
    },
    {
      "index": 8,
      "simplified": "安：好的，谢谢您！",
      "traditional": "安：好的，謝謝您！",
      "pinyin": "ān hǎo de xiè xie nín",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: OK, thank you!"
    }
  ],
