{
  "id": "616",
  "title": "Today’s Homework",
  "level": "elementary",
  "date": "2018-11-17",
  "synopsis": "The teacher explains what today’s homework is.",
  "audioUrl": "https://static.duchinese.net/documents/885/410def6ed778cf2c83ab05bced8e64dddc71b88f.mp3?1634201896",
  "series": {
    "title": "Ben’s life in China 5: You’re my best friend",
    "chapter": 13,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "今天的作业\n\n张老师：今天的课就上到这里。今天我们上到了第30页，第31页的练习题就是今天的作业。\n本：老师，是第31页第一题和第二题吗？\n张老师：不是。你们做第一题，第二题我们明天在课上一起做。",
    "traditional": "今天的作業\n\n張老師：今天的課就上到這裡。今天我們上到了第30頁，第31頁的練習題就是今天的作業。\n本：老師，是第31頁第一題和第二題嗎？\n張老師：不是。你們做第一題，第二題我們明天在課上一起做。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Today’s Homework"
    },
    {
      "index": 2,
      "simplified": "张老师：今天的课就上到这里。",
      "traditional": "張老師：今天的課就上到這裡。",
      "pinyin": "zhāng lǎo shī jīn tiān de kè jiù shàng dào zhè lǐ",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "今天我们上到了第30页，第31页的练习题就是今天的作业。",
      "traditional": "今天我們上到了第30頁，第31頁的練習題就是今天的作業。",
      "pinyin": "jīn tiān wǒ men shàng dào le dì 2 yè dì 3 yè de liàn xí tí jiù shì jīn tiān de zuò yè",
      "english": "Teacher Zhang: Let’s wrap up today’s class here."
    },
    {
      "index": 4,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Today we studied until page 30. The exercises on page 31 will be today’s homework."
    },
    {
      "index": 5,
      "simplified": "本：老师，是第31页第一题和第二题吗？",
      "traditional": "本：老師，是第31頁第一題和第二題嗎？",
      "pinyin": "běn lǎo shī shì dì 3 yè dì yī tí hé dì èr tí ma",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Teacher, is that exercise one and two on page 31?"
    },
    {
      "index": 7,
      "simplified": "张老师：不是。你们做第一题，第二题我们明天在课上一起做。",
      "traditional": "張老師：不是。你們做第一題，第二題我們明天在課上一起做。",
      "pinyin": "zhāng lǎo shī bú shì nǐ men zuò dì yī tí dì èr tí wǒ men míng tiān zài kè shang yì qǐ zuò",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Teacher Zhang: No. You do exercise one. We will do exercise two together in class tomorrow."
    }
  ],
