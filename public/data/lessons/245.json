      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Four is four, ten is ten;"
    },
    {
      "index": 4,
      "simplified": "十四是十四，四十是四十。",
      "traditional": "十四是十四，四十是四十。",
