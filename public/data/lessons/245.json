      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Can you read it?"
    },
    {
      "index": 2,
      "simplified": "四是四，十是十；",
      "traditional": "四是四，十是十；",
      "pinyin": "sì shì sì shí shì shí",
      "english": ""
    },
    {
