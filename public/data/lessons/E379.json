{
  "id": "E379",
  "title": "Spilled Coffee",
  "level": "elementary",
  "date": "2019-12-01",
  "synopsis": "Paul spilled coffee on Little Le’s book. How does Little Le react?",
  "audioUrl": "https://static.duchinese.net/documents/50379/71e9ea1b383f4b9cf097b5b01701a7a2c8db031d.mp3?1574776812",
  "series": null,
  "fullText": {
    "simplified": "我不是故意的\n\n小乐：哎呀，你的咖啡撒我书上了。\n保罗：真对不起！我不是故意的。\n小乐：没关系，只有一点，我用纸擦一下就行。\n保罗：我来我来。",
    "traditional": "我不是故意的\n\n小樂：哎呀，你的咖啡撒我書上了。\n保羅：真對不起！我不是故意的。\n小樂：沒關係，只有一點，我用紙擦一下就行。\n保羅：我來我來。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I didn’t do it on purpose"
    },
    {
      "index": 2,
      "simplified": "小乐：哎呀，你的咖啡撒我书上了。",
      "traditional": "小樂：哎呀，你的咖啡撒我書上了。",
      "pinyin": "xiǎo lè āi yā nǐ de kā fēi sǎ wǒ shū shang le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Ah, your coffee spilled on my book."
    },
    {
      "index": 4,
      "simplified": "保罗：真对不起！我不是故意的。",
      "traditional": "保羅：真對不起！我不是故意的。",
      "pinyin": "bǎo luó zhēn duì bu qǐ wǒ bú shì gù yì de",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: I’m so sorry! I didn’t do it on purpose."
    },
    {
      "index": 6,
      "simplified": "小乐：没关系，只有一点，我用纸擦一下就行。",
      "traditional": "小樂：沒關係，只有一點，我用紙擦一下就行。",
      "pinyin": "xiǎo lè méi guān xi zhǐ yǒu yì diǎn wǒ yòng zhǐ cā yí xià jiù xíng",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Never mind, it’s only a little. It'll be OK when I give it a wipe with a napkin."
    },
    {
      "index": 8,
      "simplified": "保罗：我来我来。",
      "traditional": "保羅：我來我來。",
      "pinyin": "bǎo luó wǒ lái wǒ lái",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Paul: Let me do it."
    }
  ],
