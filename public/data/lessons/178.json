{
  "id": "178",
  "title": "Paying at the Supermarket",
  "level": "intermediate",
  "date": "2016-10-05",
  "synopsis": "Have you ever had trouble understanding the cashier at the supermarket? Here we learn some common phrases you might come across.",
  "audioUrl": "https://static.duchinese.net/documents/246/b054986039b90142cd2bbf052a54bde1f7fbee66.mp3?1575021236",
  "series": null,
  "fullText": {
    "simplified": "超市付款\n\n服务员：您好。欢迎光临。请问您有会员卡吗？\n保罗：有，给。\n服务员：请问您要袋子吗？\n保罗：要吧。\n服务员：要几个呢？1个袋子3毛钱。\n保罗：要1个。\n服务员：好的。一共是197块。请问是刷卡还是付现？\n保罗：付现吧。200块，给。\n服务员：请问有2块吗？\n保罗：有，给。\n服务员：谢谢。找您5块。这是您的小票。请慢走，欢迎下次光临。",
    "traditional": "超市付款\n\n服務員：您好。歡迎光臨。請問您有會員卡嗎？\n保羅：有，給。\n服務員：請問您要袋子嗎？\n保羅：要吧。\n服務員：要幾個呢？1個袋子3毛錢。\n保羅：要1個。\n服務員：好的。一共是197塊。請問是刷卡還是付現？\n保羅：付現吧。200塊，給。\n服務員：請問有2塊嗎？\n保羅：有，給。\n服務員：謝謝。找您5塊。這是您的小票。請慢走，歡迎下次光臨。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Paying at the Supermarket"
    },
    {
      "index": 2,
      "simplified": "服务员：您好。欢迎光临。请问您有会员卡吗？",
      "traditional": "服務員：您好。歡迎光臨。請問您有會員卡嗎？",
      "pinyin": "fú wù yuán nín hǎo huān yíng guāng lín qǐng wèn nín yǒu huì yuán kǎ ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Attendant: Hello. Welcome. May I ask if you have a members card?"
    },
    {
      "index": 4,
      "simplified": "保罗：有，给。",
      "traditional": "保羅：有，給。",
      "pinyin": "bǎo luó yǒu gěi",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Yes, here."
    },
    {
      "index": 6,
      "simplified": "服务员：请问您要袋子吗？",
      "traditional": "服務員：請問您要袋子嗎？",
      "pinyin": "fú wù yuán qǐng wèn nín yào dài zi ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Attendant: Do you need a bag?"
    },
    {
      "index": 8,
      "simplified": "保罗：要吧。",
      "traditional": "保羅：要吧。",
      "pinyin": "bǎo luó yào ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Sure."
    },
    {
      "index": 10,
      "simplified": "服务员：要几个呢？1个袋子3毛钱。",
      "traditional": "服務員：要幾個呢？1個袋子3毛錢。",
      "pinyin": "fú wù yuán yào jǐ ge ne 1 ge dài zi 1 máo qián",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Attendant: How many do you need? One bag costs 0.3 yuan."
    },
    {
      "index": 12,
      "simplified": "保罗：要1个。",
      "traditional": "保羅：要1個。",
      "pinyin": "bǎo luó yào 1 ge",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: One."
    },
    {
      "index": 14,
      "simplified": "服务员：好的。一共是197块。请问是刷卡还是付现？",
      "traditional": "服務員：好的。一共是197塊。請問是刷卡還是付現？",
      "pinyin": "fú wù yuán hǎo de yí gòng shì 5 kuài qǐng wèn shì shuā kǎ hái shi fù xiàn",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Attendant: Ok, that will be 197 yuan altogether. Do you want to pay by card or in cash?"
    },
    {
      "index": 16,
      "simplified": "保罗：付现吧。200块，给。",
      "traditional": "保羅：付現吧。200塊，給。",
      "pinyin": "bǎo luó fù xiàn ba 2 kuài gěi",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: In cash. Here's 200 yuan."
    },
    {
      "index": 18,
      "simplified": "服务员：请问有2块吗？",
      "traditional": "服務員：請問有2塊嗎？",
      "pinyin": "fú wù yuán qǐng wèn yǒu 1 kuài ma",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Attendant: Do you have 2 yuan?"
    },
    {
      "index": 20,
      "simplified": "保罗：有，给。",
      "traditional": "保羅：有，給。",
      "pinyin": "bǎo luó yǒu gěi",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Yes, here."
    },
    {
      "index": 22,
      "simplified": "服务员：谢谢。找您5块。这是您的小票。请慢走，欢迎下次光临。",
      "traditional": "服務員：謝謝。找您5塊。這是您的小票。請慢走，歡迎下次光臨。",
      "pinyin": "fú wù yuán xiè xie zhǎo nín 1 kuài zhè shì nín de xiǎo piào qǐng màn zǒu huān yíng xià cì guāng lín",
      "english": ""
    },
    {
      "index": 23,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Attendant: Thank you. Here's your 5 yuan change. This is your receipt. Take care, and welcome back."
    }
  ],
