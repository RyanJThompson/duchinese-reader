{
  "id": "E171",
  "title": "Little Ming Got Sick",
  "level": "newbie",
  "date": "2017-11-23",
  "synopsis": "Little Ming got sick but was very happy.",
  "audioUrl": "https://static.duchinese.net/documents/584/93d8cfe8c65d6a49fd3d9e0fdf5d544415f260b9.mp3?1511205959",
  "series": null,
  "fullText": {
    "simplified": "小明生病了\n\n    昨天天气太冷，小明生病了。今天他要去医院看医生，但是他很高兴。因为妈妈说他今天可以不去学校，在家休息，所以他也不用考试了。",
    "traditional": "小明生病了\n\n    昨天天氣太冷，小明生病了。今天他要去醫院看醫生，但是他很高興。因為媽媽說他今天可以不去學校，在家休息，所以他也不用考試了。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Little Ming Got Sick"
    },
    {
      "index": 2,
      "simplified": "昨天天气太冷，小明生病了。",
      "traditional": "昨天天氣太冷，小明生病了。",
      "pinyin": "zuó tiān tiān qì tài lěng xiǎo míng shēng bìng le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "今天他要去医院看医生，但是他很高兴。",
      "traditional": "今天他要去醫院看醫生，但是他很高興。",
      "pinyin": "jīn tiān tā yào qù yī yuàn kàn yī shēng dàn shì tā hěn gāo xìng",
      "english": "Yesterday was too cold and Little Ming got sick."
    },
    {
      "index": 4,
      "simplified": "因为妈妈说他今天可以不去学校，在家休息，",
      "traditional": "因為媽媽說他今天可以不去學校，在家休息，",
      "pinyin": "yīn wèi mā ma shuō tā jīn tiān kě yǐ bú qù xué xiào zài jiā xiū xi",
      "english": "Today he has to go see the doctor, but he is very happy."
    },
    {
      "index": 5,
      "simplified": "所以他也不用考试了。",
      "traditional": "所以他也不用考試了。",
      "pinyin": "suǒ yǐ tā yě bú yòng kǎo shì le",
      "english": "Because his mom says that he doesn’t need to go to school today, and to rest at home."
    },
    {
      "index": 6,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Therefore he doesn’t need to do the examination either."
    }
  ],
