{
  "id": "545",
  "title": "I Already Told You",
  "level": "newbie",
  "date": "2018-07-12",
  "synopsis": "Little He is too busy at work and cannot go have a meal with Lili.",
  "audioUrl": "https://static.duchinese.net/documents/785/aafd6769e5d438ba538584e59c7a78ed01f09309.mp3?1589791821",
  "series": {
