      "english": "The Story of Mr. Li"
    },
    {
      "index": 2,
      "simplified": "李先生是一个医生，在医院工作。",
      "traditional": "李先生是一個醫生，在醫院工作。",
      "pinyin": "lǐ xiān sheng shì yí ge yī shēng zài yī yuàn gōng zuò",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "一天，他坐出租车去医院，上车以后，他开始给朋友打电话。",
      "traditional": "一天，他坐出租車去醫院，上車以後，他開始給朋友打電話。",
      "pinyin": "yì tiān tā zuò chū zū chē qù yī yuàn shàng chē yǐ hòu tā kāi shǐ gěi péng you dǎ diàn huà",
      "english": "Mr. Li is a doctor. He works in a hospital."
    },
    {
      "index": 4,
      "simplified": "他跟他的朋友说孩子的事情、工作的事情，非常高兴。",
      "traditional": "他跟他的朋友說孩子的事情、工作的事情，非常高興。",
      "pinyin": "tā gēn tā de péng you shuō hái zi de shì qing gōng zuò de shì qing fēi cháng gāo xìng",
      "english": "One day, he took a taxi to the hospital, and once he got in the car, he started giving his friend a phone call."
    },
    {
      "index": 5,
      "simplified": "到了医院，他开门下车的时候说：",
      "traditional": "到了醫院，他開門下車的時候說：",
      "pinyin": "dào le yī yuàn tā kāi mén xià chē de shí hou shuō",
      "english": "He told his friend things about his children and work matters, and he was very happy."
    },
    {
      "index": 6,
      "simplified": "“晚上我有事，不回家了。”",
      "traditional": "“晚上我有事，不回家了。”",
      "pinyin": "wǎn shang wǒ yǒu shì bù huí jiā le",
      "english": "When they arrived at the hospital, he opened the door, got out of the car and said:"
    },
    {
      "index": 7,
      "simplified": "师傅说：“什么？您没给钱。”",
      "traditional": "師傅說：“什麼？您沒給錢。”",
      "pinyin": "shī fu shuō shén me nín méi gěi qián",
      "english": "“I have things to do tonight, and won’t come back home.”"
    },
    {
      "index": 8,
      "simplified": "李先生说：“哎呀，对不起，我忘了我在出租车上，",
      "traditional": "李先生說：“哎呀，對不起，我忘了我在出租車上，",
      "pinyin": "lǐ xiān sheng shuō āi yā duì bu qǐ wǒ wàng le wǒ zài chū zū chē shang",
      "english": "The driver said: “What? You didn’t give me the money.”"
    },
    {
      "index": 9,
      "simplified": "我以为是我妻子开车呢！”",
      "traditional": "我以為是我妻子開車呢！”",
      "pinyin": "wǒ yǐ wéi shì wǒ qī zi kāi chē ne",
      "english": "Mr. Li said: “Oh, I’m sorry. I forgot I was in a taxi."
    }
  ],
