      "pinyin": "",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "妈妈说：“你的手机很热。”",
      "traditional": "媽媽說：“你的手機很熱。”",
      "pinyin": "mā ma shuō nǐ de shǒu jī hěn rè",
      "english": "Mom said, “Your phone is very hot.”"
    },
    {
      "index": 10,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "“我看看。”大星说，“是不是这儿太热了？",
      "traditional": "“我看看。”大星說，“是不是這兒太熱了？",
      "pinyin": "wǒ kàn kan dà xīng shuō shì bú shì zhè‘r tài rè le",
      "english": "“Let me take a look,” Daxing said, “Is it too hot here?"
    },
    {
      "index": 12,
      "simplified": "没关系，那儿不热，我和小米手机去那儿。”",
      "traditional": "沒關係，那兒不熱，我和小米手機去那兒。”",
      "pinyin": "méi guān xi nà'r bú rè wǒ hé xiǎo mǐ shǒu jī qù nà'r",
      "english": "Never mind, it’s not hot over there. I’ll go over there with the Xiaomi phone.”"
    },
    {
      "index": 13,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "太好了，我回大星手里了！我知道了，我身体很热的时候，大星会和我在一起。",
      "traditional": "太好了，我回大星手裡了！我知道了，我身體很熱的時候，大星會和我在一起。",
      "pinyin": "tài hǎo le wǒ huí dà xīng shǒu lǐ le wǒ zhī dào le wǒ shēn tǐ hěn rè de shí hou dà xīng huì hé wǒ zài yì qǐ",
      "english": "Great, I’m back in Daxing’s hands! Now I know that when I’m very hot, Daxing will be together with me."
    },
