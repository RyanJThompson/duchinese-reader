{
  "id": "621",
  "title": "Are You Using This Dumbbell?",
  "level": "intermediate",
  "date": "2018-11-21",
  "synopsis": "Little Yu is at the gym trying to find a suitable weight to train with.",
  "audioUrl": "https://static.duchinese.net/documents/900/014897040f45fbe925a36dfae3c32fc6de80f07f.mp3?1698350484",
  "series": null,
  "fullText": {
    "simplified": "你在用这个哑铃吗\n\n小雨：你好！你在用这个哑铃吗？\n陌生人：是的。\n小雨：你这个是多少公斤的？\n陌生人：30公斤。\n小雨：你还剩几组？\n陌生人：两组，每组30次，很快就好了。\n小雨：好的，谢谢你。",
    "traditional": "你在用這個啞鈴嗎\n\n小雨：你好！你在用這個啞鈴嗎？\n陌生人：是的。\n小雨：你這個是多少公斤的？\n陌生人：30公斤。\n小雨：你還剩幾組？\n陌生人：兩組，每組30次，很快就好了。\n小雨：好的，謝謝你。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Are You Using This Dumbbell?"
    },
    {
      "index": 2,
      "simplified": "小雨：你好！你在用这个哑铃吗？",
      "traditional": "小雨：你好！你在用這個啞鈴嗎？",
      "pinyin": "xiǎo yǔ nǐ hǎo nǐ zài yòng zhè ge yǎ líng ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Hello! Are you using this dumbbell?"
    },
    {
      "index": 4,
      "simplified": "陌生人：是的。",
      "traditional": "陌生人：是的。",
      "pinyin": "mò shēng rén shì de",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Stranger: Yes."
    },
    {
      "index": 6,
      "simplified": "小雨：你这个是多少公斤的？",
      "traditional": "小雨：你這個是多少公斤的？",
      "pinyin": "xiǎo yǔ nǐ zhè ge shì duō shao gōng jīn de",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: How many kilos is this one?"
    },
    {
      "index": 8,
      "simplified": "陌生人：30公斤。",
      "traditional": "陌生人：30公斤。",
      "pinyin": "mò shēng rén 2 gōng jīn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Stranger: 30 kilos."
    },
    {
      "index": 10,
      "simplified": "小雨：你还剩几组？",
      "traditional": "小雨：你還剩幾組？",
      "pinyin": "xiǎo yǔ nǐ hái shèng jǐ zǔ",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: How many sets do you have left?"
    },
    {
      "index": 12,
      "simplified": "陌生人：两组，每组30次，很快就好了。",
      "traditional": "陌生人：兩組，每組30次，很快就好了。",
      "pinyin": "mò shēng rén liǎng zǔ měi zǔ 2 cì hěn kuài jiù hǎo le",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Stranger: 2 sets, each set 30 reps. I’ll be done soon."
    },
    {
      "index": 14,
      "simplified": "小雨：好的，谢谢你。",
      "traditional": "小雨：好的，謝謝你。",
      "pinyin": "xiǎo yǔ hǎo de xiè xie nǐ",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu: Ok, thank you."
    }
  ],
