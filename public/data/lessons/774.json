{
  "id": "774",
  "title": "Have You Been to Sichuan?",
  "level": "newbie",
  "date": "2019-08-01",
  "synopsis": "Ben is telling Lili when he is going to Sichuan.",
  "audioUrl": "https://static.duchinese.net/documents/1110/72fdfc55323ed56188559c293a2fd964a3c78a8a.mp3?1564387601",
  "series": null,
  "fullText": {
    "simplified": "你去四川了吗？\n\n丽丽：你去四川了吗？\n本：没有。我想今年10月去。\n丽丽：10月是秋天，天气很好。\n本：是啊。小雨说，4月和10月去四川最好。她去年8月去了四川，太热了。",
    "traditional": "你去四川了嗎？\n\n麗麗：你去四川了嗎？\n本：沒有。我想今年10月去。\n麗麗：10月是秋天，天氣很好。\n本：是啊。小雨說，4月和10月去四川最好。她去年8月去了四川，太熱了。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Have You Been to Sichuan?"
    },
    {
      "index": 2,
      "simplified": "丽丽：你去四川了吗？",
      "traditional": "麗麗：你去四川了嗎？",
      "pinyin": "lì lì nǐ qù sì chuān le ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Have you been to Sichuan?"
    },
    {
      "index": 4,
      "simplified": "本：没有。我想今年10月去。",
      "traditional": "本：沒有。我想今年10月去。",
      "pinyin": "běn méi yǒu wǒ xiǎng jīn nián 1 yuè qù",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: No. I want to go in October this year."
    },
    {
      "index": 6,
      "simplified": "丽丽：10月是秋天，天气很好。",
      "traditional": "麗麗：10月是秋天，天氣很好。",
      "pinyin": "lì lì 1 yuè shì qiū tiān tiān qì hěn hǎo",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: It’s fall in October, the weather will be very good."
    },
    {
      "index": 8,
      "simplified": "本：是啊。小雨说，4月和10月去四川最好。",
      "traditional": "本：是啊。小雨說，4月和10月去四川最好。",
      "pinyin": "běn shì a xiǎo yǔ shuō 1 yuè hé 1 yuè qù sì chuān zuì hǎo",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "她去年8月去了四川，太热了。",
      "traditional": "她去年8月去了四川，太熱了。",
      "pinyin": "tā qù nián 1 yuè qù le sì chuān tài rè le",
      "english": "Ben: Yes. Little Yu said that it’s best to go to Sichuan in April and October."
    },
    {
      "index": 10,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "She went to Sichuan in August last year, and it was too hot."
    }
  ],
