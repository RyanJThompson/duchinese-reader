{
  "id": "566",
  "title": "You Decide",
  "level": "elementary",
  "date": "2018-11-28",
  "synopsis": "Little He and Lili are trying to decide what to have for lunch.",
  "audioUrl": "https://static.duchinese.net/documents/901/f3a99b58847bb62b13836825372d9cb81f9ddd69.mp3?1589791641",
  "series": {
    "title": "Ben’s life in China 3: Who is Little Yu?",
    "chapter": 16,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "听你的\n\n丽丽：中午吃什么？\n小何：随你。\n丽丽：在家吃还是在外面吃。\n小何：都行，你说了算。\n丽丽：那你想吃韩国菜还是日本菜？\n小何：都行，听你的。\n丽丽：怎么都听我的？你定吧！\n小何：你定吧！\n丽丽：那就日本菜吧！",
    "traditional": "聽你的\n\n麗麗：中午吃什麼？\n小何：隨你。\n麗麗：在家吃還是在外面吃。\n小何：都行，你說了算。\n麗麗：那你想吃韓國菜還是日本菜？\n小何：都行，聽你的。\n麗麗：怎麼都聽我的？你定吧！\n小何：你定吧！\n麗麗：那就日本菜吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "You Decide"
    },
    {
      "index": 2,
      "simplified": "丽丽：中午吃什么？",
      "traditional": "麗麗：中午吃什麼？",
      "pinyin": "lì lì zhōng wǔ chī shén me",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: What should we eat for lunch?"
    },
    {
      "index": 4,
      "simplified": "小何：随你。",
      "traditional": "小何：隨你。",
      "pinyin": "xiǎo hé suí nǐ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: It’s up to you."
    },
    {
      "index": 6,
      "simplified": "丽丽：在家吃还是在外面吃。",
      "traditional": "麗麗：在家吃還是在外面吃。",
      "pinyin": "lì lì zài jiā chī hái shi zài wài miàn chī",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Should we eat at home or go out to eat?"
    },
    {
      "index": 8,
      "simplified": "小何：都行，你说了算。",
      "traditional": "小何：都行，你說了算。",
      "pinyin": "xiǎo hé dōu xíng nǐ shuō le suàn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Whatever is fine. You decide."
    },
    {
      "index": 10,
      "simplified": "丽丽：那你想吃韩国菜还是日本菜？",
      "traditional": "麗麗：那你想吃韓國菜還是日本菜？",
      "pinyin": "lì lì nà nǐ xiǎng chī hán guó cài hái shi rì běn cài",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Do you want to eat Korean or Japanese food?"
    },
    {
      "index": 12,
      "simplified": "小何：都行，听你的。",
      "traditional": "小何：都行，聽你的。",
      "pinyin": "xiǎo hé dōu xíng tīng nǐ de",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Both are fine. Whatever you say."
    },
    {
      "index": 14,
      "simplified": "丽丽：怎么都听我的？你定吧！",
      "traditional": "麗麗：怎麼都聽我的？你定吧！",
      "pinyin": "lì lì zěn me dōu tīng wǒ de nǐ dìng ba",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: How come everything is up to me? You decide!"
    },
    {
      "index": 16,
      "simplified": "小何：你定吧！",
      "traditional": "小何：你定吧！",
      "pinyin": "xiǎo hé nǐ dìng ba",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: No, you decide!"
    },
    {
      "index": 18,
      "simplified": "丽丽：那就日本菜吧！",
      "traditional": "麗麗：那就日本菜吧！",
      "pinyin": "lì lì nà jiù rì běn cài ba",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Lili: Then let’s have Japanese food!"
    }
