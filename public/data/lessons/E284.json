{
  "id": "E284",
  "title": "Oh My Mom!",
  "level": "intermediate",
  "date": "2018-12-26",
  "synopsis": "How can you say \"Oh my God\" in Chinese?",
  "audioUrl": "https://static.duchinese.net/documents/929/76b013e329948c9f181f87fa52284a897f2883c3.mp3?1545070109",
  "series": null,
  "fullText": {
    "simplified": "我的妈呀!\n\n保罗：小乐你看，这是我买的新衣服，你觉得怎么样？\n小乐：我的妈呀！这件衣服太好看了，多少钱啊？\n保罗：一千多块钱。\n小乐：我的妈呀！这么贵？\n保罗：小乐，为什么你一直说你妈妈？她不在这里吧？\n小乐：我没有说我妈妈。这句话和英文的“Oh my god”一样，当你觉得非常惊讶的时候就可以说，“我的妈呀“。",
    "traditional": "我的媽呀!\n\n保羅：小樂你看，這是我買的新衣服，你覺得怎麼樣？\n小樂：我的媽呀！這件衣服太好看了，多少錢啊？\n保羅：一千多塊錢。\n小樂：我的媽呀！這麼貴？\n保羅：小樂，為什麼你一直說你媽媽？她不在這裡吧？\n小樂：我沒有說我媽媽。這句話和英文的“Oh my god”一樣，當你覺得非常驚訝的時候就可以說，“我的媽呀“。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Oh my mom!"
    },
    {
      "index": 2,
      "simplified": "保罗：小乐你看，这是我买的新衣服，你觉得怎么样？",
      "traditional": "保羅：小樂你看，這是我買的新衣服，你覺得怎麼樣？",
      "pinyin": "bǎo luó xiǎo lè nǐ kàn zhè shì wǒ mǎi de xīn yī fu nǐ jué de zěn me yàng",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Look, Little Le! This is the new coat I bought. What do you think?"
    },
    {
      "index": 4,
      "simplified": "小乐：我的妈呀！这件衣服太好看了，多少钱啊？",
      "traditional": "小樂：我的媽呀！這件衣服太好看了，多少錢啊？",
      "pinyin": "xiǎo lè wǒ de mā ya zhè jiàn yī fu tài hǎo kàn le duō shao qián a",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Oh my mom! That coat looks great. How much was it?"
    },
    {
      "index": 6,
      "simplified": "保罗：一千多块钱。",
      "traditional": "保羅：一千多塊錢。",
      "pinyin": "bǎo luó yì qiān duō kuài qián",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Over one thousand yuan."
    },
    {
      "index": 8,
      "simplified": "小乐：我的妈呀！这么贵？",
      "traditional": "小樂：我的媽呀！這麼貴？",
      "pinyin": "xiǎo lè wǒ de mā ya zhè me guì",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Oh my mom! So expensive!"
    },
    {
      "index": 10,
      "simplified": "保罗：小乐，为什么你一直说你妈妈？她不在这里吧？",
      "traditional": "保羅：小樂，為什麼你一直說你媽媽？她不在這裡吧？",
      "pinyin": "bǎo luó xiǎo lè wèi shén me nǐ yì zhí shuō nǐ mā ma tā bú zài zhè lǐ ba",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, why do you keep talking about your mom? She’s not here, is she?"
    },
    {
      "index": 12,
      "simplified": "小乐：我没有说我妈妈。",
      "traditional": "小樂：我沒有說我媽媽。",
      "pinyin": "xiǎo lè wǒ méi yǒu shuō wǒ mā ma",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "这句话和英文的“Oh my god”一样，",
      "traditional": "這句話和英文的“Oh my god”一樣，",
      "pinyin": "zhè jù huà hé yīng wén de 3 yí yàng",
      "english": "Little Le: I’m not talking about my mom."
    },
    {
      "index": 14,
      "simplified": "当你觉得非常惊讶的时候就可以说，“我的妈呀“。",
      "traditional": "當你覺得非常驚訝的時候就可以說，“我的媽呀“。",
      "pinyin": "dāng nǐ jué de fēi cháng jīng yà de shí hou jiù kě yǐ shuō wǒ de mā ya",
      "english": "This phrase has the same meaning as the English phrase “Oh my God”."
    }
  ],
