{
  "id": "398",
  "title": "Day After Tomorrow",
  "level": "newbie",
  "date": "2017-10-06",
  "synopsis": "Lili invites Ben to visit her place the day after tomorrow.",
  "audioUrl": "https://static.duchinese.net/documents/542/3f06f18bea14dde6adc167a524787cd07bb289e9.mp3?1698352294",
  "series": null,
  "fullText": {
    "simplified": "你后天有时间吗？\n\n丽丽：本，你后天有时间吗？\n本：有呀，怎么了？\n丽丽：后天是我的生日，我想请你来我家。\n本：好呀。后天几点？\n丽丽：下午五点。\n本：好的。先祝你生日快乐！\n丽丽：谢谢！",
    "traditional": "你後天有時間嗎？\n\n麗麗：本，你後天有時間嗎？\n本：有呀，怎麼了？\n麗麗：後天是我的生日，我想請你來我家。\n本：好呀。後天幾點？\n麗麗：下午五點。\n本：好的。先祝你生日快樂！\n麗麗：謝謝！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Do you have time the day after tomorrow?"
    },
    {
      "index": 2,
      "simplified": "丽丽：本，你后天有时间吗？",
      "traditional": "麗麗：本，你後天有時間嗎？",
      "pinyin": "lì lì běn nǐ hòu tiān yǒu shí jiān ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Ben, do you have time the day after tomorrow?"
    },
    {
      "index": 4,
      "simplified": "本：有呀，怎么了？",
      "traditional": "本：有呀，怎麼了？",
      "pinyin": "běn yǒu ya zěn me le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I do, what's up?"
    },
    {
      "index": 6,
      "simplified": "丽丽：后天是我的生日，我想请你来我家。",
      "traditional": "麗麗：後天是我的生日，我想請你來我家。",
      "pinyin": "lì lì hòu tiān shì wǒ de shēng rì wǒ xiǎng qǐng nǐ lái wǒ jiā",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: The day after tomorrow is my birthday. I want to invite you to my home."
    },
    {
      "index": 8,
      "simplified": "本：好呀。后天几点？",
      "traditional": "本：好呀。後天幾點？",
      "pinyin": "běn hǎo ya hòu tiān jǐ diǎn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Ok. The day after tomorrow at what time?"
    },
    {
      "index": 10,
      "simplified": "丽丽：下午五点。",
      "traditional": "麗麗：下午五點。",
      "pinyin": "lì lì xià wǔ wǔ diǎn",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: 5 in the afternoon."
    },
    {
      "index": 12,
      "simplified": "本：好的。先祝你生日快乐！",
      "traditional": "本：好的。先祝你生日快樂！",
      "pinyin": "běn hǎo de xiān zhù nǐ shēng rì kuài lè",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Ok. But first I want to say happy birthday!"
    },
    {
      "index": 14,
      "simplified": "丽丽：谢谢！",
      "traditional": "麗麗：謝謝！",
      "pinyin": "lì lì xiè xie",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Lili: Thank you!"
    }
  ],
