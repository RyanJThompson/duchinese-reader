{
  "id": "E232",
  "title": "It’s Hard to Say",
  "level": "elementary",
  "date": "2018-06-30",
  "synopsis": "This short sentence can help you avoid some awkward situations.",
  "audioUrl": "https://static.duchinese.net/documents/772/1cc3b0303595aaf2fae783fbee274cbbdd5ab534.mp3?1529323592",
  "series": null,
  "fullText": {
    "simplified": "怎么说呢 \n\n安妮：我觉得《水形物语》这个电影太好看了。你觉得呢？\n林红：怎么说呢？还可以吧。\n安妮：为什么？\n林红：怎么说呢，就是个爱情和大魔王的故事，都是套路。\n安妮：好吧。怎么说呢，有时候你也挺挑的。",
    "traditional": "怎麼說呢 \n\n安妮：我覺得《水形物語》這個電影太好看了。你覺得呢？\n林紅：怎麼說呢？還可以吧。\n安妮：為什麼？\n林紅：怎麼說呢，就是個愛情和大魔王的故事，都是套路。\n安妮：好吧。怎麼說呢，有時候你也挺挑的。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "It’s Hard to Say"
    },
    {
      "index": 2,
      "simplified": "安妮：我觉得《水形物语》这个电影太好看了。你觉得呢？",
      "traditional": "安妮：我覺得《水形物語》這個電影太好看了。你覺得呢？",
      "pinyin": "ān nī wǒ jué de shuǐ xíng wù yǔ zhè ge diàn yǐng tài hǎo kàn le nǐ jué de ne",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: I think the movie “The Shape of Water” is great. What do you think?"
    },
    {
      "index": 4,
      "simplified": "林红：怎么说呢？还可以吧。",
      "traditional": "林紅：怎麼說呢？還可以吧。",
      "pinyin": "lín hóng zěn me shuō ne hái kě yǐ ba",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lin Hong: It’s hard to say. It wasn’t bad."
    },
    {
      "index": 6,
      "simplified": "安妮：为什么？",
      "traditional": "安妮：為什麼？",
      "pinyin": "ān nī wèi shén me",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Why?"
    },
    {
      "index": 8,
      "simplified": "林红：怎么说呢，就是个爱情和大魔王的故事，都是套路。",
      "traditional": "林紅：怎麼說呢，就是個愛情和大魔王的故事，都是套路。",
      "pinyin": "lín hóng zěn me shuō ne jiù shì ge ài qíng hé dà mó wáng de gù shi dōu shì tào lù",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lin Hong: It’s hard to say. It's just a story of love and the devil. It’s all the same."
    },
    {
      "index": 10,
      "simplified": "安妮：好吧。怎么说呢，有时候你也挺挑的。",
      "traditional": "安妮：好吧。怎麼說呢，有時候你也挺挑的。",
      "pinyin": "ān nī hǎo ba zěn me shuō ne yǒu shí hou nǐ yě tǐng tiāo de",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Annie: Ok. How should I put it… Sometimes you are quite picky."
    }
  ],
