{
  "id": "379",
  "title": "Stopped by the Police",
  "level": "intermediate",
  "date": "2017-10-24",
  "synopsis": "A taxi driver is flagged down by a police officer even though he has seemingly done nothing wrong.",
  "audioUrl": "https://static.duchinese.net/documents/557/56ab0e5343c4f887c155967a80da6c6e60a63fc2.mp3?1508683700",
  "series": null,
  "fullText": {
    "simplified": "你为什么拦我？\n\n    小王是一个出租车司机。一天，他开着出租车走在路上，被一个警察拦下来了。\n    小王很生气，说：“我没有喝酒，也没有闯红灯，你为什么拦我？”\n    警察说：“我打车！”",
    "traditional": "你為什麼攔我？\n\n    小王是一個出租車司機。一天，他開著出租車走在路上，被一個警察攔下來了。\n    小王很生氣，說：“我沒有喝酒，也沒有闖紅燈，你為什麼攔我？”\n    警察說：“我打車！”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Why did you stop me?"
    },
    {
      "index": 2,
      "simplified": "小王是一个出租车司机。",
      "traditional": "小王是一個出租車司機。",
      "pinyin": "xiǎo wáng shì yí ge chū zū chē sī jī",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "一天，他开着出租车走在路上，被一个警察拦下来了。",
      "traditional": "一天，他開著出租車走在路上，被一個警察攔下來了。",
      "pinyin": "yì tiān tā kāi zhe chū zū chē zǒu zài lù shang bèi yí ge jǐng chá lán xia lai le",
      "english": "Little Wang is a taxi driver."
    },
    {
      "index": 4,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "One day, he was driving his taxi on the road when he was stopped by a police officer."
    },
    {
      "index": 5,
      "simplified": "小王很生气，说：“我没有喝酒，也没有闯红灯，你为什么拦我？”",
      "traditional": "小王很生氣，說：“我沒有喝酒，也沒有闖紅燈，你為什麼攔我？”",
      "pinyin": "xiǎo wáng hěn shēng qì shuō wǒ méi yǒu hē jiǔ yě méi yǒu chuǎng hóng dēng nǐ wèi shén me lán wǒ",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Wang said angrily: “I haven't had any alcohol, and I haven't run any red light. Why are you stopping me?”"
    },
    {
      "index": 7,
      "simplified": "警察说：“我打车！”",
      "traditional": "警察說：“我打車！”",
      "pinyin": "jǐng chá shuō wǒ dǎ chē",
      "english": ""
    }
  ],
