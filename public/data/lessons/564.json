    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: How much money?"
    },
    {
      "index": 8,
      "simplified": "本：1千。",
      "traditional": "本：1千。",
      "pinyin": "běn 1 qiān",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: 1000."
    },
    {
      "index": 10,
      "simplified": "小雨：怎么不见的？",
      "traditional": "小雨：怎麼不見的？",
      "pinyin": "xiǎo yǔ zěn me bú jiàn de",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: How come it’s gone?"
    },
    {
      "index": 12,
      "simplified": "本：唉，说来话长，我现在不想说。",
      "traditional": "本：唉，說來話長，我現在不想說。",
      "pinyin": "běn ài shuō lái huà cháng wǒ xiàn zài bù xiǎng shuō",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Sigh… It’s a long story. I don’t want to talk about it right now."
    },
    {
      "index": 14,
      "simplified": "小雨：没关系。钱乃身外之物，别想那么多了。",
      "traditional": "小雨：沒關係。錢乃身外之物，別想那麼多了。",
      "pinyin": "xiǎo yǔ méi guān xi qián nǎi shēn wài zhī wù bié xiǎng nà me duō le",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: It’s alright. Money will come and go. Don’t think about it too much."
    },
    {
      "index": 16,
      "simplified": "本：但是……",
      "traditional": "本：但是……",
      "pinyin": "běn dàn shì",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: But…"
    },
    {
      "index": 18,
      "simplified": "小雨：没有但是。开心点！走，我请你吃饭。",
      "traditional": "小雨：沒有但是。開心點！走，我請你吃飯。",
      "pinyin": "xiǎo yǔ méi yǒu dàn shì kāi xīn diǎn zǒu wǒ qǐng nǐ chī fàn",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu: No buts. Lighten up! Let’s go, I’ll treat you to a meal."
    }
