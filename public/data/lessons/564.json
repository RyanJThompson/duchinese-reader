      "pinyin": "běn wǒ de qián bú jiàn le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I’ve lost my money."
    },
    {
      "index": 6,
      "simplified": "小雨：多少钱？",
      "traditional": "小雨：多少錢？",
      "pinyin": "xiǎo yǔ duō shao qián",
