      "pinyin": "mā ma wèi shén me",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Why?"
    },
    {
      "index": 20,
      "simplified": "小明：饭和汤不是甜的，不好吃，不好喝。",
      "traditional": "小明：飯和湯不是甜的，不好吃，不好喝。",
      "pinyin": "xiǎo míng fàn hé tāng bù shì tián de bù hǎo chī bù hǎo hē",
