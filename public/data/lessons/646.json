    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: And the soup?"
    },
    {
      "index": 16,
      "simplified": "小明：没喝完。",
      "traditional": "小明：沒喝完。",
      "pinyin": "xiǎo míng méi hē wán",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I haven’t drunk it all."
    },
    {
      "index": 18,
      "simplified": "妈妈：为什么？",
