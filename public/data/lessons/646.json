{
  "id": "646",
  "title": "Finished Eating",
  "level": "elementary",
  "date": "2019-01-05",
  "synopsis": "Little Ming only likes to eat sweet things.",
  "audioUrl": "https://static.duchinese.net/documents/933/790cf904d03d48269871aca5a202f8480b5310c6.mp3?1575020815",
  "series": null,
  "fullText": {
    "simplified": "吃完了\n\n妈妈：小明，蛋糕呢？\n小明：吃完了。\n妈妈：果汁呢？\n小明：喝完了。\n妈妈：饭呢？\n小明：没吃完。\n妈妈：汤呢？\n小明：没喝完。\n妈妈：为什么？\n小明：饭和汤不是甜的，不好吃，不好喝。",
    "traditional": "吃完了\n\n媽媽：小明，蛋糕呢？\n小明：吃完了。\n媽媽：果汁呢？\n小明：喝完了。\n媽媽：飯呢？\n小明：沒吃完。\n媽媽：湯呢？\n小明：沒喝完。\n媽媽：為什麼？\n小明：飯和湯不是甜的，不好吃，不好喝。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Finished Eating"
    },
    {
      "index": 2,
      "simplified": "妈妈：小明，蛋糕呢？",
      "traditional": "媽媽：小明，蛋糕呢？",
      "pinyin": "mā ma xiǎo míng dàn gāo ne",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Little Ming, where’s the cake?"
    },
    {
      "index": 4,
      "simplified": "小明：吃完了。",
      "traditional": "小明：吃完了。",
      "pinyin": "xiǎo míng chī wán le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I ate it all."
    },
    {
      "index": 6,
      "simplified": "妈妈：果汁呢？",
      "traditional": "媽媽：果汁呢？",
      "pinyin": "mā ma guǒ zhī ne",
