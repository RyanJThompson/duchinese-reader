    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: And the juice?"
    },
    {
      "index": 8,
      "simplified": "小明：喝完了。",
      "traditional": "小明：喝完了。",
      "pinyin": "xiǎo míng hē wán le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I drank it all."
    },
    {
      "index": 10,
      "simplified": "妈妈：饭呢？",
      "traditional": "媽媽：飯呢？",
      "pinyin": "mā ma fàn ne",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: And the rice?"
    },
    {
      "index": 12,
      "simplified": "小明：没吃完。",
      "traditional": "小明：沒吃完。",
      "pinyin": "xiǎo míng méi chī wán",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: I haven’t finished it."
    },
    {
      "index": 14,
      "simplified": "妈妈：汤呢？",
