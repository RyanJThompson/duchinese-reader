    "sentence_translations": [
      "Chatting with the masseur",
      "",
      "Masseur: Hello Sir. I am masseur no. 23. It is my pleasure to offer you this service.",
      "",
      "Client: Hello.",
      "",
      "Masseur: May I ask where you are tense?",
      "",
      "Client: Like most people, neck and shoulders are pretty tense.",
      "",
      "Masseur: Ok, let us start. Is the force I am using alright?",
      "",
      "Client: It is too much. Can you go a bit softer?",
      "",
      "Masseur: Of course. How about now?",
      "",
      "Client: Now it’s perfect.",
      "",
      "Masseur: Sir, the muscles in your right shoulder are very tense.",
      "It seems like you are spending too much time in front of a computer every day. You need to rest more.",
      "",
      "Client: Mmm.",
      "",
      "Masseur: Sir, do you generally sleep well?",
      "",
      "Client: Mmm.",
      "",
      "Masseur: Sir?",
      "",
      "Client: It is really comfortable. I think I almost fell asleep…",
      "",
      "Masseur: ……"
    ]
  }
