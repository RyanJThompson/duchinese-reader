      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Masseur: Hello Sir. I am masseur no. 23. It is my pleasure to offer you this service."
    },
    {
      "index": 4,
      "simplified": "客人： 您好。",
      "traditional": "客人： 您好。",
      "pinyin": "kè rén nín hǎo",
      "english": ""
    },
    {
