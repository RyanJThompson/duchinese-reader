    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Masseur: Ok, let us start. Is the force I am using alright?"
    },
    {
      "index": 12,
      "simplified": "客人： 太重了，可以轻一点吗？",
      "traditional": "客人： 太重了，可以輕一點嗎？",
      "pinyin": "kè rén tài zhòng le kě yǐ qīng yì diǎn ma",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Client: It is too much. Can you go a bit softer?"
