  "title": "Don't Use Your Phone When Eating",
  "level": "elementary",
  "date": "2018-05-26",
  "synopsis": "Lili reprimands Little He for using his phone at the dinner table.",
  "audioUrl": "https://static.duchinese.net/documents/722/625f6fe0a3a041f6f0494a44a7cb9f09c722813f.mp3?1589791644",
