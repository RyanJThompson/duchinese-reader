{
  "id": "502",
  "title": "Where Did You Buy the Cup?",
  "level": "newbie",
  "date": "2018-04-05",
  "synopsis": "Ben thanks Little Yu for the cup she bought for him.",
  "audioUrl": "https://static.duchinese.net/documents/702/8e11f18a20c5cb55c51287130713838c2f38868b.mp3?1589791679",
  "series": {
    "title": "Ben’s life in China 3: Who is Little Yu?",
    "chapter": 27,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你在哪儿买的杯子？\n\n本：小雨，你给我的杯子很好，谢谢！\n小雨：不客气。\n本：你在哪儿买的杯子？\n小雨：在学校旁边的超市，怎么了？\n本：麦克也喜欢这个杯子，他也想买一个。",
    "traditional": "你在哪兒買的杯子？\n\n本：小雨，你給我的杯子很好，謝謝！\n小雨：不客氣。\n本：你在哪兒買的杯子？\n小雨：在學校旁邊的超市，怎麼了？\n本：麥克也喜歡這個杯子，他也想買一個。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Where Did You Buy the Cup?"
    },
    {
      "index": 2,
      "simplified": "本：小雨，你给我的杯子很好，谢谢！",
      "traditional": "本：小雨，你給我的杯子很好，謝謝！",
      "pinyin": "běn xiǎo yǔ nǐ gěi wǒ de bēi zi hěn hǎo xiè xie",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Little Yu, the cup you gave me is great. Thank you!"
    },
    {
      "index": 4,
      "simplified": "小雨：不客气。",
      "traditional": "小雨：不客氣。",
      "pinyin": "xiǎo yǔ bú kè qi",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Don't mention it."
    },
    {
      "index": 6,
      "simplified": "本：你在哪儿买的杯子？",
      "traditional": "本：你在哪兒買的杯子？",
      "pinyin": "běn nǐ zài nǎ'r mǎi de bēi zi",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Where did you buy the cup?"
    },
    {
      "index": 8,
      "simplified": "小雨：在学校旁边的超市，怎么了？",
      "traditional": "小雨：在學校旁邊的超市，怎麼了？",
      "pinyin": "xiǎo yǔ zài xué xiào páng biān de chāo shì zěn me le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: At the supermarket next to the school. Why?"
    },
    {
      "index": 10,
      "simplified": "本：麦克也喜欢这个杯子，他也想买一个。",
      "traditional": "本：麥克也喜歡這個杯子，他也想買一個。",
      "pinyin": "běn mài kè yě xǐ huan zhè ge bēi zi tā yě xiǎng mǎi yí ge",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Mike also likes this cup. He wants to buy one too."
    }
  ],
