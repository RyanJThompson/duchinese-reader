{
  "id": "E319",
  "title": "Ben’s Bragging",
  "level": "elementary",
  "date": "2019-04-27",
  "synopsis": "What does “blow cow” mean in Chinese?",
  "audioUrl": "https://static.duchinese.net/documents/1032/27b4541d1a0373c9852f3d8c7c076f54a0eb80cb.mp3?1555842511",
  "series": null,
  "fullText": {
    "simplified": "吹牛\n\n小雨：你有过几个女朋友啊？\n本：我想想，十多个吧。\n小雨：吹牛！我怎么一个也没有见过？\n本：都在我的梦里啊。",
    "traditional": "吹牛\n\n小雨：你有過幾個女朋友啊？\n本：我想想，十多個吧。\n小雨：吹牛！我怎麼一個也沒有見過？\n本：都在我的夢裡啊。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Bragging"
    },
    {
      "index": 2,
      "simplified": "小雨：你有过几个女朋友啊？",
      "traditional": "小雨：你有過幾個女朋友啊？",
      "pinyin": "xiǎo yǔ nǐ yǒu guò jǐ ge nǚ péng you a",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: How many girlfriends have you had?"
    },
    {
      "index": 4,
      "simplified": "本：我想想，十多个吧。",
      "traditional": "本：我想想，十多個吧。",
      "pinyin": "běn wǒ xiǎng xiǎng shí duō ge ba",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Let me see, more than ten."
    },
    {
      "index": 6,
      "simplified": "小雨：吹牛！我怎么一个也没有见过？",
      "traditional": "小雨：吹牛！我怎麼一個也沒有見過？",
      "pinyin": "xiǎo yǔ chuī niú wǒ zěn me yí ge yě méi yǒu jiàn guò",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: You’re bragging! How come I’ve never seen any of them?"
    },
    {
      "index": 8,
      "simplified": "本：都在我的梦里啊。",
      "traditional": "本：都在我的夢裡啊。",
      "pinyin": "běn dōu zài wǒ de mèng lǐ a",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: They were all in my dreams."
    }
  ],
