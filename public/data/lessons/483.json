    {
      "index": 2,
      "simplified": "一天，老师让大家写一个爱情故事。",
      "traditional": "一天，老師讓大家寫一個愛情故事。",
      "pinyin": "yì tiān lǎo shī ràng dà jiā xiě yí ge ài qíng gù shi",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "她说：“大家写这个故事的时候尽量写得简单一些。",
      "traditional": "她說：“大家寫這個故事的時候儘量寫得簡單一些。",
      "pinyin": "tā shuō dà jiā xiě zhè ge gù shi de shí hou jǐn liàng xiě de jiǎn dān yì xiē",
      "english": "One day, the teacher had everyone write a love story."
    },
    {
      "index": 4,
      "simplified": "故事短一点也没关系，但要是一个让人难过的爱情故事。”",
      "traditional": "故事短一點也沒關係，但要是一個讓人難過的愛情故事。”",
      "pinyin": "gù shi duǎn yì diǎn yě méi guān xi dàn yào shì yí ge ràng rén nán guò de ài qíng gù shi",
      "english": "She said: “When you write this story, make it as simple as possible.”"
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "“It doesn't matter if the story is a bit short, but it must be a love story that moves people.”"
    },
    {
      "index": 6,
      "simplified": "小明想了想，写道：",
      "traditional": "小明想了想，寫道：",
      "pinyin": "xiǎo míng xiǎng le xiǎng xiě dào",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Ming thought for a while, then wrote:"
    },
    {
      "index": 8,
      "simplified": "“请你嫁给我吧！”",
      "traditional": "“請你嫁給我吧！”",
      "pinyin": "qǐng nǐ jià gěi wǒ ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "“Please marry me!”"
    },
    {
      "index": 10,
      "simplified": "“滚！”",
      "traditional": "“滾！”",
      "pinyin": "gǔn",
      "english": ""
    }
