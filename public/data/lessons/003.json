{
  "id": "003",
  "title": "My Family",
  "level": "newbie",
  "date": "2015-11-13",
  "synopsis": "What do you answer when someone asks how many siblings you have? This lesson teaches you how you can describe your family using Chinese.",
  "audioUrl": "https://static.duchinese.net/documents/3/4f0eae0f3971eafcf5d4d20ba74eb9af13d200cd.mp3",
  "series": null,
  "fullText": {
    "simplified": "我的家人\n\n　　我家有爸爸，妈妈和我。我的爸爸是一名医生，在医院里给人看病。我的妈妈是一名老师，在学校里教数学。我是一名学生，在学校里学习。",
    "traditional": "我的家人\n\n　　我家有爸爸，媽媽和我。我的爸爸是一名醫生，在醫院裡給人看病。我的媽媽是一名老師，在學校裡教數學。我是一名學生，在學校裡學習。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n　　",
      "traditional": "\n\n　　",
      "pinyin": "",
      "english": "My Family"
    },
    {
      "index": 2,
      "simplified": "我家有爸爸，妈妈和我。",
      "traditional": "我家有爸爸，媽媽和我。",
      "pinyin": "wǒ jiā yǒu bà ba mā ma hé wǒ",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "我的爸爸是一名医生，在医院里给人看病。",
      "traditional": "我的爸爸是一名醫生，在醫院裡給人看病。",
      "pinyin": "wǒ de bà ba shì yì míng yī shēng zài yī yuàn lǐ gěi rén kàn bìng",
      "english": "My family consists of my father, my mother and me."
    },
    {
      "index": 4,
      "simplified": "我的妈妈是一名老师，在学校里教数学。",
      "traditional": "我的媽媽是一名老師，在學校裡教數學。",
      "pinyin": "wǒ de mā ma shì yì míng lǎo shī zài xué xiào lǐ jiāo shù xué",
      "english": "My father is a doctor, working at the hospital treating illnesses."
    },
    {
      "index": 5,
      "simplified": "我是一名学生，在学校里学习。",
      "traditional": "我是一名學生，在學校裡學習。",
      "pinyin": "wǒ shì yì míng xué sheng zài xué xiào lǐ xué xí",
      "english": "My mother is a teacher, teaching maths at a school."
    }
  ],
