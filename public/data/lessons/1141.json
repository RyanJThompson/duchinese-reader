{
  "id": "1141",
  "title": "What Am I To You?",
  "level": "intermediate",
  "date": "2021-01-24",
  "synopsis": "Little Le sweetly teases Paul with a Chinese play on words.",
  "audioUrl": "https://static.duchinese.net/documents/1141/9b4e104384cfcb57ab65cba9967fedd067b044d1.mp3?1605192215",
  "series": null,
  "fullText": {
    "simplified": "我是你的什么？\n\n小乐：你看这是什么？\n保罗：你的手背？\n小乐：对！你再看看，这是什么？\n保罗：你的脚背？\n小乐：对！那我是你的什么？\n保罗：你不是我的女朋友吗？\n小乐：不对！我是你的宝贝！",
    "traditional": "我是你的什麼？\n\n小樂：你看這是什麼？\n保羅：你的手背？\n小樂：對！你再看看，這是什麼？\n保羅：你的腳背？\n小樂：對！那我是你的什麼？\n保羅：你不是我的女朋友嗎？\n小樂：不對！我是你的寶貝！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "What Am I To You?"
    },
    {
      "index": 2,
      "simplified": "小乐：你看这是什么？",
      "traditional": "小樂：你看這是什麼？",
      "pinyin": "xiǎo lè nǐ kàn zhè shì shén me",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Look, what is this?"
    },
    {
      "index": 4,
      "simplified": "保罗：你的手背？",
      "traditional": "保羅：你的手背？",
      "pinyin": "bǎo luó nǐ de shǒu bèi",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: The back of your hand?"
    },
    {
      "index": 6,
      "simplified": "小乐：对！你再看看，这是什么？",
      "traditional": "小樂：對！你再看看，這是什麼？",
      "pinyin": "xiǎo lè duì nǐ zài kàn kan zhè shì shén me",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Correct! Look again, what is this?"
    },
    {
      "index": 8,
      "simplified": "保罗：你的脚背？",
      "traditional": "保羅：你的腳背？",
      "pinyin": "bǎo luó nǐ de jiǎo bèi",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Your instep?"
    },
    {
      "index": 10,
      "simplified": "小乐：对！那我是你的什么？",
      "traditional": "小樂：對！那我是你的什麼？",
      "pinyin": "xiǎo lè duì nà wǒ shì nǐ de shén me",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Correct! Well then, what am I to you?"
    },
    {
      "index": 12,
      "simplified": "保罗：你不是我的女朋友吗？",
      "traditional": "保羅：你不是我的女朋友嗎？",
      "pinyin": "bǎo luó nǐ bú shì wǒ de nǚ péng you ma",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Aren’t you my girlfriend?"
    },
    {
      "index": 14,
      "simplified": "小乐：不对！我是你的宝贝！",
      "traditional": "小樂：不對！我是你的寶貝！",
      "pinyin": "xiǎo lè bú duì wǒ shì nǐ de bǎo bèi",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: Incorrect! I am your darling!"
    }
  ],
