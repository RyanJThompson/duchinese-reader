      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Waiter: We do. The name is the pinyin for “Coffee Every Day”."
    },
    {
      "index": 6,
      "simplified": "本：密码是多少？",
      "traditional": "本：密碼是多少？",
      "pinyin": "běn mì mǎ shì duō shao",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: What's the password?"
    },
    {
      "index": 8,
      "simplified": "服务员：8个6。",
      "traditional": "服務員：8個6。",
      "pinyin": "fú wù yuán 1 ge 1",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Waiter: 8 sixes."
    },
    {
      "index": 10,
      "simplified": "本：可以再说一次吗？",
      "traditional": "本：可以再說一次嗎？",
      "pinyin": "běn kě yǐ zài shuō yí cì ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Could you say that again?"
    },
