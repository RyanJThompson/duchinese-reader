{
  "id": "692",
  "title": "I Want to Make Friends",
  "level": "elementary",
  "date": "2019-11-12",
  "synopsis": "Lili wants to make friends, so she is introducing herself in a personal ad.",
  "audioUrl": "https://static.duchinese.net/documents/692/1d49078aa737e61f6a019d855e0a995506e4b364.mp3?1573478558",
  "series": {
    "title": "Ben’s life in China 6: Maybe I Like Him",
    "chapter": 0,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "我想交朋友\n\n    你们好！我叫丽丽，19岁，大学二年级。我喜欢跑步，跳舞。周六、周日我有时会去游泳。我想交一些喜欢跑步的女孩做朋友。我们可以一起去跑步，一起去吃饭，一起去玩儿。",
    "traditional": "我想交朋友\n\n    你們好！我叫麗麗，19歲，大學二年級。我喜歡跑步，跳舞。週六、週日我有時會去游泳。我想交一些喜歡跑步的女孩做朋友。我們可以一起去跑步，一起去吃飯，一起去玩兒。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "I want to make friends"
    },
    {
      "index": 2,
      "simplified": "你们好！我叫丽丽，19岁，大学二年级。",
      "traditional": "你們好！我叫麗麗，19歲，大學二年級。",
      "pinyin": "nǐ men hǎo wǒ jiào lì lì 2 suì dà xué èr nián jí",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "我喜欢跑步，跳舞。",
      "traditional": "我喜歡跑步，跳舞。",
      "pinyin": "wǒ xǐ huan pǎo bù tiào wǔ",
      "english": "Hello! My name is Lili, I’m 19 years old, and in my second year of university."
    },
    {
      "index": 4,
      "simplified": "周六、周日我有时会去游泳。",
      "traditional": "週六、週日我有時會去游泳。",
      "pinyin": "zhōu liù zhōu rì wǒ yǒu shí huì qù yóu yǒng",
      "english": "I like to jog and dance."
    },
    {
      "index": 5,
      "simplified": "我想交一些喜欢跑步的女孩做朋友。",
      "traditional": "我想交一些喜歡跑步的女孩做朋友。",
      "pinyin": "wǒ xiǎng jiāo yì xiē xǐ huan pǎo bù de nǚ hái zuò péng you",
      "english": "Sometimes I’ll go swim on Saturdays or Sundays."
    },
    {
      "index": 6,
      "simplified": "我们可以一起去跑步，一起去吃饭，一起去玩儿。",
      "traditional": "我們可以一起去跑步，一起去吃飯，一起去玩兒。",
      "pinyin": "wǒ men kě yǐ yì qǐ qù pǎo bù yì qǐ qù chī fàn yì qǐ qù wán'r",
      "english": "I want to make friends with some girls that like to jog."
    },
    {
      "index": 7,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "We could go jogging together, go eat together and have fun together."
    }
  ],
