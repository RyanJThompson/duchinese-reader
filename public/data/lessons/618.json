    "sentence_translations": [
      "Washing Your Hair at the Hairdresser’s",
      "",
      "Staff: Hello, I’m number 5. Today, I will help you wash your hair.",
      "",
      "Paul: Ok.",
      "",
      "Staff: Please sit a bit higher up.",
      "",
      "Paul: Ok.",
      "",
      "Staff: First, I will massage your head a bit. Please relax.",
      "",
      "Paul: Ok.",
      "",
      "Staff: May I ask if the amount of pressure is suitable?",
      "",
      "Paul: It’s suitable.",
      "",
      "Staff: Now, I will begin to wash your hair. May I ask if the water temperature is suitable?",
      "",
      "Paul: It’s too hot.",
      "",
      "Staff: I apologize. Then I will turn the water temperature down a bit. How about now?",
      "",
      "Paul: It’s good.",
      "",
      "Staff: Is the pressure suitable?",
      "",
      "Paul: It’s too hard. A bit softer, please.",
      "",
      "Staff: Ok. How about now?",
      "",
      "Paul: It’s good.",
      "",
      "Staff: May I ask if any spot on your scalp is still itchy?",
      "",
      "Paul: No.",
      "",
      "Staff: Then I will rinse and apply conditioner now.",
      "",
      "Paul: Ok.",
      "",
      "Staff: I finished washing. I will help you sit up.",
      "",
      "Paul: Thank you!",
      "",
      "Staff: You’re welcome.",
      ""
    ]
  }
