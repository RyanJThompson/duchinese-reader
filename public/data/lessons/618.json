  "title": "Washing Your Hair at the Hairdresser’s",
  "level": "upper intermediate",
  "date": "2018-11-23",
  "synopsis": "Paul gets his hair washed at the hairdresser’s.",
  "audioUrl": "https://static.duchinese.net/documents/889/a4b8ca64145a2db8f5be584c3c17fd6f295ec8da.mp3?1698350575",
