      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Gao Tian: Anne, good afternoon! Where are you going?"
    },
    {
      "index": 4,
      "simplified": "Anne：中午好，高天！我想去商店。请问，商店在哪儿？",
      "traditional": "Anne：中午好，高天！我想去商店。請問，商店在哪兒？",
      "pinyin": "1 zhōng wǔ hǎo gāo tiān wǒ xiǎng qù shāng diàn qǐng wèn shāng diàn zài nǎ'r",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: Good afternoon, Gao Tian! I want to go to the store. May I ask, where is the store?"
    },
    {
      "index": 6,
      "simplified": "高天：商店在那儿。",
      "traditional": "高天：商店在那兒。",
      "pinyin": "gāo tiān shāng diàn zài nà'r",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Gao Tian: The store is over there."
    },
    {
      "index": 8,
      "simplified": "Anne：谢谢。你去哪儿？",
      "traditional": "Anne：謝謝。你去哪兒？",
      "pinyin": "1 xiè xie nǐ qù nǎ'r",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: Thanks. Where are you going?"
    },
    {
      "index": 10,
      "simplified": "高天：我去书店。我想买汉语书。",
      "traditional": "高天：我去書店。我想買漢語書。",
      "pinyin": "gāo tiān wǒ qù shū diàn wǒ xiǎng mǎi hàn yǔ shū",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Gao Tian: I’m going to the bookstore. I want to buy Chinese books."
    },
    {
      "index": 12,
      "simplified": "Anne：你有手机吗？号码是多少？",
      "traditional": "Anne：你有手機嗎？號碼是多少？",
      "pinyin": "1 nǐ yǒu shǒu jī ma hào mǎ shì duō shao",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Anne: Do you have a cellphone? What’s your number?"
    },
