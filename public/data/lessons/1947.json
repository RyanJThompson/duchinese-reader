    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Gao Tian: Yes, this is my cellphone number."
    },
    {
      "index": 16,
      "simplified": "Anne：明天上午有课，你来上课吗？",
      "traditional": "Anne：明天上午有課，你來上課嗎？",
