{
  "id": "603",
  "title": "Pick Up at the Airport",
  "level": "intermediate",
  "date": "2018-11-11",
  "synopsis": "Manager Wang wants Little Zhang to pick up Ms. Honda at the airport.",
  "audioUrl": "https://static.duchinese.net/documents/886/aa531a7624c443c3948052307da5f6ef915b20fb.mp3?1698350532",
  "series": null,
  "fullText": {
    "simplified": "去接机\n\n王经理：小何，小张呢？\n小何：她出去买东西了。\n王经理：本田女士今天下午3点到机场，你让小张去接机。\n小何：好的。\n王经理：哦，对了。让小张带上合同，本田女士说她要在车上看。\n小何：好的。",
    "traditional": "去接機\n\n王經理：小何，小張呢？\n小何：她出去買東西了。\n王經理：本田女士今天下午3點到機場，你讓小張去接機。\n小何：好的。\n王經理：哦，對了。讓小張帶上合同，本田女士說她要在車上看。\n小何：好的。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Pick Up at the Airport"
    },
    {
      "index": 2,
      "simplified": "王经理：小何，小张呢？",
      "traditional": "王經理：小何，小張呢？",
      "pinyin": "wáng jīng lǐ xiǎo hé xiǎo zhāng ne",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: Little He, where is Little Zhang?"
    },
    {
      "index": 4,
      "simplified": "小何：她出去买东西了。",
      "traditional": "小何：她出去買東西了。",
      "pinyin": "xiǎo hé tā chū qù mǎi dōng xi le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: She went to buy some things."
    },
    {
      "index": 6,
      "simplified": "王经理：本田女士今天下午3点到机场，你让小张去接机。",
      "traditional": "王經理：本田女士今天下午3點到機場，你讓小張去接機。",
      "pinyin": "wáng jīng lǐ běn tián nǚ shì jīn tiān xià wǔ 1 diǎn dào jī chǎng nǐ ràng xiǎo zhāng qù jiē jī",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: Ms. Honda will arrive at the airport at 3 this afternoon. Have Little Zhang go pick her up."
    },
    {
      "index": 8,
      "simplified": "小何：好的。",
      "traditional": "小何：好的。",
      "pinyin": "xiǎo hé hǎo de",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Ok."
    },
    {
      "index": 10,
      "simplified": "王经理：哦，对了。让小张带上合同，本田女士说她要在车上看。",
      "traditional": "王經理：哦，對了。讓小張帶上合同，本田女士說她要在車上看。",
      "pinyin": "wáng jīng lǐ ò duì le ràng xiǎo zhāng dài shàng hé tong běn tián nǚ shì shuō tā yào zài chē shang kàn",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: Oh, right. Have Little Zhang bring the contract. Ms. Honda said she will read it in the car."
    },
    {
      "index": 12,
      "simplified": "小何：好的。",
      "traditional": "小何：好的。",
      "pinyin": "xiǎo hé hǎo de",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: Ok."
    }
  ],
