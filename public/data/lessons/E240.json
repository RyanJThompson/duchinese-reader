{
  "id": "E240",
  "title": "Where Am I Pretty?",
  "level": "elementary",
  "date": "2018-07-21",
  "synopsis": "How do you respond to a compliment in Chinese?",
  "audioUrl": "https://static.duchinese.net/documents/792/975aad46d23c6f1850a6d0b4fed520267c53d5d9.mp3?1531654028",
  "series": null,
  "fullText": {
    "simplified": "哪里漂亮？\n\n保罗：这是你的新裙子吗？真漂亮！\n小乐：哪里哪里。\n保罗：哪里？都很漂亮啊。\n小乐：不是“哪里漂亮”，是谢谢你的夸奖。你今天也很帅啊。\n保罗：啊，哪里哪里！",
    "traditional": "哪裏漂亮？\n\n保羅：這是你的新裙子嗎？真漂亮！\n小樂：哪裡哪裡。\n保羅：哪裏？都很漂亮啊。\n小樂：不是“哪裏漂亮”，是謝謝你的誇獎。你今天也很帥啊。\n保羅：啊，哪裡哪裡！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Where Am I Pretty?"
    },
    {
      "index": 2,
      "simplified": "保罗：这是你的新裙子吗？真漂亮！",
      "traditional": "保羅：這是你的新裙子嗎？真漂亮！",
      "pinyin": "bǎo luó zhè shì nǐ de xīn qún zi ma zhēn piào liang",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Is this your new skirt? It’s really pretty!"
    },
    {
      "index": 4,
      "simplified": "小乐：哪里哪里。",
      "traditional": "小樂：哪裡哪裡。",
      "pinyin": "xiǎo lè nǎ lǐ nǎ lǐ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: It’s nothing."
    },
    {
      "index": 6,
      "simplified": "保罗：哪里？都很漂亮啊。",
      "traditional": "保羅：哪裏？都很漂亮啊。",
      "pinyin": "bǎo luó nǎ lǐ dōu hěn piào liang a",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Where? You’re pretty everywhere."
    },
    {
      "index": 8,
      "simplified": "小乐：不是“哪里漂亮”，是谢谢你的夸奖。你今天也很帅啊。",
      "traditional": "小樂：不是“哪裏漂亮”，是謝謝你的誇獎。你今天也很帥啊。",
      "pinyin": "xiǎo lè bú shì nǎ lǐ piào liang shì xiè xie nǐ de kuā jiǎng nǐ jīn tiān yě hěn shuài a",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: I didn’t mean “where am I pretty”. I meant “thank you for your praise”. You look handsome as well today."
    },
    {
      "index": 10,
      "simplified": "保罗：啊，哪里哪里！",
      "traditional": "保羅：啊，哪裡哪裡！",
      "pinyin": "bǎo luó a nǎ lǐ nǎ lǐ",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Paul: Ah, it’s nothing!"
    }
  ],
