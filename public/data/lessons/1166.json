    {
      "index": 2,
      "simplified": "一只小马想过河，可是不知道河水是深还是浅。",
      "traditional": "一隻小馬想過河，可是不知道河水是深還是淺。",
      "pinyin": "yì zhī xiǎo mǎ xiǎng guò hé kě shì bù zhī dào hé shuǐ shì shēn hái shi qiǎn",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "A little horse wanted to cross the river, but didn’t know whether the water was deep or shallow."
    },
    {
      "index": 4,
      "simplified": "他去问老牛：“牛爷爷，河水深吗？”",
      "traditional": "他去問老牛：“牛爺爺，河水深嗎？”",
      "pinyin": "tā qù wèn lǎo niú niú yé ye hé shuǐ shēn ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "老牛说：“不深，一点儿都不深。”",
      "traditional": "老牛說：“不深，一點兒都不深。”",
      "pinyin": "lǎo niú shuō bù shēn yì diǎn'r dōu bù shēn",
      "english": "He went to ask the old cow, “Grandpa Cow, is the water deep?”"
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "The old cow said, “No, it’s not deep at all.”"
    },
    {
      "index": 7,
      "simplified": "小马来到河边，他刚要过河，小兔子说：",
      "traditional": "小馬來到河邊，他剛要過河，小兔子說：",
      "pinyin": "xiǎo mǎ lái dào hé biān tā gāng yào guò hé xiǎo tù zi shuō",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "“小马，别下去，河水非常深！昨天我的一个朋友就掉进河里了。”",
      "traditional": "“小馬，別下去，河水非常深！昨天我的一個朋友就掉進河裡了。”",
      "pinyin": "xiǎo mǎ bié xià qù hé shuǐ fēi cháng shēn zuó tiān wǒ de yí ge péng you jiù diào jìn hé lǐ le",
      "english": "The little horse walked to the river bank, and was about to cross the river when the little rabbit said,"
    },
    {
      "index": 9,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "“Little horse, don’t go down there; the water is very deep! Just yesterday one of my friends fell into the river.”"
    },
    {
      "index": 10,
      "simplified": "老牛说河水浅，小兔子说河水深，怎么办？",
      "traditional": "老牛說河水淺，小兔子說河水深，怎麼辦？",
      "pinyin": "lǎo niú shuō hé shuǐ qiǎn xiǎo tù zi shuō hé shuǐ shēn zěn me bàn",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "小马只好回家问妈妈。",
      "traditional": "小馬只好回家問媽媽。",
      "pinyin": "xiǎo mǎ zhǐ hǎo huí jiā wèn mā ma",
      "english": "The old cow says the water is shallow, but the little rabbit says the water is deep. What to do?"
    },
    {
      "index": 12,
      "simplified": "妈妈和小马一起来到河边，她让小马自己试一试。",
      "traditional": "媽媽和小馬一起來到河邊，她讓小馬自己試一試。",
      "pinyin": "mā ma hé xiǎo mǎ yì qǐ lái dào hé biān tā ràng xiǎo mǎ zì jǐ shì yí shì",
      "english": "The little horse could only go home and ask his mother."
    },
    {
      "index": 13,
      "simplified": "小马试了试，河水不深也不浅，他高兴地过河了。",
      "traditional": "小馬試了試，河水不深也不淺，他高興地過河了。",
      "pinyin": "xiǎo mǎ shì le shì hé shuǐ bù shēn yě bù qiǎn tā gāo xìng de guò hé le",
      "english": "The little horse and his mother went to the river bank together. She wanted the little horse to try for himself."
    },
    {
      "index": 14,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "The little horse tried it. The water was neither deep nor shallow, and he crossed the river very happily."
    }
  ],
