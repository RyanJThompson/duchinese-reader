{
  "id": "754",
  "title": "Is Your Work Finished?",
  "level": "newbie",
  "date": "2019-06-27",
  "synopsis": "Little Zhang wants to finish today’s work before going home.",
  "audioUrl": "https://static.duchinese.net/documents/1081/63053a132bc3d7005674e4bf12dc6cd95899ecc3.mp3?1561034969",
  "series": null,
  "fullText": {
    "simplified": "你的工作做完了吗？\n\n小何：今天的工作你做完了吗？\n小张：没有。\n小何：那明天再做吧！\n小张：今天的工作要今天做完！明天有明天的工作。你先回去吧！\n小何：好吧！那我们明天见！\n小张：明天见！",
    "traditional": "你的工作做完了嗎？\n\n小何：今天的工作你做完了嗎？\n小張：沒有。\n小何：那明天再做吧！\n小張：今天的工作要今天做完！明天有明天的工作。你先回去吧！\n小何：好吧！那我們明天見！\n小張：明天見！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Is Your Work Finished?"
    },
    {
      "index": 2,
      "simplified": "小何：今天的工作你做完了吗？",
      "traditional": "小何：今天的工作你做完了嗎？",
      "pinyin": "xiǎo hé jīn tiān de gōng zuò nǐ zuò wán le ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Have you finished today’s work?"
    },
    {
      "index": 4,
      "simplified": "小张：没有。",
      "traditional": "小張：沒有。",
      "pinyin": "xiǎo zhāng méi yǒu",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: I haven’t."
    },
    {
      "index": 6,
      "simplified": "小何：那明天再做吧！",
      "traditional": "小何：那明天再做吧！",
      "pinyin": "xiǎo hé nà míng tiān zài zuò ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Then keep doing it tomorrow!"
    },
    {
      "index": 8,
      "simplified": "小张：今天的工作要今天做完！明天有明天的工作。你先回去吧！",
      "traditional": "小張：今天的工作要今天做完！明天有明天的工作。你先回去吧！",
      "pinyin": "xiǎo zhāng jīn tiān de gōng zuò yào jīn tiān zuò wán míng tiān yǒu míng tiān de gōng zuò nǐ xiān huí qù ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: Today’s work should be done today! There is tomorrow’s work tomorrow. You go back first!"
    },
    {
      "index": 10,
      "simplified": "小何：好吧！那我们明天见！",
      "traditional": "小何：好吧！那我們明天見！",
      "pinyin": "xiǎo hé hǎo ba nà wǒ men míng tiān jiàn",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Ok! Then we’ll see each other tomorrow!"
    },
    {
      "index": 12,
      "simplified": "小张：明天见！",
      "traditional": "小張：明天見！",
      "pinyin": "xiǎo zhāng míng tiān jiàn",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Zhang: See you tomorrow!"
    }
  ],
