{
  "id": "448",
  "title": "We Meet Again",
  "level": "newbie",
  "date": "2018-01-25",
  "synopsis": "Ben bumps into Lili's friend Little Yu again.",
  "audioUrl": "https://static.duchinese.net/documents/638/fb759f326d468063db770a020601174e3d76d575.mp3?1589791600",
  "series": {
    "title": "Ben’s life in China 3: Who is Little Yu?",
    "chapter": 5,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "我们又见面了\n\n小雨：本！我们又见面了！你去哪儿？\n本：你好，小雨！我去吃饭。\n小雨：我也要去吃饭，我们一起吧！\n本：好啊！你想吃什么？\n小雨：我知道有一家店非常好吃，我带你去。",
    "traditional": "我們又見面了\n\n小雨：本！我們又見面了！你去哪兒？\n本：你好，小雨！我去吃飯。\n小雨：我也要去吃飯，我們一起吧！\n本：好啊！你想吃什麼？\n小雨：我知道有一家店非常好吃，我帶你去。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "We Meet Again"
    },
    {
      "index": 2,
      "simplified": "小雨：本！我们又见面了！你去哪儿？",
      "traditional": "小雨：本！我們又見面了！你去哪兒？",
      "pinyin": "xiǎo yǔ běn wǒ men yòu jiàn miàn le nǐ qù nǎ'r",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Ben! We meet again! Where are you going?"
    },
    {
      "index": 4,
      "simplified": "本：你好，小雨！我去吃饭。",
      "traditional": "本：你好，小雨！我去吃飯。",
      "pinyin": "běn nǐ hǎo xiǎo yǔ wǒ qù chī fàn",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Hi, Little Yu! I'm going to eat."
    },
    {
      "index": 6,
      "simplified": "小雨：我也要去吃饭，我们一起吧！",
      "traditional": "小雨：我也要去吃飯，我們一起吧！",
      "pinyin": "xiǎo yǔ wǒ yě yào qù chī fàn wǒ men yì qǐ ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: I'm also going to eat, let's go together!"
    },
    {
      "index": 8,
      "simplified": "本：好啊！你想吃什么？",
      "traditional": "本：好啊！你想吃什麼？",
      "pinyin": "běn hǎo a nǐ xiǎng chī shén me",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Sure! What do you want to eat?"
    },
    {
      "index": 10,
      "simplified": "小雨：我知道有一家店非常好吃，我带你去。",
      "traditional": "小雨：我知道有一家店非常好吃，我帶你去。",
      "pinyin": "xiǎo yǔ wǒ zhī dào yǒu yì jiā diàn fēi cháng hǎo chī wǒ dài nǐ qù",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu: I know a really tasty restaurant. I'll take you."
    }
