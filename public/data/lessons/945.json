      "english": ""
    },
    {
      "index": 3,
      "simplified": "9点去找你，美人。",
      "traditional": "9點去找你，美人。",
      "pinyin": "1 diǎn qù zhǎo nǐ měi rén",
      "english": "One morning, after Little Yu got out of bed, she saw a WeChat message that Ben had sent her:"
    },
    {
      "index": 4,
      "simplified": "小雨十分高兴，因为她很喜欢本。",
      "traditional": "小雨十分高興，因為她很喜歡本。",
      "pinyin": "xiǎo yǔ shí fēn gāo xìng yīn wèi tā hěn xǐ huan běn",
      "english": "Call on you at 9 o’clock, beauty."
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Yu was very happy, because she likes Ben a lot."
    },
    {
      "index": 6,
      "simplified": "这一天，小雨哪儿也没去。她从早上等到下午，可是本并没有来。",
      "traditional": "這一天，小雨哪兒也沒去。她從早上等到下午，可是本並沒有來。",
      "pinyin": "zhè yì tiān xiǎo yǔ nǎ'r yě méi qù tā cóng zǎo shang děng dào xià wǔ kě shì běn bìng méi yǒu lái",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "This day, Little Yu didn’t go anywhere. She waited from morning to afternoon, but Ben never came."
    },
    {
      "index": 8,
      "simplified": "小雨很生气，她给本打电话：“你为什么没来找我？”",
      "traditional": "小雨很生氣，她給本打電話：“你為什麼沒來找我？”",
      "pinyin": "xiǎo yǔ hěn shēng qì tā gěi běn dǎ diàn huà nǐ wèi shén me méi lái zhǎo wǒ",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Yu was very angry and called Ben, “Why didn’t you call on me?”"
    },
    {
      "index": 10,
      "simplified": "本说：“我昨天晚上9点去找你了，你家没人啊！”",
      "traditional": "本說：“我昨天晚上9點去找你了，你家沒人啊！”",
      "pinyin": "běn shuō wǒ zuó tiān wǎn shang 1 diǎn qù zhǎo nǐ le nǐ jiā méi rén a",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Ben said. “I called on you yesterday evening at 9 o’clock, but there was no one at your house!”"
    },
    {
      "index": 12,
      "simplified": "小雨又看了一遍微信，原来昨天本把“没人”写成了“美人”。",
      "traditional": "小雨又看了一遍微信，原來昨天本把“沒人”寫成了“美人”。",
      "pinyin": "xiǎo yǔ yòu kàn le yí biàn wēi xìn yuán lái zuó tiān běn bǎ méi rén xiě chéng le měi rén",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu looked at the WeChat message one more time. It turned out that Ben had written “no one” as “beauty”."
    }
