{
  "id": "417",
  "title": "Did You Sleep Well?",
  "level": "intermediate",
  "date": "2017-12-13",
  "synopsis": "Lili tells Ben why she had trouble sleeping last night.",
  "audioUrl": "https://static.duchinese.net/documents/601/6b0960a6b75bd4bf74ae0dc9667640e346eb8bf9.mp3?1635865077",
  "series": {
