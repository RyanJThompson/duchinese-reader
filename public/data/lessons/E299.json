{
  "id": "E299",
  "title": "Don’t Gift Chrysanthemums",
  "level": "elementary",
  "date": "2019-02-14",
  "synopsis": "Do you know the special meaning of giving someone chrysanthemums?",
  "audioUrl": "https://static.duchinese.net/documents/970/49c156d7ecea39e03c778ce6986c3bc36853b37d.mp3?1549095615",
  "series": null,
  "fullText": {
    "simplified": "不要送菊花\n\n保罗：小乐，情人节快乐！这束花送给你。\n小乐：谢谢你，保罗！可是这个花…\n保罗：怎么了？不好看吗？\n小乐：不，这束花很漂亮。但是在中国，菊花是送给已经去世的人的。",
    "traditional": "不要送菊花\n\n保羅：小樂，情人節快樂！這束花送給你。\n小樂：謝謝你，保羅！可是這個花…\n保羅：怎麼了？不好看嗎？\n小樂：不，這束花很漂亮。但是在中國，菊花是送給已經去世的人的。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Don’t Gift Chrysanthemums"
    },
    {
      "index": 2,
      "simplified": "保罗：小乐，情人节快乐！这束花送给你。",
      "traditional": "保羅：小樂，情人節快樂！這束花送給你。",
      "pinyin": "bǎo luó xiǎo lè qíng rén jié kuài lè zhè shù huā sòng gěi nǐ",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, Happy Valentine’s Day! This bunch of flowers is for you."
    },
    {
      "index": 4,
      "simplified": "小乐：谢谢你，保罗！可是这个花…",
      "traditional": "小樂：謝謝你，保羅！可是這個花…",
      "pinyin": "xiǎo lè xiè xie nǐ bǎo luó kě shì zhè ge huā",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Thank you, Paul! But these flowers…"
    },
    {
      "index": 6,
      "simplified": "保罗：怎么了？不好看吗？",
      "traditional": "保羅：怎麼了？不好看嗎？",
      "pinyin": "bǎo luó zěn me le bù hǎo kàn ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: What’s wrong? Aren’t they beautiful?"
    },
    {
      "index": 8,
      "simplified": "小乐：不，这束花很漂亮。",
      "traditional": "小樂：不，這束花很漂亮。",
      "pinyin": "xiǎo lè bù zhè shù huā hěn piào liang",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "但是在中国，菊花是送给已经去世的人的。",
      "traditional": "但是在中國，菊花是送給已經去世的人的。",
      "pinyin": "dàn shì zài zhōng guó jú huā shì sòng gěi yǐ jīng qù shì de rén de",
      "english": "Little Le: No, this bouquet is very beautiful."
    },
    {
      "index": 10,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "But in China, chrysanthemums are given to people who have already passed away."
    }
  ],
