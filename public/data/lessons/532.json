{
  "id": "532",
  "title": "Why Did You Go With Him?",
  "level": "newbie",
  "date": "2018-07-05",
  "synopsis": "He Jing is not too happy about Lili going to the movies with Ben.",
  "audioUrl": "https://static.duchinese.net/documents/778/d4935ac33cc6058d502641eccad8dd4526ab7d53.mp3?1589791839",
