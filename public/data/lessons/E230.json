{
  "id": "E230",
  "title": "Meeting Notice",
  "level": "upper intermediate",
  "date": "2018-06-10",
  "synopsis": "The marketing department announces a very important meeting.",
  "audioUrl": "https://static.duchinese.net/documents/761/15ab9268a7ad891b064b4e95c414b26b5b235f23.mp3?1528361757",
  "series": null,
  "fullText": {
    "simplified": "会议通知\n\n     市场部将于6月8日上午9点在201会议室召开部门会议，对五月工作情况进行总结，并讨论六月具体工作计划。请相关发言人员认真准备发言内容。\n     本次会议内容非常重要，请市场部所有员工准时参加。会议期间请把手机关机或者调成静音。",
    "traditional": "會議通知\n\n     市場部將於6月8日上午9點在201會議室召開部門會議，對五月工作情況進行總結，並討論六月具體工作計劃。請相關發言人員認真準備發言內容。\n     本次會議內容非常重要，請市場部所有員工準時參加。會議期間請把手機關機或者調成靜音。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n     ",
      "traditional": "\n\n     ",
      "pinyin": "",
      "english": "Meeting Notice"
    },
    {
      "index": 2,
      "simplified": "市场部将于6月8日上午9点在201会议室召开部门会议，",
      "traditional": "市場部將於6月8日上午9點在201會議室召開部門會議，",
      "pinyin": "shì chǎng bù jiāng yú 1 yuè 1 rì shàng wǔ 1 diǎn zài 3 huì yì shì zhào kāi bù mén huì yì",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "对五月工作情况进行总结，并讨论六月具体工作计划。",
      "traditional": "對五月工作情況進行總結，並討論六月具體工作計劃。",
      "pinyin": "duì wǔ yuè gōng zuò qíng kuàng jìn xíng zǒng jié bìng tǎo lùn liù yuè jù tǐ gōng zuò jì huà",
      "english": "The marketing department will hold a meeting on June 8th at 9 am in meeting room 201."
    },
    {
      "index": 4,
      "simplified": "请相关发言人员认真准备发言内容。",
      "traditional": "請相關發言人員認真準備發言內容。",
      "pinyin": "qǐng xiāng guān fā yán rén yuán rèn zhēn zhǔn bèi fā yán nèi róng",
      "english": "We will summarize our work in May, and talk about the concrete work plan for June."
    },
    {
      "index": 5,
      "simplified": "\n     ",
      "traditional": "\n     ",
      "pinyin": "",
      "english": "Please prepare if you need to give a speech during the meeting."
    },
    {
      "index": 6,
      "simplified": "本次会议内容非常重要，",
      "traditional": "本次會議內容非常重要，",
      "pinyin": "běn cì huì yì nèi róng fēi cháng zhòng yào",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "请市场部所有员工准时参加。",
      "traditional": "請市場部所有員工準時參加。",
      "pinyin": "qǐng shì chǎng bù suǒ yǒu yuán gōng zhǔn shí cān jiā",
      "english": "The content of this meeting is very important."
    },
    {
      "index": 8,
      "simplified": "会议期间请把手机关机或者调成静音。",
      "traditional": "會議期間請把手機關機或者調成靜音。",
      "pinyin": "huì yì qī jiān qǐng bǎ shǒu jī guān jī huò zhě tiáo chéng jìng yīn",
      "english": "We ask everyone in the marketing department to attend the meeting on time."
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Please turn off your cell phone or switch it to silent mode during the meeting."
    }
  ],
