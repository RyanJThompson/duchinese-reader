{
  "id": "430",
  "title": "Participating in the Opening Ceremony",
  "level": "intermediate",
  "date": "2017-11-29",
  "synopsis": "Manager Wang and Little He make a business visit to an opening ceremony.",
  "audioUrl": "https://static.duchinese.net/documents/590/2c3351f076451c58145d83c8a19b016b6e385adc.mp3?1698352059",
  "series": null,
  "fullText": {
    "simplified": "参加开业典礼\n\n在宴会上。\n王总：陈总！恭喜恭喜！开张大吉啊！\n陈总：谢谢！谢谢！\n王总：刚才看了你们店的手机展，实在是太棒了！\n陈总：哪里哪里！过奖了！咦？这位是？\n王总：哦，忘了介绍。这是我们公司的小何。\n小何：陈总，您好！这是我的名片。\n陈总：您好！\n小何：祝您开张大吉！生意兴隆！\n陈总：谢谢！那王总、小何，你们玩得开心！我还有事，失陪了。\n王总：好的，您先忙。",
    "traditional": "參加開業典禮\n\n在宴會上。\n王總：陳總！恭喜恭喜！開張大吉啊！\n陳總：謝謝！謝謝！\n王總：剛才看了你們店的手機展，實在是太棒了！\n陳總：哪裡哪裡！過獎了！咦？這位是？\n王總：哦，忘了介紹。這是我們公司的小何。\n小何：陳總，您好！這是我的名片。\n陳總：您好！\n小何：祝您開張大吉！生意興隆！\n陳總：謝謝！那王總、小何，你們玩得開心！我還有事，失陪了。\n王總：好的，您先忙。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Participating in the Opening Ceremony"
    },
    {
      "index": 2,
      "simplified": "在宴会上。",
      "traditional": "在宴會上。",
      "pinyin": "zài yàn huì shang",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "At the banquet."
    },
    {
      "index": 4,
      "simplified": "王总：陈总！恭喜恭喜！开张大吉啊！",
      "traditional": "王總：陳總！恭喜恭喜！開張大吉啊！",
      "pinyin": "wáng zǒng chén zǒng gōng xǐ gōng xǐ kāi zhāng dà jí a",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: Manager Chen! Congratulations! Great luck on your new business!"
    },
    {
      "index": 6,
      "simplified": "陈总：谢谢！谢谢！",
      "traditional": "陳總：謝謝！謝謝！",
      "pinyin": "chén zǒng xiè xie xiè xie",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Chen: Thank you, thank you!"
    },
    {
      "index": 8,
      "simplified": "王总：刚才看了你们店的手机展，实在是太棒了！",
      "traditional": "王總：剛才看了你們店的手機展，實在是太棒了！",
      "pinyin": "wáng zǒng gāng cái kàn le nǐ men diàn de shǒu jī zhǎn shí zài shì tài bàng le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: I just saw the mobile phone exhibition in your store, it's really great!"
    },
    {
      "index": 10,
      "simplified": "陈总：哪里哪里！过奖了！咦？这位是？",
      "traditional": "陳總：哪裡哪裡！過獎了！咦？這位是？",
      "pinyin": "chén zǒng nǎ lǐ nǎ lǐ guò jiǎng le yí zhè wèi shì",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Chen: Oh, it's nothing! You're flattering me! Oh? Who is this?"
    },
    {
      "index": 12,
      "simplified": "王总：哦，忘了介绍。这是我们公司的小何。",
      "traditional": "王總：哦，忘了介紹。這是我們公司的小何。",
      "pinyin": "wáng zǒng ò wàng le jiè shào zhè shì wǒ men gōng sī de xiǎo hé",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: Oh, I forgot to introduce you. This is Little He from our company."
    },
    {
      "index": 14,
      "simplified": "小何：陈总，您好！这是我的名片。",
      "traditional": "小何：陳總，您好！這是我的名片。",
      "pinyin": "xiǎo hé chén zǒng nín hǎo zhè shì wǒ de míng piàn",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Hello, Manager Chen! Here is my card."
    },
    {
      "index": 16,
      "simplified": "陈总：您好！",
      "traditional": "陳總：您好！",
      "pinyin": "chén zǒng nín hǎo",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Chen: Hello!"
    },
    {
      "index": 18,
      "simplified": "小何：祝您开张大吉！生意兴隆！",
      "traditional": "小何：祝您開張大吉！生意興隆！",
      "pinyin": "xiǎo hé zhù nín kāi zhāng dà jí shēng yì xīng lóng",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Congratulations on your successful business opening! May your business thrive!"
    },
    {
      "index": 20,
      "simplified": "陈总：谢谢！那王总、小何，你们玩得开心！",
      "traditional": "陳總：謝謝！那王總、小何，你們玩得開心！",
      "pinyin": "chén zǒng xiè xie nà wáng zǒng xiǎo hé nǐ men wán de kāi xīn",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "我还有事，失陪了。",
      "traditional": "我還有事，失陪了。",
      "pinyin": "wǒ hái yǒu shì shī péi le",
      "english": "Manager Chen: Thank you! Well then, Manager Wang and Little He, enjoy yourselves!"
    },
    {
      "index": 22,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "I still have some things to take care of, goodbye!"
    },
    {
      "index": 23,
      "simplified": "王总：好的，您先忙。",
      "traditional": "王總：好的，您先忙。",
      "pinyin": "wáng zǒng hǎo de nín xiān máng",
      "english": ""
    },
    {
      "index": 24,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Manager Wang: Sure, you go on ahead."
    }
  ],
