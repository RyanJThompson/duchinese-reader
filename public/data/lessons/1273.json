    {
      "index": 2,
      "simplified": "今天是星期天，天气很热。",
      "traditional": "今天是星期天，天氣很熱。",
      "pinyin": "jīn tiān shì xīng qī tiān tiān qì hěn rè",
      "english": "Today was Sunday. The weather was very hot."
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 4,
      "simplified": "今天没有人来学校，学校没有饭。",
      "traditional": "今天沒有人來學校，學校沒有飯。",
      "pinyin": "jīn tiān méi yǒu rén lái xué xiào xué xiào méi yǒu fàn",
      "english": "Today nobody came to the school. There was no food at the school."
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "我和饭饭前天没有吃饭，昨天也没有吃饭。我们很想吃饭！",
      "traditional": "我和飯飯前天沒有吃飯，昨天也沒有吃飯。我們很想吃飯！",
      "pinyin": "wǒ hé fàn fàn qián tiān méi yǒu chī fàn zuó tiān yě méi yǒu chī fàn wǒ men hěn xiǎng chī fàn",
      "english": "Me and Fanfan didn’t eat the day before yesterday, nor did we eat yesterday. We really wanted to eat!"
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "我和饭饭去饭店，饭店没有米饭；",
      "traditional": "我和飯飯去飯店，飯店沒有米飯；",
      "pinyin": "wǒ hé fàn fàn qù fàn diàn fàn diàn méi yǒu mǐ fàn",
      "english": "Me and Fanfan went to the restaurant. The restaurant didn’t have any rice."
    },
    {
      "index": 9,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "我和饭饭去医院，医院也没有米饭。",
      "traditional": "我和飯飯去醫院，醫院也沒有米飯。",
      "pinyin": "wǒ hé fàn fàn qù yī yuàn yī yuàn yě méi yǒu mǐ fàn",
      "english": "Me and Fanfan went to the hospital. The hospital also didn’t have any rice."
    },
    {
      "index": 11,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "在一个商店，饭饭看见有米饭，我们很高兴。",
      "traditional": "在一個商店，飯飯看見有米飯，我們很高興。",
      "pinyin": "zài yí ge shāng diàn fàn fàn kàn jiàn yǒu mǐ fàn wǒ men hěn gāo xìng",
      "english": "At one store, Fanfan saw that there was rice. We were very happy."
    },
    {
      "index": 13,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "我们在吃米饭。",
      "traditional": "我們在吃米飯。",
      "pinyin": "wǒ men zài chī mǐ fàn",
      "english": "We were in the middle of eating rice."
    },
    {
      "index": 15,
      "simplified": "这个时候，一个大猫来了，他说：“这是我的地方！这是我的米饭！你们不能吃！”",
      "traditional": "這個時候，一個大貓來了，他說：“這是我的地方！這是我的米飯！你們不能吃！”",
      "pinyin": "zhè ge shí hou yí ge dà māo lái le tā shuō zhè shì wǒ de dì fang zhè shì wǒ de mǐ fàn nǐ men bù néng chī",
      "english": "At this time, a big cat came. He said, “This is my place! This is my rice! You must not eat it!”"
    }
  ],
