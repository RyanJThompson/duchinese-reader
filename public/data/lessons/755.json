      "english": ""
    },
    {
      "index": 3,
      "simplified": "小张很想和他搭讪，但又不知道说些什么。",
      "traditional": "小張很想和他搭訕，但又不知道說些什麼。",
      "pinyin": "xiǎo zhāng hěn xiǎng hé tā dā shàn dàn yòu bù zhī dào shuō xiē shén me",
      "english": "On the nonstop flight to Beijing, a handsome guy sat beside Little Zhang."
    },
    {
      "index": 4,
      "simplified": "小张想了好久，终于鼓起勇气，问道：",
      "traditional": "小張想了好久，終於鼓起勇氣，問道：",
      "pinyin": "xiǎo zhāng xiǎng le hǎo jiǔ zhōng yú gǔ qǐ yǒng qì wèn dào",
      "english": "Little Zhang really wanted to strike up a conversation with him, but also didn’t know what to say."
    },
    {
      "index": 5,
      "simplified": "“帅哥，你也去北京吗？”",
      "traditional": "“帥哥，你也去北京嗎？”",
      "pinyin": "shuài gē nǐ yě qù běi jīng ma",
      "english": "Little Zhang thought for quite a while, finally summoned up courage, and asked:"
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "“Handsome guy, are you also going to Beijing?”"
    },
    {
      "index": 7,
      "simplified": "那位帅哥看着小张，笑道：",
      "traditional": "那位帥哥看著小張，笑道：",
      "pinyin": "nà wèi shuài gē kàn zhe xiǎo zhāng xiào dào",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "“我们在同一架飞机上，我不去北京，难道还中途跳下去不成？”",
      "traditional": "“我們在同一架飛機上，我不去北京，難道還中途跳下去不成？”",
      "pinyin": "wǒ men zài tóng yí jià fēi jī shang wǒ bú qù běi jīng nán dào hái zhōng tú tiào xià qù bù chéng",
      "english": "That handsome guy looked at Little Zhang, and said with a smile:"
    }
