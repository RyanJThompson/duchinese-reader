{
  "id": "530",
  "title": "Ben's Diary – Rain Tomorrow",
  "level": "newbie",
  "date": "2018-06-07",
  "synopsis": "Ben writes about his plans of going to the beach with Lili.",
  "audioUrl": "https://static.duchinese.net/documents/754/2873e683f69bf22e56b48bdd1529e6fda1cb5710.mp3?1527744191",
  "series": null,
  "fullText": {
    "simplified": "本的日记—明天下雨\n\n2018年6月15日 阴\n    丽丽说明天想去海边玩，我很想和丽丽去海边玩。但是我看电视，电视说明天下雨。我希望明天不下雨，我们能去海边玩。",
    "traditional": "本的日記—明天下雨\n\n2018年6月15日 陰\n    麗麗說明天想去海邊玩，我很想和麗麗去海邊玩。但是我看電視，電視說明天下雨。我希望明天不下雨，我們能去海邊玩。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Ben’s Diary – Rain Tomorrow"
    },
    {
      "index": 2,
      "simplified": "2018年6月15日 阴",
      "traditional": "2018年6月15日 陰",
      "pinyin": "4 nián 1 yuè 2 rì yīn",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "2018-06-15 Cloudy"
    },
    {
      "index": 4,
      "simplified": "丽丽说明天想去海边玩，",
      "traditional": "麗麗說明天想去海邊玩，",
      "pinyin": "lì lì shuō míng tiān xiǎng qù hǎi biān wán",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "我很想和丽丽去海边玩。",
      "traditional": "我很想和麗麗去海邊玩。",
      "pinyin": "wǒ hěn xiǎng hé lì lì qù hǎi biān wán",
      "english": "Lili said she wants to go to the beach to play tomorrow."
    },
    {
      "index": 6,
      "simplified": "但是我看电视，电视说明天下雨。",
      "traditional": "但是我看電視，電視說明天下雨。",
      "pinyin": "dàn shì wǒ kàn diàn shì diàn shì shuō míng tiān xià yǔ",
      "english": "I really want to go with Lili to the beach."
    },
    {
      "index": 7,
      "simplified": "我希望明天不下雨，我们能去海边玩。",
      "traditional": "我希望明天不下雨，我們能去海邊玩。",
      "pinyin": "wǒ xī wàng míng tiān bú xià yǔ wǒ men néng qù hǎi biān wán",
      "english": "But I looked at the TV, and on the TV they said it will rain tomorrow."
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "I hope it will not rain tomorrow, so that we can go to the beach together."
    }
  ],
