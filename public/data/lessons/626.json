{
  "id": "626",
  "title": "Your Delivery Has Arrived",
  "level": "intermediate",
  "date": "2018-12-05",
  "synopsis": "Feifei gets a delivery when she is not at home.",
  "audioUrl": "https://static.duchinese.net/documents/909/d153bb4274b163cd87ac01e10213b95135db0214.mp3?1698350428",
  "series": null,
  "fullText": {
    "simplified": "您的快递到了\n\n快递员：您好！您的快递到了。\n李飞飞：您现在在哪里？\n快递员：我在你们楼下，请您下来取一下。\n李飞飞：我现在在外面。您帮我放到自提柜里吧！\n快递员：自提柜满了，放不进去。\n李飞飞：那请您帮我放到门卫那里吧。\n快递员：门卫不收。\n李飞飞：啊？这样呀！我现在在路上，5分钟后到家，要不您等我一下。\n快递员：好的。那您快点。\n李飞飞：好的好的。马上到。",
    "traditional": "您的快遞到了\n\n快遞員：您好！您的快遞到了。\n李飛飛：您現在在哪裏？\n快遞員：我在你們樓下，請您下來取一下。\n李飛飛：我現在在外面。您幫我放到自提櫃裡吧！\n快遞員：自提櫃滿了，放不進去。\n李飛飛：那請您幫我放到門衛那裡吧。\n快遞員：門衛不收。\n李飛飛：啊？這樣呀！我現在在路上，5分鐘後到家，要不您等我一下。\n快遞員：好的。那您快點。\n李飛飛：好的好的。馬上到。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Your Delivery Has Arrived"
    },
    {
      "index": 2,
      "simplified": "快递员：您好！您的快递到了。",
      "traditional": "快遞員：您好！您的快遞到了。",
      "pinyin": "kuài dì yuán nín hǎo nín de kuài dì dào le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Courier: Hello! Your delivery has arrived."
    },
    {
      "index": 4,
      "simplified": "李飞飞：您现在在哪里？",
      "traditional": "李飛飛：您現在在哪裏？",
      "pinyin": "lǐ fēi fēi nín xiàn zài zài nǎ lǐ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Where are you now?"
    },
    {
      "index": 6,
      "simplified": "快递员：我在你们楼下，请您下来取一下。",
      "traditional": "快遞員：我在你們樓下，請您下來取一下。",
      "pinyin": "kuài dì yuán wǒ zài nǐ men lóu xià qǐng nín xià lai qǔ yí xià",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Courier: I’m downstairs. Please come down and fetch it."
    },
    {
      "index": 8,
      "simplified": "李飞飞：我现在在外面。您帮我放到自提柜里吧！",
      "traditional": "李飛飛：我現在在外面。您幫我放到自提櫃裡吧！",
      "pinyin": "lǐ fēi fēi wǒ xiàn zài zài wài miàn nín bāng wǒ fàng dào zì tí guì lǐ ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I’m outside at the moment. Please put it in the delivery locker for me!"
    },
    {
      "index": 10,
      "simplified": "快递员：自提柜满了，放不进去。",
      "traditional": "快遞員：自提櫃滿了，放不進去。",
      "pinyin": "kuài dì yuán zì tí guì mǎn le fàng bú jìn qù",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Courier: The delivery locker is full, I can’t put it in."
    },
    {
      "index": 12,
      "simplified": "李飞飞：那请您帮我放到门卫那里吧。",
      "traditional": "李飛飛：那請您幫我放到門衛那裡吧。",
      "pinyin": "lǐ fēi fēi nà qǐng nín bāng wǒ fàng dào mén wèi nà lǐ ba",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Then please give it to the guard over at the gate."
    },
    {
      "index": 14,
      "simplified": "快递员：门卫不收。",
      "traditional": "快遞員：門衛不收。",
      "pinyin": "kuài dì yuán mén wèi bù shōu",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Courier: The guard won’t take it."
    },
    {
      "index": 16,
      "simplified": "李飞飞：啊？这样呀！我现在在路上，5分钟后到家，要不您等我一下。",
      "traditional": "李飛飛：啊？這樣呀！我現在在路上，5分鐘後到家，要不您等我一下。",
      "pinyin": "lǐ fēi fēi a zhè yàng ya wǒ xiàn zài zài lù shang 1 fēn zhōng hòu dào jiā yào bù nín děng wǒ yí xià",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Ah? Really! I’m currently on my way and will be home in 5 minutes. How about you wait for me?"
    },
    {
      "index": 18,
      "simplified": "快递员：好的。那您快点。",
      "traditional": "快遞員：好的。那您快點。",
      "pinyin": "kuài dì yuán hǎo de nà nín kuài diǎn",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Courier: Ok. Then hurry up."
    },
    {
      "index": 20,
      "simplified": "李飞飞：好的好的。马上到。",
      "traditional": "李飛飛：好的好的。馬上到。",
      "pinyin": "lǐ fēi fēi hǎo de hǎo de mǎ shàng dào",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Lili: Ok, ok. I’ll be there soon."
    }
  ],
