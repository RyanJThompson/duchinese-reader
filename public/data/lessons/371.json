  "title": "Watching the Moon",
  "level": "elementary",
  "date": "2017-10-03",
  "synopsis": "Little Li invites Ben to go watch the moon during the Mid-Autumn Festival.",
  "audioUrl": "https://static.duchinese.net/documents/539/5234ff259bbdb5e3585a2ee9f81d987439c1b37f.mp3?1554973194",
