{
  "id": "765",
  "title": "A Beginner on the Road",
  "level": "intermediate",
  "date": "2019-09-22",
  "synopsis": "Little Zhang is not an experienced driver.",
  "audioUrl": "https://static.duchinese.net/documents/1153/bcf5ebfbc48fa101f3a578602d512b8af19e6661.mp3?1568622581",
  "series": null,
  "fullText": {
    "simplified": "新手上路\n\n小何：刹车！刹车！\n小张：哦！\n小何：吓死我了！你没看到有人在过人行横道吗？\n小张：还真没看到。\n小何：真不知道你怎么拿到驾照的。\n小张：我新手上路嘛，多多包涵！",
    "traditional": "新手上路\n\n小何：剎車！剎車！\n小張：哦！\n小何：嚇死我了！你沒看到有人在過人行橫道嗎？\n小張：還真沒看到。\n小何：真不知道你怎麼拿到駕照的。\n小張：我新手上路嘛，多多包涵！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "A Beginner on the Road"
    },
    {
      "index": 2,
      "simplified": "小何：刹车！刹车！",
      "traditional": "小何：剎車！剎車！",
      "pinyin": "xiǎo hé shā chē shā chē",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Brake the car! Brake the car!"
    },
    {
      "index": 4,
      "simplified": "小张：哦！",
      "traditional": "小張：哦！",
      "pinyin": "xiǎo zhāng ò",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: Oh!"
    },
    {
      "index": 6,
      "simplified": "小何：吓死我了！你没看到有人在过人行横道吗？",
      "traditional": "小何：嚇死我了！你沒看到有人在過人行橫道嗎？",
      "pinyin": "xiǎo hé xià sǐ wǒ le nǐ méi kàn dào yǒu rén zài guò rén xíng héng dào ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: You scared me to death! Didn’t you see there’s someone passing at the crosswalk?"
    },
    {
      "index": 8,
      "simplified": "小张：还真没看到。",
      "traditional": "小張：還真沒看到。",
      "pinyin": "xiǎo zhāng hái zhēn méi kàn dào",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: I really didn’t even notice."
    },
    {
      "index": 10,
      "simplified": "小何：真不知道你怎么拿到驾照的。",
      "traditional": "小何：真不知道你怎麼拿到駕照的。",
      "pinyin": "xiǎo hé zhēn bù zhī dào nǐ zěn me ná dào jià zhào de",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: I really don’t know how you got a hold of a driving license."
    },
    {
      "index": 12,
      "simplified": "小张：我新手上路嘛，多多包涵！",
      "traditional": "小張：我新手上路嘛，多多包涵！",
      "pinyin": "xiǎo zhāng wǒ xīn shǒu shàng lù ma duō duō bāo hán",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Zhang: I’m a beginner on the road, please bear with me!"
    }
  ],
