    "sentence_translations": [
      "I’m Taking a Taxi",
      "",
      "Driver: Hello! Where are you going?",
      "",
      "Amy: Hello! I’m going to the Beijing Hotel. Thank you!",
      "",
      "Driver: Okay. I’ll help you put your luggage in the back of the car.",
      "",
      "Amy: Okay, thank you! How many minutes does it take to get from the airport to the Beijing Hotel?",
      "",
      "Driver: Maybe 30 minutes.",
      "",
      "Amy: Sorry, I’m a bit carsick. Can you open the window, please?",
      "",
      "Driver: Okay. Is it better now?",
      "",
      "Amy: Much better, thank you! But it’s a little cold.",
      "",
      "Driver: I’ll close the window and turn on the air conditioning.",
      "",
      "Amy: Okay, thank you! Excuse me, are we almost there?",
      "",
      "Driver: Almost there, five more minutes.",
      "This time is when people are getting off work. There are a lot of cars, so just wait a but more.",
      "",
      "Amy: Okay.",
      "",
      "Driver: We’re here. One hundred and twenty yuan, thank you!",
      "",
      "Amy: Here you go, thank you!"
    ]
  }
