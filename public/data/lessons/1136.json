{
  "id": "1136",
  "title": "You’re Really Fat",
  "level": "newbie",
  "date": "2020-12-16",
  "synopsis": "Lili has some good news!",
  "audioUrl": "https://static.duchinese.net/documents/1136/67b2c2eb35556ba99923d0d50371706d2d9a64e0.mp3?1605192231",
  "series": null,
  "fullText": {
    "simplified": "你真胖\n\n丽丽：告诉你们一个好消息，这次考试我考了第一名！\n本：你真胖！\n丽丽：本，你想说的是“你真棒”吧？要是对女生说“你真胖”，她们会生气的！",
    "traditional": "你真胖\n\n麗麗：告訴你們一個好消息，這次考試我考了第一名！\n本：你真胖！\n麗麗：本，你想說的是“你真棒”吧？要是對女生說“你真胖”，她們會生氣的！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "You’re Really Fat"
    },
    {
      "index": 2,
      "simplified": "丽丽：告诉你们一个好消息，这次考试我考了第一名！",
      "traditional": "麗麗：告訴你們一個好消息，這次考試我考了第一名！",
      "pinyin": "lì lì gào su nǐ men yí ge hǎo xiāo xi zhè cì kǎo shì wǒ kǎo le dì yī míng",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I have some good news to tell you. I scored best in class on this test!"
    },
    {
      "index": 4,
      "simplified": "本：你真胖！",
      "traditional": "本：你真胖！",
      "pinyin": "běn nǐ zhēn pàng",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: You’re really fat!"
    },
    {
      "index": 6,
      "simplified": "丽丽：本，你想说的是“你真棒”吧？",
      "traditional": "麗麗：本，你想說的是“你真棒”吧？",
      "pinyin": "lì lì běn nǐ xiǎng shuō de shì nǐ zhēn bàng ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "要是对女生说“你真胖”，她们会生气的！",
      "traditional": "要是對女生說“你真胖”，她們會生氣的！",
      "pinyin": "yào shi duì nǚ shēng shuō nǐ zhēn pàng tā men huì shēng qì de",
      "english": "Lili: Ben, you wanted to say “you’re really great”, right?"
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "If you say “you’re really fat” to girls, they will get angry!"
    }
  ],
