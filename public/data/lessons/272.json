{
  "id": "272",
  "title": "Driver's License Exam",
  "level": "intermediate",
  "date": "2017-03-22",
  "synopsis": "Li Li is about to take her driver's license. Does Wang Ping want to hitch a ride?",
  "audioUrl": "https://static.duchinese.net/documents/371/9d4d4c55351cc83572a173e55f3d9538ef061d4d.mp3?1489606821",
  "series": null,
  "fullText": {
    "simplified": "考驾照\n\n    李丽对好朋友王平说：“我准备考驾照啦！“\n    王平说：“等驾照考了，车买了，记得把车牌号码告诉我。”\n    李丽笑了，问：“怎么？路上见到我好坐顺风车吗？”\n    王平说：“不是的。我得离你远一点。”",
    "traditional": "考駕照\n\n    李麗對好朋友王平說：“我準備考駕照啦！“\n    王平說：“等駕照考了，車買了，記得把車牌號碼告訴我。”\n    李麗笑了，問：“怎麼？路上見到我好坐順風車嗎？”\n    王平說：“不是的。我得離你遠一點。”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Driver's License Exam"
    },
    {
      "index": 2,
      "simplified": "李丽对好朋友王平说：“我准备考驾照啦！“",
      "traditional": "李麗對好朋友王平說：“我準備考駕照啦！“",
      "pinyin": "lǐ lì duì hǎo péng you wáng píng shuō wǒ zhǔn bèi kǎo jià zhào la",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Li Li said to her good friend Wang Ping: “I have my driver's license exam soon!”"
    },
    {
      "index": 4,
      "simplified": "王平说：“等驾照考了，车买了，记得把车牌号码告诉我。”",
      "traditional": "王平說：“等駕照考了，車買了，記得把車牌號碼告訴我。”",
      "pinyin": "wáng píng shuō děng jià zhào kǎo le chē mǎi le jì de bǎ chē pái hào mǎ gào su wǒ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Wang Ping said: “When you've done the exam and bought a car, remember to tell me the license plate number.”"
    },
    {
      "index": 6,
      "simplified": "李丽笑了，问：“怎么？路上见到我好坐顺风车吗？”",
      "traditional": "李麗笑了，問：“怎麼？路上見到我好坐順風車嗎？”",
      "pinyin": "lǐ lì xiào le wèn zěn me lù shang jiàn dào wǒ hǎo zuò shùn fēng chē ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Li Li laughed and asked: “Why? Do you want to hitch a ride if you see me on the road?”"
    },
    {
      "index": 8,
      "simplified": "王平说：“不是的。我得离你远一点。”",
      "traditional": "王平說：“不是的。我得離你遠一點。”",
      "pinyin": "wáng píng shuō bú shì de wǒ děi lí nǐ yuǎn yì diǎn",
      "english": ""
    }
  ],
