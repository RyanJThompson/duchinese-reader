  "title": "Where Should We Meet",
  "level": "newbie",
  "date": "2018-12-20",
  "synopsis": "Ben and Lili make plans to watch football together.",
  "audioUrl": "https://static.duchinese.net/documents/884/9b50cd4d56621a09aa7c482dbb9cdf7f81f8e979.mp3?1634201868",
