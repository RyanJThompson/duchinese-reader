{
  "id": "1063",
  "title": "Sourness",
  "level": "newbie",
  "date": "2022-10-31",
  "synopsis": "Sourness can be literal or metaphorical.",
  "audioUrl": "https://static.duchinese.net/documents/1063/69994f547657b9c19d32c8ca26aab5a59e1e9d8c.mp3?1611931050",
  "series": null,
  "fullText": {
    "simplified": "酸酸的\n\n保罗：小乐，有没有一个人，你一想起他来，心里就会酸酸的？\n小乐：有，学校对面那个卖酸菜鱼的老板。",
    "traditional": "酸酸的\n\n保羅：小樂，有沒有一個人，你一想起他來，心裡就會酸酸的？\n小樂：有，學校對面那個賣酸菜魚的老闆。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Sourness"
    },
    {
      "index": 2,
      "simplified": "保罗：小乐，有没有一个人，你一想起他来，心里就会酸酸的？",
      "traditional": "保羅：小樂，有沒有一個人，你一想起他來，心裡就會酸酸的？",
      "pinyin": "bǎo luó xiǎo lè yǒu méi yǒu yí ge rén nǐ yì xiǎng qǐ tā lái xīn lǐ jiù huì suān suān de",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, is there anyone that makes you feel distressed as soon as you think of them?"
    },
    {
      "index": 4,
      "simplified": "小乐：有，学校对面那个卖酸菜鱼的老板。",
      "traditional": "小樂：有，學校對面那個賣酸菜魚的老闆。",
      "pinyin": "xiǎo lè yǒu xué xiào duì miàn nèi ge mài suān cài yú de lǎo bǎn",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: Yes, the shop owner who sells pickled fish across the road from school."
    }
  ],
