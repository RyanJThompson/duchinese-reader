    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "The girl smiled happily and asked: “So, between Bingbing Fan, Mi Yang, and I, who is the most beautiful?”"
    },
