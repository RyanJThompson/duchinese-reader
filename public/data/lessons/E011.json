    "sentence_translations": [
      "Giving Directions to the Driver",
      "",
      "Wang Ke: Driver, I want to go to Wudong Road.",
      "",
      "Taxi driver: Wudong Road is near to which road?",
      "",
      "Wang Ke: Wudong Road is near to Guoding Road.",
      "",
      "Taxi driver: I'm sorry, I am not familiar with that area. Can you show me the way when we are nearby?",
      "",
      "Wang Ke: Okay, no problem, I know the area. I'll give you directions.",
      "",
      "(ten minutes later)",
      "",
      "Wang Ke: Now turn left ...... and then turn right ……keep going ...... stop here.",
      "",
      "Taxi driver: You are a foreigner, but you are more familiar (with this area) than I am.",
      "",
      "Wang Ke: Of course, I have to come here to study every day, Alas!"
    ]
