{
  "id": "734",
  "title": "The Signal is Bad Here",
  "level": "elementary",
  "date": "2019-07-27",
  "synopsis": "Little Le is trying to call Paul.",
  "audioUrl": "https://static.duchinese.net/documents/1105/5a9f753d0e8d1b0c0296bc2337851f8f9d85c6a9.mp3?1563817689",
  "series": null,
  "fullText": {
    "simplified": "这里信号不好\n\n小乐：喂，保罗！是我，小乐！\n保罗：小乐，怎么了？\n小乐：我刚……，你……来……\n保罗：你说什么？我听不清。\n小乐：我说，刚才……你……\n保罗：小乐，我在电梯里，这里信号不好。我等会儿打回去给你。\n小乐：好的。",
    "traditional": "這裡信號不好\n\n小樂：喂，保羅！是我，小樂！\n保羅：小樂，怎麼了？\n小樂：我剛……，你……來……\n保羅：你說什麼？我聽不清。\n小樂：我說，剛才……你……\n保羅：小樂，我在電梯裡，這裡信號不好。我等會兒打回去給你。\n小樂：好的。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "The Signal is Bad Here"
    },
    {
      "index": 2,
      "simplified": "小乐：喂，保罗！是我，小乐！",
      "traditional": "小樂：喂，保羅！是我，小樂！",
      "pinyin": "xiǎo lè wéi bǎo luó shì wǒ xiǎo lè",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Hey, Paul! It’s me, Little Le!"
    },
    {
      "index": 4,
      "simplified": "保罗：小乐，怎么了？",
      "traditional": "保羅：小樂，怎麼了？",
      "pinyin": "bǎo luó xiǎo lè zěn me le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, what’s up?"
    },
    {
      "index": 6,
      "simplified": "小乐：我刚……，你……来……",
      "traditional": "小樂：我剛……，你……來……",
      "pinyin": "xiǎo lè wǒ gāng nǐ lái",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: I just… you… come…"
    },
    {
      "index": 8,
      "simplified": "保罗：你说什么？我听不清。",
      "traditional": "保羅：你說什麼？我聽不清。",
      "pinyin": "bǎo luó nǐ shuō shén me wǒ tīng bù qīng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: What did you say? I can’t hear you clearly."
    },
    {
      "index": 10,
      "simplified": "小乐：我说，刚才……你……",
      "traditional": "小樂：我說，剛才……你……",
      "pinyin": "xiǎo lè wǒ shuō gāng cái nǐ",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: I said, just now… you…"
    },
    {
      "index": 12,
      "simplified": "保罗：小乐，我在电梯里，这里信号不好。我等会儿打回去给你。",
      "traditional": "保羅：小樂，我在電梯裡，這裡信號不好。我等會兒打回去給你。",
      "pinyin": "bǎo luó xiǎo lè wǒ zài diàn tī lǐ zhè lǐ xìn hào bù hǎo wǒ děng huì'r dǎ huí qù gěi nǐ",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, I’m in an elevator, the signal is bad here. I’ll call you back in a moment."
    },
    {
      "index": 14,
      "simplified": "小乐：好的。",
      "traditional": "小樂：好的。",
