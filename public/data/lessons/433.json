{
  "id": "433",
  "title": "Exchanging Renminbi",
  "level": "intermediate",
  "date": "2018-01-14",
  "synopsis": "Lili exchanges US dollars for Renminbi at the bank.",
  "audioUrl": "https://static.duchinese.net/documents/624/72fe0b2c7a88d4611f1fa03d77648f4b2572d964.mp3?1575020789",
  "series": null,
  "fullText": {
    "simplified": "换人民币\n\n丽丽：您好！我可以在这里兑换钱吗？\n银行服务员：当然可以。\n丽丽：我想把美元换成人民币。现在的汇率是多少？\n银行服务员：汇率是6.62。\n丽丽：好的。那我换500美元。这是我的护照。\n银行服务员：好的。这是您的人民币，请拿好。\n丽丽：谢谢！\n银行服务员：不客气。",
    "traditional": "換人民幣\n\n麗麗：您好！我可以在這裡兌換錢嗎？\n銀行服務員：當然可以。\n麗麗：我想把美元換成人民幣。現在的匯率是多少？\n銀行服務員：匯率是6.62。\n麗麗：好的。那我換500美元。這是我的護照。\n銀行服務員：好的。這是您的人民幣，請拿好。\n麗麗：謝謝！\n銀行服務員：不客氣。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Exchanging Renminbi"
    },
    {
      "index": 2,
      "simplified": "丽丽：您好！我可以在这里兑换钱吗？",
      "traditional": "麗麗：您好！我可以在這裡兌換錢嗎？",
      "pinyin": "lì lì nín hǎo wǒ kě yǐ zài zhè lǐ duì huàn qián ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Hello! Can I exchange money here?"
    },
    {
      "index": 4,
      "simplified": "银行服务员：当然可以。",
      "traditional": "銀行服務員：當然可以。",
      "pinyin": "yín háng fú wù yuán dāng rán kě yǐ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Bank teller: Yes, of course."
    },
    {
      "index": 6,
      "simplified": "丽丽：我想把美元换成人民币。现在的汇率是多少？",
      "traditional": "麗麗：我想把美元換成人民幣。現在的匯率是多少？",
      "pinyin": "lì lì wǒ xiǎng bǎ měi yuán huàn chéng rén mín bì xiàn zài de huì lǜ shì duō shao",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I want to exchange US dollars for Renminbi. What's the exchange rate now?"
    },
    {
      "index": 8,
      "simplified": "银行服务员：汇率是6.62。",
      "traditional": "銀行服務員：匯率是6.62。",
      "pinyin": "yín háng fú wù yuán huì lǜ shì 4",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Bank teller: The exchange rate is 6.62."
    },
    {
      "index": 10,
      "simplified": "丽丽：好的。那我换500美元。这是我的护照。",
      "traditional": "麗麗：好的。那我換500美元。這是我的護照。",
      "pinyin": "lì lì hǎo de nà wǒ huàn 2 měi yuán zhè shì wǒ de hù zhào",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Ok. Then I'll exchange 500 US dollars. Here's my passport."
    },
    {
      "index": 12,
      "simplified": "银行服务员：好的。这是您的人民币，请拿好。",
      "traditional": "銀行服務員：好的。這是您的人民幣，請拿好。",
      "pinyin": "yín háng fú wù yuán hǎo de zhè shì nín de rén mín bì qǐng ná hǎo",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Bank teller: Sure. Here's your Renminbi, please take it."
    },
    {
      "index": 14,
      "simplified": "丽丽：谢谢！",
      "traditional": "麗麗：謝謝！",
      "pinyin": "lì lì xiè xie",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Thank you!"
    },
    {
      "index": 16,
      "simplified": "银行服务员：不客气。",
      "traditional": "銀行服務員：不客氣。",
      "pinyin": "yín háng fú wù yuán bú kè qi",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Bank teller: You're welcome."
    }
  ],
