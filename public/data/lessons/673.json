{
  "id": "673",
  "title": "At The Right Time",
  "level": "elementary",
  "date": "2019-04-13",
  "synopsis": "Little He is trying to get in touch with Lili.",
  "audioUrl": "https://static.duchinese.net/documents/1014/cf23ba4e66aafedd621a03ad15312c46a319a5b2.mp3?1635865032",
  "series": {
    "title": "Ben’s life in China 6: Maybe I Like Him",
    "chapter": 2,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你来得正好\n\n小雨：学长好！\n小何：小雨，你来得正好。丽丽在楼上吗？\n小雨：不在。\n小何：你知道她去哪儿了吗？\n小雨：不知道。你打电话问问她吧。\n小何：她生气了，不接我的电话。",
    "traditional": "你來得正好\n\n小雨：學長好！\n小何：小雨，你來得正好。麗麗在樓上嗎？\n小雨：不在。\n小何：你知道她去哪兒了嗎？\n小雨：不知道。你打電話問問她吧。\n小何：她生氣了，不接我的電話。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "You Came At The Right Time"
    },
    {
      "index": 2,
      "simplified": "小雨：学长好！",
      "traditional": "小雨：學長好！",
      "pinyin": "xiǎo yǔ xué zhǎng hǎo",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Hello, senior!"
    },
    {
      "index": 4,
      "simplified": "小何：小雨，你来得正好。丽丽在楼上吗？",
      "traditional": "小何：小雨，你來得正好。麗麗在樓上嗎？",
      "pinyin": "xiǎo hé xiǎo yǔ nǐ lái de zhèng hǎo lì lì zài lóu shàng ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Little Yu, you came at the right time. Is Lili upstairs?"
    },
    {
      "index": 6,
      "simplified": "小雨：不在。",
      "traditional": "小雨：不在。",
      "pinyin": "xiǎo yǔ bú zài",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: She’s not."
    },
    {
      "index": 8,
      "simplified": "小何：你知道她去哪儿了吗？",
      "traditional": "小何：你知道她去哪兒了嗎？",
      "pinyin": "xiǎo hé nǐ zhī dào tā qù nǎ'r le ma",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Do you know where she went?"
    },
    {
      "index": 10,
      "simplified": "小雨：不知道。你打电话问问她吧。",
      "traditional": "小雨：不知道。你打電話問問她吧。",
      "pinyin": "xiǎo yǔ bù zhī dào nǐ dǎ diàn huà wèn wen tā ba",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: I don’t know. Why don’t you give her a call?"
    },
    {
      "index": 12,
      "simplified": "小何：她生气了，不接我的电话。",
      "traditional": "小何：她生氣了，不接我的電話。",
      "pinyin": "xiǎo hé tā shēng qì le bù jiē wǒ de diàn huà",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: She’s angry and won’t answer my calls."
    }
  ],
