      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Waiter: Ok. This is the menu, please take a look."
    },
    {
      "index": 8,
      "simplified": "王可： 谢谢。你们有什么特色菜？",
      "traditional": "王可： 謝謝。你們有什麼特色菜？",
      "pinyin": "wáng kě xiè xie nǐ men yǒu shén me tè sè cài",
