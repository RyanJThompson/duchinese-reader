{
  "id": "E143",
  "title": "Where are You Going Tomorrow?",
  "level": "elementary",
  "date": "2017-08-23",
  "synopsis": "Annie is going to have a violin class tomorrow.",
  "audioUrl": "https://static.duchinese.net/documents/505/7083cf451107e1e7da662f4a9607052b06c0b46d.mp3?1503339883",
  "series": null,
  "fullText": {
    "simplified": "明天你要去哪儿？\n\n李力: 明天你要去哪儿？\n安妮: 明天我要去上小提琴课。\n李力: 你会拉小提琴？\n安妮: 是的，我会一点儿。\n李力: 明天我可以和你一起去上小提琴课吗？我也很感兴趣！\n安妮: 好啊，一起去更好！",
    "traditional": "明天你要去哪兒？\n\n李力: 明天你要去哪兒？\n安妮: 明天我要去上小提琴課。\n李力: 你會拉小提琴？\n安妮: 是的，我會一點兒。\n李力: 明天我可以和你一起去上小提琴課嗎？我也很感興趣！\n安妮: 好啊，一起去更好！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Where are you going tomorrow?"
    },
    {
      "index": 2,
      "simplified": "李力: 明天你要去哪儿？",
      "traditional": "李力: 明天你要去哪兒？",
      "pinyin": "lǐ lì míng tiān nǐ yào qù nǎ'r",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Li Li: Where are you going tomorrow?"
    },
    {
      "index": 4,
      "simplified": "安妮: 明天我要去上小提琴课。",
      "traditional": "安妮: 明天我要去上小提琴課。",
      "pinyin": "ān nī míng tiān wǒ yào qù shàng xiǎo tí qín kè",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: I am going to have a violin class."
    },
    {
      "index": 6,
      "simplified": "李力: 你会拉小提琴？",
      "traditional": "李力: 你會拉小提琴？",
      "pinyin": "lǐ lì nǐ huì lā xiǎo tí qín",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Li Li: Can you play the violin?"
    },
    {
      "index": 8,
      "simplified": "安妮: 是的，我会一点儿。",
      "traditional": "安妮: 是的，我會一點兒。",
      "pinyin": "ān nī shì de wǒ huì yì diǎn'r",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Yes, a little bit."
    },
    {
      "index": 10,
      "simplified": "李力: 明天我可以和你一起去上小提琴课吗？我也很感兴趣！",
      "traditional": "李力: 明天我可以和你一起去上小提琴課嗎？我也很感興趣！",
      "pinyin": "lǐ lì míng tiān wǒ kě yǐ hé nǐ yì qǐ qù shàng xiǎo tí qín kè ma wǒ yě hěn gǎn xìng qù",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Li Li: May I join you for the violin class tomorrow? I am very interested in it."
    },
    {
      "index": 12,
      "simplified": "安妮: 好啊，一起去更好！",
      "traditional": "安妮: 好啊，一起去更好！",
      "pinyin": "ān nī hǎo a yì qǐ qù gèng hǎo",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Annie: Sure, going together is even better!"
    }
  ],
