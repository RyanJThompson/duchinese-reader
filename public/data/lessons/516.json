{
  "id": "516",
  "title": "Her Wish Came True",
  "level": "elementary",
  "date": "2018-06-16",
  "synopsis": "Meeting an old friend for the first time in a long while.",
  "audioUrl": "https://static.duchinese.net/documents/753/4de2d44fd58acbf80bfb4b69b22393ef94300796.mp3?1527744183",
  "series": null,
  "fullText": {
    "simplified": "她的愿望实现了\n\n    去年，我和很久不见的小学同学小新见了一面，小新胖了很多。她看到我还是那么瘦，就对我说：“如果我能和你一样重就好了！”\n    今年，她的愿望实现了。因为我胖了二十多斤。",
    "traditional": "她的願望實現了\n\n    去年，我和很久不見的小學同學小新見了一面，小新胖了很多。她看到我還是那麼瘦，就對我說：“如果我能和你一樣重就好了！”\n    今年，她的願望實現了。因為我胖了二十多斤。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Her Wish Came True"
    },
    {
      "index": 2,
      "simplified": "去年，我和很久不见的小学同学小新见了一面，",
      "traditional": "去年，我和很久不見的小學同學小新見了一面，",
      "pinyin": "qù nián wǒ hé hěn jiǔ bú jiàn de xiǎo xué tóng xué xiǎo xīn jiàn le yí miàn",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "小新胖了很多。",
      "traditional": "小新胖了很多。",
      "pinyin": "xiǎo xīn pàng le hěn duō",
      "english": "Last year, I met my elementary school classmate Little Xin who I hadn’t seen in a long time."
    },
    {
      "index": 4,
      "simplified": "她看到我还是那么瘦，就对我说：“如果我能和你一样重就好了！”",
      "traditional": "她看到我還是那麼瘦，就對我說：“如果我能和你一樣重就好了！”",
      "pinyin": "tā kàn dào wǒ hái shì nà me shòu jiù duì wǒ shuō rú guǒ wǒ néng hé nǐ yí yàng zhòng jiù hǎo le",
      "english": "Little Xin had gained a lot of weight."
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "She saw that I was still thin and said to me: “If only I could be the same weight as you!”"
    },
    {
      "index": 6,
      "simplified": "今年，她的愿望实现了。",
      "traditional": "今年，她的願望實現了。",
      "pinyin": "jīn nián tā de yuàn wàng shí xiàn le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "因为我胖了二十多斤。",
      "traditional": "因為我胖了二十多斤。",
      "pinyin": "yīn wèi wǒ pàng le èr shí duō jīn",
      "english": "This year her wish came true."
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Because I gained over 10 kilos."
    }
  ],
