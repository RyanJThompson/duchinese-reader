{
  "id": "923",
  "title": "Is Chinese Difficult?",
  "level": "newbie",
  "date": "2020-07-29",
  "synopsis": "What part of learning Chinese is most difficult?",
  "audioUrl": "https://static.duchinese.net/documents/923/16ecd358365336f893e2fba1ee22ccc92d3da658.mp3?1589701093",
  "series": null,
  "fullText": {
    "simplified": "汉语难吗？\n\n老师：同学们好！\n学生：老师好！\n老师：今天是第一节汉语课，我们一起来学习汉语拼音。\n学生：老师，汉语难吗？\n老师：开始的时候有点儿难，后面容易。\n学生：后面不难，那我学后面的吧。",
    "traditional": "漢語難嗎？\n\n老師：同學們好！\n學生：老師好！\n老師：今天是第一節漢語課，我們一起來學習漢語拼音。\n學生：老師，漢語難嗎？\n老師：開始的時候有點兒難，後面容易。\n學生：後面不難，那我學後面的吧。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Is Chinese Difficult?"
    },
    {
      "index": 2,
      "simplified": "老师：同学们好！",
      "traditional": "老師：同學們好！",
      "pinyin": "lǎo shī tóng xué men hǎo",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Teacher: Hello, students!"
    },
    {
      "index": 4,
      "simplified": "学生：老师好！",
      "traditional": "學生：老師好！",
      "pinyin": "xué sheng lǎo shī hǎo",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Student: Hello, teacher!"
    },
    {
      "index": 6,
      "simplified": "老师：今天是第一节汉语课，我们一起来学习汉语拼音。",
      "traditional": "老師：今天是第一節漢語課，我們一起來學習漢語拼音。",
      "pinyin": "lǎo shī jīn tiān shì dì yī jié hàn yǔ kè wǒ men yì qǐ lái xué xí hàn yǔ pīn yīn",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Teacher: Today is our first Chinese class, let’s learn pinyin together."
    },
    {
      "index": 8,
      "simplified": "学生：老师，汉语难吗？",
      "traditional": "學生：老師，漢語難嗎？",
      "pinyin": "xué sheng lǎo shī hàn yǔ nán ma",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Student: Teacher, is Chinese difficult?"
    },
    {
      "index": 10,
      "simplified": "老师：开始的时候有点儿难，后面容易。",
      "traditional": "老師：開始的時候有點兒難，後面容易。",
      "pinyin": "lǎo shī kāi shǐ de shí hou yǒu diǎn'r nán hòu miàn róng yì",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Teacher: In the beginning it’s a little difficult; later on it’s easy."
    },
    {
      "index": 12,
      "simplified": "学生：后面不难，那我学后面的吧。",
      "traditional": "學生：後面不難，那我學後面的吧。",
      "pinyin": "xué sheng hòu miàn bù nán nà wǒ xué hòu miàn de ba",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Student: It’s not difficult later on  … then I guess I’ll learn the later on part."
    }
  ],
