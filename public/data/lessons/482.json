{
  "id": "482",
  "title": "What Colors Do You Like?",
  "level": "newbie",
  "date": "2018-05-10",
  "synopsis": "Ben and Lili discuss what colors they like.",
  "audioUrl": "https://static.duchinese.net/documents/720/9d590401d7f34b5d1d95fe1d648c93a3ed245f7e.mp3?1553269308",
  "series": {
    "title": "Ben’s life in China 1: Meeting Lili",
    "chapter": 25,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你喜欢什么颜色？\n\n丽丽：本，你喜欢什么颜色？\n本：我喜欢绿色，你呢？\n丽丽：我喜欢红色和蓝色。\n本：那你不喜欢什么颜色？\n丽丽：我不喜欢黄色和紫色，你呢？\n本：我也不喜欢黄色。",
    "traditional": "你喜歡什麼顏色？\n\n麗麗：本，你喜歡什麼顏色？\n本：我喜歡綠色，你呢？\n麗麗：我喜歡紅色和藍色。\n本：那你不喜歡什麼顏色？\n麗麗：我不喜歡黃色和紫色，你呢？\n本：我也不喜歡黃色。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "What Colors Do You Like?"
    },
    {
      "index": 2,
      "simplified": "丽丽：本，你喜欢什么颜色？",
      "traditional": "麗麗：本，你喜歡什麼顏色？",
      "pinyin": "lì lì běn nǐ xǐ huan shén me yán sè",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Ben, what colors do you like?"
    },
    {
      "index": 4,
      "simplified": "本：我喜欢绿色，你呢？",
      "traditional": "本：我喜歡綠色，你呢？",
      "pinyin": "běn wǒ xǐ huan lǜ sè nǐ ne",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I like green. What about you?"
    },
    {
      "index": 6,
      "simplified": "丽丽：我喜欢红色和蓝色。",
      "traditional": "麗麗：我喜歡紅色和藍色。",
      "pinyin": "lì lì wǒ xǐ huan hóng sè hé lán sè",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I like red and blue."
    },
    {
      "index": 8,
      "simplified": "本：那你不喜欢什么颜色？",
      "traditional": "本：那你不喜歡什麼顏色？",
      "pinyin": "běn nà nǐ bù xǐ huan shén me yán sè",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: So what colors do you not like?"
    },
    {
      "index": 10,
      "simplified": "丽丽：我不喜欢黄色和紫色，你呢？",
      "traditional": "麗麗：我不喜歡黃色和紫色，你呢？",
      "pinyin": "lì lì wǒ bù xǐ huan huáng sè hé zǐ sè nǐ ne",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I don't like yellow and purple. How about you?"
    },
    {
      "index": 12,
      "simplified": "本：我也不喜欢黄色。",
      "traditional": "本：我也不喜歡黃色。",
      "pinyin": "běn wǒ yě bù xǐ huan huáng sè",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: I don't like yellow either."
    }
  ],
