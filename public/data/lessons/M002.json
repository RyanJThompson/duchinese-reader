{
  "id": "M002",
  "title": "Ben Buys Breakfast",
  "level": "intermediate",
  "date": "2022-01-06",
  "synopsis": "Ben decides what to have for breakfast.",
  "audioUrl": "https://static.duchinese.net/documents/90002/59769dba9d3b89d58772f0ea53ecce5ba379ec36.mp3?1637914694",
