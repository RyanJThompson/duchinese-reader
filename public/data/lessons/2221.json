    },
    {
      "index": 2,
      "simplified": "在日本有一个车站，车站前有一个狗的雕像。",
      "traditional": "在日本有一個車站，車站前有一個狗的雕像。",
      "pinyin": "zài rì běn yǒu yí ge chē zhàn chē zhàn qián yǒu yí ge gǒu de diāo xiàng",
      "english": "In Japan, there is a train station in front of which there is a dog statue."
    },
    {
      "index": 3,
      "simplified": "这个雕像是为了让人们记住一只叫“八公”的狗。",
      "traditional": "這個雕像是為了讓人們記住一隻叫“八公”的狗。",
      "pinyin": "zhè ge diāo xiàng shì wèi le ràng rén men jì zhu yì zhī jiào bā gōng de gǒu",
      "english": "This statue is to remind people of a dog named “Hachiko”."
    },
    {
      "index": 4,
      "simplified": "八公在1923年出生，",
      "traditional": "八公在1923年出生，",
      "pinyin": "bā gōng zài 4 nián chū shēng",
      "english": "Hachiko was born in 1923."
    },
    {
      "index": 5,
      "simplified": "它每天都看着主人去工作，晚上再去车站接主人回家。",
      "traditional": "牠每天都看著主人去工作，晚上再去車站接主人回家。",
      "pinyin": "tā měi tiān dōu kàn zhe zhǔ rén qù gōng zuò wǎn shang zài qù chē zhàn jiē zhǔ rén huí jiā",
      "english": "Every day, he would watch his owner go to work, and in the evening, he would go to the station to meet his owner and return home together."
    },
    {
      "index": 6,
      "simplified": "主人后来生病死了，八公还是每天去车站等主人。",
      "traditional": "主人後來生病死了，八公還是每天去車站等主人。",
      "pinyin": "zhǔ rén hòu lái shēng bìng sǐ le bā gōng hái shi měi tiān qù chē zhàn děng zhǔ rén",
      "english": "The owner later fell ill and died, but Hachiko still went to the station every day to wait for him."
    },
    {
      "index": 7,
      "simplified": "八公等了九年。1935年，它也死了。",
      "traditional": "八公等了九年。1935年，牠也死了。",
      "pinyin": "bā gōng děng le jiǔ nián 4 nián tā yě sǐ le",
      "english": "Hachiko waited for nine years. In 1935, he also died."
    },
    {
      "index": 8,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "八公的故事让很多人感动。",
      "traditional": "八公的故事讓很多人感動。",
      "pinyin": "bā gōng de gù shi ràng hěn duō rén gǎn dòng",
      "english": "Hachiko’s story has touched many people."
    },
    {
      "index": 10,
      "simplified": "现在，车站前的八公雕像是日本一个很有名的地方。",
      "traditional": "現在，車站前的八公雕像是日本一個很有名的地方。",
      "pinyin": "xiàn zài chē zhàn qián de bā gōng diāo xiàng shì rì běn yí ge hěn yǒu míng de dì fang",
      "english": "Now, the Hachiko Statue in front of the station is a very famous place in Japan."
    },
    {
      "index": 11,
      "simplified": "人们还把八公的故事做成了电影。",
      "traditional": "人們還把八公的故事做成了電影。",
      "pinyin": "rén men hái bǎ bā gōng de gù shi zuò chéng le diàn yǐng",
      "english": "People have also made a movie out of Hachiko’s story."
    },
    {
      "index": 12,
      "simplified": "我们的故事《半斤和八两》也是从八公的故事中来的。",
      "traditional": "我們的故事《半斤和八兩》也是從八公的故事中來的。",
      "pinyin": "wǒ men de gù shi bàn jīn hé bā liǎng yě shì cóng bā gōng de gù shi zhōng lái de",
      "english": "Our story “Forever Faithful: A Dog’s Story” is also derived from Hachiko’s story."
    }
  ],
