{
  "id": "535",
  "title": "Where is my Seat?",
  "level": "intermediate",
  "date": "2018-06-24",
  "synopsis": "Little Wang finds that someone has taken his seat on the train.",
  "audioUrl": "https://static.duchinese.net/documents/765/530ce108be8e686d09fab3a89f6a7eea4d3f0d62.mp3?1529323568",
  "series": null,
  "fullText": {
    "simplified": "我的票在哪个位置？\n\n     小王坐火车出差。他上火车后发现有人坐在他的座位上。他走过去故意拿票对坐在座位上的人说：“你好。我不认识字，麻烦你帮我看看我的票在哪个位置？”那个人看了一眼小王的票，说：“你的是站票，站哪都行。”",
    "traditional": "我的票在哪個位置？\n\n     小王坐火車出差。他上火車後發現有人坐在他的座位上。他走過去故意拿票對坐在座位上的人說：“你好。我不認識字，麻煩你幫我看看我的票在哪個位置？”那個人看了一眼小王的票，說：“你的是站票，站哪都行。”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n     ",
      "traditional": "\n\n     ",
      "pinyin": "",
      "english": "Where is the seat for my ticket?"
    },
    {
      "index": 2,
      "simplified": "小王坐火车出差。",
      "traditional": "小王坐火車出差。",
      "pinyin": "xiǎo wáng zuò huǒ chē chū chāi",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "他上火车后发现有人坐在他的座位上。",
      "traditional": "他上火車後發現有人坐在他的座位上。",
      "pinyin": "tā shàng huǒ chē hòu fā xiàn yǒu rén zuò zài tā de zuò wèi shang",
      "english": "Little Wang took the train for a business trip."
    },
    {
      "index": 4,
      "simplified": "他走过去故意拿票对坐在座位上的人说：",
      "traditional": "他走過去故意拿票對坐在座位上的人說：",
      "pinyin": "tā zǒu guò qù gù yì ná piào duì zuò zài zuò wèi shang de rén shuō",
      "english": "After boarding the train, he noticed someone was sitting in his seat."
    },
    {
      "index": 5,
      "simplified": "“你好。我不认识字，麻烦你帮我看看我的票在哪个位置？”",
      "traditional": "“你好。我不認識字，麻煩你幫我看看我的票在哪個位置？”",
      "pinyin": "nǐ hǎo wǒ bú rèn shi zì má fan nǐ bāng wǒ kàn kan wǒ de piào zài nǎ ge wèi zhi",
      "english": "He walked over, deliberately held out the ticket to the person sitting in the seat, and said:"
    },
    {
      "index": 6,
      "simplified": "那个人看了一眼小王的票，说：“你的是站票，站哪都行。”",
      "traditional": "那個人看了一眼小王的票，說：“你的是站票，站哪都行。”",
      "pinyin": "nà ge rén kàn le yì yǎn xiǎo wáng de piào shuō nǐ de shì zhàn piào zhàn nǎ dōu xíng",
      "english": "“Hello. I can’t read. Could you help me look where the seat for my ticket is?”"
    }
  ],
