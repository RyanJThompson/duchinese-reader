{
  "id": "612",
  "title": "The Exam Starts Now",
  "level": "elementary",
  "date": "2018-11-03",
  "synopsis": "During the exam, there are rules about what things you may have on your desk.",
  "audioUrl": "https://static.duchinese.net/documents/880/566958a20ead8b07f8614094d640b0fc68bf8fe2.mp3?1539498291",
  "series": null,
  "fullText": {
    "simplified": "我们现在考试\n\n    同学们，我们现在考试。请大家把手机、书等放在书包里。桌子上只能有笔和橡皮。今天的考试要用到词典，请大家把词典也放在桌子上。",
    "traditional": "我們現在考試\n\n    同學們，我們現在考試。請大家把手機、書等放在書包裡。桌子上只能有筆和橡皮。今天的考試要用到詞典，請大家把詞典也放在桌子上。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "The Exam Starts Now"
    },
    {
      "index": 2,
      "simplified": "同学们，我们现在考试。",
      "traditional": "同學們，我們現在考試。",
      "pinyin": "tóng xué men wǒ men xiàn zài kǎo shì",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "请大家把手机、书等放在书包里。",
      "traditional": "請大家把手機、書等放在書包裡。",
      "pinyin": "qǐng dà jiā bǎ shǒu jī shū děng fàng zài shū bāo lǐ",
      "english": "Students, the exam starts now."
    },
    {
      "index": 4,
      "simplified": "桌子上只能有笔和橡皮。",
      "traditional": "桌子上只能有筆和橡皮。",
      "pinyin": "zhuō zi shang zhǐ néng yǒu bǐ hé xiàng pí",
      "english": "Everyone, please take your mobile phones, books, etc. and place them inside your schoolbags."
    },
    {
      "index": 5,
      "simplified": "今天的考试要用到词典，请大家把词典也放在桌子上。",
      "traditional": "今天的考試要用到詞典，請大家把詞典也放在桌子上。",
      "pinyin": "jīn tiān de kǎo shì yào yòng dào cí diǎn qǐng dà jiā bǎ cí diǎn yě fàng zài zhuō zi shang",
      "english": "You may only have pen and eraser on your table."
    },
    {
      "index": 6,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "You will need to use a dictionary for today’s exam, so everyone, please also place your dictionaries on your desks."
    }
  ],
