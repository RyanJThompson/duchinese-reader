    "sentence_translations": [
      "50 Years or 98 Years Old?",
      "",
      "Little He: Darling, I have a question I want to test on you.",
      "",
      "Lili: Ok, ask me.",
      "",
      "Little He: The elder brother is 4 years old this year, and the younger brother is half the age of the elder brother.",
      "So when the elder brother is 100 years old, how old is the younger brother?",
      "",
      "Lili: The younger brother will be 50 years old!",
      "",
      "Little He: Think about it again!",
      "",
      "Lili: The younger brother is half the age of the elder brother.",
      "So when the elder brother is 100 years old, the younger brother will be 50 years old!",
      "",
      "Little He: You’re wrong! When the elder brother is 100 years old, the younger brother will be 98 years old!",
      "",
      "Lili: Half of 100 is 50!",
      "",
      "Little He: Fine, go and carefully think about it some more.",
      ""
    ]
