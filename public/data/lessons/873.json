  "title": "Quarter of an Hour",
  "level": "newbie",
  "date": "2020-01-16",
  "synopsis": "How do you say 10:15? What about 10:45?",
  "audioUrl": "https://static.duchinese.net/documents/873/dd7294142c14185957fd12ea26bc27c521344708.mp3?1578921447",
