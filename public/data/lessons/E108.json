{
  "id": "E108",
  "title": "Washing Clothes at the Laundry",
  "level": "intermediate",
  "date": "2017-04-22",
  "synopsis": "Having someone wash your clothes is cheap in China. Learn some useful phrase for going to the laundry.",
  "audioUrl": "https://static.duchinese.net/documents/399/23939f612edf496b5331cf8d168a6a239e28625c.mp3?1492417985",
  "series": null,
  "fullText": {
    "simplified": "去洗衣店洗衣服\n\n安妮：你好！我要洗衣服。\n阿姨：好的，把衣服给我吧。\n安妮：阿姨，这两件大衣和那套西服请干洗，别的衣服都可以水洗。\n阿姨：没问题。\n安妮：还有这几件衬衫，洗完以后可以帮我烫一下吗？\n阿姨：当然可以。\n安妮：谢谢。我什么时候可以来取？\n阿姨：一个星期以后。你留个电话号码，洗好以后我们会打电话给你。\n安妮：好的，这是我的电话号码。",
    "traditional": "去洗衣店洗衣服\n\n安妮：你好！我要洗衣服。\n阿姨：好的，把衣服給我吧。\n安妮：阿姨，這兩件大衣和那套西服請乾洗，別的衣服都可以水洗。\n阿姨：沒問題。\n安妮：還有這幾件襯衫，洗完以後可以幫我燙一下嗎？\n阿姨：當然可以。\n安妮：謝謝。我什麼時候可以來取？\n阿姨：一個星期以後。你留個電話號碼，洗好以後我們會打電話給你。\n安妮：好的，這是我的電話號碼。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Washing clothes at the laundry"
    },
    {
      "index": 2,
      "simplified": "安妮：你好！我要洗衣服。",
      "traditional": "安妮：你好！我要洗衣服。",
      "pinyin": "ān nī nǐ hǎo wǒ yào xǐ yī fu",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Hello! I would like to wash some clothes."
    },
    {
      "index": 4,
      "simplified": "阿姨：好的，把衣服给我吧。",
      "traditional": "阿姨：好的，把衣服給我吧。",
      "pinyin": "ā yí hǎo de bǎ yī fu gěi wǒ ba",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Laundry lady: Ok, give me your clothes."
    },
    {
      "index": 6,
      "simplified": "安妮：阿姨，这两件大衣和那套西服请干洗，别的衣服都可以水洗。",
      "traditional": "安妮：阿姨，這兩件大衣和那套西服請乾洗，別的衣服都可以水洗。",
      "pinyin": "ān nī ā yí zhè liǎng jiàn dà yī hé nà tào xī fú qǐng gān xǐ bié de yī fu dōu kě yǐ shuǐ xǐ",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Mrs., please dry clean these two coats and this suit. All the other clothes can be washed with water."
    },
    {
      "index": 8,
      "simplified": "阿姨：没问题。",
      "traditional": "阿姨：沒問題。",
      "pinyin": "ā yí méi wèn tí",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Laundry lady: No problem."
    },
    {
      "index": 10,
      "simplified": "安妮：还有这几件衬衫，洗完以后可以帮我烫一下吗？",
      "traditional": "安妮：還有這幾件襯衫，洗完以後可以幫我燙一下嗎？",
      "pinyin": "ān nī hái yǒu zhè jǐ jiàn chèn shān xǐ wán yǐ hòu kě yǐ bāng wǒ tàng yí xià ma",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: There are several shirts. Could you please iron them after washing?"
    },
    {
      "index": 12,
      "simplified": "阿姨：当然可以。",
      "traditional": "阿姨：當然可以。",
      "pinyin": "ā yí dāng rán kě yǐ",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Laundry lady: Of course."
    },
    {
      "index": 14,
      "simplified": "安妮：谢谢。我什么时候可以来取？",
      "traditional": "安妮：謝謝。我什麼時候可以來取？",
      "pinyin": "ān nī xiè xie wǒ shén me shí hou kě yǐ lái qǔ",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Thanks. When can I come to pick it up?"
    },
    {
      "index": 16,
      "simplified": "阿姨：一个星期以后。你留个电话号码，洗好以后我们会打电话给你。",
      "traditional": "阿姨：一個星期以後。你留個電話號碼，洗好以後我們會打電話給你。",
      "pinyin": "ā yí yí ge xīng qī yǐ hòu nǐ liú ge diàn huà hào mǎ xǐ hǎo yǐ hòu wǒ men huì dǎ diàn huà gěi nǐ",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Laundry lady: In one week. Leave your phone number and we’ll call you when it’s done."
    },
