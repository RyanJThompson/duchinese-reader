{
  "id": "E307",
  "title": "How Is My Chinese?",
  "level": "elementary",
  "date": "2019-03-23",
  "synopsis": "Ben asks about his Chinese level from different aspects.",
  "audioUrl": "https://static.duchinese.net/documents/999/62d3879ce6884fb531bad97aca8ba3bb2ff7329e.mp3?1552124905",
  "series": null,
  "fullText": {
    "simplified": "我的汉语怎么样\n\n本：你觉得我的汉语口语怎么样？\n小雨：你说得挺好的。\n本：我的发音呢？\n小雨：你发音发得很准。\n本：我的汉字写得不好，写汉字太难了。\n小雨：没关系，你多练习，一定能写得更好。",
    "traditional": "我的漢語怎麼樣\n\n本：你覺得我的漢語口語怎麼樣？\n小雨：你說得挺好的。\n本：我的發音呢？\n小雨：你發音發得很準。\n本：我的漢字寫得不好，寫漢字太難了。\n小雨：沒關係，你多練習，一定能寫得更好。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "How is my Chinese?"
    },
    {
      "index": 2,
      "simplified": "本：你觉得我的汉语口语怎么样？",
      "traditional": "本：你覺得我的漢語口語怎麼樣？",
      "pinyin": "běn nǐ jué de wǒ de hàn yǔ kǒu yǔ zěn me yàng",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: What do you think of my spoken Chinese?"
    },
    {
      "index": 4,
      "simplified": "小雨：你说得挺好的。",
      "traditional": "小雨：你說得挺好的。",
      "pinyin": "xiǎo yǔ nǐ shuō de tǐng hǎo de",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: You speak quite well."
    },
    {
      "index": 6,
      "simplified": "本：我的发音呢？",
      "traditional": "本：我的發音呢？",
      "pinyin": "běn wǒ de fā yīn ne",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: How about my pronunciation?"
    },
    {
      "index": 8,
      "simplified": "小雨：你发音发得很准。",
      "traditional": "小雨：你發音發得很準。",
      "pinyin": "xiǎo yǔ nǐ fā yīn fā de hěn zhǔn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Your pronunciation is very accurate."
    },
    {
      "index": 10,
      "simplified": "本：我的汉字写得不好，写汉字太难了。",
      "traditional": "本：我的漢字寫得不好，寫漢字太難了。",
      "pinyin": "běn wǒ de hàn zì xiě de bù hǎo xiě hàn zì tài nán le",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I’m not good at writing Chinese characters. Characters are too difficult to write."
    },
    {
      "index": 12,
      "simplified": "小雨：没关系，你多练习，一定能写得更好。",
      "traditional": "小雨：沒關係，你多練習，一定能寫得更好。",
      "pinyin": "xiǎo yǔ méi guān xi nǐ duō liàn xí yí dìng néng xiě de gèng hǎo",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu: It’s ok. If you practice more, you will certainly write better."
    }
  ],
