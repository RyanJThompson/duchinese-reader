      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "星期六、星期天，妈妈不去学校。",
      "traditional": "星期六、星期天，媽媽不去學校。",
      "pinyin": "xīng qī liù xīng qī tiān mā ma bú qù xué xiào",
      "english": "On Saturday and Sunday, mom doesn’t go to school."
    },
    {
      "index": 12,
      "simplified": "她上午在家看书、打电话，下午去工作。",
      "traditional": "她上午在家看書、打電話，下午去工作。",
      "pinyin": "tā shàng wǔ zài jiā kàn shū dǎ diàn huà xià wǔ qù gōng zuò",
      "english": "In the morning, she studies at home and makes phone calls. In the afternoon, she goes to work."
    },
    {
      "index": 13,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "我的妈妈很爱打电话。",
      "traditional": "我的媽媽很愛打電話。",
      "pinyin": "wǒ de mā ma hěn ài dǎ diàn huà",
      "english": "My mom really loves making phone calls."
    },
    {
      "index": 15,
      "simplified": "星期一、星期二、星期三、星期四、星期五、星期六、星期天，她都打电话。",
      "traditional": "星期一、星期二、星期三、星期四、星期五、星期六、星期天，她都打電話。",
      "pinyin": "xīng qī yī xīng qī èr xīng qī sān xīng qī sì xīng qī wǔ xīng qī liù xīng qī tiān tā dōu dǎ diàn huà",
      "english": "On Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, and Sunday she makes phone calls."
    },
    {
      "index": 16,
      "simplified": "她有一个东西，她说那是电脑。",
      "traditional": "她有一個東西，她說那是電腦。",
      "pinyin": "tā yǒu yí ge dōng xi tā shuō nà shì diàn nǎo",
      "english": "She has a thing that she calls a computer."
    },
    {
      "index": 17,
      "simplified": "她很爱和电脑说话，电脑里面也有人说话。",
      "traditional": "她很愛和電腦說話，電腦裡面也有人說話。",
      "pinyin": "tā hěn ài hé diàn nǎo shuō huà diàn nǎo lǐ miàn yě yǒu rén shuō huà",
      "english": "She really loves speaking with the computer. Inside the computer, there is also a person who speaks."
    },
