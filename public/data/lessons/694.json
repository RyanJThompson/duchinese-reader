{
  "id": "694",
  "title": "To Take an Exam",
  "level": "intermediate",
  "date": "2019-11-10",
  "synopsis": "The teacher is informing the students before an exam.",
  "audioUrl": "https://static.duchinese.net/documents/694/1bd4a0eb15f3810147d92d08aba40948a3337d9e.mp3?1572261306",
  "series": null,
  "fullText": {
    "simplified": "考试\n\n    同学们，明天我们就要考试了。考试时间是上午10点到12点。迟到20分钟以上的同学不能进教室考试，所以请同学们早点来教室，不要迟到。在开始考试30分钟后可以离开教室，所以如果你们写得快，不到12点就写完了，可以离开教室。听明白了吗？",
    "traditional": "考試\n\n    同學們，明天我們就要考試了。考試時間是上午10點到12點。遲到20分鐘以上的同學不能進教室考試，所以請同學們早點來教室，不要遲到。在開始考試30分鐘後可以離開教室，所以如果你們寫得快，不到12點就寫完了，可以離開教室。聽明白了嗎？"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "To take an exam"
    },
    {
      "index": 2,
      "simplified": "同学们，明天我们就要考试了。",
      "traditional": "同學們，明天我們就要考試了。",
      "pinyin": "tóng xué men míng tiān wǒ men jiù yào kǎo shì le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "考试时间是上午10点到12点。",
      "traditional": "考試時間是上午10點到12點。",
      "pinyin": "kǎo shì shí jiān shì shàng wǔ 1 diǎn dào 2 diǎn",
      "english": "Fellow students, tomorrow we are going to have an exam."
    },
    {
      "index": 4,
      "simplified": "迟到20分钟以上的同学不能进教室考试，",
      "traditional": "遲到20分鐘以上的同學不能進教室考試，",
      "pinyin": "chí dào 2 fēn zhōng yǐ shàng de tóng xué bù néng jìn jiào shì kǎo shì",
      "english": "The exam time is 10 o'clock in the morning until 12 o'clock."
    },
    {
      "index": 5,
      "simplified": "所以请同学们早点来教室，不要迟到。",
      "traditional": "所以請同學們早點來教室，不要遲到。",
      "pinyin": "suǒ yǐ qǐng tóng xué men zǎo diǎn lái jiào shì bú yào chí dào",
      "english": "Fellow students that are late by 20 minutes or more will not be able to enter the classroom to take the exam."
    },
    {
      "index": 6,
      "simplified": "在开始考试30分钟后可以离开教室，",
      "traditional": "在開始考試30分鐘後可以離開教室，",
      "pinyin": "zài kāi shǐ kǎo shì 2 fēn zhōng hòu kě yǐ lí kāi jiào shì",
      "english": "So fellow students are asked to come to the classroom a bit early, and not be late."
    },
    {
      "index": 7,
      "simplified": "所以如果你们写得快，不到12点就写完了，可以离开教室。",
      "traditional": "所以如果你們寫得快，不到12點就寫完了，可以離開教室。",
      "pinyin": "suǒ yǐ rú guǒ nǐ men xiě de kuài bú dào 2 diǎn jiù xiě wán le kě yǐ lí kāi jiào shì",
      "english": "You can leave the classroom 30 minutes after the exam begins."
    },
    {
      "index": 8,
      "simplified": "听明白了吗？",
      "traditional": "聽明白了嗎？",
      "pinyin": "tīng míng bai le ma",
      "english": "So if you write fast and finish writing before 12 o’clock, you can leave the classroom."
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Is that clear?"
    }
  ],
