  "title": "Ben’s Diary—Is Anything Wrong?",
  "level": "elementary",
  "date": "2020-05-16",
  "synopsis": "Ben has trouble getting a hotel room.",
  "audioUrl": "https://static.duchinese.net/documents/865/7d0af9bc830600cd88d38d326c88770d835c1e80.mp3?1588497600",
