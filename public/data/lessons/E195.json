{
  "id": "E195",
  "title": "Your Food Has Arrived",
  "level": "elementary",
  "date": "2018-02-24",
  "synopsis": "It is really convenient to order home delivery food in China.",
  "audioUrl": "https://static.duchinese.net/documents/666/9bc346a0d45b910141da21bad662020d6df6b25c.mp3?1519035901",
  "series": null,
  "fullText": {
    "simplified": "外卖到了  \n\n外卖小哥：喂，您好，您的外卖到了，请开门。\n安妮：好的，请稍等。\n外卖小哥：这是您的外卖，牛肉炒饭。\n安妮：谢谢你。\n外卖小哥：不用客气。祝您用餐愉快！\n安妮：请慢走。",
    "traditional": "外賣到了  \n\n外賣小哥：喂，您好，您的外賣到了，請開門。\n安妮：好的，請稍等。\n外賣小哥：這是您的外賣，牛肉炒飯。\n安妮：謝謝你。\n外賣小哥：不用客氣。祝您用餐愉快！\n安妮：請慢走。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "  \n\n",
      "traditional": "  \n\n",
      "pinyin": "",
      "english": "Your Food Has Arrived"
    },
    {
      "index": 2,
      "simplified": "外卖小哥：喂，您好，您的外卖到了，请开门。",
      "traditional": "外賣小哥：喂，您好，您的外賣到了，請開門。",
      "pinyin": "wài mài xiǎo gē wéi nín hǎo nín de wài mài dào le qǐng kāi mén",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Delivery guy: Hello, your home delivery is here. Please open the door."
    },
    {
      "index": 4,
      "simplified": "安妮：好的，请稍等。",
      "traditional": "安妮：好的，請稍等。",
      "pinyin": "ān nī hǎo de qǐng shāo děng",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Ok, wait a second."
    },
    {
      "index": 6,
      "simplified": "外卖小哥：这是您的外卖，牛肉炒饭。",
      "traditional": "外賣小哥：這是您的外賣，牛肉炒飯。",
      "pinyin": "wài mài xiǎo gē zhè shì nín de wài mài niú ròu chǎo fàn",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Delivery guy: Here is your food, beef fried rice."
    },
    {
      "index": 8,
      "simplified": "安妮：谢谢你。",
      "traditional": "安妮：謝謝你。",
      "pinyin": "ān nī xiè xie nǐ",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Thank you."
    },
    {
      "index": 10,
      "simplified": "外卖小哥：不用客气。祝您用餐愉快！",
      "traditional": "外賣小哥：不用客氣。祝您用餐愉快！",
      "pinyin": "wài mài xiǎo gē bú yòng kè qi zhù nín yòng cān yú kuài",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Delivery guy: You are welcome. Have a nice meal."
    },
    {
      "index": 12,
      "simplified": "安妮：请慢走。",
      "traditional": "安妮：請慢走。",
      "pinyin": "ān nī qǐng màn zǒu",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Annie: Take care."
    }
  ],
