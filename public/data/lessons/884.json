{
  "id": "884",
  "title": "Air China",
  "level": "elementary",
  "date": "2020-05-02",
  "synopsis": "What is China’s largest airline called in Chinese?",
  "audioUrl": "https://static.duchinese.net/documents/884/a415f9e72d1697490375504b961c078fd852dff1.mp3?1587289673",
  "series": null,
  "fullText": {
    "simplified": "空气中国\n\n小乐：上次你去日本，坐的是哪个航空公司的飞机？\n保罗：空气中国。\n小乐：空气中国？没听过这个航空公司。\n保罗：不可能吧？Air China不是中国最大的航空公司吗？你没听说过吗？\n小乐：保罗！那叫“中国航空”……",
    "traditional": "空氣中國\n\n小樂：上次你去日本，坐的是哪個航空公司的飛機？\n保羅：空氣中國。\n小樂：空氣中國？沒聽過這個航空公司。\n保羅：不可能吧？Air China不是中國最大的航空公司嗎？你沒聽說過嗎？\n小樂：保羅！那叫“中國航空”……"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Air China"
    },
    {
      "index": 2,
      "simplified": "小乐：上次你去日本，坐的是哪个航空公司的飞机？",
      "traditional": "小樂：上次你去日本，坐的是哪個航空公司的飛機？",
      "pinyin": "xiǎo lè shàng cì nǐ qù rì běn zuò de shì nǎ ge háng kōng gōng sī de fēi jī",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Last time you went to Japan, which airline did you fly with?"
    },
    {
      "index": 4,
      "simplified": "保罗：空气中国。",
      "traditional": "保羅：空氣中國。",
      "pinyin": "bǎo luó kōng qì zhōng guó",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Air China."
    },
    {
      "index": 6,
      "simplified": "小乐：空气中国？没听过这个航空公司。",
      "traditional": "小樂：空氣中國？沒聽過這個航空公司。",
      "pinyin": "xiǎo lè kōng qì zhōng guó méi tīng guò zhè ge háng kōng gōng sī",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Air China? I haven’t heard of this airline."
    },
    {
      "index": 8,
      "simplified": "保罗：不可能吧？Air China不是中国最大的航空公司吗？你没听说过吗？",
      "traditional": "保羅：不可能吧？Air China不是中國最大的航空公司嗎？你沒聽說過嗎？",
      "pinyin": "bǎo luó bù kě néng ba 3 bú shì zhōng guó zuì dà de háng kōng gōng sī ma nǐ méi tīng shuō guò ma",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: It can’t be? Isn’t Air China the largest airline in China? You haven’t heard about it?"
    },
    {
      "index": 10,
      "simplified": "小乐：保罗！那叫“中国航空”……",
      "traditional": "小樂：保羅！那叫“中國航空”……",
      "pinyin": "xiǎo lè bǎo luó nà jiào zhōng guó háng kōng",
      "english": ""
    }
  ],
