{
  "id": "987",
  "title": "Don’t Want to Get Up",
  "level": "newbie",
  "date": "2020-07-22",
  "synopsis": "A son doesn’t want to get out of bed.",
  "audioUrl": "https://static.duchinese.net/documents/987/5384346003233a8bc5fb25abe25637e5f26ab698.mp3?1595070097",
  "series": null,
  "fullText": {
    "simplified": "我不想起床\n\n妈妈：你看看几点了？怎么还不起床？你得起床上课了！\n儿子：我不用上课，妈妈。我已经不是学生了。我不想起床！\n妈妈：你现在是老师！快起床，你的学生们都在等你上课呢！",
    "traditional": "我不想起床\n\n媽媽：你看看幾點了？怎麼還不起床？你得起床上課了！\n兒子：我不用上課，媽媽。我已經不是學生了。我不想起床！\n媽媽：你現在是老師！快起床，你的學生們都在等你上課呢！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Don’t Want to Get Out of Bed"
    },
    {
      "index": 2,
      "simplified": "妈妈：你看看几点了？怎么还不起床？你得起床上课了！",
      "traditional": "媽媽：你看看幾點了？怎麼還不起床？你得起床上課了！",
      "pinyin": "mā ma nǐ kàn kan jǐ diǎn le zěn me hái bù qǐ chuáng nǐ děi qǐ chuáng shàng kè le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: Have you seen what time it is? How come you still haven’t gotten out of bed? You have to get up and go to class!"
    },
    {
      "index": 4,
      "simplified": "儿子：我不用上课，妈妈。我已经不是学生了。我不想起床！",
      "traditional": "兒子：我不用上課，媽媽。我已經不是學生了。我不想起床！",
      "pinyin": "ér zi wǒ bú yòng shàng kè mā ma wǒ yǐ jīng bú shì xué sheng le wǒ bù xiǎng qǐ chuáng",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Son: I don’t have to go to class, mom. I’m not a student anymore. I don’t want to get out of bed!"
    },
    {
      "index": 6,
      "simplified": "妈妈：你现在是老师！快起床，你的学生们都在等你上课呢！",
      "traditional": "媽媽：你現在是老師！快起床，你的學生們都在等你上課呢！",
      "pinyin": "mā ma nǐ xiàn zài shì lǎo shī kuài qǐ chuáng nǐ de xué sheng men dōu zài děng nǐ shàng kè ne",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Mom: You’re the teacher now! Hurry and get up. Your students are all waiting for you to go to class!"
    }
  ],
