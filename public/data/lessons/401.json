{
  "id": "401",
  "title": "What Are You Looking For?",
  "level": "newbie",
  "date": "2017-11-09",
  "synopsis": "Ben gets some help from Lili looking for Aunt Li's dog.",
  "audioUrl": "https://static.duchinese.net/documents/571/17dc1c0a53932e437196a5a3d21c3a1a816faf2f.mp3?1554973221",
  "series": {
    "title": "Ben’s life in China 2: Lili’s Boyfriend",
    "chapter": 19,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你在找什么？\n\n丽丽：本，你在找什么？\n本：李阿姨家的狗不见了，我帮李阿姨找一找。\n丽丽：狗？什么样的狗？\n本：它是一只黄色的狗，但是耳朵是黑色的。\n丽丽：你看看，是不是那只？\n本：啊！对！就是它！太好了！",
    "traditional": "你在找什麼？\n\n麗麗：本，你在找什麼？\n本：李阿姨家的狗不見了，我幫李阿姨找一找。\n麗麗：狗？什麼樣的狗？\n本：它是一隻黃色的狗，但是耳朵是黑色的。\n麗麗：你看看，是不是那隻？\n本：啊！對！就是它！太好了！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "What Are You Looking For?"
    },
    {
      "index": 2,
      "simplified": "丽丽：本，你在找什么？",
      "traditional": "麗麗：本，你在找什麼？",
      "pinyin": "lì lì běn nǐ zài zhǎo shén me",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Ben, what are you looking for?"
    },
    {
      "index": 4,
      "simplified": "本：李阿姨家的狗不见了，我帮李阿姨找一找。",
      "traditional": "本：李阿姨家的狗不見了，我幫李阿姨找一找。",
      "pinyin": "běn lǐ ā yí jiā de gǒu bú jiàn le wǒ bāng lǐ ā yí zhǎo yì zhǎo",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Aunt Li's family dog is missing. I'm helping Aunt Li look."
    },
    {
      "index": 6,
      "simplified": "丽丽：狗？什么样的狗？",
      "traditional": "麗麗：狗？什麼樣的狗？",
      "pinyin": "lì lì gǒu shén me yàng de gǒu",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Dog? What type of dog?"
    },
    {
      "index": 8,
      "simplified": "本：它是一只黄色的狗，但是耳朵是黑色的。",
      "traditional": "本：它是一隻黃色的狗，但是耳朵是黑色的。",
      "pinyin": "běn tā shì yì zhī huáng sè de gǒu dàn shì ěr duo shì hēi sè de",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: He's a yellow dog, but his ears are black."
    },
    {
      "index": 10,
      "simplified": "丽丽：你看看，是不是那只？",
      "traditional": "麗麗：你看看，是不是那隻？",
      "pinyin": "lì lì nǐ kàn kan shì bu shì nà zhī",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Look, isn't it that dog?"
    },
    {
      "index": 12,
      "simplified": "本：啊！对！就是它！太好了！",
      "traditional": "本：啊！對！就是它！太好了！",
      "pinyin": "běn a duì jiù shì tā tài hǎo le",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Ah! Yes! That's him! Great!"
    }
  ],
