{
  "id": "429",
  "title": "Medicine for Injuries",
  "level": "intermediate",
  "date": "2018-04-04",
  "synopsis": "Lili is at the pharmacy buying medicine for her friend who fell.",
  "audioUrl": "https://static.duchinese.net/documents/698/9f0ef29a936cc209d892540537eeac0ea7704ee4.mp3?1635865096",
