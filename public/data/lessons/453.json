{
  "id": "453",
  "title": "Your Watch is Slow",
  "level": "newbie",
  "date": "2018-02-08",
  "synopsis": "Little He is late for his movie date with Lili.",
  "audioUrl": "https://static.duchinese.net/documents/649/1be9a59a4f6ebb6742e41793ef53779c7627ca0b.mp3?1589791856",
  "series": {
    "title": "Ben’s life in China 4: Trouble in Paradise",
    "chapter": 17,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "你的表慢了\n\n丽丽：你来晚了！电影已经开始了！\n小何：没有啊！电影不是8点半开始吗？\n丽丽：是啊，现在已经8点半了！\n小何：我的表才8点呀！\n丽丽：你的表慢了半个小时。\n小何：天啊！对不起！\n丽丽：算了！我们快进去吧！",
    "traditional": "你的錶慢了\n\n麗麗：你來晚了！電影已經開始了！\n小何：沒有啊！電影不是8點半開始嗎？\n麗麗：是啊，現在已經8點半了！\n小何：我的錶才8點呀！\n麗麗：你的錶慢了半個小時。\n小何：天啊！對不起！\n麗麗：算了！我們快進去吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Your Watch is Slow"
    },
    {
      "index": 2,
      "simplified": "丽丽：你来晚了！电影已经开始了！",
      "traditional": "麗麗：你來晚了！電影已經開始了！",
      "pinyin": "lì lì nǐ lái wǎn le diàn yǐng yǐ jīng kāi shǐ le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: You're late! The movie has already started!"
    },
    {
      "index": 4,
      "simplified": "小何：没有啊！电影不是8点半开始吗？",
      "traditional": "小何：沒有啊！電影不是8點半開始嗎？",
      "pinyin": "xiǎo hé méi yǒu a diàn yǐng bú shì 1 diǎn bàn kāi shǐ ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: No, doesn't the movie start at 8:30?"
    },
    {
      "index": 6,
      "simplified": "丽丽：是啊，现在已经8点半了！",
      "traditional": "麗麗：是啊，現在已經8點半了！",
      "pinyin": "lì lì shì a xiàn zài yǐ jīng 1 diǎn bàn le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Yes, it's already 8:30 now!"
    },
    {
      "index": 8,
      "simplified": "小何：我的表才8点呀！",
      "traditional": "小何：我的錶才8點呀！",
      "pinyin": "xiǎo hé wǒ de biǎo cái 1 diǎn ya",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: My watch is only 8 o'clock!"
    },
    {
      "index": 10,
      "simplified": "丽丽：你的表慢了半个小时。",
      "traditional": "麗麗：你的錶慢了半個小時。",
      "pinyin": "lì lì nǐ de biǎo màn le bàn ge xiǎo shí",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: You watch is half an hour slow."
    },
    {
      "index": 12,
      "simplified": "小何：天啊！对不起！",
      "traditional": "小何：天啊！對不起！",
      "pinyin": "xiǎo hé tiān a duì bu qǐ",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Heavens! I'm sorry!"
    },
    {
      "index": 14,
      "simplified": "丽丽：算了！我们快进去吧！",
      "traditional": "麗麗：算了！我們快進去吧！",
      "pinyin": "lì lì suàn le wǒ men kuài jìn qù ba",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Lili: Forget it! Let's hurry up inside!"
    }
  ],
