{
  "id": "365",
  "title": "I'm Going to a Meeting",
  "level": "intermediate",
  "date": "2017-08-16",
  "synopsis": "Manager Wang is expecting a call but needs to go to a meeting.",
  "audioUrl": "https://static.duchinese.net/documents/500/7f588ae666ca59e178b783592e826ddf9a86243e.mp3?1698352482",
  "series": null,
  "fullText": {
    "simplified": "我去开会了\n\n王总：小张，我去二楼会议室开会了。如果等会儿有个叫陈东的人打电话找我，请告诉他三点后来我办公室。\n小张：好的。",
    "traditional": "我去開會了\n\n王總：小張，我去二樓會議室開會了。如果等會兒有個叫陳東的人打電話找我，請告訴他三點後來我辦公室。\n小張：好的。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I'm going to a meeting"
    },
    {
      "index": 2,
      "simplified": "王总：小张，我去二楼会议室开会了。",
      "traditional": "王總：小張，我去二樓會議室開會了。",
      "pinyin": "wáng zǒng xiǎo zhāng wǒ qù èr lóu huì yì shì kāi huì le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "如果等会儿有个叫陈东的人打电话找我，请告诉他三点后来我办公室。",
      "traditional": "如果等會兒有個叫陳東的人打電話找我，請告訴他三點後來我辦公室。",
      "pinyin": "rú guǒ děng huì'r yǒu ge jiào chén dōng de rén dǎ diàn huà zhǎo wǒ qǐng gào su tā sān diǎn hòu lái wǒ bàn gōng shì",
      "english": "Manager Wang: Little Zhang, I'm going to the conference room on the second floor for a meeting."
    },
    {
      "index": 4,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "If someone called Chen Dong calls asking for me in a while, please tell him to come to my office after 3 o'clock."
    },
    {
      "index": 5,
      "simplified": "小张：好的。",
      "traditional": "小張：好的。",
      "pinyin": "xiǎo zhāng hǎo de",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Zhang: Ok."
    }
  ],
