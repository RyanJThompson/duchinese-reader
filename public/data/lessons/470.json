{
  "id": "470",
  "title": "Can You Teach Me?",
  "level": "newbie",
  "date": "2018-03-15",
  "synopsis": "Ben calls Little Yu asking for study help.",
  "audioUrl": "https://static.duchinese.net/documents/676/96146c58c728c297f8064d53cb5a687c78826822.mp3?1589791638",
  "series": {
