{
  "id": "795",
  "title": "Queen",
  "level": "newbie",
  "date": "2019-09-12",
  "synopsis": "Little Ming’s Mom and Dad don’t understand each other…",
  "audioUrl": "https://static.duchinese.net/documents/1147/56d8c259ce72856520863f5a063f5985c29008b0.mp3?1568021262",
  "series": null,
  "fullText": {
    "simplified": "女王\n\n小明爸爸：小明妈，吃饭了。\n小明妈妈：不要叫我小明妈，叫我“女王”吧！\n小明爸爸：什么？叫你“女王八”？\n小明妈妈：不是三个字，是两个字！\n小明爸爸：你再怎么不好，我也不能叫你“王八”啊！",
    "traditional": "女王\n\n小明爸爸：小明媽，吃飯了。\n小明媽媽：不要叫我小明媽，叫我“女王”吧！\n小明爸爸：什麼？叫你“女王八”？\n小明媽媽：不是三個字，是兩個字！\n小明爸爸：你再怎麼不好，我也不能叫你“王八”啊！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Queen"
    },
    {
      "index": 2,
      "simplified": "小明爸爸：小明妈，吃饭了。",
      "traditional": "小明爸爸：小明媽，吃飯了。",
      "pinyin": "xiǎo míng bà ba xiǎo míng mā chī fàn le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming’s Dad: Little Ming’s Mom, eat."
    },
    {
      "index": 4,
      "simplified": "小明妈妈：不要叫我小明妈，叫我“女王”吧！",
      "traditional": "小明媽媽：不要叫我小明媽，叫我“女王”吧！",
      "pinyin": "xiǎo míng mā ma bú yào jiào wǒ xiǎo míng mā jiào wǒ nǚ wáng ba",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming’s Mom: I don’t want you to call me Little Ming’s Mom, call me “Queen”!"
    },
    {
      "index": 6,
      "simplified": "小明爸爸：什么？叫你“女王八”？",
      "traditional": "小明爸爸：什麼？叫你“女王八”？",
      "pinyin": "xiǎo míng bà ba shén me jiào nǐ nǚ wáng bā",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming’s Dad: What? Call you “Female Bastard”?"
    },
    {
      "index": 8,
      "simplified": "小明妈妈：不是三个字，是两个字！",
      "traditional": "小明媽媽：不是三個字，是兩個字！",
      "pinyin": "xiǎo míng mā ma bú shì sān ge zì shì liǎng ge zì",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming’s Mom: It’s not three characters, it’s two characters!"
    },
    {
      "index": 10,
      "simplified": "小明爸爸：你再怎么不好，我也不能叫你“王八”啊！",
      "traditional": "小明爸爸：你再怎麼不好，我也不能叫你“王八”啊！",
      "pinyin": "xiǎo míng bà ba nǐ zài zěn me bù hǎo wǒ yě bù néng jiào nǐ wáng bā a",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Ming’s Dad: No matter how bad you are, I still can’t call you “bastard”!"
    }
