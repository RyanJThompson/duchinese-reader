{
  "id": "E364",
  "title": "I Don’t Feel Well",
  "level": "elementary",
  "date": "2019-10-05",
  "synopsis": "How do you describe how you feel when you are ill?",
  "audioUrl": "https://static.duchinese.net/documents/1168/7c37d4ff8d49c588dbc0a1ca6233fc0d2eb187de.mp3?1569842058",
  "series": null,
  "fullText": {
    "simplified": "不舒服\n\n小何：你今天怎么了？看起来特别累。\n小张：我今天有点不舒服。\n小何：怎么了？\n小张：我头痛，肚子也有点痛。\n小何：那你还是早点回家休息吧。我帮你请假。",
    "traditional": "不舒服\n\n小何：你今天怎麼了？看起來特別累。\n小張：我今天有點不舒服。\n小何：怎麼了？\n小張：我頭痛，肚子也有點痛。\n小何：那你還是早點回家休息吧。我幫你請假。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Don’t Feel Well"
    },
    {
      "index": 2,
      "simplified": "小何：你今天怎么了？看起来特别累。",
      "traditional": "小何：你今天怎麼了？看起來特別累。",
      "pinyin": "xiǎo hé nǐ jīn tiān zěn me le kàn qǐ lái tè bié lèi",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: What's up with you today? You look really tired."
    },
    {
      "index": 4,
      "simplified": "小张：我今天有点不舒服。",
      "traditional": "小張：我今天有點不舒服。",
      "pinyin": "xiǎo zhāng wǒ jīn tiān yǒu diǎn bù shū fu",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: I feel a bit unwell today."
    },
    {
      "index": 6,
      "simplified": "小何：怎么了？",
      "traditional": "小何：怎麼了？",
      "pinyin": "xiǎo hé zěn me le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: How?"
    },
    {
      "index": 8,
      "simplified": "小张：我头痛，肚子也有点痛。",
      "traditional": "小張：我頭痛，肚子也有點痛。",
      "pinyin": "xiǎo zhāng wǒ tóu tòng dù zi yě yǒu diǎn tòng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: I have a headache, and my stomach also hurts a bit."
    },
    {
      "index": 10,
      "simplified": "小何：那你还是早点回家休息吧。我帮你请假。",
      "traditional": "小何：那你還是早點回家休息吧。我幫你請假。",
      "pinyin": "xiǎo hé nà nǐ hái shi zǎo diǎn huí jiā xiū xi ba wǒ bāng nǐ qǐng jià",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: Then you had better go home a bit early and rest. I will help you request leave of absence."
    }
  ],
