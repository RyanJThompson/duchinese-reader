{
  "id": "712",
  "title": "Go Back On One’s Word",
  "level": "elementary",
  "date": "2019-06-15",
  "synopsis": "Little Le doesn’t stand by her words…",
  "audioUrl": "https://static.duchinese.net/documents/1068/727004176feb6bfe9c605ac0b0824a7fc550c4b4.mp3?1560164227",
  "series": null,
  "fullText": {
    "simplified": "说话不算话\n\n保罗：小乐，晚饭呢？你不是说今天你做晚饭的吗？\n小乐：对不起，我忘了。\n保罗：你说话不算话！\n小乐：对不起。我们去外面吃吧！\n保罗：好吧！",
    "traditional": "說話不算話\n\n保羅：小樂，晚飯呢？你不是說今天你做晚飯的嗎？\n小樂：對不起，我忘了。\n保羅：你說話不算話！\n小樂：對不起。我們去外面吃吧！\n保羅：好吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Go Back On One’s Word"
    },
    {
      "index": 2,
      "simplified": "保罗：小乐，晚饭呢？你不是说今天你做晚饭的吗？",
      "traditional": "保羅：小樂，晚飯呢？你不是說今天你做晚飯的嗎？",
      "pinyin": "bǎo luó xiǎo lè wǎn fàn ne nǐ bú shì shuō jīn tiān nǐ zuò wǎn fàn de ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, what about dinner? Didn’t you say that you are making dinner today?"
    },
    {
      "index": 4,
      "simplified": "小乐：对不起，我忘了。",
      "traditional": "小樂：對不起，我忘了。",
      "pinyin": "xiǎo lè duì bu qǐ wǒ wàng le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: I’m sorry, I forgot."
    },
    {
      "index": 6,
      "simplified": "保罗：你说话不算话！",
      "traditional": "保羅：你說話不算話！",
      "pinyin": "bǎo luó nǐ shuō huà bù suàn huà",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: You’re going back on your word!"
    },
    {
      "index": 8,
      "simplified": "小乐：对不起。我们去外面吃吧！",
      "traditional": "小樂：對不起。我們去外面吃吧！",
      "pinyin": "xiǎo lè duì bu qǐ wǒ men qù wài miàn chī ba",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: I’m sorry. Let’s go eat out!"
    },
    {
      "index": 10,
      "simplified": "保罗：好吧！",
      "traditional": "保羅：好吧！",
      "pinyin": "bǎo luó hǎo ba",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Paul: Alright!"
    }
