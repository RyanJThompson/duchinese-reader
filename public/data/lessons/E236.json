{
  "id": "E236",
  "title": "Did You Take My Book?",
  "level": "intermediate",
  "date": "2018-07-04",
  "synopsis": "Paul accidentally takes the teacher’s book home with him.",
  "audioUrl": "https://static.duchinese.net/documents/776/34f789c8bc54c8c8a4b24addf48601c0ff97d96d.mp3?1530648405",
  "series": null,
  "fullText": {
    "simplified": "你是不是拿了我的书？\n\n老师：保罗，你是不是拿了我的书？\n保罗：没有吧。\n老师：可是昨天下课后我找不到我的书了。\n保罗：我看看我的包。\n老师：你看，里面有两本一样的书！\n保罗：啊，这是你的书？\n老师：我觉得是我的。\n保罗：嗯，可能是你的……我看看，应该是你的……“Eva”，一定是你的！不好意思，我昨天拿错了！",
    "traditional": "你是不是拿了我的書？\n\n老師：保羅，你是不是拿了我的書？\n保羅：沒有吧。\n老師：可是昨天下課後我找不到我的書了。\n保羅：我看看我的包。\n老師：你看，裡面有兩本一樣的書！\n保羅：啊，這是你的書？\n老師：我覺得是我的。\n保羅：嗯，可能是你的……我看看，應該是你的……“Eva”，一定是你的！不好意思，我昨天拿錯了！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Did you take my book?"
    },
    {
      "index": 2,
      "simplified": "老师：保罗，你是不是拿了我的书？",
      "traditional": "老師：保羅，你是不是拿了我的書？",
      "pinyin": "lǎo shī bǎo luó nǐ shì bú shì ná le wǒ de shū",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Teacher: Paul, did you take my book?"
    },
    {
      "index": 4,
      "simplified": "保罗：没有吧。",
      "traditional": "保羅：沒有吧。",
      "pinyin": "bǎo luó méi yǒu ba",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: No, I don’t think so."
    },
    {
      "index": 6,
      "simplified": "老师：可是昨天下课后我找不到我的书了。",
      "traditional": "老師：可是昨天下課後我找不到我的書了。",
      "pinyin": "lǎo shī kě shì zuó tiān xià kè hòu wǒ zhǎo bu dào wǒ de shū le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Teacher: But I couldn't find my book yesterday after our class."
    },
    {
      "index": 8,
      "simplified": "保罗：我看看我的包。",
      "traditional": "保羅：我看看我的包。",
      "pinyin": "bǎo luó wǒ kàn kan wǒ de bāo",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Let me look in my bag."
    },
    {
      "index": 10,
      "simplified": "老师：你看，里面有两本一样的书！",
      "traditional": "老師：你看，裡面有兩本一樣的書！",
      "pinyin": "lǎo shī nǐ kàn lǐ miàn yǒu liǎng běn yí yàng de shū",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Teacher: Look! There are two of the same book inside."
    },
    {
      "index": 12,
      "simplified": "保罗：啊，这是你的书？",
      "traditional": "保羅：啊，這是你的書？",
      "pinyin": "bǎo luó a zhè shì nǐ de shū",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Ah, is this your book?"
    },
    {
      "index": 14,
      "simplified": "老师：我觉得是我的。",
      "traditional": "老師：我覺得是我的。",
      "pinyin": "lǎo shī wǒ jué de shì wǒ de",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Teacher: I think it’s mine."
    },
    {
      "index": 16,
      "simplified": "保罗：嗯，可能是你的……我看看，应该是你的……",
      "traditional": "保羅：嗯，可能是你的……我看看，應該是你的……",
      "pinyin": "bǎo luó èn kě néng shì nǐ de wǒ kàn kan yīng gāi shì nǐ de",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "“Eva”，一定是你的！不好意思，我昨天拿错了！",
      "traditional": "“Eva”，一定是你的！不好意思，我昨天拿錯了！",
      "pinyin": "2 yí dìng shì nǐ de bù hǎo yì si wǒ zuó tiān ná cuò le",
      "english": "Paul: Hmm, maybe it’s yours… Let me see, it’s probably yours."
    },
    {
      "index": 18,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "“Eva”, it’s definitely yours! Sorry, I must have taken it by mistake yesterday."
    }
  ],
