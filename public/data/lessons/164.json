      "index": 2,
      "simplified": "小明很喜欢笑笑。",
      "traditional": "小明很喜歡笑笑。",
      "pinyin": "xiǎo míng hěn xǐ huan xiào xiào",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "今天他对笑笑表白被拒绝了。",
      "traditional": "今天他對笑笑表白被拒絕了。",
      "pinyin": "jīn tiān tā duì xiào xiào biǎo bái bèi jù jué le",
      "english": "Little Ming likes Xiao Xiao."
    },
    {
      "index": 4,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Today he confessed his feelings to her, but was refused."
    },
    {
      "index": 5,
      "simplified": "小明问：",
      "traditional": "小明問：",
      "pinyin": "xiǎo míng wèn",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "“为什么？为什么我不能当你男朋友？就是因为我不够帅吗？帅能当饭吃吗？”",
      "traditional": "“為什麼？為什麼我不能當你男朋友？就是因為我不夠帥嗎？帥能當飯吃嗎？”",
      "pinyin": "wèi shén me wèi shén me wǒ bù néng dāng nǐ nán péng you jiù shì yīn wèi wǒ bú gòu shuài ma shuài néng dāng fàn chī ma",
      "english": "Little Ming asked:"
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "“Why? Why can't I be your boyfriend? Am I not good looking enough? Can good looks put food on the table?”"
    },
    {
      "index": 8,
      "simplified": "笑笑回答：“你错了！女生找男朋友不一定要找长得帅的，但是一定要找自己喜欢的！”",
      "traditional": "笑笑回答：“你錯了！女生找男朋友不一定要找長得帥的，但是一定要找自己喜歡的！”",
      "pinyin": "xiào xiào huí dá nǐ cuò le nǚ shēng zhǎo nán péng you bù yí dìng yào zhǎo zhǎng de shuài de dàn shì yí dìng yào zhǎo zì jǐ xǐ huan de",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Xiao Xiao replied: “You're wrong! Girls don't search for good looks in a boyfriend, they search for someone they like.”"
    },
    {
      "index": 10,
      "simplified": "小明没办法了，问：“那你告诉我，你喜欢什么样的？”",
      "traditional": "小明沒辦法了，問：“那你告訴我，你喜歡什麼樣的？”",
      "pinyin": "xiǎo míng méi bàn fǎ le wèn nà nǐ gào su wǒ nǐ xǐ huan shén me yàng de",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Ming had no choice but to ask: “So tell me, what type do you like?”"
    },
    {
      "index": 12,
      "simplified": "笑笑回答：“我喜欢帅的！”",
      "traditional": "笑笑回答：“我喜歡帥的！”",
      "pinyin": "xiào xiào huí dá wǒ xǐ huan shuài de",
      "english": ""
    }
  ],
