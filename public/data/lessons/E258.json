{
  "id": "E258",
  "title": "Someone Is Sitting Here",
  "level": "newbie",
  "date": "2018-09-27",
  "synopsis": "There are many people in the coffee shop and Ben can’t find a seat.",
  "audioUrl": "https://static.duchinese.net/documents/850/1f9ff31cae1364da246cb710a00c03de284f54bd.mp3?1536666467",
  "series": null,
  "fullText": {
    "simplified": "这里有人了\n\n本：不好意思，请问我可以坐这里吗？\n女生：不好意思，这里有人了。\n本：有人？他在哪儿？\n女生：就在你后面，拿着一杯咖啡。\n本：不好意思！你坐吧。",
    "traditional": "這裡有人了\n\n本：不好意思，請問我可以坐這裡嗎？\n女生：不好意思，這裡有人了。\n本：有人？他在哪兒？\n女生：就在你後面，拿著一杯咖啡。\n本：不好意思！你坐吧。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Someone Is Sitting Here"
    },
    {
      "index": 2,
      "simplified": "本：不好意思，请问我可以坐这里吗？",
      "traditional": "本：不好意思，請問我可以坐這裡嗎？",
      "pinyin": "běn bù hǎo yì si qǐng wèn wǒ kě yǐ zuò zhè lǐ ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Excuse me, may I sit here?"
    },
    {
      "index": 4,
      "simplified": "女生：不好意思，这里有人了。",
      "traditional": "女生：不好意思，這裡有人了。",
      "pinyin": "nǚ shēng bù hǎo yì si zhè lǐ yǒu rén le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Girl: Sorry, there is someone sitting here."
    },
    {
      "index": 6,
      "simplified": "本：有人？他在哪儿？",
      "traditional": "本：有人？他在哪兒？",
      "pinyin": "běn yǒu rén tā zài nǎ'r",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: Someone is sitting here? Where is he?"
    },
    {
      "index": 8,
      "simplified": "女生：就在你后面，拿着一杯咖啡。",
      "traditional": "女生：就在你後面，拿著一杯咖啡。",
      "pinyin": "nǚ shēng jiù zài nǐ hòu miàn ná zhe yì bēi kā fēi",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Girl: He is right behind you, holding a cup of coffee."
    },
    {
      "index": 10,
      "simplified": "本：不好意思！你坐吧。",
      "traditional": "本：不好意思！你坐吧。",
      "pinyin": "běn bù hǎo yì si nǐ zuò ba",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Sorry! Please sit."
    }
  ],
