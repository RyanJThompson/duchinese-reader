{
  "id": "E228",
  "title": "Pig and Bear",
  "level": "elementary",
  "date": "2018-06-09",
  "synopsis": "Be careful when picking a Chinese name for yourself. It could be very funny.",
  "audioUrl": "https://static.duchinese.net/documents/759/864b2dbb91314d7f0adc8447922e85de6ff21c10.mp3?1528140791",
  "series": null,
  "fullText": {
    "simplified": "猪和熊\n\n保罗：喂，你好！\n陌生人：哥哥，你什么时候到？\n保罗：不好意思，请问你是谁？\n陌生人：朱河雄。\n保罗：猪和熊？哈哈，对不起，你的名字太好笑了！还有，我觉得你打错了。",
    "traditional": "豬和熊\n\n保羅：喂，你好！\n陌生人：哥哥，你什麼時候到？\n保羅：不好意思，請問你是誰？\n陌生人：朱河雄。\n保羅：豬和熊？哈哈，對不起，你的名字太好笑了！還有，我覺得你打錯了。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Pig and Bear"
    },
    {
      "index": 2,
      "simplified": "保罗：喂，你好！",
      "traditional": "保羅：喂，你好！",
      "pinyin": "bǎo luó wéi nǐ hǎo",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Hello!"
    },
    {
      "index": 4,
      "simplified": "陌生人：哥哥，你什么时候到？",
      "traditional": "陌生人：哥哥，你什麼時候到？",
      "pinyin": "mò shēng rén gē ge nǐ shén me shí hou dào",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Stranger: Older brother, when will you arrive?"
    },
    {
      "index": 6,
      "simplified": "保罗：不好意思，请问你是谁？",
      "traditional": "保羅：不好意思，請問你是誰？",
      "pinyin": "bǎo luó bù hǎo yì si qǐng wèn nǐ shì shéi",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Sorry, but may I ask who this is?"
    },
    {
      "index": 8,
      "simplified": "陌生人：朱河雄。",
      "traditional": "陌生人：朱河雄。",
      "pinyin": "mò shēng rén zhū hé xióng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Stranger: Zhu Hexiong"
    },
    {
      "index": 10,
      "simplified": "保罗：猪和熊？哈哈，对不起，你的名字太好笑了！还有，我觉得你打错了。",
      "traditional": "保羅：豬和熊？哈哈，對不起，你的名字太好笑了！還有，我覺得你打錯了。",
      "pinyin": "bǎo luó zhū hé xióng hā hā duì bu qǐ nǐ de míng zi tài hǎo xiào le hái yǒu wǒ jué de nǐ dǎ cuò le",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Paul: Pig and bear? Haha, sorry, your name is too funny! And I think you dialed the wrong number."
    }
  ],
