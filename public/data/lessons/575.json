    "sentence_translations": [
      "Being Stood Up",
      "",
      "Ben: Lili, you look a bit down. What happened?",
      "",
      "Lili: Little He stood me up!",
      "",
      "Ben: He released your pigeon?",
      "",
      "Lili: Yes!",
      "",
      "Ben: Pigeon? When did you start raising pigeons?",
      "",
      "Lili: Haha! I’m not raising pigeons. “Release pigeon” also means to “stand someone up”.",
      "",
      "Ben: Hmm… I still don’t get it.",
      "",
      "Lili: Little He and I had promised to go eat together, but he didn’t show up.",
      "That is called “I was released a pigeon”.",
      "",
      "Ben: Ah, I get it. Thank you, Lili!",
      "",
      "Lili: I should be thanking you. Thanks to your little joke, I feel much better.",
      ""
    ]
  }
