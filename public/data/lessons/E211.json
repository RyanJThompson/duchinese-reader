{
  "id": "E211",
  "title": "This is My Seat",
  "level": "elementary",
  "date": "2018-04-14",
  "synopsis": "What do you do if someone else has taken your seat on a train?",
  "audioUrl": "https://static.duchinese.net/documents/714/b52cc6063459add392a74b2eb6a75f81f62c21f7.mp3?1523343860",
  "series": null,
  "fullText": {
    "simplified": "这是我的座位\n\n安妮：不好意思，这个是我的座位，11A。\n乘客：我也是11A，让我看看你的票。\n安妮：你看，6车11A，就是这里。\n乘客：你走错车厢了，这里是5车。\n安妮：可是前面写着6车。\n乘客：啊，真不好意思，是我走错了！",
    "traditional": "這是我的座位\n\n安妮：不好意思，這個是我的座位，11A。\n乘客：我也是11A，讓我看看你的票。\n安妮：你看，6車11A，就是這裡。\n乘客：你走錯車廂了，這裡是5車。\n安妮：可是前面寫著6車。\n乘客：啊，真不好意思，是我走錯了！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "This is My Seat"
    },
    {
      "index": 2,
      "simplified": "安妮：不好意思，这个是我的座位，11A。",
      "traditional": "安妮：不好意思，這個是我的座位，11A。",
      "pinyin": "ān nī bù hǎo yì si zhè ge shì wǒ de zuò wèi 2 1",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Excuse me. This is my seat, 11A."
    },
    {
      "index": 4,
      "simplified": "乘客：我也是11A，让我看看你的票。",
      "traditional": "乘客：我也是11A，讓我看看你的票。",
      "pinyin": "chéng kè wǒ yě shì 2 1 ràng wǒ kàn kan nǐ de piào",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Passenger: My seat is also 11A. Let me see your ticket."
    },
    {
      "index": 6,
      "simplified": "安妮：你看，6车11A，就是这里。",
      "traditional": "安妮：你看，6車11A，就是這裡。",
      "pinyin": "ān nī nǐ kàn 1 chē 2 1 jiù shì zhè lǐ",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Look, car 6, seat 11A. It's here."
    },
    {
      "index": 8,
      "simplified": "乘客：你走错车厢了，这里是5车。",
      "traditional": "乘客：你走錯車廂了，這裡是5車。",
      "pinyin": "chéng kè nǐ zǒu cuò chē xiāng le zhè lǐ shì 1 chē",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Passenger: You are in the wrong car. This is car 5."
    },
    {
      "index": 10,
      "simplified": "安妮：可是前面写着6车。",
      "traditional": "安妮：可是前面寫著6車。",
      "pinyin": "ān nī kě shì qián miàn xiě zhe 1 chē",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: But it says car 6 in the front."
    },
    {
      "index": 12,
      "simplified": "乘客：啊，真不好意思，是我走错了！",
      "traditional": "乘客：啊，真不好意思，是我走錯了！",
      "pinyin": "chéng kè a zhēn bù hǎo yì si shì wǒ zǒu cuò le",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Passenger: Oh, I’m sorry. I am in the wrong car!"
    }
  ],
