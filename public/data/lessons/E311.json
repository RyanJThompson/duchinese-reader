{
  "id": "E311",
  "title": "I’m Done For",
  "level": "elementary",
  "date": "2019-04-06",
  "synopsis": "A popular new way to say “I’m done for”.",
  "audioUrl": "https://static.duchinese.net/documents/1012/8a41186ec9e4dd234779caa2fd1267c115a730c2.mp3?1553506574",
  "series": null,
  "fullText": {
    "simplified": "凉凉\n\n保罗：明天的考试你复习好了吗？\n小乐：还没有，感觉我要凉凉了。\n保罗：那你还不好好复习？如果真的凉凉了，你又要哭了。\n小乐：好吧，我去复习了。希望这次不要凉凉！",
    "traditional": "涼涼\n\n保羅：明天的考試你復習好了嗎？\n小樂：還沒有，感覺我要涼涼了。\n保羅：那你還不好好復習？如果真的涼涼了，你又要哭了。\n小樂：好吧，我去復習了。希望這次不要涼涼！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I’m Done For"
    },
    {
      "index": 2,
      "simplified": "保罗：明天的考试你复习好了吗？",
      "traditional": "保羅：明天的考試你復習好了嗎？",
      "pinyin": "bǎo luó míng tiān de kǎo shì nǐ fù xí hǎo le ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Have you prepared for tomorrow’s test?"
    },
    {
      "index": 4,
      "simplified": "小乐：还没有，感觉我要凉凉了。",
      "traditional": "小樂：還沒有，感覺我要涼涼了。",
      "pinyin": "xiǎo lè hái méi yǒu gǎn jué wǒ yào liáng liáng le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Not yet. I feel like I’m done for."
    },
    {
      "index": 6,
      "simplified": "保罗：那你还不好好复习？如果真的凉凉了，你又要哭了。",
      "traditional": "保羅：那你還不好好復習？如果真的涼涼了，你又要哭了。",
      "pinyin": "bǎo luó nà nǐ hái bù hǎo hǎo fù xí rú guǒ zhēn de liáng liáng le nǐ yòu yào kū le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Then why don’t you start reviewing? If you really fail, you will cry again."
    },
    {
      "index": 8,
      "simplified": "小乐：好吧，我去复习了。希望这次不要凉凉！",
      "traditional": "小樂：好吧，我去復習了。希望這次不要涼涼！",
      "pinyin": "xiǎo lè hǎo ba wǒ qù fù xí le xī wàng zhè cì bú yào liáng liáng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: Fine, I’ll go review. Let’s hope I won’t fail this time!"
    }
  ],
