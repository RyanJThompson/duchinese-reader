{
  "id": "819",
  "title": "Do You Smell Something?",
  "level": "intermediate",
  "date": "2020-01-12",
  "synopsis": "Paul has a favor to ask of Little Le.",
  "audioUrl": "https://static.duchinese.net/documents/819/cefa72f62109b0f9d1921c401c56d75c0eea4b59.mp3?1578129402",
  "series": null,
  "fullText": {
    "simplified": "你有没有闻到什么味道？\n\n保罗：小乐，你有没有闻到什么味道？\n小乐：没有啊。\n保罗：你一进来，空气都变甜了。\n小乐：呵呵！\n保罗：小乐，你猜，我的心在哪边？\n小乐：左边啊。\n保罗：不对！我的心，在你那边。\n小乐：呵呵呵。说吧，嘴巴那么甜，是不是有什么要我帮忙的？\n保罗：你说对了。小乐，你可以帮我洗一下东西吗？\n小乐：就知道你有求于我。说吧！洗什么？\n保罗：喜欢我！\n小乐：呵呵呵呵！保罗，你的中文越来越好了啊！",
    "traditional": "你有沒有聞到什麼味道？\n\n保羅：小樂，你有沒有聞到什麼味道？\n小樂：沒有啊。\n保羅：你一進來，空氣都變甜了。\n小樂：呵呵！\n保羅：小樂，你猜，我的心在哪邊？\n小樂：左邊啊。\n保羅：不對！我的心，在你那邊。\n小樂：呵呵呵。說吧，嘴巴那麼甜，是不是有什麼要我幫忙的？\n保羅：你說對了。小樂，你可以幫我洗一下東西嗎？\n小樂：就知道你有求於我。說吧！洗什麼？\n保羅：喜歡我！\n小樂：呵呵呵呵！保羅，你的中文越來越好了啊！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Do you smell something?"
    },
    {
      "index": 2,
      "simplified": "保罗：小乐，你有没有闻到什么味道？",
      "traditional": "保羅：小樂，你有沒有聞到什麼味道？",
      "pinyin": "bǎo luó xiǎo lè nǐ yǒu méi yǒu wén dào shén me wèi dào",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, do you smell something?"
    },
    {
      "index": 4,
      "simplified": "小乐：没有啊。",
      "traditional": "小樂：沒有啊。",
      "pinyin": "xiǎo lè méi yǒu a",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: No."
    },
    {
      "index": 6,
      "simplified": "保罗：你一进来，空气都变甜了。",
      "traditional": "保羅：你一進來，空氣都變甜了。",
      "pinyin": "bǎo luó nǐ yí jìn lái kōng qì dōu biàn tián le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: As soon as you came in, the air got all sweet."
    },
    {
      "index": 8,
      "simplified": "小乐：呵呵！",
      "traditional": "小樂：呵呵！",
      "pinyin": "xiǎo lè hē hē",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Haha!"
    },
    {
      "index": 10,
      "simplified": "保罗：小乐，你猜，我的心在哪边？",
      "traditional": "保羅：小樂，你猜，我的心在哪邊？",
      "pinyin": "bǎo luó xiǎo lè nǐ cāi wǒ de xīn zài nǎ biān",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, you guess, on what side is my heart?"
    },
    {
      "index": 12,
      "simplified": "小乐：左边啊。",
      "traditional": "小樂：左邊啊。",
      "pinyin": "xiǎo lè zuǒ bian a",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: The left side."
    },
    {
      "index": 14,
      "simplified": "保罗：不对！我的心，在你那边。",
      "traditional": "保羅：不對！我的心，在你那邊。",
      "pinyin": "bǎo luó bú duì wǒ de xīn zài nǐ nà bian",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Wrong! My heart is on your side."
    },
    {
      "index": 16,
      "simplified": "小乐：呵呵呵。说吧，嘴巴那么甜，是不是有什么要我帮忙的？",
      "traditional": "小樂：呵呵呵。說吧，嘴巴那麼甜，是不是有什麼要我幫忙的？",
      "pinyin": "xiǎo lè hē hē hē shuō ba zuǐ ba nà me tián shì bú shì yǒu shén me yào wǒ bāng máng de",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Hahaha. Tell me, with a mouth so sweet, is there something that you want my help with?"
    },
    {
      "index": 18,
      "simplified": "保罗：你说对了。小乐，你可以帮我洗一下东西吗？",
      "traditional": "保羅：你說對了。小樂，你可以幫我洗一下東西嗎？",
      "pinyin": "bǎo luó nǐ shuō duì le xiǎo lè nǐ kě yǐ bāng wǒ xǐ yí xià dōng xi ma",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: You’re right. Little Le, can you help me wash some things?"
    },
    {
      "index": 20,
      "simplified": "小乐：就知道你有求于我。说吧！洗什么？",
      "traditional": "小樂：就知道你有求於我。說吧！洗什麼？",
      "pinyin": "xiǎo lè jiù zhī dào nǐ yǒu qiú yú wǒ shuō ba xǐ shén me",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: I just knew that you had a request for me. Say it! Wash what?"
    },
    {
      "index": 22,
      "simplified": "保罗：喜欢我！",
      "traditional": "保羅：喜歡我！",
      "pinyin": "bǎo luó xǐ huan wǒ",
      "english": ""
    },
    {
      "index": 23,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Like me!"
    },
    {
      "index": 24,
      "simplified": "小乐：呵呵呵呵！保罗，你的中文越来越好了啊！",
      "traditional": "小樂：呵呵呵呵！保羅，你的中文越來越好了啊！",
      "pinyin": "xiǎo lè hē hē hē hē bǎo luó nǐ de zhōng wén yuè lái yuè hǎo le a",
      "english": ""
    },
    {
      "index": 25,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: Hahahaha! Paul, your Chinese is getting better and better!"
    }
  ],
