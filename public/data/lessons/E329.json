{
  "id": "E329",
  "title": "Are You Wearing Makeup?",
  "level": "intermediate",
  "date": "2019-05-26",
  "synopsis": "Paul says Little Le is more beautiful without makeup. Is he telling the truth?",
  "audioUrl": "https://static.duchinese.net/documents/1055/f179d21072ef43b5965c07db786a56c1631bfe6f.mp3?1560936303",
  "series": null,
  "fullText": {
    "simplified": "你化妆了吗？\n\n保罗：你今天化妆了吗？\n小乐：没有啊，我今天素颜，什么都没有化。\n保罗：那怎么比化了妆还漂亮啊？\n小乐：真的？说吧，你是不是有事情要我帮忙？",
    "traditional": "你化妝了嗎？\n\n保羅：你今天化妝了嗎？\n小樂：沒有啊，我今天素顏，什麼都沒有化。\n保羅：那怎麼比化了妝還漂亮啊？\n小樂：真的？說吧，你是不是有事情要我幫忙？"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Are You Wearing Makeup?"
    },
    {
      "index": 2,
      "simplified": "保罗：你今天化妆了吗？",
      "traditional": "保羅：你今天化妝了嗎？",
      "pinyin": "bǎo luó nǐ jīn tiān huà zhuāng le ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Are you wearing makeup today?"
    },
    {
      "index": 4,
      "simplified": "小乐：没有啊，我今天素颜，什么都没有化。",
      "traditional": "小樂：沒有啊，我今天素顏，什麼都沒有化。",
      "pinyin": "xiǎo lè méi yǒu a wǒ jīn tiān sù yán shén me dōu méi yǒu huà",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: No, I'm all natural today, I didn’t put on any makeup at all."
    },
    {
      "index": 6,
      "simplified": "保罗：那怎么比化了妆还漂亮啊？",
      "traditional": "保羅：那怎麼比化了妝還漂亮啊？",
      "pinyin": "bǎo luó nà zěn me bǐ huà le zhuāng hái piào liang a",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Then how come you are even more beautiful than when you wear makeup?"
    },
    {
      "index": 8,
      "simplified": "小乐：真的？说吧，你是不是有事情要我帮忙？",
      "traditional": "小樂：真的？說吧，你是不是有事情要我幫忙？",
      "pinyin": "xiǎo lè zhēn de shuō ba nǐ shì bú shì yǒu shì qing yào wǒ bāng máng",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: Really? Tell me, is it that you have something you want my help with?"
    }
  ],
