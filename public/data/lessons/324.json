    {
      "index": 4,
      "simplified": "上个星期，我在商店买了一件衣服，158元。",
      "traditional": "上個星期，我在商店買了一件衣服，158元。",
      "pinyin": "shàng ge xīng qī wǒ zài shāng diàn mǎi le yí jiàn yī fu 5 yuán",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "后来丽丽和我说，中国人喜欢在淘宝上买衣服，",
      "traditional": "後來麗麗和我說，中國人喜歡在淘寶上買衣服，",
      "pinyin": "hòu lái lì lì hé wǒ shuō zhōng guó rén xǐ huan zài táo bǎo shang mǎi yī fu",
      "english": "Last week, I bought some clothes at the store for 158 yuan."
    },
    {
      "index": 6,
      "simplified": "因为淘宝上的衣服很便宜。",
      "traditional": "因為淘寶上的衣服很便宜。",
      "pinyin": "yīn wèi táo bǎo shang de yī fu hěn pián yi",
      "english": "Afterwards Lili told me that Chinese people like to buy clothes on Taobao."
    },
    {
      "index": 7,
      "simplified": "我今天上淘宝一看，我的那件衣服才58元！",
      "traditional": "我今天上淘寶一看，我的那件衣服才58元！",
      "pinyin": "wǒ jīn tiān shàng táo bǎo yí kàn wǒ de nà jiàn yī fu cái 3 yuán",
      "english": "Because the clothes on Taobao are cheap."
    },
    {
      "index": 8,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Today I looked on Taobao, and the clothes I bought only cost 58 yuan!"
    }
  ],
