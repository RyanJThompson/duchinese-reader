      "english": "Work Hours"
    },
    {
      "index": 2,
      "simplified": "小何：唉……周六又要加班了。",
      "traditional": "小何：唉……週六又要加班了。",
      "pinyin": "xiǎo hé ài zhōu liù yòu yào jiā bān le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Sigh… We have to work overtime on Saturday again."
    },
    {
      "index": 4,
      "simplified": "小张：是啊。别人都说程序员的工作时间是996，",
      "traditional": "小張：是啊。別人都說程序員的工作時間是996，",
      "pinyin": "xiǎo zhāng shì a bié ren dōu shuō chéng xù yuán de gōng zuò shí jiān shì 3",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "我看我们也快和他们一样了。",
      "traditional": "我看我們也快和他們一樣了。",
      "pinyin": "wǒ kàn wǒ men yě kuài hé tā men yí yàng le",
      "english": "Little Zhang: Yes. Everyone else says that a programmer’s work hours are 996."
    },
    {
      "index": 6,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "I see ours also quickly getting the same as theirs."
    },
    {
      "index": 7,
      "simplified": "小何：什么996？",
      "traditional": "小何：什麼996？",
      "pinyin": "xiǎo hé shén me 3",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: What 996?"
    },
    {
      "index": 9,
      "simplified": "小张：就是早上9点上班，晚上9点下班，每周工作6天。",
      "traditional": "小張：就是早上9點上班，晚上9點下班，每週工作6天。",
      "pinyin": "xiǎo zhāng jiù shì zǎo shang 1 diǎn shàng bān wǎn shang 1 diǎn xià bān měi zhōu gōng zuò 1 tiān",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: It is to start working at 9 in the morning, get off work at 9 in the evening, and work 6 days a week."
    },
    {
      "index": 11,
      "simplified": "小何：我们哪是996呀？",
      "traditional": "小何：我們哪是996呀？",
      "pinyin": "xiǎo hé wǒ men nǎ shì 3 ya",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "我们是007，零点上班，零点下班，每周工作7天，一点儿休息时间都没有。",
      "traditional": "我們是007，零點上班，零點下班，每週工作7天，一點兒休息時間都沒有。",
      "pinyin": "wǒ men shì 3 líng diǎn shàng bān líng diǎn xià bān měi zhōu gōng zuò 1 tiān yì diǎn'r xiū xi shí jiān dōu méi yǒu",
      "english": "Little He: How can we be 996?"
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "We are 007, start work at 00:00, get off work at 00:00, work 7 days a week, and have no time to rest at all."
    },
    {
      "index": 14,
      "simplified": "小张：说得没错。唉……好久没去旅游了。",
      "traditional": "小張：說得沒錯。唉……好久沒去旅遊了。",
      "pinyin": "xiǎo zhāng shuō de méi cuò ài hǎo jiǔ méi qù lǚ yóu le",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "真希望自己是老师或公务员，他们都是855，太幸福了。",
      "traditional": "真希望自己是老師或公務員，他們都是855，太幸福了。",
      "pinyin": "zhēn xī wàng zì jǐ shì lǎo shī huò gōng wù yuán tā men dōu shì 3 tài xìng fú le",
      "english": "Little Zhang: You’re not wrong. Sigh… I haven’t traveled in such a long time."
    },
    {
      "index": 16,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "I really wish I was a teacher or a civil servant, they are all 855, such happiness."
    },
    {
      "index": 17,
      "simplified": "小何：855？啊，早上8点上班，下午5点下班，每周工作5天，对吧？",
      "traditional": "小何：855？啊，早上8點上班，下午5點下班，每週工作5天，對吧？",
      "pinyin": "xiǎo hé 3 a zǎo shang 1 diǎn shàng bān xià wǔ 1 diǎn xià bān měi zhōu gōng zuò 1 tiān duì ba",
      "english": ""
    },
    {
      "index": 18,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: 855? Oh, start work at 8 in the morning, get off work at 5 in the afternoon, work 5 days a week, right?"
    },
    {
      "index": 19,
      "simplified": "小张：对啊！你想想，我们已经多久没有5点下班了？",
      "traditional": "小張：對啊！你想想，我們已經多久沒有5點下班了？",
      "pinyin": "xiǎo zhāng duì a nǐ xiǎng xiǎng wǒ men yǐ jīng duō jiǔ méi yǒu 1 diǎn xià bān le",
      "english": ""
    },
    {
      "index": 20,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: That’s right! Think about it, how long is it already since we got off work at 5?"
    },
    {
      "index": 21,
      "simplified": "小何：算了！别想了，赶紧工作吧！",
      "traditional": "小何：算了！別想了，趕緊工作吧！",
      "pinyin": "xiǎo hé suàn le bié xiǎng le gǎn jǐn gōng zuò ba",
      "english": ""
    },
    {
      "index": 22,
      "simplified": "我可不想每天都工作到半夜。",
      "traditional": "我可不想每天都工作到半夜。",
      "pinyin": "wǒ kě bù xiǎng měi tiān dōu gōng zuò dào bàn yè",
      "english": "Little He: Forget it! Don’t think about it, let’s get to work without losing time!"
    },
    {
      "index": 23,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "I really don’t want to always work until midnight every day."
    }
