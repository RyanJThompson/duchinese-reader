  "title": "Work Hours",
  "level": "upper intermediate",
  "date": "2019-08-20",
  "synopsis": "Little He and Little Zhang have to work overtime again…",
  "audioUrl": "https://static.duchinese.net/documents/1129/c289f03c3892ff5545acd9869b36d751ed0f6ce8.mp3?1566203684",
