      "traditional": "\n    ",
      "pinyin": "",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "妈妈说：“我是你妈妈，你听我的！”",
      "traditional": "媽媽說：“我是你媽媽，你聽我的！”",
      "pinyin": "mā ma shuō wǒ shì nǐ mā ma nǐ tīng wǒ de",
      "english": "Mom said, “I’m your mom; you have to listen to me!”"
    },
