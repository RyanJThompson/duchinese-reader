  "title": "They All Don’t Like Me",
  "level": "newbie",
  "date": "2019-05-16",
  "synopsis": "Little Li is not in the mood for school, but he has to go.",
  "audioUrl": "https://static.duchinese.net/documents/1046/0ecf1c9b6417e7af95492fe4fd3b5533b11ca56e.mp3?1557400581",
