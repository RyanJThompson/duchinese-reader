{
  "id": "438",
  "title": "When is Spring Festival this Year?",
  "level": "newbie",
  "date": "2018-01-04",
  "synopsis": "Little He is looking forward to the Spring Festival vacation.",
  "audioUrl": "https://static.duchinese.net/documents/619/f428e49f9ff9cbce162bf268f90e3e379d3c22dd.mp3?1698351931",
  "series": null,
  "fullText": {
    "simplified": "今年的春节是什么时候？\n\n小何：好累啊，好想放假啊！\n丽丽：对了，今年的春节是什么时候？\n小何：2月16号。\n丽丽：等到春节就可以放假啦！\n小何：还有好久啊！",
    "traditional": "今年的春節是什麼時候？\n\n小何：好累啊，好想放假啊！\n麗麗：對了，今年的春節是什麼時候？\n小何：2月16號。\n麗麗：等到春節就可以放假啦！\n小何：還有好久啊！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "When is Spring Festival this year?"
    },
    {
      "index": 2,
      "simplified": "小何：好累啊，好想放假啊！",
      "traditional": "小何：好累啊，好想放假啊！",
      "pinyin": "xiǎo hé hǎo lèi a hǎo xiǎng fàng jià a",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: I'm so tired, I want a vacation!"
    },
    {
      "index": 4,
      "simplified": "丽丽：对了，今年的春节是什么时候？",
      "traditional": "麗麗：對了，今年的春節是什麼時候？",
      "pinyin": "lì lì duì le jīn nián de chūn jié shì shén me shí hou",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Right, when is Spring Festival this year?"
    },
    {
      "index": 6,
      "simplified": "小何：2月16号。",
      "traditional": "小何：2月16號。",
      "pinyin": "xiǎo hé 1 yuè 2 hào",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: February 16."
    },
    {
      "index": 8,
      "simplified": "丽丽：等到春节就可以放假啦！",
      "traditional": "麗麗：等到春節就可以放假啦！",
      "pinyin": "lì lì děng dào chūn jié jiù kě yǐ fàng jià la",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: You'll have vacation when Spring Festival arrives!"
    },
    {
      "index": 10,
      "simplified": "小何：还有好久啊！",
      "traditional": "小何：還有好久啊！",
      "pinyin": "xiǎo hé hái yǒu hǎo jiǔ a",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: It's so far away!"
    }
