{
  "id": "1097",
  "title": "Can We Buy This?",
  "level": "newbie",
  "date": "2020-10-07",
  "synopsis": "Little Ming is in a store with his Mom.",
  "audioUrl": "https://static.duchinese.net/documents/1097/4ed533a18779d7bd0842253837aa4218f33a6ee1.mp3?1596884442",
  "series": null,
  "fullText": {
    "simplified": "可以买了吗？\n\n小明：妈妈，我要买这个！\n妈妈：家里有。\n小明：妈妈，我想吃这个！\n妈妈：家里也有。\n小明：那这个吧，这个家里没有！\n妈妈：这个……贵！哎？小明你在做什么？\n小明：妈妈，你不是让我跪吗？现在可以买了吗？",
    "traditional": "可以買了嗎？\n\n小明：媽媽，我要買這個！\n媽媽：家裡有。\n小明：媽媽，我想吃這個！\n媽媽：家裡也有。\n小明：那這個吧，這個家裡沒有！\n媽媽：這個……貴！哎？小明你在做什麼？\n小明：媽媽，你不是讓我跪嗎？現在可以買了嗎？"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Can We Buy This?"
    },
    {
      "index": 2,
      "simplified": "小明：妈妈，我要买这个！",
      "traditional": "小明：媽媽，我要買這個！",
      "pinyin": "xiǎo míng mā ma wǒ yào mǎi zhè ge",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Mom, I want to buy this!"
    },
    {
      "index": 4,
      "simplified": "妈妈：家里有。",
      "traditional": "媽媽：家裡有。",
      "pinyin": "mā ma jiā lǐ yǒu",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: We have that at home."
    },
    {
      "index": 6,
      "simplified": "小明：妈妈，我想吃这个！",
      "traditional": "小明：媽媽，我想吃這個！",
      "pinyin": "xiǎo míng mā ma wǒ xiǎng chī zhè ge",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Mom, I want to eat this!"
    },
    {
      "index": 8,
      "simplified": "妈妈：家里也有。",
      "traditional": "媽媽：家裡也有。",
      "pinyin": "mā ma jiā lǐ yě yǒu",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: We have that at home too."
    },
    {
      "index": 10,
      "simplified": "小明：那这个吧，这个家里没有！",
      "traditional": "小明：那這個吧，這個家裡沒有！",
      "pinyin": "xiǎo míng nà zhè ge ba zhè ge jiā lǐ méi yǒu",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Then what about this, we don’t have this at home!"
    },
    {
      "index": 12,
      "simplified": "妈妈：这个……贵！哎？小明你在做什么？",
      "traditional": "媽媽：這個……貴！哎？小明你在做什麼？",
      "pinyin": "mā ma zhè ge guì āi xiǎo míng nǐ zài zuò shén me",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Mom: That’s … expensive! Hey? Little Ming, what are you doing?"
    },
    {
      "index": 14,
      "simplified": "小明：妈妈，你不是让我跪吗？现在可以买了吗？",
      "traditional": "小明：媽媽，你不是讓我跪嗎？現在可以買了嗎？",
      "pinyin": "xiǎo míng mā ma nǐ bú shì ràng wǒ guì ma xiàn zài kě yǐ mǎi le ma",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Ming: Mom, didn’t you make me kneel? Can we buy it now?"
    }
  ],
