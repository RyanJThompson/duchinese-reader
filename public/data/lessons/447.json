    },
    {
      "index": 2,
      "simplified": "今天天气很好，我去书店买书。",
      "traditional": "今天天氣很好，我去書店買書。",
      "pinyin": "jīn tiān tiān qì hěn hǎo wǒ qù shū diàn mǎi shū",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Today the weather was great. I went to the bookstore to buy a book."
    },
    {
      "index": 4,
      "simplified": "在书店里，我碰到了丽丽和她的朋友小雨。",
      "traditional": "在書店裡，我碰到了麗麗和她的朋友小雨。",
      "pinyin": "zài shū diàn lǐ wǒ pèng dào le lì lì hé tā de péng you xiǎo yǔ",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "小雨很热情，",
      "traditional": "小雨很熱情，",
      "pinyin": "xiǎo yǔ hěn rè qíng",
      "english": "In the bookstore, I bumped into Lili and her friend Little Yu."
    },
    {
      "index": 6,
      "simplified": "她带我去找书，还告诉我哪本书好，哪本书不好。",
      "traditional": "她帶我去找書，還告訴我哪本書好，哪本書不好。",
      "pinyin": "tā dài wǒ qù zhǎo shū hái gào su wǒ nǎ běn shū hǎo nǎ běn shū bù hǎo",
      "english": "Little Yu is very passionate."
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "She took me along to look for a book, and also told me what books are good, and what books are not good."
    },
    {
      "index": 8,
      "simplified": "丽丽有事先走了，",
      "traditional": "麗麗有事先走了，",
      "pinyin": "lì lì yǒu shì xiān zǒu le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "我和小雨买完书后，一起去咖啡店喝了咖啡。",
      "traditional": "我和小雨買完書後，一起去咖啡店喝了咖啡。",
      "pinyin": "wǒ hé xiǎo yǔ mǎi wán shū hòu yì qǐ qù kā fēi diàn hē le kā fēi",
      "english": "Lili had something to do and left before us."
    },
    {
      "index": 10,
      "simplified": "小雨很爱说话，她和我说了很多好玩的事情。",
      "traditional": "小雨很愛說話，她和我說了很多好玩的事情。",
      "pinyin": "xiǎo yǔ hěn ài shuō huà tā hé wǒ shuō le hěn duō hǎo wán de shì qing",
      "english": "When Little Yu and I had finished buying the book, we went to a café and drank coffee together."
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Yu loves to talk. She and I talked about a lot of fun things."
    }
  ],
