{
  "id": "E244",
  "title": "He Wants To Buy An Airplane",
  "level": "elementary",
  "date": "2018-08-11",
  "synopsis": "When will you be able to buy an airplane?",
  "audioUrl": "https://static.duchinese.net/documents/810/506008c1454d6ec3a71a82826a3d6cc072e28fb6.mp3?1532935072",
  "series": null,
  "fullText": {
    "simplified": "他要买一架飞机\n\n小明：昨天我爷爷说，他要买一架飞机。\n小红：真的吗？\n小明：真的，他说了一百多遍。\n小红：他发财了吗？\n小明：不，他喝多了。",
    "traditional": "他要買一架飛機\n\n小明：昨天我爺爺說，他要買一架飛機。\n小紅：真的嗎？\n小明：真的，他說了一百多遍。\n小紅：他發財了嗎？\n小明：不，他喝多了。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "He Wants To Buy An Airplane"
    },
    {
      "index": 2,
      "simplified": "小明：昨天我爷爷说，他要买一架飞机。",
      "traditional": "小明：昨天我爺爺說，他要買一架飛機。",
      "pinyin": "xiǎo míng zuó tiān wǒ yé ye shuō tā yào mǎi yí jià fēi jī",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Yesterday, my grandfather said he wants to buy an airplane."
    },
    {
      "index": 4,
      "simplified": "小红：真的吗？",
      "traditional": "小紅：真的嗎？",
      "pinyin": "xiǎo hóng zhēn de ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: Really?"
    },
    {
      "index": 6,
      "simplified": "小明：真的，他说了一百多遍。",
      "traditional": "小明：真的，他說了一百多遍。",
      "pinyin": "xiǎo míng zhēn de tā shuō le yì bǎi duō biàn",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Ming: Yes, he said it over 100 times."
    },
    {
      "index": 8,
      "simplified": "小红：他发财了吗？",
      "traditional": "小紅：他發財了嗎？",
      "pinyin": "xiǎo hóng tā fā cái le ma",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: Did he get a lot of money?"
    },
    {
      "index": 10,
      "simplified": "小明：不，他喝多了。",
      "traditional": "小明：不，他喝多了。",
      "pinyin": "xiǎo míng bù tā hē duō le",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Ming: No, he got drunk."
    }
  ],
