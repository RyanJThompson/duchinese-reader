{
  "id": "735",
  "title": "Does Your Room Need Cleaning?",
  "level": "elementary",
  "date": "2019-08-10",
  "synopsis": "He Jing is at a hotel, and the attendant has a question for him.",
  "audioUrl": "https://static.duchinese.net/documents/1116/ecd98f13ce217e3137e4398b817e9e2021dd1587.mp3?1565000716",
  "series": null,
  "fullText": {
    "simplified": "您的房间需要打扫吗？\n\n服务员：您好，不好意思！\n何京：请等一下。好了，有事吗？\n服务员：早上好，先生！请问您的房间现在需要打扫吗？\n何京：不好意思，我正在打电话。我想今天晚些时候再打扫。\n服务员：好的，没问题。\n何京：谢谢！",
    "traditional": "您的房間需要打掃嗎？\n\n服務員：您好，不好意思！\n何京：請等一下。好了，有事嗎？\n服務員：早上好，先生！請問您的房間現在需要打掃嗎？\n何京：不好意思，我正在打電話。我想今天晚些時候再打掃。\n服務員：好的，沒問題。\n何京：謝謝！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Does Your Room Need Cleaning?"
    },
    {
      "index": 2,
      "simplified": "服务员：您好，不好意思！",
      "traditional": "服務員：您好，不好意思！",
      "pinyin": "fú wù yuán nín hǎo bù hǎo yì si",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Attendant: Hello, excuse me!"
    },
    {
      "index": 4,
      "simplified": "何京：请等一下。好了，有事吗？",
      "traditional": "何京：請等一下。好了，有事嗎？",
      "pinyin": "hé jīng qǐng děng yí xià hǎo le yǒu shì ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "He Jing: Please wait a moment. Ok, is something the matter?"
    },
    {
      "index": 6,
      "simplified": "服务员：早上好，先生！请问您的房间现在需要打扫吗？",
      "traditional": "服務員：早上好，先生！請問您的房間現在需要打掃嗎？",
      "pinyin": "fú wù yuán zǎo shang hǎo xiān sheng qǐng wèn nín de fáng jiān xiàn zài xū yào dǎ sǎo ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Attendant: Good morning, sir! May I ask if your room needs cleaning now?"
    },
    {
      "index": 8,
      "simplified": "何京：不好意思，我正在打电话。我想今天晚些时候再打扫。",
      "traditional": "何京：不好意思，我正在打電話。我想今天晚些時候再打掃。",
      "pinyin": "hé jīng bù hǎo yì si wǒ zhèng zài dǎ diàn huà wǒ xiǎng jīn tiān wǎn xiē shí hou zài dǎ sǎo",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "He Jing: I’m sorry, I’m on the phone right now. I don’t want the cleaning until a bit later today."
    },
    {
      "index": 10,
      "simplified": "服务员：好的，没问题。",
      "traditional": "服務員：好的，沒問題。",
      "pinyin": "fú wù yuán hǎo de méi wèn tí",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Attendant: Ok, no problem."
    },
    {
      "index": 12,
      "simplified": "何京：谢谢！",
      "traditional": "何京：謝謝！",
      "pinyin": "hé jīng xiè xie",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "He Jing: Thank you!"
    }
  ],
