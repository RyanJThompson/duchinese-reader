{
  "id": "E288",
  "title": "The Instant Noodle Interview",
  "level": "intermediate",
  "date": "2019-01-09",
  "synopsis": "Annie receives a strange phone call asking her about instant noodles.",
  "audioUrl": "https://static.duchinese.net/documents/943/a79f32d08dd511b0913bd12e938543172e1ae6e8.mp3?1546097894",
  "series": null,
  "fullText": {
    "simplified": "方便面试吗？\n\nHR：你好，我是东方公司的，请问方便面试吗？\n安妮：方便面？不，我不是方便面。\nHR：我是说，你什么时候有时间，方便面试吗？\n安妮：我没时间，我不是方便面 。\nHR：再见！",
    "traditional": "方便面試嗎？\n\nHR：你好，我是東方公司的，請問方便面試嗎？\n安妮：方便麵？不，我不是方便麵。\nHR：我是說，你什麼時候有時間，方便面試嗎？\n安妮：我沒時間，我不是方便麵 。\nHR：再見！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Can you participate in an interview?"
    },
    {
      "index": 2,
      "simplified": "HR：你好，我是东方公司的，请问方便面试吗？",
      "traditional": "HR：你好，我是東方公司的，請問方便面試嗎？",
      "pinyin": "nǐ hǎo wǒ shì dōng fāng gōng sī de qǐng wèn fāng biàn miàn shì ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "HR: Hello, I am from the Dongfang company. Do you have time to participate in an interview?"
    },
    {
      "index": 4,
      "simplified": "安妮：方便面？不，我不是方便面。",
      "traditional": "安妮：方便麵？不，我不是方便麵。",
      "pinyin": "ān nī fāng biàn miàn bù wǒ bú shì fāng biàn miàn",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: Instant noodles? No, I’m not instant noodles."
    },
    {
      "index": 6,
      "simplified": "HR：我是说，你什么时候有时间，方便面试吗？",
      "traditional": "HR：我是說，你什麼時候有時間，方便面試嗎？",
      "pinyin": "wǒ shì shuō nǐ shén me shí hou yǒu shí jiān fāng biàn miàn shì ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "HR: I'm asking when you have time to participate in an interview?"
    },
    {
      "index": 8,
      "simplified": "安妮：我没时间，我不是方便面 。",
      "traditional": "安妮：我沒時間，我不是方便麵 。",
      "pinyin": "ān nī wǒ méi shí jiān wǒ bú shì fāng biàn miàn",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Annie: I don’t have time. I am not instant noodles."
    },
    {
      "index": 10,
      "simplified": "HR：再见！",
      "traditional": "HR：再見！",
      "pinyin": "zài jiàn",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "HR: Good-bye!"
    }
  ],
