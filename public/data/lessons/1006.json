{
  "id": "1006",
  "title": "I Love You, Mom!",
  "level": "newbie",
  "date": "2020-08-08",
  "synopsis": "My mom is a superwoman.",
  "audioUrl": "https://static.duchinese.net/documents/1006/756c858ce56ec4fc76d0f18a960d426db78eb874.mp3?1595235799",
  "series": null,
  "fullText": {
    "simplified": "我爱你妈妈\n\n    我的妈妈是个超人。她会做好吃的饭，她也是家里的医生，她还是故事大王。\n    我喜欢和妈妈一起去商店。妈妈会给我买我喜欢的东西。\n    我爱我的妈妈。我要爱她一万年！少一年、一个月、一个星期、一天、一个小时、一分钟都不可以！",
    "traditional": "我愛你媽媽\n\n    我的媽媽是個超人。她會做好吃的飯，她也是家裡的醫生，她還是故事大王。\n    我喜歡和媽媽一起去商店。媽媽會給我買我喜歡的東西。\n    我愛我的媽媽。我要愛她一萬年！少一年、一個月、一個星期、一天、一個小時、一分鐘都不可以！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "I Love You, Mom!"
    },
    {
      "index": 2,
      "simplified": "我的妈妈是个超人。",
      "traditional": "我的媽媽是個超人。",
      "pinyin": "wǒ de mā ma shì ge chāo rén",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "她会做好吃的饭，她也是家里的医生，她还是故事大王。",
      "traditional": "她會做好吃的飯，她也是家裡的醫生，她還是故事大王。",
      "pinyin": "tā huì zuò hǎo chī de fàn tā yě shì jiā lǐ de yī shēng tā hái shì gù shi dà wáng",
      "english": "My mom is a superwoman."
    },
    {
      "index": 4,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "She knows how to cook delicious meals, she’s the doctor of our house, and she’s the also the king of stories."
    },
    {
      "index": 5,
      "simplified": "我喜欢和妈妈一起去商店。妈妈会给我买我喜欢的东西。",
      "traditional": "我喜歡和媽媽一起去商店。媽媽會給我買我喜歡的東西。",
      "pinyin": "wǒ xǐ huan hé mā ma yì qǐ qù shāng diàn mā ma huì gěi wǒ mǎi wǒ xǐ huan de dōng xi",
      "english": ""
    },
    {
      "index": 6,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "I like going to the store with my mom. My mom buys me things that I like."
    },
    {
      "index": 7,
      "simplified": "我爱我的妈妈。我要爱她一万年！",
      "traditional": "我愛我的媽媽。我要愛她一萬年！",
      "pinyin": "wǒ ài wǒ de mā ma wǒ yào ài tā yí wàn nián",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "少一年、一个月、一个星期、一天、一个小时、一分钟都不可以！",
      "traditional": "少一年、一個月、一個星期、一天、一個小時、一分鐘都不可以！",
      "pinyin": "shǎo yì nián yí ge yuè yí ge xīng qī yì tiān yí ge xiǎo shí yì fēn zhōng dōu bù kě yǐ",
      "english": "I love my mom. I will love her for ten thousand years!"
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Nothing short of that will do: not a year, a month, a week, a day, an hour, or even a minute less!"
    }
  ],
