      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Do you know? I saw a group of genius children today!"
    },
    {
      "index": 4,
      "simplified": "小乐：你怎么知道他们是天才？",
      "traditional": "小樂：你怎麼知道他們是天才？",
      "pinyin": "xiǎo lè nǐ zěn me zhī dào tā men shì tiān cái",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: How do you know that they’re geniuses?"
    },
    {
      "index": 6,
      "simplified": "保罗：你不是告诉过我吗？",
      "traditional": "保羅：你不是告訴過我嗎？",
      "pinyin": "bǎo luó nǐ bú shì gào su guò wǒ ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "“大一”是“大学一年级”的意思，“大二”是“大学二年级”的意思。",
      "traditional": "“大一”是“大學一年級”的意思，“大二”是“大學二年級”的意思。",
      "pinyin": "dà yī shì dà xué yì nián jí de yì si dà èr shì dà xué èr nián jí de yì si",
      "english": "Paul: Didn’t you tell me?"
    },
    {
      "index": 8,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "That “Big 1” means “First-Year University Student”, and “Big 2” means “Second-Year University Student”."
    },
    {
      "index": 9,
      "simplified": "小乐：对啊。",
      "traditional": "小樂：對啊。",
      "pinyin": "xiǎo lè duì a",
      "english": ""
    },
    {
      "index": 10,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Yes."
    },
    {
      "index": 11,
      "simplified": "保罗：今天我在路上看到一群小朋友，",
      "traditional": "保羅：今天我在路上看到一群小朋友，",
      "pinyin": "bǎo luó jīn tiān wǒ zài lù shang kàn dào yì qún xiǎo péng you",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "他们的老师说“大一班，走这边。大二班，走那边”。",
      "traditional": "他們的老師說“大一班，走這邊。大二班，走那邊”。",
      "pinyin": "tā men de lǎo shī shuō dà yī bān zǒu zhè biān dà èr bān zǒu nà bian",
      "english": "Paul: I saw a group of children on the street today."
    },
    {
      "index": 13,
      "simplified": "你说，他们那么小就上大学了，不是天才是什么？",
      "traditional": "你說，他們那麼小就上大學了，不是天才是什麼？",
      "pinyin": "nǐ shuō tā men nà me xiǎo jiù shàng dà xué le bú shì tiān cái shì shén me",
      "english": "Their teacher said “Big 1, walk on this side. Big 2, walk on that side.”"
    },
    {
      "index": 14,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "You tell me, if they go to university when they’re that small, what are they if not geniuses?"
    },
    {
      "index": 15,
      "simplified": "小乐：呃……保罗！",
      "traditional": "小樂：呃……保羅！",
      "pinyin": "xiǎo lè è bǎo luó",
      "english": ""
    },
    {
      "index": 16,
      "simplified": "其实，幼儿园分为小班、中班、大班和学前班。",
      "traditional": "其實，幼兒園分為小班、中班、大班和學前班。",
      "pinyin": "qí shí yòu ér yuán fēn wéi xiǎo bān zhōng bān dà bān hé xué qián bān",
      "english": "Little Le: Eh… Paul!"
    },
    {
      "index": 17,
      "simplified": "如果小班有好几个班，幼儿园就会把它分为“小一班”，“小二班”，“小三班”。",
      "traditional": "如果小班有好幾個班，幼兒園就會把它分為“小一班”，“小二班”，“小三班”。",
      "pinyin": "rú guǒ xiǎo bān yǒu hǎo jǐ ge bān yòu ér yuán jiù huì bǎ tā fēn wéi xiǎo yī bān xiǎo èr bān xiǎo sān bān",
      "english": "Actually, kindergartens are divided into nursery, lower kindergarten, upper kindergarten and preschools."
    },
    {
      "index": 18,
      "simplified": "同样的，大班有好几个班的话，就会是“大一班”，“大二班”……",
      "traditional": "同樣的，大班有好幾個班的話，就會是“大一班”，“大二班”……",
      "pinyin": "tóng yàng de dà bān yǒu hǎo jǐ ge bān de huà jiù huì shì dà yī bān dà èr bān",
      "english": "If a nursery has several classes, the kindergarten will divide them into “Nursery 1”, “Nursery 2”, “Nursery 3”."
    }
  ],
