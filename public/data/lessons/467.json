    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "For today's company dinner, the manager told everyone that they can bring along their boyfriend or husband."
    },
    {
      "index": 4,
      "simplified": "小张小声地问：“那我能带别人的老公吗？”",
      "traditional": "小張小聲地問：“那我能帶別人的老公嗎？”",
      "pinyin": "xiǎo zhāng xiǎo shēng de wèn nà wǒ néng dài bié ren de lǎo gōng ma",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Zhang asked in a small voice: “Can I bring someone else's husband?”"
    },
    {
      "index": 6,
      "simplified": "公司的同事都惊呆了。",
      "traditional": "公司的同事都驚呆了。",
      "pinyin": "gōng sī de tóng shì dōu jīng dāi le",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Her colleagues were all stunned."
    },
    {
      "index": 8,
      "simplified": "经理说：",
      "traditional": "經理說：",
      "pinyin": "jīng lǐ shuō",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "“按理说公司不应该管你的私人问题，但我还是要问你一句，你想好了吗？”",
      "traditional": "“按理說公司不應該管你的私人問題，但我還是要問你一句，你想好了嗎？”",
      "pinyin": "àn lǐ shuō gōng sī bù yīng gāi guǎn nǐ de sī rén wèn tí dàn wǒ hái shi yào wèn nǐ yí jù nǐ xiǎng hǎo le ma",
      "english": "The manager said:"
    },
    {
      "index": 10,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "“Normally the company doesn't meddle in your private business, but I have to ask: Have you thought this through?”"
    },
    {
      "index": 11,
      "simplified": "小张说：“想好了，就这一次。”",
      "traditional": "小張說：“想好了，就這一次。”",
      "pinyin": "xiǎo zhāng shuō xiǎng hǎo le jiù zhè yí cì",
      "english": ""
    },
    {
      "index": 12,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Little Zhang said: “I've thought it through. It's just this once.”"
    },
    {
      "index": 13,
      "simplified": "然后拿起电话，对着电话说：“爸，老妈不在家，你别自己做饭了。",
      "traditional": "然後拿起電話，對著電話說：“爸，老媽不在家，你別自己做飯了。",
      "pinyin": "rán hòu ná qǐ diàn huà duì zhe diàn huà shuō bà lǎo mā bú zài jiā nǐ bié zì jǐ zuò fàn le",
      "english": ""
    },
    {
      "index": 14,
      "simplified": "今天我们公司聚餐，你过来一起吃吧！”",
      "traditional": "今天我們公司聚餐，你過來一起吃吧！”",
      "pinyin": "jīn tiān wǒ men gōng sī jù cān nǐ guò lái yì qǐ chī ba",
      "english": "She then picked up her phone and said: “Dad, I know mom is not at home, but don't cook anything.”"
    }
  ],
