{
  "id": "519",
  "title": "Who Are You?",
  "level": "elementary",
  "date": "2018-08-29",
  "synopsis": "An unexpected person answers when Old Wang calls his wife.",
  "audioUrl": "https://static.duchinese.net/documents/831/f8d970e16f5cc63d02d6bd2fa81bd5570043d240.mp3?1535300681",
  "series": null,
  "fullText": {
    "simplified": "你是谁？\n\n    老王给他的老婆打电话，但接电话的是个男的。\n    老王很生气，问：“你是谁？我老婆呢？”\n    男的说：“我是抢手机的。你老婆在我后面呢。先不说了，你老婆跑得太快了！”",
    "traditional": "你是誰？\n\n    老王給他的老婆打電話，但接電話的是個男的。\n    老王很生氣，問：“你是誰？我老婆呢？”\n    男的說：“我是搶手機的。你老婆在我後面呢。先不說了，你老婆跑得太快了！”"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n    ",
      "traditional": "\n\n    ",
      "pinyin": "",
      "english": "Who Are You?"
    },
    {
      "index": 2,
      "simplified": "老王给他的老婆打电话，但接电话的是个男的。",
      "traditional": "老王給他的老婆打電話，但接電話的是個男的。",
      "pinyin": "lǎo wáng gěi tā de lǎo po dǎ diàn huà dàn jiē diàn huà de shì ge nán de",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Old Wang made a phone call to his wife, but a man answered the phone."
    },
    {
      "index": 4,
      "simplified": "老王很生气，问：“你是谁？我老婆呢？”",
      "traditional": "老王很生氣，問：“你是誰？我老婆呢？”",
      "pinyin": "lǎo wáng hěn shēng qì wèn nǐ shì shéi wǒ lǎo po ne",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n    ",
      "traditional": "\n    ",
      "pinyin": "",
      "english": "Old Wang got angry and asked: “Who are you? Where’s my wife?”"
    },
    {
      "index": 6,
      "simplified": "男的说：“我是抢手机的。你老婆在我后面呢。",
      "traditional": "男的說：“我是搶手機的。你老婆在我後面呢。",
      "pinyin": "nán de shuō wǒ shì qiǎng shǒu jī de nǐ lǎo po zài wǒ hòu miàn ne",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "先不说了，你老婆跑得太快了！”",
      "traditional": "先不說了，你老婆跑得太快了！”",
      "pinyin": "xiān bù shuō le nǐ lǎo po pǎo de tài kuài le",
      "english": "The man said: “I stole her phone. Your wife is behind me.”"
    }
  ],
