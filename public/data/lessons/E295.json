{
  "id": "E295",
  "title": "When Will She Come Back?",
  "level": "elementary",
  "date": "2019-02-02",
  "synopsis": "Manager Wang wants to talk to Little Zhang, but she is out to lunch.",
  "audioUrl": "https://static.duchinese.net/documents/958/e1fc4bf6d970e0cd50db76d56d4f5c7e46e82b7e.mp3?1548159381",
  "series": null,
  "fullText": {
    "simplified": "她什么时候能回来\n\n王总：你看见小张了吗？\n小何：看见了，她出去吃午饭了。\n王总：她什么时候能回来？\n小何：半个小时后回来。",
    "traditional": "她什麼時候能回來\n\n王總：你看見小張了嗎？\n小何：看見了，她出去吃午飯了。\n王總：她什麼時候能回來？\n小何：半個小時後回來。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "When Will She Come Back?"
    },
    {
      "index": 2,
      "simplified": "王总：你看见小张了吗？",
      "traditional": "王總：你看見小張了嗎？",
      "pinyin": "wáng zǒng nǐ kàn jiàn xiǎo zhāng le ma",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: Have you seen Little Zhang?"
    },
    {
      "index": 4,
      "simplified": "小何：看见了，她出去吃午饭了。",
      "traditional": "小何：看見了，她出去吃午飯了。",
      "pinyin": "xiǎo hé kàn jiàn le tā chū qù chī wǔ fàn le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Yes, she went out to eat lunch."
    },
    {
      "index": 6,
      "simplified": "王总：她什么时候能回来？",
      "traditional": "王總：她什麼時候能回來？",
      "pinyin": "wáng zǒng tā shén me shí hou néng huí lái",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Manager Wang: When will she come back?"
    },
    {
      "index": 8,
      "simplified": "小何：半个小时后回来。",
      "traditional": "小何：半個小時後回來。",
      "pinyin": "xiǎo hé bàn ge xiǎo shí hòu huí lái",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: She will be back in half an hour."
    }
  ],
