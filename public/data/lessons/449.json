{
  "id": "449",
  "title": "I'm Taking HSK3",
  "level": "newbie",
  "date": "2018-02-18",
  "synopsis": "Ben gets a book for his upcoming HSK3 exam.",
  "audioUrl": "https://static.duchinese.net/documents/654/def3989bbdbca5aaf0dadbef868141dcf90497b3.mp3?1589791630",
