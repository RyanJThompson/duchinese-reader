{
  "id": "E393",
  "title": "What’s In My Hand?",
  "level": "newbie",
  "date": "2020-01-09",
  "synopsis": "Little Fang is playing a game with Little Hong. Or is he?",
  "audioUrl": "https://static.duchinese.net/documents/50393/56d2e8c707ab261d444c7cf6d584eaa373a4e53d.mp3?1578130603",
  "series": null,
  "fullText": {
    "simplified": "我的手里有什么？\n\n小方：我的手里有什么？\n小红：我不知道。\n小方：你说吧。说对了，那两块糖都是你的。\n小红：是两块糖吗？\n小方：对，送给你！\n",
    "traditional": "我的手裡有什麼？\n\n小方：我的手裡有什麼？\n小紅：我不知道。\n小方：你說吧。說對了，那兩塊糖都是你的。\n小紅：是兩塊糖嗎？\n小方：對，送給你！\n"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "What’s in my hand?"
    },
    {
      "index": 2,
      "simplified": "小方：我的手里有什么？",
      "traditional": "小方：我的手裡有什麼？",
      "pinyin": "xiǎo fāng wǒ de shǒu lǐ yǒu shén me",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Fang: What’s in my hand?"
    },
    {
      "index": 4,
      "simplified": "小红：我不知道。",
      "traditional": "小紅：我不知道。",
      "pinyin": "xiǎo hóng wǒ bù zhī dào",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: I don’t know."
    },
    {
      "index": 6,
      "simplified": "小方：你说吧。说对了，那两块糖都是你的。",
      "traditional": "小方：你說吧。說對了，那兩塊糖都是你的。",
      "pinyin": "xiǎo fāng nǐ shuō ba shuō duì le nà liǎng kuài táng dōu shì nǐ de",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Fang: Just say something. If you are right, these two candies will be all yours."
    },
    {
      "index": 8,
      "simplified": "小红：是两块糖吗？",
      "traditional": "小紅：是兩塊糖嗎？",
      "pinyin": "xiǎo hóng shì liǎng kuài táng ma",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Hong: Is it two candies?"
    },
    {
      "index": 10,
      "simplified": "小方：对，送给你！",
      "traditional": "小方：對，送給你！",
      "pinyin": "xiǎo fāng duì sòng gěi nǐ",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Fang: Yes! I’ll give them to you!"
    }
  ],
