{
  "id": "388",
  "title": "I am Your New Teacher",
  "level": "newbie",
  "date": "2017-09-27",
  "synopsis": "The new teacher introduces herself to the class.",
  "audioUrl": "https://static.duchinese.net/documents/535/24605bb221c229d806b24c3143c83985a0661803.mp3?1506191389",
