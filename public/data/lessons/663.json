{
  "id": "663",
  "title": "In One Ear And Out The Other",
  "level": "intermediate",
  "date": "2019-02-24",
  "synopsis": "Little He does not pay attention to what Lili is saying.",
  "audioUrl": "https://static.duchinese.net/documents/972/44af2d61f252a7657c55e9fa3d86ff2d0146266f.mp3?1698350112",
  "series": null,
  "fullText": {
    "simplified": "左耳进，右耳出\n\n丽丽：你在哪儿？\n小何：我在加班。\n丽丽：昨晚不是和你说，今天我们要和我的爸爸妈妈一起吃饭的吗？\n小何：啊？你说了吗？\n丽丽：说了。而且我说了三次！\n小何：我不记得你说过啊。\n丽丽：你总是这样！你对我的话总是左耳进，右耳出！\n小何：哪有！\n丽丽：就有！现在爸爸妈妈都等着了，你说怎么办吧？\n小何：别急。我现在马上过去。",
    "traditional": "左耳進，右耳出\n\n麗麗：你在哪兒？\n小何：我在加班。\n麗麗：昨晚不是和你說，今天我們要和我的爸爸媽媽一起吃飯的嗎？\n小何：啊？你說了嗎？\n麗麗：說了。而且我說了三次！\n小何：我不記得你說過啊。\n麗麗：你總是這樣！你對我的話總是左耳進，右耳出！\n小何：哪有！\n麗麗：就有！現在爸爸媽媽都等著了，你說怎麼辦吧？\n小何：別急。我現在馬上過去。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "In One Ear And Out The Other"
    },
    {
      "index": 2,
      "simplified": "丽丽：你在哪儿？",
      "traditional": "麗麗：你在哪兒？",
      "pinyin": "lì lì nǐ zài nǎ'r",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Where are you?"
    },
    {
      "index": 4,
      "simplified": "小何：我在加班。",
      "traditional": "小何：我在加班。",
      "pinyin": "xiǎo hé wǒ zài jiā bān",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: I’m working overtime."
    },
    {
      "index": 6,
      "simplified": "丽丽：昨晚不是和你说，今天我们要和我的爸爸妈妈一起吃饭的吗？",
      "traditional": "麗麗：昨晚不是和你說，今天我們要和我的爸爸媽媽一起吃飯的嗎？",
      "pinyin": "lì lì zuó wǎn bú shì hé nǐ shuō jīn tiān wǒ men yào hé wǒ de bà ba mā ma yì qǐ chī fàn de ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Didn’t I tell you yesterday that we are going to eat together with my mom and dad today?"
    },
    {
      "index": 8,
      "simplified": "小何：啊？你说了吗？",
      "traditional": "小何：啊？你說了嗎？",
      "pinyin": "xiǎo hé a nǐ shuō le ma",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Huh? Did you say that?"
    },
    {
      "index": 10,
      "simplified": "丽丽：说了。而且我说了三次！",
      "traditional": "麗麗：說了。而且我說了三次！",
      "pinyin": "lì lì shuō le ér qiě wǒ shuō le sān cì",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I did. And I said it three times!"
    },
    {
      "index": 12,
      "simplified": "小何：我不记得你说过啊。",
      "traditional": "小何：我不記得你說過啊。",
      "pinyin": "xiǎo hé wǒ bú jì de nǐ shuō guò a",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: I don’t remember you saying that."
    },
    {
      "index": 14,
      "simplified": "丽丽：你总是这样！你对我的话总是左耳进，右耳出！",
      "traditional": "麗麗：你總是這樣！你對我的話總是左耳進，右耳出！",
      "pinyin": "lì lì nǐ zǒng shì zhè yàng nǐ duì wǒ de huà zǒng shì zuǒ ěr jìn yòu ěr chū",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: You’re always like this! Everything I tell you just goes in one ear and out the other."
    },
    {
      "index": 16,
      "simplified": "小何：哪有！",
      "traditional": "小何：哪有！",
      "pinyin": "xiǎo hé nǎ yǒu",
      "english": ""
    },
    {
      "index": 17,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: That’s not true!"
    },
    {
      "index": 18,
      "simplified": "丽丽：就有！现在爸爸妈妈都等着了，你说怎么办吧？",
      "traditional": "麗麗：就有！現在爸爸媽媽都等著了，你說怎麼辦吧？",
      "pinyin": "lì lì jiù yǒu xiàn zài bà ba mā ma dōu děng zhe le nǐ shuō zěn me bàn ba",
      "english": ""
    },
    {
      "index": 19,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: It’s true! My mom and dad are already waiting, what should we do?"
    },
    {
      "index": 20,
      "simplified": "小何：别急。我现在马上过去。",
      "traditional": "小何：別急。我現在馬上過去。",
      "pinyin": "xiǎo hé bié jí wǒ xiàn zài mǎ shàng guò qù",
      "english": ""
    },
    {
      "index": 21,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: Relax. I’ll come over right now."
    }
  ],
