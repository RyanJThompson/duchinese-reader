      "simplified": "请假人：林红",
      "traditional": "請假人：林紅",
      "pinyin": "qǐng jià rén lín hóng",
      "english": ""
    },
    {
      "index": 8,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "From: Lin Hong"
    },
