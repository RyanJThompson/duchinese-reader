{
  "id": "368",
  "title": "The Broken Copying Machine",
  "level": "intermediate",
  "date": "2017-09-20",
  "synopsis": "The photocopier is broken when Little Zhang wants to make a copy.",
  "audioUrl": "https://static.duchinese.net/documents/531/1308a9b9e01522bf265c556557f1c838323ed1b3.mp3?1698352464",
  "series": null,
  "fullText": {
    "simplified": "复印机坏了\n\n小张：奇怪，怎么复印不了？\n小何：复印机坏了。\n小张：有给总务打电话吗？\n小何：打了，他们说下午过来修。",
    "traditional": "複印機壞了\n\n小張：奇怪，怎麼複印不了？\n小何：複印機壞了。\n小張：有給總務打電話嗎？\n小何：打了，他們說下午過來修。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "The copying machine broke"
    },
    {
      "index": 2,
      "simplified": "小张：奇怪，怎么复印不了？",
      "traditional": "小張：奇怪，怎麼複印不了？",
      "pinyin": "xiǎo zhāng qí guài zěn me fù yìn bù liǎo",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: Strange, how come I can't make a copy?"
    },
    {
      "index": 4,
      "simplified": "小何：复印机坏了。",
      "traditional": "小何：複印機壞了。",
      "pinyin": "xiǎo hé fù yìn jī huài le",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: The copying machine is broken."
    },
    {
      "index": 6,
      "simplified": "小张：有给总务打电话吗？",
      "traditional": "小張：有給總務打電話嗎？",
      "pinyin": "xiǎo zhāng yǒu gěi zǒng wù dǎ diàn huà ma",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Zhang: Did you call general affairs?"
    },
    {
      "index": 8,
      "simplified": "小何：打了，他们说下午过来修。",
      "traditional": "小何：打了，他們說下午過來修。",
      "pinyin": "xiǎo hé dǎ le tā men shuō xià wǔ guò lái xiū",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: I did. They said they would come fix it this afternoon."
    }
  ],
