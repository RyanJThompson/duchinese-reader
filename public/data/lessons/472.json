{
  "id": "472",
  "title": "I Have Lots of Homework",
  "level": "newbie",
  "date": "2018-03-22",
  "synopsis": "Ben says he has too much homework to go out to play with Little Yu.",
  "audioUrl": "https://static.duchinese.net/documents/685/7b95072975bd0e2d9c5ffea152f728877ad848c7.mp3?1589791863",
  "series": {
    "title": "Ben’s life in China 4: Trouble in Paradise",
    "chapter": 19,
    "totalChapters": 29
  },
  "fullText": {
    "simplified": "我有好多作业\n\n小雨：本，我们去堆雪人吧。\n本：不行。我有好多作业。\n小雨：晚上再写吧。\n本：不行。作业太多了，写不完。\n小雨：我们现在去堆雪人，晚上我教你写作业，怎么样？\n本：好吧！",
    "traditional": "我有好多作業\n\n小雨：本，我們去堆雪人吧。\n本：不行。我有好多作業。\n小雨：晚上再寫吧。\n本：不行。作業太多了，寫不完。\n小雨：我們現在去堆雪人，晚上我教你寫作業，怎麼樣？\n本：好吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Have Lots of Homework"
    },
    {
      "index": 2,
      "simplified": "小雨：本，我们去堆雪人吧。",
      "traditional": "小雨：本，我們去堆雪人吧。",
      "pinyin": "xiǎo yǔ běn wǒ men qù duī xuě rén ba",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Ben, let's go make a snowman."
    },
    {
      "index": 4,
      "simplified": "本：不行。我有好多作业。",
      "traditional": "本：不行。我有好多作業。",
      "pinyin": "běn bù xíng wǒ yǒu hǎo duō zuò yè",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I can't. I have lots of homework."
    },
    {
      "index": 6,
      "simplified": "小雨：晚上再写吧。",
      "traditional": "小雨：晚上再寫吧。",
      "pinyin": "xiǎo yǔ wǎn shang zài xiě ba",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: You can do it tonight."
    },
    {
      "index": 8,
      "simplified": "本：不行。作业太多了，写不完。",
      "traditional": "本：不行。作業太多了，寫不完。",
      "pinyin": "běn bù xíng zuò yè tài duō le xiě bù wán",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Ben: I can't. I have too much homework, I won't be able to finish it."
    },
    {
      "index": 10,
      "simplified": "小雨：我们现在去堆雪人，晚上我教你写作业，怎么样？",
      "traditional": "小雨：我們現在去堆雪人，晚上我教你寫作業，怎麼樣？",
      "pinyin": "xiǎo yǔ wǒ men xiàn zài qù duī xuě rén wǎn shang wǒ jiāo nǐ xiě zuò yè zěn me yàng",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Yu: Let's go make a snowman now, and I'll help you with your homework tonight. How about that?"
    },
    {
      "index": 12,
      "simplified": "本：好吧！",
      "traditional": "本：好吧！",
      "pinyin": "běn hǎo ba",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Ben: Alright!"
    }
  ],
