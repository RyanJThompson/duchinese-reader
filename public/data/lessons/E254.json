{
  "id": "E254",
  "title": "I Don’t Want To Go Out",
  "level": "intermediate",
  "date": "2018-09-12",
  "synopsis": "Little Le just wants to stay at home and be a homebody.",
  "audioUrl": "https://static.duchinese.net/documents/834/c8c162842d187af527b17cc86feedcb21b1902ae.mp3?1535367970",
  "series": null,
  "fullText": {
    "simplified": "我不想出门\n\n保罗：小乐，我们去打羽毛球吧。\n小乐：我最近肩膀疼，不能打羽毛球。\n保罗：那我们去跑步怎么样？\n小乐：跑步对膝盖不好。\n保罗：那我们去游泳吧，游泳对身体最好了 。\n小乐：哎，我不想出门，你就让我在家当个宅女吧！",
    "traditional": "我不想出門\n\n保羅：小樂，我們去打羽毛球吧。\n小樂：我最近肩膀疼，不能打羽毛球。\n保羅：那我們去跑步怎麼樣？\n小樂：跑步對膝蓋不好。\n保羅：那我們去游泳吧，游泳對身體最好了 。\n小樂：哎，我不想出門，你就讓我在家當個宅女吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Don’t Want To Go Out"
    },
    {
      "index": 2,
      "simplified": "保罗：小乐，我们去打羽毛球吧。",
      "traditional": "保羅：小樂，我們去打羽毛球吧。",
      "pinyin": "bǎo luó xiǎo lè wǒ men qù dǎ yǔ máo qiú ba",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Little Le, let’s go play badminton!"
    },
    {
      "index": 4,
      "simplified": "小乐：我最近肩膀疼，不能打羽毛球。",
      "traditional": "小樂：我最近肩膀疼，不能打羽毛球。",
      "pinyin": "xiǎo lè wǒ zuì jìn jiān bǎng téng bù néng dǎ yǔ máo qiú",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: My shoulder hurts recently. I can’t play badminton."
    },
    {
      "index": 6,
      "simplified": "保罗：那我们去跑步怎么样？",
      "traditional": "保羅：那我們去跑步怎麼樣？",
      "pinyin": "bǎo luó nà wǒ men qù pǎo bù zěn me yàng",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Then how about we go running?"
    },
    {
      "index": 8,
      "simplified": "小乐：跑步对膝盖不好。",
      "traditional": "小樂：跑步對膝蓋不好。",
      "pinyin": "xiǎo lè pǎo bù duì xī gài bù hǎo",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Running is not good for my knees."
    },
    {
      "index": 10,
      "simplified": "保罗：那我们去游泳吧，游泳对身体最好了 。",
      "traditional": "保羅：那我們去游泳吧，游泳對身體最好了 。",
      "pinyin": "bǎo luó nà wǒ men qù yóu yǒng ba yóu yǒng duì shēn tǐ zuì hǎo le",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Then we can go swimming. It’s the best exercise for your body."
    },
    {
      "index": 12,
      "simplified": "小乐：哎，我不想出门，你就让我在家当个宅女吧！",
      "traditional": "小樂：哎，我不想出門，你就讓我在家當個宅女吧！",
      "pinyin": "xiǎo lè āi wǒ bù xiǎng chū mén nǐ jiù ràng wǒ zài jiā dāng ge zhái nǚ ba",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: Sigh, I don’t want to go out. Just let me stay at home and be a homebody."
    }
  ],
