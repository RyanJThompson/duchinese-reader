  "title": "What Type of Girls",
  "level": "newbie",
  "date": "2018-08-23",
  "synopsis": "Little Yu wants to know what type of girls Ben likes.",
  "audioUrl": "https://static.duchinese.net/documents/820/946a69f76a4ea3b2cb9403e6f3d1b9b73480e073.mp3?1589791866",
