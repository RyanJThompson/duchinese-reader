  "title": "Ben’s Diary – National Day",
  "level": "intermediate",
  "date": "2018-10-03",
  "synopsis": "Ben decided to study instead of going traveling on China’s National Day.",
  "audioUrl": "https://static.duchinese.net/documents/855/23aa4b39e0322248d73946f8640ab827e67d3a2d.mp3?1635865119",
  "series": {
