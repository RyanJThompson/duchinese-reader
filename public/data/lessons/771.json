{
  "id": "771",
  "title": "Which Shirt?",
  "level": "newbie",
  "date": "2019-07-09",
  "synopsis": "Where has Little He’s new shirt gone?",
  "audioUrl": "https://static.duchinese.net/documents/1092/cad5faf86ce468fd8c3957f1a7ab8caeac9c5b70.mp3?1562489138",
  "series": null,
  "fullText": {
    "simplified": "哪件衣服？\n\n小何：丽丽，我的衣服去哪儿了？\n丽丽：哪件衣服？\n小何：新买的那件黑色的。\n丽丽：那件我洗了。\n小何：为什么洗了？我今天要穿的！\n丽丽：新衣服就是要洗了才能穿啊！你穿这件白色的吧！\n小何：好吧！",
    "traditional": "哪件衣服？\n\n小何：麗麗，我的衣服去哪兒了？\n麗麗：哪件衣服？\n小何：新買的那件黑色的。\n麗麗：那件我洗了。\n小何：為什麼洗了？我今天要穿的！\n麗麗：新衣服就是要洗了才能穿啊！你穿這件白色的吧！\n小何：好吧！"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "Which Shirt?"
    },
    {
      "index": 2,
      "simplified": "小何：丽丽，我的衣服去哪儿了？",
      "traditional": "小何：麗麗，我的衣服去哪兒了？",
      "pinyin": "xiǎo hé lì lì wǒ de yī fu qù nǎ'r le",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Lili, where has my shirt gone?"
    },
    {
      "index": 4,
      "simplified": "丽丽：哪件衣服？",
      "traditional": "麗麗：哪件衣服？",
      "pinyin": "lì lì nǎ jiàn yī fu",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: Which shirt?"
    },
    {
      "index": 6,
      "simplified": "小何：新买的那件黑色的。",
      "traditional": "小何：新買的那件黑色的。",
      "pinyin": "xiǎo hé xīn mǎi de nèi jiàn hēi sè de",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: That black newly bought one."
    },
    {
      "index": 8,
      "simplified": "丽丽：那件我洗了。",
      "traditional": "麗麗：那件我洗了。",
      "pinyin": "lì lì nà jiàn wǒ xǐ le",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: I washed that one."
    },
    {
      "index": 10,
      "simplified": "小何：为什么洗了？我今天要穿的！",
      "traditional": "小何：為什麼洗了？我今天要穿的！",
      "pinyin": "xiǎo hé wèi shén me xǐ le wǒ jīn tiān yào chuān de",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little He: Why did you wash it? I want to wear that today!"
    },
    {
      "index": 12,
      "simplified": "丽丽：新衣服就是要洗了才能穿啊！你穿这件白色的吧！",
      "traditional": "麗麗：新衣服就是要洗了才能穿啊！你穿這件白色的吧！",
      "pinyin": "lì lì xīn yī fu jiù shì yào xǐ le cái néng chuān a nǐ chuān zhè jiàn bái sè de ba",
      "english": ""
    },
    {
      "index": 13,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Lili: You have to wash new clothes before you can wear them! Wear this white one!"
    },
    {
      "index": 14,
      "simplified": "小何：好吧！",
      "traditional": "小何：好吧！",
      "pinyin": "xiǎo hé hǎo ba",
      "english": ""
    },
    {
      "index": 15,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little He: Ok!"
    }
  ],
