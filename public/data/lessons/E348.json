{
  "id": "E348",
  "title": "I Am Nine And You Are Three",
  "level": "elementary",
  "date": "2019-08-03",
  "synopsis": "Why does Little Le say that she’s nine and Paul is three?",
  "audioUrl": "https://static.duchinese.net/documents/1115/c6bfcc7ae083f0f8cc3b2228182dde4e60464c5b.mp3?1564388409",
  "series": null,
  "fullText": {
    "simplified": "我是九，你是三\n\n小乐：保罗，我是九你是三\n保罗：为什么？\n小乐：九除三等于几？\n保罗：等于三。所以呢？\n小乐：所以，我除了你还是你。",
    "traditional": "我是九，你是三\n\n小樂：保羅，我是九你是三\n保羅：為什麼？\n小樂：九除三等於幾？\n保羅：等於三。所以呢？\n小樂：所以，我除了你還是你。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n\n",
      "traditional": "\n\n",
      "pinyin": "",
      "english": "I Am Nine And You Are Three"
    },
    {
      "index": 2,
      "simplified": "小乐：保罗，我是九你是三",
      "traditional": "小樂：保羅，我是九你是三",
      "pinyin": "xiǎo lè bǎo luó wǒ shì jiǔ nǐ shì sān",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: Paul, I am nine, and you are three."
    },
    {
      "index": 4,
      "simplified": "保罗：为什么？",
      "traditional": "保羅：為什麼？",
      "pinyin": "bǎo luó wèi shén me",
      "english": ""
    },
    {
      "index": 5,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Why?"
    },
    {
      "index": 6,
      "simplified": "小乐：九除三等于几？",
      "traditional": "小樂：九除三等於幾？",
      "pinyin": "xiǎo lè jiǔ chú sān děng yú jǐ",
      "english": ""
    },
    {
      "index": 7,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Little Le: What is nine divided by three?"
    },
    {
      "index": 8,
      "simplified": "保罗：等于三。所以呢？",
      "traditional": "保羅：等於三。所以呢？",
      "pinyin": "bǎo luó děng yú sān suǒ yǐ ne",
      "english": ""
    },
    {
      "index": 9,
      "simplified": "\n",
      "traditional": "\n",
      "pinyin": "",
      "english": "Paul: Three. So?"
    },
    {
      "index": 10,
      "simplified": "小乐：所以，我除了你还是你。",
      "traditional": "小樂：所以，我除了你還是你。",
      "pinyin": "xiǎo lè suǒ yǐ wǒ chú le nǐ hái shì nǐ",
      "english": ""
    },
    {
      "index": 11,
      "simplified": "",
      "traditional": "",
      "pinyin": "",
      "english": "Little Le: So, you are my one and only."
    }
