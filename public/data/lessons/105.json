{
  "id": "105",
  "title": "Checking into a Hotel",
  "level": "intermediate",
  "date": "2016-03-13",
  "synopsis": "Can you check into a hotel using only Chinese? Today we learn some words and phrases which come in handy when traveling in China.",
  "audioUrl": "https://static.duchinese.net/documents/85/de0e1f13eb9521893ceaa9b674fc90f19c9f0ec5.mp3",
  "series": null,
  "fullText": {
    "simplified": "入住宾馆\n    \n    你好。我预订了房间。我叫保罗。我订的是一个大床房，住一个晚上，明天退房。这是我的护照，谢谢。",
    "traditional": "入住賓館\n    \n    你好。我預訂了房間。我叫保羅。我訂的是一個大床房，住一個晚上，明天退房。這是我的護照，謝謝。"
  },
  "sentences": [
    {
      "index": 1,
      "simplified": "\n    \n    ",
      "traditional": "\n    \n    ",
      "pinyin": "",
      "english": "Checking into a Hotel"
    },
    {
      "index": 2,
      "simplified": "你好。",
      "traditional": "你好。",
      "pinyin": "nǐ hǎo",
      "english": ""
    },
    {
      "index": 3,
      "simplified": "我预订了房间。",
      "traditional": "我預訂了房間。",
      "pinyin": "wǒ yù dìng le fáng jiān",
      "english": "Hello."
    },
    {
      "index": 4,
      "simplified": "我叫保罗。",
      "traditional": "我叫保羅。",
      "pinyin": "wǒ jiào bǎo luó",
      "english": "I booked a room."
    },
    {
      "index": 5,
      "simplified": "我订的是一个大床房，住一个晚上，明天退房。",
      "traditional": "我訂的是一個大床房，住一個晚上，明天退房。",
      "pinyin": "wǒ dìng de shì yí ge dà chuáng fáng zhù yí ge wǎn shang míng tiān tuì fáng",
      "english": "My name is Paul."
    },
    {
      "index": 6,
      "simplified": "这是我的护照，谢谢。",
      "traditional": "這是我的護照，謝謝。",
      "pinyin": "zhè shì wǒ de hù zhào xiè xie",
      "english": "I booked a room with a double bed. I stay for one night and check out tomorrow."
    }
  ],
