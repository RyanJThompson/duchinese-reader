DUCHINESE_EMAIL=your-email@example.com
DUCHINESE_PASSWORD=your-password

# Required for Vercel deployments. Protects the app, assets, and lesson API.
BASIC_AUTH_USER=reader
BASIC_AUTH_PASSWORD=generate-a-long-random-password

# Optional but recommended: a dedicated secret for signing the session cookie,
# separate from the login password. When set, rotating the login password no
# longer silently changes the cookie key. Falls back to BASIC_AUTH_PASSWORD if
# unset. Generate a long random value. (Changing it signs everyone out.)
SESSION_SECRET=

# Optional: minimum lessons a full build-time scrape must produce before the
# master index is written. Guards against shipping an empty catalog if auth or
# the DuChinese feeds fail. Default 200; lower it for intentional partial scrapes.
SCRAPE_MIN_LESSONS=

# Optional: Upstash Redis (enables cross-device sync for learned lessons).
# Get these from https://console.upstash.com/ → your database → REST API section.
# Auto-populated when linking Upstash to Vercel via the integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SYNC_ACCESS_TOKEN=

# Alternative names (auto-populated by Vercel's built-in KV storage tab):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
